+                                              128, 44100, ASSERT_NO_EXCEPTION);
+  ASSERT_TRUE(context);
+  EXPECT_FALSE(context->GetGlintAudioMathPipeline().has_value());
+  DummyExceptionStateForTesting node_exception;
+  EXPECT_FALSE(context->createDynamicsCompressor(node_exception));
+  ASSERT_TRUE(node_exception.HadException());
+  EXPECT_EQ(node_exception.CodeAs<DOMExceptionCode>(),
+            DOMExceptionCode::kNotReadableError);
+  DummyExceptionStateForTesting render_exception;
+  EXPECT_TRUE(context->startOfflineRendering(nullptr, render_exception).IsEmpty());
+  ASSERT_TRUE(render_exception.HadException());
+  EXPECT_EQ(render_exception.CodeAs<DOMExceptionCode>(),
+            DOMExceptionCode::kNotReadableError);
+  EXPECT_EQ(context->state().AsStringView(), "suspended");
