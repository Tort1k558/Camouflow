@@ -0,0 +1,106 @@
+// Copyright 2026 CamouFlow contributors.
+// SPDX-License-Identifier: MIT
+
+#ifndef CONTENT_BROWSER_CAMOUFLOW_NATIVE_GLINT_PROFILE_PRODUCER_FENCE_H_
+#define CONTENT_BROWSER_CAMOUFLOW_NATIVE_GLINT_PROFILE_PRODUCER_FENCE_H_
+
+#include <cstddef>
+#include <memory>
+#include <set>
+
+#include "base/functional/callback.h"
+#include "base/memory/weak_ptr.h"
+#include "base/scoped_multi_source_observation.h"
+#include "base/time/time.h"
+#include "base/timer/timer.h"
+#include "content/common/content_export.h"
+#include "content/public/browser/render_process_host_creation_observer.h"
+#include "content/public/browser/render_process_host_observer.h"
+#include "content/public/browser/storage_partition_config.h"
+#include "content/public/common/child_process_id.h"
+
+namespace content {
+class BrowserContext;
+class RenderProcessHost;
+}  // namespace content
+
+namespace camouflow::native {
+
+// A producer-prefix acknowledgment, not a database commit or atomic snapshot.
+class CONTENT_EXPORT ProfileProducerFence final
+    : public content::RenderProcessHostObserver,
+      public content::RenderProcessHostCreationObserver {
+ public:
+  enum class Status {
+    kAcknowledged,
+    kInvalidScope,
+    kNotReady,
+    kTooManyActors,
+    kTopologyChanged,
+    kProducerRejected,
+    kTimedOut,
+    kOwnerGone,
+    kCancelled,
+  };
+
+  struct Result {
+    Status status;
+    size_t renderer_count;
+    size_t loaded_partition_count;
+  };
+  using Callback = base::OnceCallback<void(Result)>;
+
+  // UI sequence only. Never starts a renderer or creates a storage partition.
+  // Retain the returned operation until completion. Destruction posts
+  // cancellation.
+  static std::unique_ptr<ProfileProducerFence> Start(
+      content::BrowserContext* context,
+      base::TimeTicks deadline,
+      Callback callback);
+  ~ProfileProducerFence() override;
+
+  ProfileProducerFence(const ProfileProducerFence&) = delete;
+  ProfileProducerFence& operator=(const ProfileProducerFence&) = delete;
+
+ private:
+  static constexpr size_t kMaxRenderers = 512;
+  static constexpr size_t kMaxPartitions = 128;
+
+  ProfileProducerFence(content::BrowserContext* context,
+                       base::TimeTicks deadline,
+                       Callback callback);
+  void Begin();
+  Status Capture(std::set<content::ChildProcessId>& renderers,
+                 std::set<content::StoragePartitionConfig>& partitions);
+  void ProducerReplied(bool success);
+  void Changed();
+  void Finish(Status status);
+  void Deliver(Status status);
+
+  void RenderProcessReady(content::RenderProcessHost* host) override;
+  void RenderProcessExited(
+      content::RenderProcessHost* host,
+      const content::ChildProcessTerminationInfo& info) override;
+  void InProcessRendererExiting(content::RenderProcessHost* host) override;
+  void RenderProcessHostDestroyed(content::RenderProcessHost* host) override;
+  void OnRenderProcessHostCreated(content::RenderProcessHost* host) override;
+  void OnRenderProcessLaunched(content::RenderProcessHost* host) override;
+
+  base::WeakPtr<content::BrowserContext> context_;
+  const base::TimeTicks deadline_;
+  Callback callback_;
+  std::set<content::ChildProcessId> renderers_;
+  std::set<content::StoragePartitionConfig> partitions_;
+  size_t remaining_ = 0;
+  bool completion_queued_ = false;
+  bool topology_changed_ = false;
+  base::ScopedMultiSourceObservation<content::RenderProcessHost,
+                                     content::RenderProcessHostObserver>
+      observations_{this};
+  base::OneShotTimer timer_;
+  base::WeakPtrFactory<ProfileProducerFence> weak_factory_{this};
+};
+
+}  // namespace camouflow::native
+
+#endif
diff --git a/content/browser/camouflow_native/glint/profile_producer_fence_unittest.cc b/content/browser/camouflow_native/glint/profile_producer_fence_unittest.cc
new file mode 100644
--- /dev/null
+++ b/content/browser/camouflow_native/glint/profile_producer_fence_unittest.cc
@@ -0,0 +1,233 @@
+// Copyright 2026 CamouFlow contributors.
+// SPDX-License-Identifier: MIT
+
+#include "content/browser/camouflow_native/glint/profile_producer_fence.h"
+
+#include <deque>
+#include <memory>
+#include <optional>
+#include <utility>
+
+#include "base/check.h"
+#include "base/test/task_environment.h"
+#include "base/test/test_future.h"
+#include "content/public/test/browser_task_environment.h"
+#include "content/public/test/mock_render_process_host.h"
+#include "content/public/test/test_browser_context.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace camouflow::native {
+namespace {
+
+using Status = ProfileProducerFence::Status;
+using Result = ProfileProducerFence::Result;
+
+class CheckpointHost final : public content::MockRenderProcessHost {
+ public:
+  explicit CheckpointHost(content::BrowserContext* context)
+      : MockRenderProcessHost(context) {
+    Init();
+    SimulateReady();
+  }
+
+  void FenceLocalStorageForCheckpoint(
+      base::TimeTicks deadline,
+      base::OnceCallback<void(bool)> callback) override {
+    ++requests;
+    if (inline_reply.has_value()) {
+      std::move(callback).Run(*inline_reply);
+    } else {
+      replies.push_back(std::move(callback));
+    }
+  }
+
+  void Reply(bool success) {
+    CHECK(!replies.empty());
+    auto callback = std::move(replies.front());
+    replies.pop_front();
+    std::move(callback).Run(success);
+  }
+
+  int requests = 0;
+  std::optional<bool> inline_reply;
+  std::deque<base::OnceCallback<void(bool)>> replies;
+};
+
+class ProfileProducerFenceTest : public testing::Test {
+ protected:
+  base::TimeTicks Deadline() {
+    return base::TimeTicks::Now() + base::Seconds(5);
+  }
+  content::BrowserTaskEnvironment environment_{
+      base::test::TaskEnvironment::TimeSource::MOCK_TIME};
+  content::TestBrowserContext context_;
+};
+
+TEST_F(ProfileProducerFenceTest, EmptyScopeIsPostedAndDoesNotCreatePartition) {
+  const auto partitions = context_.GetLoadedStoragePartitionCount();
+  base::test::TestFuture<Result> result;
+  auto operation =
+      ProfileProducerFence::Start(&context_, Deadline(), result.GetCallback());
+  EXPECT_FALSE(result.IsReady());
+  EXPECT_EQ(result.Get().status, Status::kAcknowledged);
+  EXPECT_EQ(result.Get().renderer_count, 0u);
+  EXPECT_EQ(context_.GetLoadedStoragePartitionCount(), partitions);
+}
+
+TEST_F(ProfileProducerFenceTest, NullContextFailsWithoutInlineReply) {
+  base::test::TestFuture<Result> result;
+  auto operation =
+      ProfileProducerFence::Start(nullptr, Deadline(), result.GetCallback());
+  EXPECT_FALSE(result.IsReady());
+  EXPECT_EQ(result.Get().status, Status::kOwnerGone);
+}
+
+TEST_F(ProfileProducerFenceTest, OffTheRecordScopeIsRejected) {
+  content::TestBrowserContext off_the_record;
+  off_the_record.set_is_off_the_record(true);
+  base::test::TestFuture<Result> result;
+  auto operation = ProfileProducerFence::Start(&off_the_record, Deadline(),
+                                               result.GetCallback());
+  EXPECT_EQ(result.Get().status, Status::kInvalidScope);
+}
+
+TEST_F(ProfileProducerFenceTest, ExpiredDeadlineNeverContactsRenderer) {
+  CheckpointHost host(&context_);
+  base::test::TestFuture<Result> result;
+  auto operation = ProfileProducerFence::Start(
+      &context_, base::TimeTicks::Now(), result.GetCallback());
+  EXPECT_EQ(result.Get().status, Status::kTimedOut);
+  EXPECT_EQ(host.requests, 0);
+}
+
+TEST_F(ProfileProducerFenceTest, UnboundedDeadlineNeverContactsRenderer) {
+  CheckpointHost host(&context_);
+  base::test::TestFuture<Result> result;
+  auto operation = ProfileProducerFence::Start(
+      &context_, base::TimeTicks::Max(), result.GetCallback());
+  EXPECT_EQ(result.Get().status, Status::kTimedOut);
+  EXPECT_EQ(host.requests, 0);
+}
+
+TEST_F(ProfileProducerFenceTest, WaitsForAllCapturedRenderers) {
+  CheckpointHost first(&context_);
+  CheckpointHost second(&context_);
+  base::test::TestFuture<Result> result;
+  auto operation =
+      ProfileProducerFence::Start(&context_, Deadline(), result.GetCallback());
+  EXPECT_EQ(first.requests, 1);
+  EXPECT_EQ(second.requests, 1);
+  second.Reply(true);
+  environment_.RunUntilIdle();
+  EXPECT_FALSE(result.IsReady());
+  first.Reply(true);
+  EXPECT_EQ(result.Get().status, Status::kAcknowledged);
+  EXPECT_EQ(result.Get().renderer_count, 2u);
+}
+
+TEST_F(ProfileProducerFenceTest, DoesNotContactOtherBrowserContext) {
+  content::TestBrowserContext neighbour;
+  CheckpointHost other(&neighbour);
+  base::test::TestFuture<Result> result;
+  auto operation =
+      ProfileProducerFence::Start(&context_, Deadline(), result.GetCallback());
+  EXPECT_EQ(result.Get().status, Status::kAcknowledged);
+  EXPECT_EQ(other.requests, 0);
+}
+
+TEST_F(ProfileProducerFenceTest, InlineProducerCannotInvokeCallerInline) {
+  CheckpointHost host(&context_);
+  host.inline_reply = true;
+  base::test::TestFuture<Result> result;
+  auto operation =
+      ProfileProducerFence::Start(&context_, Deadline(), result.GetCallback());
+  EXPECT_FALSE(result.IsReady());
+  EXPECT_EQ(result.Get().status, Status::kAcknowledged);
+}
+
+TEST_F(ProfileProducerFenceTest, ProducerRejectionIsNotSuccess) {
+  CheckpointHost host(&context_);
+  base::test::TestFuture<Result> result;
+  auto operation =
+      ProfileProducerFence::Start(&context_, Deadline(), result.GetCallback());
+  host.Reply(false);
+  EXPECT_EQ(result.Get().status, Status::kProducerRejected);
+}
+
+TEST_F(ProfileProducerFenceTest, DroppedProducerReplyFailsClosed) {
+  CheckpointHost host(&context_);
+  base::test::TestFuture<Result> result;
+  auto operation =
+      ProfileProducerFence::Start(&context_, Deadline(), result.GetCallback());
+  host.replies.clear();
+  EXPECT_EQ(result.Get().status, Status::kProducerRejected);
+}
+
+TEST_F(ProfileProducerFenceTest, UnansweredProducerUsesBrowserDeadline) {
+  CheckpointHost host(&context_);
+  base::test::TestFuture<Result> result;
+  auto operation =
+      ProfileProducerFence::Start(&context_, Deadline(), result.GetCallback());
+  environment_.FastForwardBy(base::Seconds(5));
+  EXPECT_EQ(result.Get().status, Status::kTimedOut);
+  host.Reply(true);
+  environment_.RunUntilIdle();
+}
+
+TEST_F(ProfileProducerFenceTest, CancelPendingOperationPostsFailure) {
+  CheckpointHost host(&context_);
+  base::test::TestFuture<Result> result;
+  auto operation =
+      ProfileProducerFence::Start(&context_, Deadline(), result.GetCallback());
+  operation.reset();
+  EXPECT_FALSE(result.IsReady());
+  EXPECT_EQ(result.Get().status, Status::kCancelled);
+  host.Reply(true);
+  environment_.RunUntilIdle();
+}
+
+TEST_F(ProfileProducerFenceTest, CancelQueuedSuccessCannotBecomeAcknowledged) {
+  base::test::TestFuture<Result> result;
+  auto operation =
+      ProfileProducerFence::Start(&context_, Deadline(), result.GetCallback());
+  operation.reset();
+  EXPECT_EQ(result.Get().status, Status::kCancelled);
+}
+
+TEST_F(ProfileProducerFenceTest, ContextDestructionRejectsQueuedSuccess) {
+  auto context = std::make_unique<content::TestBrowserContext>();
+  base::test::TestFuture<Result> result;
+  auto operation = ProfileProducerFence::Start(context.get(), Deadline(),
+                                               result.GetCallback());
+  context.reset();
+  EXPECT_EQ(result.Get().status, Status::kOwnerGone);
+}
+
+TEST_F(ProfileProducerFenceTest, HostDestructionRejectsPendingCohort) {
+  auto host = std::make_unique<CheckpointHost>(&context_);
+  base::test::TestFuture<Result> result;
+  auto operation =
+      ProfileProducerFence::Start(&context_, Deadline(), result.GetCallback());
+  host.reset();
+  EXPECT_EQ(result.Get().status, Status::kTopologyChanged);
+}
+
+TEST_F(ProfileProducerFenceTest, NewReadyRendererInvalidatesQueuedEmptyScope) {
+  base::test::TestFuture<Result> result;
+  auto operation =
+      ProfileProducerFence::Start(&context_, Deadline(), result.GetCallback());
+  CheckpointHost host(&context_);
+  EXPECT_EQ(result.Get().status, Status::kTopologyChanged);
+  EXPECT_EQ(host.requests, 0);
+}
+
+TEST_F(ProfileProducerFenceTest, UnreadyRendererDoesNotReceiveFence) {
+  content::MockRenderProcessHost host(&context_);
+  base::test::TestFuture<Result> result;
+  auto operation =
+      ProfileProducerFence::Start(&context_, Deadline(), result.GetCallback());
+  EXPECT_EQ(result.Get().status, Status::kNotReady);
+}
+
+}  // namespace
+}  // namespace camouflow::native
