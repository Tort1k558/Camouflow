--- /dev/null
+++ b/content/browser/camouflow_native/glint/profile_producer_fence.cc
@@ -0,0 +1,223 @@
+// Copyright 2026 CamouFlow contributors.
+// SPDX-License-Identifier: MIT
+
+#include "content/browser/camouflow_native/glint/profile_producer_fence.h"
+
+#include <utility>
+
+#include "base/check.h"
+#include "base/functional/bind.h"
+#include "base/task/bind_post_task.h"
+#include "base/task/sequenced_task_runner.h"
+#include "content/public/browser/browser_context.h"
+#include "content/public/browser/browser_thread.h"
+#include "content/public/browser/render_process_host.h"
+#include "content/public/browser/storage_partition.h"
+#include "mojo/public/cpp/bindings/callback_helpers.h"
+
+namespace camouflow::native {
+
+std::unique_ptr<ProfileProducerFence> ProfileProducerFence::Start(
+    content::BrowserContext* context,
+    base::TimeTicks deadline,
+    Callback callback) {
+  CHECK_CURRENTLY_ON(content::BrowserThread::UI);
+  CHECK(callback);
+  auto operation = std::unique_ptr<ProfileProducerFence>(
+      new ProfileProducerFence(context, deadline, std::move(callback)));
+  operation->Begin();
+  return operation;
+}
+
+ProfileProducerFence::ProfileProducerFence(content::BrowserContext* context,
+                                           base::TimeTicks deadline,
+                                           Callback callback)
+    : context_(context ? context->GetWeakPtr()
+                       : base::WeakPtr<content::BrowserContext>()),
+      deadline_(deadline),
+      callback_(std::move(callback)) {}
+
+ProfileProducerFence::~ProfileProducerFence() {
+  CHECK_CURRENTLY_ON(content::BrowserThread::UI);
+  weak_factory_.InvalidateWeakPtrs();
+  timer_.Stop();
+  observations_.RemoveAllObservations();
+  if (callback_) {
+    base::BindPostTaskToCurrentDefault(std::move(callback_))
+        .Run(Result{Status::kCancelled, renderers_.size(), partitions_.size()});
+  }
+}
+
+ProfileProducerFence::Status ProfileProducerFence::Capture(
+    std::set<content::ChildProcessId>& renderers,
+    std::set<content::StoragePartitionConfig>& partitions) {
+  if (!context_ || context_->ShutdownStarted()) {
+    return Status::kOwnerGone;
+  }
+  if (context_->IsOffTheRecord()) {
+    return Status::kInvalidScope;
+  }
+  if (context_->GetLoadedStoragePartitionCount() > kMaxPartitions) {
+    return Status::kTooManyActors;
+  }
+  context_->ForEachLoadedStoragePartition(
+      [&partitions](content::StoragePartition* partition) {
+        partitions.insert(partition->GetConfig());
+      });
+  for (auto it = content::RenderProcessHost::AllHostsIterator(); !it.IsAtEnd();
+       it.Advance()) {
+    auto* host = it.GetCurrentValue();
+    if (host->GetBrowserContext() != context_.get()) {
+      continue;
+    }
+    if (!host->IsInitializedAndNotDead() || !host->IsReady() ||
+        host->FastShutdownStarted()) {
+      return Status::kNotReady;
+    }
+    renderers.insert(host->GetID());
+    if (renderers.size() > kMaxRenderers) {
+      return Status::kTooManyActors;
+    }
+  }
+  return Status::kAcknowledged;
+}
+
+void ProfileProducerFence::Begin() {
+  if (deadline_.is_max() || deadline_ <= base::TimeTicks::Now()) {
+    Finish(Status::kTimedOut);
+    return;
+  }
+  Status captured = Capture(renderers_, partitions_);
+  if (captured != Status::kAcknowledged) {
+    Finish(captured);
+    return;
+  }
+  remaining_ = renderers_.size();
+  for (auto id : renderers_) {
+    auto* host = content::RenderProcessHost::FromID(id);
+    if (!host) {
+      Finish(Status::kTopologyChanged);
+      return;
+    }
+    observations_.AddObservation(host);
+  }
+  timer_.Start(FROM_HERE, deadline_ - base::TimeTicks::Now(),
+               base::BindOnce(&ProfileProducerFence::Finish,
+                              weak_factory_.GetWeakPtr(), Status::kTimedOut));
+  if (renderers_.empty()) {
+    Finish(Status::kAcknowledged);
+    return;
+  }
+  // Force posted delivery even for an embedder/mock implementation that replies
+  // inline; observation setup and iteration must finish before user callbacks.
+  for (auto id : renderers_) {
+    if (completion_queued_) {
+      return;
+    }
+    auto* host = content::RenderProcessHost::FromID(id);
+    if (!host || !context_ || host->GetBrowserContext() != context_.get() ||
+        !host->IsInitializedAndNotDead() || !host->IsReady()) {
+      Finish(Status::kTopologyChanged);
+      return;
+    }
+    host->FenceLocalStorageForCheckpoint(
+        deadline_, mojo::WrapCallbackWithDefaultInvokeIfNotRun(
+                       base::BindPostTaskToCurrentDefault(base::BindOnce(
+                           &ProfileProducerFence::ProducerReplied,
+                           weak_factory_.GetWeakPtr())),
+                       false));
+  }
+}
+
+void ProfileProducerFence::ProducerReplied(bool success) {
+  if (completion_queued_) {
+    return;
+  }
+  CHECK_GT(remaining_, 0u);
+  if (!success) {
+    Finish(Status::kProducerRejected);
+    return;
+  }
+  if (--remaining_ == 0) {
+    Finish(Status::kAcknowledged);
+  }
+}
+
+void ProfileProducerFence::Changed() {
+  // Latch changes even after Finish() posts success but before Deliver().
+  topology_changed_ = true;
+  if (callback_) {
+    Finish(Status::kTopologyChanged);
+  }
+}
+
+void ProfileProducerFence::Finish(Status status) {
+  if (completion_queued_ || !callback_) {
+    return;
+  }
+  completion_queued_ = true;
+  timer_.Stop();
+  base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, base::BindOnce(&ProfileProducerFence::Deliver,
+                                weak_factory_.GetWeakPtr(), status));
+}
+
+void ProfileProducerFence::Deliver(Status status) {
+  if (!context_ || context_->ShutdownStarted()) {
+    status = Status::kOwnerGone;
+  } else if (status == Status::kAcknowledged) {
+    std::set<content::ChildProcessId> renderers;
+    std::set<content::StoragePartitionConfig> partitions;
+    const Status current = Capture(renderers, partitions);
+    if (base::TimeTicks::Now() >= deadline_) {
+      status = Status::kTimedOut;
+    } else if (current != Status::kAcknowledged) {
+      status = current;
+    } else if (topology_changed_ || renderers != renderers_ ||
+               partitions != partitions_) {
+      status = Status::kTopologyChanged;
+    }
+  }
+  observations_.RemoveAllObservations();
+  auto callback = std::move(callback_);
+  std::move(callback).Run(
+      Result{status, renderers_.size(), partitions_.size()});
+}
+
+void ProfileProducerFence::RenderProcessReady(
+    content::RenderProcessHost* host) {
+  Changed();
+}
+
+void ProfileProducerFence::RenderProcessExited(
+    content::RenderProcessHost* host,
+    const content::ChildProcessTerminationInfo& info) {
+  Changed();
+}
+
+void ProfileProducerFence::InProcessRendererExiting(
+    content::RenderProcessHost* host) {
+  Changed();
+}
+
+void ProfileProducerFence::RenderProcessHostDestroyed(
+    content::RenderProcessHost* host) {
+  observations_.RemoveObservation(host);
+  Changed();
+}
+
+void ProfileProducerFence::OnRenderProcessHostCreated(
+    content::RenderProcessHost* host) {
+  if (context_ && host->GetBrowserContext() == context_.get()) {
+    Changed();
+  }
+}
+
+void ProfileProducerFence::OnRenderProcessLaunched(
+    content::RenderProcessHost* host) {
+  if (context_ && host->GetBrowserContext() == context_.get()) {
+    Changed();
+  }
+}
+
+}  // namespace camouflow::native
diff --git a/content/browser/camouflow_native/glint/profile_producer_fence.h b/content/browser/camouflow_native/glint/profile_producer_fence.h
