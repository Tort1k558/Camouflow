+base::OnceCallback<void(bool)>
+CachedStorageArea::MakeCheckpointMutationCallback(Source* source) {
+  auto pauser = MakeVirtualTimePauserCallback(source);
+  if (IsSessionStorage()) {
+    return base::IgnoreArgs<bool>(std::move(pauser));
+  }
+  // HashSet reserves both zero and the maximum integer value as sentinels.
+  CHECK_LT(checkpoint_issued_, std::numeric_limits<uint64_t>::max() - 1);
+  const uint64_t serial = ++checkpoint_issued_;
+  CHECK(checkpoint_pending_.insert(serial).is_new_entry);
+  return mojo::WrapCallbackWithDefaultInvokeIfNotRun(
+      base::BindOnce(
+          [](base::WeakPtr<CachedStorageArea> owner, uint64_t generation,
+             uint64_t serial, base::OnceClosure pauser, bool success) {
+            std::move(pauser).Run();
+            if (owner) {
+              owner->OnCheckpointMutationAck(generation, serial, success);
+            }
+          },
+          checkpoint_weak_factory_.GetWeakPtr(), checkpoint_generation_, serial,
+          std::move(pauser)),
+      false);
+}
+
+void CachedStorageArea::OnCheckpointMutationAck(uint64_t generation,
+                                                uint64_t serial,
+                                                bool success) {
+  if (generation != checkpoint_generation_) {
+    return;
+  }
+  CHECK(checkpoint_pending_.Contains(serial));
+  checkpoint_pending_.erase(serial);
+  checkpoint_write_failed_ |= !success;
+  while (checkpoint_acknowledged_ < checkpoint_issued_ &&
+         !checkpoint_pending_.Contains(checkpoint_acknowledged_ + 1)) {
+    ++checkpoint_acknowledged_;
+  }
+  CompleteCheckpointWaiters();
+}
+
+void CachedStorageArea::FenceMutationsForCheckpoint(
+    base::TimeTicks deadline,
+    base::OnceCallback<void(bool)> callback) {
+  CHECK(callback);
+  const uint64_t serial = checkpoint_issued_;
+  auto reply = base::BindPostTaskToCurrentDefault(base::BindOnce(
+      [](base::WeakPtr<CachedStorageArea> owner, uint64_t generation,
+         uint64_t serial, base::TimeTicks deadline,
+         base::OnceCallback<void(bool)> callback, bool success) {
+        std::move(callback).Run(success && base::TimeTicks::Now() < deadline &&
+                                owner &&
+                                owner->checkpoint_generation_ == generation &&
+                                owner->checkpoint_issued_ == serial &&
+                                !owner->checkpoint_write_failed_ &&
+                                owner->remote_area_.is_bound() &&
+                                owner->remote_area_.is_connected());
+      },
+      checkpoint_weak_factory_.GetWeakPtr(), checkpoint_generation_, serial,
+      deadline, std::move(callback)));
+  if (deadline.is_max() || deadline <= base::TimeTicks::Now() ||
+      IsSessionStorage() || is_session_storage_for_prerendering_ ||
+      !remote_area_.is_bound() || !remote_area_.is_connected() ||
+      checkpoint_write_failed_ || checkpoint_waiters_.size() >= 256) {
+    std::move(reply).Run(false);
+    return;
+  }
+  checkpoint_waiters_.push_back(
+      CheckpointWaiter{serial, deadline, std::move(reply)});
+  CompleteCheckpointWaiters();
+}
+
+void CachedStorageArea::CompleteCheckpointWaiters() {
+  checkpoint_timeout_.Stop();
+  Vector<CheckpointWaiter> pending;
+  pending.swap(checkpoint_waiters_);
+  for (auto& waiter : pending) {
+    if (checkpoint_write_failed_ || base::TimeTicks::Now() >= waiter.deadline ||
+        waiter.serial <= checkpoint_acknowledged_) {
+      std::move(waiter.callback)
+          .Run(!checkpoint_write_failed_ &&
+               base::TimeTicks::Now() < waiter.deadline);
+    } else {
+      checkpoint_waiters_.push_back(std::move(waiter));
+    }
+  }
+  if (!checkpoint_waiters_.empty()) {
+    auto earliest = base::TimeTicks::Max();
+    for (const auto& waiter : checkpoint_waiters_) {
+      earliest = std::min(earliest, waiter.deadline);
+    }
+    checkpoint_timeout_.Start(
+        FROM_HERE,
+        std::max(base::TimeDelta(), earliest - base::TimeTicks::Now()),
+        base::BindOnce(&CachedStorageArea::CompleteCheckpointWaiters,
+                       checkpoint_weak_factory_.GetWeakPtr()));
+  }
+}
+
+void CachedStorageArea::InvalidateCheckpointConnection() {
+  checkpoint_timeout_.Stop();
+  CHECK_LT(checkpoint_generation_, std::numeric_limits<uint64_t>::max());
+  ++checkpoint_generation_;
+  checkpoint_write_failed_ |= !checkpoint_pending_.empty();
+  checkpoint_pending_.clear();
+  checkpoint_acknowledged_ = checkpoint_issued_;
+  Vector<CheckpointWaiter> pending;
+  pending.swap(checkpoint_waiters_);
+  for (auto& waiter : pending) {
+    std::move(waiter.callback).Run(false);
+  }
+}
