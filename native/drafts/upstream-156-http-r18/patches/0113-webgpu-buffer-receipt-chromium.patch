+bool GlintWebGPUReadbackObserver::ValidateGpuInputReceipt(
+    const dawn::native::GlintShaderScope& scope,
+    const std::shared_ptr<const dawn::native::GlintGpuInputReceipt>& receipt) const {
+  const auto committed = committed_gpu_input_plan_.lock();
+  if (!receipt || !committed || receipt->GetPlan() != committed ||
+      committed->regions.empty() || committed->deviceEpoch != epoch_ ||
+      committed->policyGeneration != policy_->generation() ||
+      committed->sequence != sequence_ || !scope.complete ||
+      scope.hasTextureInputs != gpu_input_texture_scope_ ||
+      scope.buffers.size() != gpu_input_scope_.size()) return false;
+  for (size_t index = 0; index < gpu_input_scope_.size(); ++index) {
+    const auto& expected = gpu_input_scope_[index];
+    const auto& actual = scope.buffers[index];
+    if (expected.buffer.handle != actual.buffer.handle ||
+        expected.buffer.size != actual.buffer.size || expected.readable != actual.readable ||
+        expected.writable != actual.writable || expected.offset != actual.offset ||
+        expected.size != actual.size || expected.rangeKnown != actual.rangeKnown) return false;
+  }
+  return true;
 }
 
