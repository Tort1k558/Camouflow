+TEST_F(GlintHttpCookieNetworkTest, ResponseWaitsForRealCookieCompletion) {
+  TestDelegate delegate;
+  base::test::TestFuture<void> completed;
+  delegate.set_on_complete(completed.GetCallback());
+  auto request = Request("/one", &delegate);
+  request->Start();
+  ASSERT_TRUE(WaitForWrites(1));
+  base::test::TestFuture<bool> checkpoint;
+  store_->FlushHttpCookieWritesForCheckpoint(checkpoint.GetCallback());
+  RunUntilIdle();
+  EXPECT_TRUE(store_->backend.empty());
+  EXPECT_FALSE(checkpoint.IsReady());
+  EXPECT_FALSE(completed.IsReady());
+  store_->ReleaseWrite(0);
+  ASSERT_TRUE(completed.Wait());
+  EXPECT_EQ(delegate.request_status(), OK);
+  EXPECT_EQ(delegate.data_received(), "owned");
+  RunUntilIdle();
+  ASSERT_EQ(store_->backend.size(), 1u);
+  CompleteBackend(0, true);
+  EXPECT_TRUE(checkpoint.Get());
+  EXPECT_EQ(CookieValues(),
+            (std::map<std::string, std::string>{{"first", "1"}}));
+}
