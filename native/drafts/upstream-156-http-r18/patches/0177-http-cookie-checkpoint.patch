+// Real CookieMonster mutations are held before dispatch. Only the persistence
+// callback is synthetic: these tests do not establish SQL or crash durability.
+class HeldHttpCookieStore : public CookieMonster {
+ public:
+  HeldHttpCookieStore() : CookieMonster(nullptr, nullptr) {}
+
+  struct Write {
+    Write(std::unique_ptr<CanonicalCookie> cookie,
+          const GURL& source,
+          const CookieOptions& options,
+          SetCookiesCallback callback,
+          std::optional<CookieAccessResult> result)
+        : cookie(std::move(cookie)),
+          source(source),
+          options(options),
+          callback(std::move(callback)),
+          result(std::move(result)) {}
+    std::unique_ptr<CanonicalCookie> cookie;
+    GURL source;
+    CookieOptions options;
+    SetCookiesCallback callback;
+    std::optional<CookieAccessResult> result;
+  };
+
+  void SetCanonicalCookieAsync(
+      std::unique_ptr<CanonicalCookie> cookie,
+      const GURL& source,
+      const CookieOptions& options,
+      SetCookiesCallback callback,
+      std::optional<CookieAccessResult> result) override {
+    writes.push_back(std::make_unique<Write>(std::move(cookie), source, options,
+                                             std::move(callback),
+                                             std::move(result)));
+    if (on_write) {
+      on_write.Run();
+    }
+  }
+
+  void ReleaseWrite(size_t index) {
+    CHECK_LT(index, writes.size());
+    CHECK(writes[index]);
+    auto write = std::move(writes[index]);
+    CookieMonster::SetCanonicalCookieAsync(
+        std::move(write->cookie), write->source, write->options,
+        std::move(write->callback), std::move(write->result));
+  }
+
+  void FlushStoreForCheckpoint(
+      base::OnceCallback<void(bool)> callback) override {
+    backend.push_back(std::move(callback));
+  }
+
+  std::vector<std::unique_ptr<Write>> writes;
+  std::vector<base::OnceCallback<void(bool)>> backend;
+  base::RepeatingClosure on_write;
+};
+
+std::unique_ptr<test_server::HttpResponse> HttpCheckpointResponse(
+    const test_server::HttpRequest& request) {
+  auto response = std::make_unique<test_server::BasicHttpResponse>();
+  response->set_code(HTTP_OK);
+  response->set_content_type("text/plain");
+  response->set_content("owned");
+  if (request.relative_url == "/one") {
+    response->AddCustomHeader("Set-Cookie", "first=1; Path=/; Max-Age=3600");
+  } else if (request.relative_url == "/two") {
+    response->AddCustomHeader("Set-Cookie", "first=1; Path=/; Max-Age=3600");
+    response->AddCustomHeader("Set-Cookie", "second=2; Path=/; Max-Age=3600");
+  } else if (request.relative_url == "/redirect") {
+    response->set_code(HTTP_FOUND);
+    response->AddCustomHeader("Location", "/one");
+    response->AddCustomHeader("Set-Cookie",
+                              "redirect=before; Path=/; Max-Age=3600");
+  } else if (request.relative_url == "/invalid-domain") {
+    response->AddCustomHeader("Set-Cookie",
+                              "rejected=1; Domain=unrelated.invalid; Path=/");
+  } else {
+    return nullptr;
+  }
+  return response;
+}
