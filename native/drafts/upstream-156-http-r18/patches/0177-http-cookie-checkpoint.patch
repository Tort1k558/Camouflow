+class GlintHttpCookieCheckpointTest : public testing::Test {
+ protected:
+  GlintHttpCookieCheckpointTest()
+      : store_(std::make_unique<HttpCheckpointCookieStore>()) {}
+
+  CookieStore::SetCookiesCallback Track() {
+    return store_->TrackHttpCookieWriteForCheckpoint(
+        base::BindOnce([](CookieAccessResult result) {}));
+  }
+
+  void CompleteBackend(size_t index, bool success) {
+    ASSERT_LT(index, store_->backend.size());
+    ASSERT_TRUE(store_->backend[index]);
+    std::move(store_->backend[index]).Run(success);
+  }
+
+  NetTaskEnvironment tasks_{base::test::TaskEnvironment::MainThreadType::IO,
+                            base::test::TaskEnvironment::TimeSource::MOCK_TIME};
+  std::unique_ptr<HttpCheckpointCookieStore> store_;
+};
+
+TEST_F(GlintHttpCookieCheckpointTest, EmptyCheckpointUsesRealBackendResult) {
+  base::test::TestFuture<bool> result;
+  store_->FlushHttpCookieWritesForCheckpoint(result.GetCallback());
+  EXPECT_FALSE(result.IsReady());
+  EXPECT_TRUE(store_->backend.empty());
+  tasks_.RunUntilIdle();
+  ASSERT_EQ(store_->backend.size(), 1u);
+  CompleteBackend(0, true);
+  EXPECT_FALSE(result.IsReady());
+  tasks_.RunUntilIdle();
+  EXPECT_TRUE(result.Get());
+}
+
+TEST_F(GlintHttpCookieCheckpointTest, BackendFailureIsNotSuccess) {
+  base::test::TestFuture<bool> result;
+  store_->FlushHttpCookieWritesForCheckpoint(result.GetCallback());
+  tasks_.RunUntilIdle();
+  CompleteBackend(0, false);
+  EXPECT_FALSE(result.Get());
+}
+
+TEST_F(GlintHttpCookieCheckpointTest, PendingHttpWritePrecedesBackendCommit) {
+  auto write = Track();
+  base::test::TestFuture<bool> result;
+  store_->FlushHttpCookieWritesForCheckpoint(result.GetCallback());
+  tasks_.RunUntilIdle();
+  EXPECT_TRUE(store_->backend.empty());
+  EXPECT_FALSE(result.IsReady());
+  std::move(write).Run(CookieAccessResult());
+  EXPECT_TRUE(store_->backend.empty());
+  tasks_.RunUntilIdle();
+  ASSERT_EQ(store_->backend.size(), 1u);
+  CompleteBackend(0, true);
+  EXPECT_TRUE(result.Get());
+}
