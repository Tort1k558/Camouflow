+class GlintHttpCookieNetworkTest : public TestWithTaskEnvironment {
+ protected:
+  void SetUp() override {
+    auto store = std::make_unique<HeldHttpCookieStore>();
+    store_ = store.get();
+    auto builder = CreateTestURLRequestContextBuilder();
+    builder->DisableHttpCache();
+    builder->SetCookieStore(std::move(store));
+    context_ = builder->Build();
+    server_.RegisterRequestHandler(
+        base::BindRepeating(&HttpCheckpointResponse));
+    ASSERT_TRUE(server_.Start());
+  }
+
+  std::unique_ptr<URLRequest> Request(const char* path,
+                                      TestDelegate* delegate) {
+    const GURL url = server_.GetURL(path);
+    auto request = context_->CreateRequest(url, DEFAULT_PRIORITY, delegate,
+                                           TRAFFIC_ANNOTATION_FOR_TESTS,
+                                           net::handles::kInvalidNetworkHandle);
+    request->set_site_for_cookies(SiteForCookies::FromUrl(url));
+    request->SetLoadFlags(LOAD_DISABLE_CACHE);
+    return request;
+  }
+
+  bool WaitForWrites(size_t count) {
+    if (store_->writes.size() < count) {
+      base::RunLoop loop;
+      store_->on_write = base::BindRepeating(
+          [](HeldHttpCookieStore* store, size_t count,
+             base::RepeatingClosure quit) {
+            if (store->writes.size() >= count) {
+              quit.Run();
+            }
+          },
+          base::Unretained(store_.get()), count, loop.QuitClosure());
+      loop.Run();
+      store_->on_write.Reset();
+    }
+    return store_->writes.size() >= count;
+  }
+
+  std::map<std::string, std::string> CookieValues() {
+    GetAllCookiesCallback result;
+    store_->GetAllCookiesAsync(result.MakeCallback());
+    result.WaitUntilDone();
+    std::map<std::string, std::string> values;
+    for (const auto& cookie : result.cookies()) {
+      values.emplace(cookie.Name(), cookie.Value());
+    }
+    return values;
+  }
+
+  void CompleteBackend(size_t index, bool success) {
+    ASSERT_LT(index, store_->backend.size());
+    ASSERT_TRUE(store_->backend[index]);
+    std::move(store_->backend[index]).Run(success);
+  }
+
+  base::test::ScopedRunLoopTimeout timeout_{FROM_HERE, base::Seconds(10)};
+  EmbeddedTestServer server_{EmbeddedTestServer::TYPE_HTTP};
+  std::unique_ptr<URLRequestContext> context_;
+  raw_ptr<HeldHttpCookieStore> store_ = nullptr;
+};
