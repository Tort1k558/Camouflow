+  }
+  tasks_.RunUntilIdle();
+  ASSERT_EQ(store_->backend.size(), 64u);
+  tasks_.FastForwardBy(base::Seconds(30));
+  for (auto& result : results) {
+    EXPECT_FALSE(result->Get());
+  }
+  base::test::TestFuture<bool> over_capacity;
+  store_->FlushHttpCookieWritesForCheckpoint(over_capacity.GetCallback());
+  EXPECT_FALSE(over_capacity.Get());
+  EXPECT_EQ(store_->backend.size(), 64u);
+  CompleteBackend(0, true);
+  base::test::TestFuture<bool> admitted;
+  store_->FlushHttpCookieWritesForCheckpoint(admitted.GetCallback());
+  tasks_.RunUntilIdle();
+  ASSERT_EQ(store_->backend.size(), 65u);
+  CompleteBackend(64, true);
+  EXPECT_TRUE(admitted.Get());
+}
+
+TEST_F(GlintHttpCookieCheckpointTest,
+       PendingWriteLimitNeverDropsCallerCallback) {
+  std::vector<CookieStore::SetCookiesCallback> writes;
+  for (size_t i = 0; i < 4096; ++i) {
+    writes.push_back(Track());
+  }
+  base::test::TestFuture<CookieAccessResult> original;
+  auto overflow =
+      store_->TrackHttpCookieWriteForCheckpoint(original.GetCallback());
+  std::move(overflow).Run(CookieAccessResult());
+  EXPECT_TRUE(original.IsReady());
+  base::test::TestFuture<bool> result;
+  store_->FlushHttpCookieWritesForCheckpoint(result.GetCallback());
+  EXPECT_FALSE(result.Get());
+  EXPECT_TRUE(store_->backend.empty());
+  writes.clear();
+}
+
+TEST_F(GlintHttpCookieCheckpointTest,
+       CookiePolicyRejectionIsForwardedUnchanged) {
+  base::test::TestFuture<CookieAccessResult> original;
+  auto write =
+      store_->TrackHttpCookieWriteForCheckpoint(original.GetCallback());
+  CookieInclusionStatus rejected;
+  rejected.AddExclusionReason(
+      CookieInclusionStatus::ExclusionReason::EXCLUDE_USER_PREFERENCES);
+  std::move(write).Run(CookieAccessResult(rejected));
+  EXPECT_EQ(original.Get().status, rejected);
+  base::test::TestFuture<bool> result;
+  store_->FlushHttpCookieWritesForCheckpoint(result.GetCallback());
+  tasks_.RunUntilIdle();
+  CompleteBackend(0, true);
+  EXPECT_TRUE(result.Get());
+}
+
+TEST_F(GlintHttpCookieCheckpointTest, SeparateStoresDoNotShareHttpWrites) {
+  auto write = Track();
+  auto other = std::make_unique<HttpCheckpointCookieStore>();
+  base::test::TestFuture<bool> result;
+  other->FlushHttpCookieWritesForCheckpoint(result.GetCallback());
+  tasks_.RunUntilIdle();
+  ASSERT_EQ(other->backend.size(), 1u);
+  std::move(other->backend[0]).Run(true);
+  EXPECT_TRUE(result.Get());
+  EXPECT_TRUE(store_->backend.empty());
+  std::move(write).Run(CookieAccessResult());
+}
+
+TEST_F(GlintHttpCookieCheckpointTest,
+       MemoryOnlyBackendStillRejectsPersistence) {
+  auto memory_only = std::make_unique<CookieMonster>(nullptr, nullptr);
+  base::test::TestFuture<bool> result;
+  memory_only->FlushHttpCookieWritesForCheckpoint(result.GetCallback());
+  EXPECT_FALSE(result.Get());
+}
+
+TEST_F(GlintHttpCookieCheckpointTest, CallbackCanSafelyDestroyStore) {
+  bool called = false;
+  store_->FlushHttpCookieWritesForCheckpoint(base::BindOnce(
+      [](std::unique_ptr<HttpCheckpointCookieStore>* store, bool* called,
+         bool success) {
+        EXPECT_TRUE(success);
+        store->reset();
+        *called = true;
+      },
+      &store_, &called));
+  tasks_.RunUntilIdle();
+  CompleteBackend(0, true);
+  tasks_.RunUntilIdle();
+  EXPECT_TRUE(called);
+  EXPECT_FALSE(store_);
+}
