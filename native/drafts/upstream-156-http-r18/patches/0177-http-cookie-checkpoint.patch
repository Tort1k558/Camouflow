+class CookieStore::HttpCookieCheckpointState
+    : public base::RefCounted<HttpCookieCheckpointState> {
+ public:
+  explicit HttpCookieCheckpointState(CookieStore* owner) : owner_(owner) {
+    CHECK(owner_);
+  }
+
+  SetCookiesCallback Track(SetCookiesCallback callback) {
+    DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+    CHECK(callback);
+    if (broken_ || !owner_) {
+      return callback;
+    }
+    if (pending_.size() >= 4096 ||
+        epoch_ == std::numeric_limits<uint64_t>::max()) {
+      BreakTracking();
+      return callback;
+    }
+    const uint64_t serial = ++epoch_;
+    pending_.insert(serial);
+    RejectRequests();
+    return base::BindOnce(
+        [](std::unique_ptr<WriteLease> lease, SetCookiesCallback callback,
+           CookieAccessResult result) {
+          lease->Complete();
+          std::move(callback).Run(std::move(result));
+        },
+        std::make_unique<WriteLease>(base::WrapRefCounted(this), serial),
+        std::move(callback));
+  }
+
+  void Flush(base::OnceCallback<void(bool)> callback) {
+    DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+    CHECK(callback);
+    if (!owner_ || broken_ || requests_.size() >= 64 ||
+        next_request_ == std::numeric_limits<uint64_t>::max()) {
+      PostResult(std::move(callback), epoch_, false);
+      return;
+    }
+    const uint64_t id = ++next_request_;
+    auto request = std::make_unique<Request>(epoch_, std::move(callback));
+    request->timer.Start(FROM_HERE, base::Seconds(30),
+                         base::BindOnce(&HttpCookieCheckpointState::FailRequest,
+                                        weak_factory_.GetWeakPtr(), id));
+    requests_.emplace(id, std::move(request));
+    if (pending_.empty()) {
+      QueueBackend(id);
+    }
+  }
+
+  void Close() {
+    DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+    owner_ = nullptr;
+    broken_ = true;
+    pending_.clear();
+    RejectRequests();
+    requests_.clear();
+  }
+
+ private:
+  friend class base::RefCounted<HttpCookieCheckpointState>;
+
+  struct Request {
+    Request(uint64_t epoch, base::OnceCallback<void(bool)> callback)
+        : epoch(epoch), callback(std::move(callback)) {}
+    const uint64_t epoch;
+    base::OnceCallback<void(bool)> callback;
+    base::OneShotTimer timer;
+    bool backend_started = false;
+    bool backend_queued = false;
+  };
+
+  class WriteLease {
+   public:
+    WriteLease(scoped_refptr<HttpCookieCheckpointState> state, uint64_t serial)
+        : state_(std::move(state)), serial_(serial) {}
+    ~WriteLease() {
+      if (state_) {
+        state_->AbandonWrite(serial_);
+      }
+    }
+    void Complete() {
+      auto state = std::move(state_);
+      state->CompleteWrite(serial_);
+    }
+
+   private:
+    scoped_refptr<HttpCookieCheckpointState> state_;
+    const uint64_t serial_;
+  };
+
+  class BackendLease {
+   public:
+    BackendLease(scoped_refptr<HttpCookieCheckpointState> state, uint64_t id)
+        : state_(std::move(state)), id_(id) {}
+    ~BackendLease() {
+      if (state_) {
+        state_->BackendResult(id_, false);
+      }
+    }
+    void Complete(bool success) {
+      auto state = std::move(state_);
+      state->BackendResult(id_, success);
+    }
+
+   private:
+    scoped_refptr<HttpCookieCheckpointState> state_;
+    const uint64_t id_;
+  };
+
+  ~HttpCookieCheckpointState() {
+    DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+    DCHECK(!owner_);
+    DCHECK(requests_.empty());
+  }
+
+  void PostResult(base::OnceCallback<void(bool)> callback,
+                  uint64_t epoch,
+                  bool success) {
+    base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE,
+        base::BindOnce(
+            [](scoped_refptr<HttpCookieCheckpointState> state, uint64_t epoch,
+               base::OnceCallback<void(bool)> callback, bool success) {
+              DCHECK_CALLED_ON_VALID_SEQUENCE(state->sequence_checker_);
+              std::move(callback).Run(
+                  success && state->owner_ && !state->broken_ &&
+                  state->epoch_ == epoch && state->pending_.empty());
+            },
+            base::WrapRefCounted(this), epoch, std::move(callback), success));
+  }
+
+  void FailRequest(uint64_t id) {
+    DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+    auto found = requests_.find(id);
+    if (found == requests_.end()) {
+      return;
+    }
+    auto& request = *found->second;
+    request.timer.Stop();
+    if (request.callback) {
+      PostResult(std::move(request.callback), request.epoch, false);
+    }
+    // A caller timeout cannot cancel the actual backend operation. Retain its
+    // slot until the completion arrives or is abandoned, avoiding queue growth.
+    if (!request.backend_started) {
+      requests_.erase(found);
+    }
+  }
+
+  void RejectRequests() {
+    for (auto iterator = requests_.begin(); iterator != requests_.end();) {
+      auto& request = *iterator->second;
+      request.timer.Stop();
+      if (request.callback) {
+        PostResult(std::move(request.callback), request.epoch, false);
+      }
+      if (request.backend_started) {
+        ++iterator;
+      } else {
+        iterator = requests_.erase(iterator);
+      }
+    }
+  }
+
+  void BreakTracking() {
+    broken_ = true;
+    pending_.clear();
+    RejectRequests();
+  }
+
+  void AbandonWrite(uint64_t serial) {
+    DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+    if (owner_ && !broken_) {
+      CHECK(pending_.contains(serial));
+      BreakTracking();
+    }
+  }
+
+  void CompleteWrite(uint64_t serial) {
+    DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+    if (!owner_ || broken_) {
+      return;
+    }
+    if (pending_.erase(serial) != 1) {
+      BreakTracking();
+      return;
+    }
+    if (pending_.empty()) {
+      for (const auto& [id, request] : requests_) {
+        QueueBackend(id);
+      }
+    }
+  }
+
+  void QueueBackend(uint64_t id) {
+    auto& request = *requests_.at(id);
+    if (request.backend_started || request.backend_queued ||
+        !request.callback) {
+      return;
+    }
+    request.backend_queued = true;
+    base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE, base::BindOnce(&HttpCookieCheckpointState::StartBackend,
+                                  weak_factory_.GetWeakPtr(), id));
+  }
+
+  void StartBackend(uint64_t id) {
+    DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+    auto found = requests_.find(id);
+    if (found == requests_.end()) {
+      return;
+    }
+    auto& request = *found->second;
+    if (!owner_ || broken_ || request.epoch != epoch_ || !pending_.empty()) {
+      FailRequest(id);
+      return;
+    }
+    request.backend_started = true;
+    owner_->FlushStoreForCheckpoint(base::BindOnce(
+        [](std::unique_ptr<BackendLease> lease, bool success) {
+          lease->Complete(success);
+        },
+        std::make_unique<BackendLease>(base::WrapRefCounted(this), id)));
+  }
+
+  void BackendResult(uint64_t id, bool success) {
+    DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+    auto found = requests_.find(id);
+    if (found == requests_.end()) {
+      return;
+    }
+    auto request = std::move(found->second);
+    requests_.erase(found);
+    if (request->callback) {
+      PostResult(std::move(request->callback), request->epoch, success);
+    }
+  }
+
+  raw_ptr<CookieStore> owner_;
+  uint64_t epoch_ = 0;
+  uint64_t next_request_ = 0;
+  bool broken_ = false;
+  std::set<uint64_t> pending_;
+  std::map<uint64_t, std::unique_ptr<Request>> requests_;
+  SEQUENCE_CHECKER(sequence_checker_);
+  base::WeakPtrFactory<HttpCookieCheckpointState> weak_factory_{this};
+};
+
 CookieStore::CookieStore() = default;
 
-CookieStore::~CookieStore() = default;
+CookieStore::~CookieStore() {
+  if (http_cookie_checkpoint_state_) {
+    http_cookie_checkpoint_state_->Close();
+  }
+}
+
+CookieStore::SetCookiesCallback CookieStore::TrackHttpCookieWriteForCheckpoint(
+    SetCookiesCallback callback) {
+  if (!http_cookie_checkpoint_state_) {
+    http_cookie_checkpoint_state_ =
+        base::MakeRefCounted<HttpCookieCheckpointState>(this);
+  }
+  return http_cookie_checkpoint_state_->Track(std::move(callback));
+}
+
+void CookieStore::FlushHttpCookieWritesForCheckpoint(
+    base::OnceCallback<void(bool)> callback) {
+  if (!http_cookie_checkpoint_state_) {
+    http_cookie_checkpoint_state_ =
+        base::MakeRefCounted<HttpCookieCheckpointState>(this);
+  }
+  http_cookie_checkpoint_state_->Flush(std::move(callback));
+}
 
