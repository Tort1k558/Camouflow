+TEST_F(NativePrivacyBrowserContextTest,
+       LaunchWithoutModePreservesCompatibilityDefault) {
+  base::CommandLine command(base::CommandLine::NO_PROGRAM);
+  EXPECT_EQ(ResolveNativeFingerprintDerivationModeForLaunch(command),
+            NativeFingerprintDerivationMode::kPartitionedPrivacy);
+}
+
+TEST_F(NativePrivacyBrowserContextTest,
+       ExplicitLaunchModeRequiresEnabledKeyService) {
+  base::CommandLine command(base::CommandLine::NO_PROGRAM);
+  command.AppendSwitchASCII(kNativeFingerprintDerivationModeSwitch,
+                            "partitioned-privacy");
+  EXPECT_FALSE(ResolveNativeFingerprintDerivationModeForLaunch(command));
+  command.AppendSwitchASCII(kNativePrivacyKeyServiceSwitch, "0");
+  EXPECT_FALSE(ResolveNativeFingerprintDerivationModeForLaunch(command));
+  command.AppendSwitchASCII(kNativePrivacyKeyServiceSwitch, "1");
+  EXPECT_EQ(ResolveNativeFingerprintDerivationModeForLaunch(command),
+            NativeFingerprintDerivationMode::kPartitionedPrivacy);
+  for (const auto* invalid :
+       {"", "unknown", "PROFILE-IDENTITY", "profile-identity "}) {
+    command.AppendSwitchASCII(kNativeFingerprintDerivationModeSwitch, invalid);
+    EXPECT_FALSE(ResolveNativeFingerprintDerivationModeForLaunch(command));
+  }
+}
+
+TEST_F(NativePrivacyBrowserContextTest,
+       IdentityLaunchRequiresBothFullSurfacePolicies) {
+  base::CommandLine command(base::CommandLine::NO_PROGRAM);
+  command.AppendSwitchASCII(kNativePrivacyKeyServiceSwitch, "1");
+  command.AppendSwitchASCII(kNativeFingerprintDerivationModeSwitch,
+                            "profile-identity");
+  EXPECT_FALSE(ResolveNativeFingerprintDerivationModeForLaunch(command));
+  command.AppendSwitch("glint-document-surface-bootstrap-test");
+  EXPECT_FALSE(ResolveNativeFingerprintDerivationModeForLaunch(command));
+  command.RemoveSwitch("glint-document-surface-bootstrap-test");
+  command.AppendSwitch("glint-worker-surface-bootstrap-test");
+  EXPECT_FALSE(ResolveNativeFingerprintDerivationModeForLaunch(command));
+  command.AppendSwitch("glint-document-surface-bootstrap-test");
+  EXPECT_EQ(ResolveNativeFingerprintDerivationModeForLaunch(command),
+            NativeFingerprintDerivationMode::kProfileIdentity);
+}
+
+TEST_F(NativePrivacyBrowserContextTest,
+       IdentityLaunchRejectsEitherLegacyCanvasConflict) {
+  base::CommandLine command(base::CommandLine::NO_PROGRAM);
+  command.AppendSwitchASCII(kNativePrivacyKeyServiceSwitch, "1");
+  command.AppendSwitchASCII(kNativeFingerprintDerivationModeSwitch,
+                            "profile-identity");
+  command.AppendSwitch("glint-document-surface-bootstrap-test");
+  command.AppendSwitch("glint-worker-surface-bootstrap-test");
+  for (const auto* legacy : {"glint-document-canvas-bootstrap-test",
+                             "glint-worker-canvas-bootstrap-test"}) {
+    command.AppendSwitch(legacy);
+    EXPECT_FALSE(ResolveNativeFingerprintDerivationModeForLaunch(command));
+    command.RemoveSwitch(legacy);
+    EXPECT_EQ(ResolveNativeFingerprintDerivationModeForLaunch(command),
+              NativeFingerprintDerivationMode::kProfileIdentity);
+  }
+}
