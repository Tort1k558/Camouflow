+class GlintSessionCookiePolicyBrowserTest
+    : public ProfileNetworkContextServiceBrowsertest {
+ protected:
+  void SetPreserve(bool enabled) {
+    browser()->GetProfile()->GetPrefs()->SetBoolean(
+        ProfileNetworkContextService::kGlintRestoreSessionCookiesPref, enabled);
+  }
+
+  network::mojom::NetworkContextParamsPtr Configure(
+      Profile* profile,
+      bool in_memory = false,
+      const base::FilePath& partition = base::FilePath()) {
+    auto params = network::mojom::NetworkContextParams::New();
+    cert_verifier::mojom::CertVerifierCreationParams cert_params;
+    ProfileNetworkContextServiceFactory::GetForContext(profile)
+        ->ConfigureNetworkContextParams(in_memory, partition, params.get(),
+                                        &cert_params);
+    return params;
+  }
+};
+
+IN_PROC_BROWSER_TEST_F(GlintSessionCookiePolicyBrowserTest, DefaultIsOptOut) {
+  EXPECT_FALSE(browser()->GetProfile()->GetPrefs()->GetBoolean(
+      ProfileNetworkContextService::kGlintRestoreSessionCookiesPref));
+}
+
+IN_PROC_BROWSER_TEST_F(GlintSessionCookiePolicyBrowserTest,
+                       DefaultPartitionKeepsChromiumPolicy) {
+  SetPreserve(false);
+  Profile* profile = browser()->GetProfile();
+  auto params = Configure(profile);
+  EXPECT_EQ(params->restore_old_session_cookies,
+            profile->ShouldRestoreOldSessionCookies());
+  EXPECT_EQ(params->persist_session_cookies,
+            profile->ShouldPersistSessionCookies());
+}
+
+IN_PROC_BROWSER_TEST_F(GlintSessionCookiePolicyBrowserTest,
+                       OptInDefaultPartitionPreservesAndRestores) {
+  SetPreserve(true);
+  auto params = Configure(browser()->GetProfile());
+  EXPECT_TRUE(params->restore_old_session_cookies);
+  EXPECT_TRUE(params->persist_session_cookies);
+}
+
+IN_PROC_BROWSER_TEST_F(GlintSessionCookiePolicyBrowserTest,
+                       OptInAdditionalDiskPartitionPreservesAndRestores) {
+  SetPreserve(true);
+  auto params =
+      Configure(browser()->GetProfile(), false,
+                base::FilePath(FILE_PATH_LITERAL("glint-test-partition")));
+  EXPECT_TRUE(params->restore_old_session_cookies);
+  EXPECT_TRUE(params->persist_session_cookies);
+}
+
+IN_PROC_BROWSER_TEST_F(GlintSessionCookiePolicyBrowserTest,
+                       OptOutAdditionalPartitionKeepsChromiumPolicy) {
+  SetPreserve(false);
+  auto params =
+      Configure(browser()->GetProfile(), false,
+                base::FilePath(FILE_PATH_LITERAL("glint-test-partition")));
+  EXPECT_FALSE(params->restore_old_session_cookies);
+  EXPECT_FALSE(params->persist_session_cookies);
+}
+
+IN_PROC_BROWSER_TEST_F(GlintSessionCookiePolicyBrowserTest,
+                       OptInMemoryPartitionNeverPersists) {
+  SetPreserve(true);
+  auto params =
+      Configure(browser()->GetProfile(), true,
+                base::FilePath(FILE_PATH_LITERAL("glint-memory-partition")));
+  EXPECT_FALSE(params->restore_old_session_cookies);
+  EXPECT_FALSE(params->persist_session_cookies);
+  EXPECT_FALSE(params->file_paths);
+}
+
+IN_PROC_BROWSER_TEST_F(GlintSessionCookiePolicyBrowserTest,
+                       OptInOffTheRecordNeverPersists) {
+  SetPreserve(true);
+  Profile* otr = browser()->GetProfile()->GetPrimaryOTRProfile(true);
+  otr->GetPrefs()->SetBoolean(
+      ProfileNetworkContextService::kGlintRestoreSessionCookiesPref, true);
+  // Even a caller incorrectly requesting disk storage cannot persist OTR data.
+  auto params = Configure(otr, false);
+  EXPECT_FALSE(params->restore_old_session_cookies);
+  EXPECT_FALSE(params->persist_session_cookies);
+  EXPECT_FALSE(params->file_paths);
+}
+
+IN_PROC_BROWSER_TEST_F(GlintSessionCookiePolicyBrowserTest,
+                       DisablingReturnsFutureContextsToChromiumPolicy) {
+  Profile* profile = browser()->GetProfile();
+  SetPreserve(true);
+  auto enabled = Configure(profile);
+  ASSERT_TRUE(enabled->restore_old_session_cookies);
+  SetPreserve(false);
+  auto disabled = Configure(profile);
+  EXPECT_EQ(disabled->restore_old_session_cookies,
+            profile->ShouldRestoreOldSessionCookies());
+  EXPECT_EQ(disabled->persist_session_cookies,
+            profile->ShouldPersistSessionCookies());
+}
