+using CookieRows = std::map<std::string, std::pair<std::string, bool>>;
+
+std::unique_ptr<test_server::HttpResponse> SqlCheckpointResponse(
+    const test_server::HttpRequest& request) {
+  auto response = std::make_unique<test_server::BasicHttpResponse>();
+  response->set_code(HTTP_OK);
+  response->set_content_type("text/plain");
+  response->set_content("owned");
+  if (request.relative_url == "/one") {
+    response->AddCustomHeader("Set-Cookie", "first=1; Path=/; Max-Age=3600");
+  } else if (request.relative_url == "/redirect") {
+    response->set_code(HTTP_FOUND);
+    response->AddCustomHeader("Location", "/one");
+    response->AddCustomHeader("Set-Cookie",
+                              "redirect=before; Path=/; Max-Age=3600");
+  } else if (request.relative_url == "/http-only") {
+    response->AddCustomHeader("Set-Cookie",
+                              "hidden=1; Path=/; Max-Age=3600; HttpOnly");
+  } else if (request.relative_url == "/delete") {
+    response->AddCustomHeader("Set-Cookie", "first=; Path=/; Max-Age=0");
+  } else if (request.relative_url == "/echo") {
+    const auto found = request.headers.find("Cookie");
+    response->set_content(found == request.headers.end() ? "" : found->second);
+  } else {
+    return nullptr;
+  }
+  return response;
+}
+
+class GlintHttpCookieSqlCheckpointTest : public TestWithTaskEnvironment {
+ protected:
+  void SetUp() override {
+    ASSERT_TRUE(temp_dir_.CreateUniqueTempDir());
+    cookie_path_ = temp_dir_.GetPath().AppendASCII("Cookies");
+    server_.RegisterRequestHandler(base::BindRepeating(&SqlCheckpointResponse));
+    ASSERT_TRUE(server_.Start());
+    context_ = CreateContext(cookie_path_);
+  }
+
+  void TearDown() override {
+    context_.reset();
+    RunUntilIdle();
+  }
+
+  std::unique_ptr<URLRequestContext> CreateContext(const base::FilePath& path) {
+    auto persistent = base::MakeRefCounted<SQLitePersistentCookieStore>(
+        path, base::SequencedTaskRunner::GetCurrentDefault(), background_,
+        false, nullptr, false);
+    auto builder = CreateTestURLRequestContextBuilder();
+    builder->DisableHttpCache();
+    builder->SetCookieStore(
+        std::make_unique<CookieMonster>(persistent.get(), nullptr));
+    return builder->Build();
+  }
+
+  void Fetch(URLRequestContext& context, const char* path, std::string& body) {
+    TestDelegate delegate;
+    base::test::TestFuture<void> completed;
+    delegate.set_on_complete(completed.GetCallback());
+    const GURL url = server_.GetURL(path);
+    auto request = context.CreateRequest(url, DEFAULT_PRIORITY, &delegate,
+                                         TRAFFIC_ANNOTATION_FOR_TESTS,
+                                         handles::kInvalidNetworkHandle);
+    request->set_site_for_cookies(SiteForCookies::FromUrl(url));
+    request->SetLoadFlags(LOAD_DISABLE_CACHE);
+    request->Start();
+    ASSERT_TRUE(completed.Wait());
+    ASSERT_EQ(delegate.request_status(), OK);
+    body = delegate.data_received();
+  }
+
+  void Checkpoint(URLRequestContext& context, bool expected) {
+    base::test::TestFuture<bool> result;
+    context.cookie_store()->FlushHttpCookieWritesForCheckpoint(
+        result.GetCallback());
+    EXPECT_FALSE(result.IsReady());
+    ASSERT_EQ(result.Get(), expected);
+  }
+
+  void ExpectRows(const base::FilePath& path, const CookieRows& expected) {
+    sql::Database database(sql::test::kTestTag);
+    ASSERT_TRUE(database.Open(path));
+    sql::Statement query(database.GetUniqueStatement(
+        "SELECT name,value,is_httponly FROM cookies ORDER BY name"));
+    ASSERT_TRUE(query.is_valid());
+    CookieRows rows;
+    while (query.Step()) {
+      ASSERT_TRUE(rows.emplace(query.ColumnString(0),
+                               std::make_pair(query.ColumnString(1),
+                                              query.ColumnInt(2) != 0))
+                      .second);
+    }
+    ASSERT_TRUE(query.Succeeded());
+    EXPECT_EQ(rows, expected);
+  }
+
+  void Reopen() {
+    context_.reset();
+    RunUntilIdle();
+    context_ = CreateContext(cookie_path_);
+  }
+
+  base::test::ScopedRunLoopTimeout timeout_{FROM_HERE, base::Seconds(15)};
+  base::ScopedTempDir temp_dir_;
+  base::FilePath cookie_path_;
+  const scoped_refptr<base::SequencedTaskRunner> background_ =
+      base::ThreadPool::CreateSequencedTaskRunner({base::MayBlock()});
+  EmbeddedTestServer server_{EmbeddedTestServer::TYPE_HTTP};
+  std::unique_ptr<URLRequestContext> context_;
+};
+
+TEST_F(GlintHttpCookieSqlCheckpointTest,
+       ActualDatabaseContainsHttpCookieBeforeAcknowledgement) {
+  std::string body;
+  ASSERT_NO_FATAL_FAILURE(Fetch(*context_, "/one", body));
+  ASSERT_NO_FATAL_FAILURE(Checkpoint(*context_, true));
+  ASSERT_NO_FATAL_FAILURE(
+      ExpectRows(cookie_path_, CookieRows{{"first", {"1", false}}}));
+  Reopen();
+  ASSERT_NO_FATAL_FAILURE(Fetch(*context_, "/echo", body));
+  EXPECT_EQ(body, "first=1");
+}
+
+TEST_F(GlintHttpCookieSqlCheckpointTest,
+       RedirectAndFinalResponsePersistInActualDatabase) {
+  std::string body;
+  ASSERT_NO_FATAL_FAILURE(Fetch(*context_, "/redirect", body));
+  ASSERT_NO_FATAL_FAILURE(Checkpoint(*context_, true));
+  ASSERT_NO_FATAL_FAILURE(ExpectRows(
+      cookie_path_, CookieRows{{"first", {"1", false}},
+                               {"redirect", {"before", false}}}));
+  Reopen();
+  ASSERT_NO_FATAL_FAILURE(Fetch(*context_, "/echo", body));
+  EXPECT_NE(body.find("first=1"), std::string::npos);
+  EXPECT_NE(body.find("redirect=before"), std::string::npos);
+}
+
+TEST_F(GlintHttpCookieSqlCheckpointTest,
+       HttpOnlyFlagSurvivesCommitAndContextReopen) {
+  std::string body;
+  ASSERT_NO_FATAL_FAILURE(Fetch(*context_, "/http-only", body));
+  ASSERT_NO_FATAL_FAILURE(Checkpoint(*context_, true));
+  ASSERT_NO_FATAL_FAILURE(
+      ExpectRows(cookie_path_, CookieRows{{"hidden", {"1", true}}}));
+  Reopen();
+  ASSERT_NO_FATAL_FAILURE(Fetch(*context_, "/echo", body));
+  EXPECT_EQ(body, "hidden=1");
+}
+
+TEST_F(GlintHttpCookieSqlCheckpointTest,
+       HttpExpirationDeletesActualDatabaseRowBeforeAcknowledgement) {
+  std::string body;
+  ASSERT_NO_FATAL_FAILURE(Fetch(*context_, "/one", body));
+  ASSERT_NO_FATAL_FAILURE(Checkpoint(*context_, true));
+  ASSERT_NO_FATAL_FAILURE(
+      ExpectRows(cookie_path_, CookieRows{{"first", {"1", false}}}));
+  ASSERT_NO_FATAL_FAILURE(Fetch(*context_, "/delete", body));
+  ASSERT_NO_FATAL_FAILURE(Checkpoint(*context_, true));
+  ASSERT_NO_FATAL_FAILURE(ExpectRows(cookie_path_, CookieRows{}));
+  Reopen();
+  ASSERT_NO_FATAL_FAILURE(Fetch(*context_, "/echo", body));
+  EXPECT_TRUE(body.empty());
+}
+
+TEST_F(GlintHttpCookieSqlCheckpointTest,
+       SeparateDatabasesKeepHttpCookiesIsolated) {
+  const auto other_path = temp_dir_.GetPath().AppendASCII("OtherCookies");
+  auto other = CreateContext(other_path);
+  std::string body;
+  ASSERT_NO_FATAL_FAILURE(Fetch(*context_, "/one", body));
+  ASSERT_NO_FATAL_FAILURE(Fetch(*other, "/http-only", body));
+  ASSERT_NO_FATAL_FAILURE(Checkpoint(*context_, true));
+  ASSERT_NO_FATAL_FAILURE(Checkpoint(*other, true));
+  ASSERT_NO_FATAL_FAILURE(
+      ExpectRows(cookie_path_, CookieRows{{"first", {"1", false}}}));
+  ASSERT_NO_FATAL_FAILURE(
+      ExpectRows(other_path, CookieRows{{"hidden", {"1", true}}}));
+  other.reset();
+  Reopen();
+  other = CreateContext(other_path);
+  ASSERT_NO_FATAL_FAILURE(Fetch(*context_, "/echo", body));
+  EXPECT_EQ(body, "first=1");
+  ASSERT_NO_FATAL_FAILURE(Fetch(*other, "/echo", body));
+  EXPECT_EQ(body, "hidden=1");
+}
+
+TEST_F(GlintHttpCookieSqlCheckpointTest,
+       DatabaseOpenFailureRejectsCheckpointButKeepsHttpResponse) {
+  const auto blocked_path = temp_dir_.GetPath().AppendASCII("BlockedCookies");
+  ASSERT_TRUE(base::CreateDirectory(blocked_path));
+  auto broken = CreateContext(blocked_path);
+  std::string body;
+  ASSERT_NO_FATAL_FAILURE(Fetch(*broken, "/one", body));
+  EXPECT_EQ(body, "owned");
+  ASSERT_NO_FATAL_FAILURE(Fetch(*broken, "/echo", body));
+  EXPECT_EQ(body, "first=1");
+  ASSERT_NO_FATAL_FAILURE(Checkpoint(*broken, false));
+  ASSERT_NO_FATAL_FAILURE(Checkpoint(*broken, false));
+  broken.reset();
+  RunUntilIdle();
+}
