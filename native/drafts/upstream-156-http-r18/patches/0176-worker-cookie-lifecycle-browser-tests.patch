+IN_PROC_BROWSER_TEST_F(GlintCookiePrefixBrowserTest, CancelPendingActiveWorkerPrefix) {
+  ASSERT_EQ(true, content::EvalJs(Contents(), kWriteWorkerCookie));
+  base::test::TestFuture<content::GlintCookiePrefixCommitTestResult> done;
+  auto operation = content::BeginGlintCookiePrefixCommitForTesting(
+      browser()->profile(), base::TimeTicks::Now() + base::Seconds(15),
+      done.GetCallback());
+  operation.RunAndReset();
+  EXPECT_FALSE(done.IsReady());
+  const auto result = done.Get();
+  EXPECT_FALSE(result.committed_prefix);
+  EXPECT_GE(result.running_workers_observed, 1u);
+  EXPECT_TRUE(CommitCookies().committed_prefix);
+}
+
+IN_PROC_BROWSER_TEST_F(GlintCookiePrefixBrowserTest, WorkerStopRejectsPendingPrefix) {
+  ASSERT_EQ(true, content::EvalJs(Contents(), kWriteWorkerCookie));
+  base::test::TestFuture<content::GlintCookiePrefixCommitTestResult> done;
+  auto operation = content::BeginGlintCookiePrefixCommitForTesting(
+      browser()->profile(), base::TimeTicks::Now() + base::Seconds(15),
+      done.GetCallback());
+  base::test::TestFuture<void> stopped;
+  WorkerContext()->StopAllServiceWorkers(stopped.GetCallback());
+  const auto result = done.Get();
+  EXPECT_FALSE(result.committed_prefix);
+  EXPECT_GE(result.running_workers_observed, 1u);
+  ASSERT_TRUE(stopped.Wait());
+  EXPECT_TRUE(WorkerContext()->GetRunningServiceWorkerInfos().empty());
+}
+
+IN_PROC_BROWSER_TEST_F(GlintCookiePrefixBrowserTest, CommitDoesNotStartStoppedWorker) {
+  ASSERT_EQ(true, content::EvalJs(Contents(), kWriteWorkerCookie));
+  base::test::TestFuture<void> stopped;
+  WorkerContext()->StopAllServiceWorkers(stopped.GetCallback());
+  ASSERT_TRUE(stopped.Wait());
+  ASSERT_TRUE(WorkerContext()->GetRunningServiceWorkerInfos().empty());
+  const auto result = CommitCookies();
+  EXPECT_TRUE(result.committed_prefix);
+  EXPECT_EQ(result.running_workers_observed, 0u);
+  EXPECT_TRUE(WorkerContext()->GetRunningServiceWorkerInfos().empty());
+  EXPECT_EQ(true, content::EvalJs(Contents(),
+      "document.cookie.includes('glint_worker=worker_value')"));
+}
+
+IN_PROC_BROWSER_TEST_F(GlintCookiePrefixBrowserTest, ExpiredDeadlineCannotCertifyActiveWorker) {
+  ASSERT_EQ(true, content::EvalJs(Contents(), kWriteWorkerCookie));
+  base::test::TestFuture<content::GlintCookiePrefixCommitTestResult> done;
+  auto operation = content::BeginGlintCookiePrefixCommitForTesting(
+      browser()->profile(), base::TimeTicks::Now() - base::Seconds(1),
+      done.GetCallback());
+  EXPECT_FALSE(done.IsReady());
+  const auto result = done.Get();
+  EXPECT_FALSE(result.committed_prefix);
+  EXPECT_GE(result.running_workers_observed, 1u);
+  EXPECT_TRUE(CommitCookies().committed_prefix);
+}
+
+IN_PROC_BROWSER_TEST_F(GlintCookiePrefixBrowserTest, OversizedDeadlineCannotCertifyActiveWorker) {
+  ASSERT_EQ(true, content::EvalJs(Contents(), kWriteWorkerCookie));
+  base::test::TestFuture<content::GlintCookiePrefixCommitTestResult> done;
+  auto operation = content::BeginGlintCookiePrefixCommitForTesting(
+      browser()->profile(), base::TimeTicks::Now() + base::Seconds(31),
+      done.GetCallback());
+  EXPECT_FALSE(done.IsReady());
+  const auto result = done.Get();
+  EXPECT_FALSE(result.committed_prefix);
+  EXPECT_GE(result.running_workers_observed, 1u);
+  EXPECT_TRUE(CommitCookies().committed_prefix);
+}
