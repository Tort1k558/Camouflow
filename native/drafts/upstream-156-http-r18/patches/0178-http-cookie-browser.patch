+// This pair checks real HTTP-only cookie persistence through the existing
+// prefix coordinator. Future response headers and whole-profile atomicity are
+// deliberately outside this already-completed HTTP-response prefix.
+IN_PROC_BROWSER_TEST_F(GlintCookiePrefixBrowserTest,
+                       PRE_HttpAndWorkerPrefixesSurviveRestart) {
+  ASSERT_EQ(true, content::EvalJs(Contents(), kWriteWindowCookies));
+  ASSERT_EQ(true, content::EvalJs(Contents(), kWriteWorkerCookie));
+  ASSERT_EQ(true, WriteHttpCookie(""));
+  const auto result = CommitCookies();
+  ASSERT_GE(result.running_workers_observed, 1u);
+  ASSERT_TRUE(result.committed_prefix) << "coordinator status=" << result.coordinator_status;
+  EXPECT_EQ(true, content::EvalJs(Contents(), kAllCookiesPresent));
+  EXPECT_EQ(true, CheckHttpCookie(""));
+}
