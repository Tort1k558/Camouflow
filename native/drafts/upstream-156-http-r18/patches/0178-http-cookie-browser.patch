+constexpr char kWriteHttpCookie[] = R"JS(
+(async () => {
+  const nonce = $1;
+  const response = await fetch('/glint-http-set-cookie' +
+    (nonce ? '?nonce=' + nonce : ''), {cache: 'no-store', credentials: 'same-origin'});
+  return response.ok && await response.text() === 'set';
+})()
+)JS";
+
+constexpr char kCheckHttpCookie[] = R"JS(
+(async () => {
+  const nonce = $1;
+  const name = nonce ? 'glint_http_nonce' : 'glint_http';
+  const response = await fetch('/glint-http-echo' +
+    (nonce ? '?nonce=' + nonce : ''), {cache: 'no-store', credentials: 'same-origin'});
+  return response.ok && await response.text() === (nonce || 'http_value') &&
+    !document.cookie.split(';').some(part => part.trim().startsWith(name + '=')) &&
+    await cookieStore.get(name) === null;
+})()
+)JS";
