+std::unique_ptr<net::test_server::HttpResponse> ServeHttpCheckpointCookie(
+    const net::test_server::HttpRequest& request) {
+  auto response = std::make_unique<net::test_server::BasicHttpResponse>();
+  response->set_content_type("text/plain");
+  response->AddCustomHeader("Cache-Control", "no-store");
+  const std::string_view target(request.relative_url);
+  const bool set_cookie = target.starts_with("/glint-http-set-cookie");
+  const std::string_view endpoint =
+      set_cookie ? "/glint-http-set-cookie" : "/glint-http-echo";
+  std::string_view nonce;
+  if (target != endpoint) {
+    const std::string prefix = std::string(endpoint) + "?nonce=";
+    if (!target.starts_with(prefix) ||
+        !IsCheckpointChallenge(target.substr(prefix.size()))) {
+      response->set_code(net::HTTP_BAD_REQUEST);
+      response->set_content("invalid nonce");
+      return response;
+    }
+    nonce = target.substr(prefix.size());
+  }
+  const std::string name = nonce.empty() ? "glint_http" : "glint_http_nonce";
+  response->set_code(net::HTTP_OK);
+  if (set_cookie) {
+    const std::string value = nonce.empty() ? "http_value" : std::string(nonce);
+    response->AddCustomHeader("Set-Cookie", name + "=" + value +
+        "; Path=/; Max-Age=3600; Secure; HttpOnly; SameSite=Lax");
+    response->set_content("set");
+    return response;
+  }
+  std::string value = "missing";
+  size_t matches = 0;
+  auto header = request.headers.find("Cookie");
+  if (header != request.headers.end()) {
+    net::cookie_util::ParsedRequestCookies cookies;
+    net::cookie_util::ParseRequestCookieLine(header->second, &cookies);
+    for (const auto& cookie : cookies) {
+      if (cookie.first == name) {
+        value = cookie.second;
+        ++matches;
+      }
+    }
+  }
+  if (matches > 1) {
+    response->set_code(net::HTTP_BAD_REQUEST);
+    response->set_content("ambiguous cookie");
+  } else {
+    response->set_content(value);
+  }
+  return response;
+}
