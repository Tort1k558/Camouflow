+TEST(GlintGPUCanvasImageSourceTest, UnselectedCopyRetainsIdentityWithoutAllocation) {
+  auto source = MakeGPUCanvasImageSource(false);
+  ASSERT_TRUE(source);
+  auto result = ProtectGPUCanvasImageSource(source, std::nullopt, 0);
+  ASSERT_TRUE(result.has_value());
+  EXPECT_EQ(result.value().get(), source.get());
+  EXPECT_FALSE(result.value()->OriginClean());
+}
+
+TEST(GlintGPUCanvasImageSourceTest, MissingImageIsNotRawFallback) {
+  const std::array<uint8_t, 32> seed{};
+  EXPECT_FALSE(ProtectGPUCanvasImageSource(nullptr, seed).has_value());
+  EXPECT_FALSE(ProtectGPUCanvasImageSource(nullptr, std::nullopt).has_value());
+}
+
+TEST(GlintGPUCanvasImageSourceTest, DetachedCopyBudgetHasExactBoundary) {
+  auto source = MakeGPUCanvasImageSource(true);
+  ASSERT_TRUE(source);
+  const std::array<uint8_t, 32> seed{};
+  const auto rejected = ProtectGPUCanvasImageSource(source, seed, 127);
+  ASSERT_FALSE(rejected.has_value());
+  EXPECT_EQ(rejected.error(), CanvasCopyError::kMemoryLimit);
+  const auto accepted = ProtectGPUCanvasImageSource(source, seed, 128);
+  EXPECT_TRUE(accepted.has_value());
+}
+
+TEST(GlintGPUCanvasImageSourceTest, DetachedImagePreservesBothOriginStates) {
+  const std::array<uint8_t, 32> seed{};
+  for (const bool clean : {false, true}) {
+    auto source = MakeGPUCanvasImageSource(clean);
+    ASSERT_TRUE(source);
+    auto result = ProtectGPUCanvasImageSource(source, seed);
+    ASSERT_TRUE(result.has_value());
+    EXPECT_NE(result.value().get(), source.get());
+    EXPECT_EQ(result.value()->OriginClean(), clean);
+    EXPECT_EQ(source->OriginClean(), clean);
+    EXPECT_EQ(result.value()->Orientation(), source->Orientation());
+  }
+}
+
+TEST(GlintGPUCanvasImageSourceTest, RepeatedSnapshotsDoNotMutateTheSource) {
+  auto source = MakeGPUCanvasImageSource(true);
+  ASSERT_TRUE(source);
+  std::array<uint8_t, 64> before{}, after{}, first{}, second{};
+  ASSERT_TRUE(ReadGPUCanvasImageSource(source, before));
+  const std::array<uint8_t, 32> seed{};
+  auto one = ProtectGPUCanvasImageSource(source, seed);
+  auto two = ProtectGPUCanvasImageSource(source, seed);
+  ASSERT_TRUE(one.has_value());
+  ASSERT_TRUE(two.has_value());
+  ASSERT_TRUE(ReadGPUCanvasImageSource(one.value(), first));
+  ASSERT_TRUE(ReadGPUCanvasImageSource(two.value(), second));
+  ASSERT_TRUE(ReadGPUCanvasImageSource(source, after));
+  EXPECT_EQ(first, second);
+  EXPECT_EQ(before, after);
+  EXPECT_NE(first, before);
+}
+
+TEST(GlintGPUCanvasImageSourceTest, ExplicitSeedsDoNotAliasTheFixture) {
+  auto source = MakeGPUCanvasImageSource(true);
+  ASSERT_TRUE(source);
+  std::array<uint8_t, 32> seed{};
+  auto one = ProtectGPUCanvasImageSource(source, seed);
+  seed[0] = 1;
+  auto two = ProtectGPUCanvasImageSource(source, seed);
+  ASSERT_TRUE(one.has_value());
+  ASSERT_TRUE(two.has_value());
+  std::array<uint8_t, 64> first{}, second{};
+  ASSERT_TRUE(ReadGPUCanvasImageSource(one.value(), first));
+  ASSERT_TRUE(ReadGPUCanvasImageSource(two.value(), second));
+  EXPECT_NE(first, second);
+}
+
+TEST(GlintGPUCanvasImageSourceTest, TranslucentSourceKeepsAlphaAndTaint) {
+  auto source = MakeGPUCanvasImageSource(false, true);
+  ASSERT_TRUE(source);
+  std::array<uint8_t, 64> before{}, after{};
+  ASSERT_TRUE(ReadGPUCanvasImageSource(source, before));
+  const std::array<uint8_t, 32> seed{};
+  auto result = ProtectGPUCanvasImageSource(source, seed);
+  ASSERT_TRUE(result.has_value());
+  ASSERT_TRUE(ReadGPUCanvasImageSource(result.value(), after));
+  for (size_t index = 3; index < before.size(); index += 4) {
+    EXPECT_EQ(before[index], after[index]);
+  }
+  EXPECT_FALSE(result.value()->OriginClean());
+}
