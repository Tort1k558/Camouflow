+// Resolve against the source owner before detaching a GPU image. Canvas v1 and
+// ordinary 2D sources retain their existing drawing behaviour.
+inline SurfaceSeedResult CanvasImageSourcePartitionSeed(
+    blink::ExecutionContext* owner,
+    const blink::CanvasRenderingContext* source_context) {
+  const auto rendering = CanvasRenderingPolicyForCommand(
+      *base::CommandLine::ForCurrentProcess());
+  if (!rendering) {
+    return base::unexpected(SurfaceSeedError::kInvalidPolicy);
+  }
+  if (rendering->pipeline != CanvasPipeline::kRenderingV2 || !source_context ||
+      (!source_context->IsWebGL() && !source_context->IsWebGPU())) {
+    return std::optional<std::array<uint8_t, 32>>{};
+  }
+  return CanvasExportPartitionSeed(
+      owner, CanvasExportSurfaceForContext(source_context));
+}
+
+// Protect a detached source exactly once, before any crop, scale or colour
+// conversion. Never mutate the live drawing buffer or return raw on failure.
+inline base::expected<scoped_refptr<blink::StaticBitmapImage>, CanvasCopyError>
+ProtectGPUCanvasImageSource(
+    scoped_refptr<blink::StaticBitmapImage> source,
+    const std::optional<std::array<uint8_t, 32>>& partition_seed,
+    size_t memory_limit_bytes = kCandidateAdditionalPixelBudget) {
+  if (!source) {
+    return base::unexpected(CanvasCopyError::kInvalidLayout);
+  }
+  if (!partition_seed) {
+    return source;
+  }
+  const bool origin_clean = source->OriginClean();
+  auto result = CreateProtectedCanvasImage(
+      std::move(source), *partition_seed, memory_limit_bytes);
+  if (!result.has_value()) {
+    return base::unexpected(result.error());
+  }
+  result.value()->SetOriginClean(origin_clean);
+  return result;
+}
+
 }  // namespace glint::candidate
