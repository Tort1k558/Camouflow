+scoped_refptr<blink::StaticBitmapImage> MakeGPUCanvasImageSource(
+    bool origin_clean, bool translucent = false) {
+  std::array<uint8_t, 64> pixels{};
+  const auto info = SkImageInfo::Make(4, 4, kRGBA_8888_SkColorType,
+      translucent ? kUnpremul_SkAlphaType : kOpaque_SkAlphaType,
+      SkColorSpace::MakeSRGB());
+  for (size_t y = 0; y < 4; ++y) {
+    for (size_t x = 0; x < 4; ++x) {
+      const size_t start = (y * 4 + x) * 4;
+      pixels[start] = static_cast<uint8_t>(x + 1);
+      pixels[start + 1] = static_cast<uint8_t>(y + 1);
+      pixels[start + 2] = 85;
+      pixels[start + 3] = translucent ? static_cast<uint8_t>(96 + x * 31) : 255;
+    }
+  }
+  auto image = blink::UnacceleratedStaticBitmapImage::Create(
+      SkImages::RasterFromPixmapCopy(SkPixmap(info, pixels.data(), 16)));
+  if (image) {
+    image->SetOriginClean(origin_clean);
+  }
+  return image;
+}
+
+bool ReadGPUCanvasImageSource(
+    const scoped_refptr<blink::StaticBitmapImage>& image,
+    std::array<uint8_t, 64>& pixels) {
+  if (!image) {
+    return false;
+  }
+  const auto info = SkImageInfo::Make(4, 4, kRGBA_8888_SkColorType,
+      kUnpremul_SkAlphaType, SkColorSpace::MakeSRGB());
+  return image->PaintImageForCurrentFrame().readPixels(
+      info, pixels.data(), 16, 0, 0);
+}
