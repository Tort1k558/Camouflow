+TEST_F(SQLitePersistentCookieStoreTest,
+       CheckpointEmptyStoreRepliesAsynchronously) {
+  InitializeStore(false, false);
+  base::test::TestFuture<bool> result;
+  store_->FlushForCheckpoint(result.GetCallback());
+  EXPECT_FALSE(result.IsReady());
+  EXPECT_TRUE(result.Get());
+}
+
+TEST_F(SQLitePersistentCookieStoreTest,
+       CheckpointPersistsReceivedCookieBeforeAck) {
+  InitializeStore(false, false);
+  AddCookie("checkpoint", "value", "example.test", "/", base::Time::Now());
+  base::test::TestFuture<bool> result;
+  store_->FlushForCheckpoint(result.GetCallback());
+  ASSERT_TRUE(result.Get());
+  sql::Database database(sql::test::kTestTag);
+  ASSERT_TRUE(database.Open(temp_dir_.GetPath().Append(kCookieFilename)));
+  sql::Statement query(database.GetUniqueStatement(
+      "SELECT value FROM cookies WHERE name='checkpoint'"));
+  ASSERT_TRUE(query.Step());
+  EXPECT_EQ("value", query.ColumnString(0));
+}
