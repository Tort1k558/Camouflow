+void SQLitePersistentCookieStore::FlushForCheckpoint(
+    base::OnceCallback<void(bool)> callback) {
+  CHECK(callback);
+  backend_->FlushForCheckpoint(
+      base::BindPostTaskToCurrentDefault(base::BindOnce(
+          [](scoped_refptr<base::RefCountedData<std::atomic<bool>>> closed,
+             base::OnceCallback<void(bool)> callback, bool success) {
+            std::move(callback).Run(
+                !closed->data.load(std::memory_order_acquire) && success);
+          },
+          checkpoint_closed_, std::move(callback))));
+}
+
 size_t SQLitePersistentCookieStore::GetQueueLengthForTesting() {
   return backend_->GetQueueLengthForTesting();
 }
 
 SQLitePersistentCookieStore::~SQLitePersistentCookieStore() {
+  checkpoint_closed_->data.store(true, std::memory_order_release);
   net_log_.AddEventWithStringParams(
       NetLogEventType::COOKIE_PERSISTENT_STORE_CLOSED, "type",
       "SQLitePersistentCookieStore");
