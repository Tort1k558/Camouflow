+
+TEST_F(SQLitePersistentCookieStoreTest,
+       CheckpointLegacyWriteErrorRemainsSticky) {
+  sql::test::ScopedErrorExpecter errors;
+  errors.ExpectError(SQLITE_CONSTRAINT);
+  InitializeStore(false, false);
+  {
+    sql::Database database(sql::test::kTestTag);
+    ASSERT_TRUE(database.Open(temp_dir_.GetPath().Append(kCookieFilename)));
+    ASSERT_TRUE(database.Execute(
+        "CREATE TRIGGER reject_checkpoint BEFORE INSERT ON cookies BEGIN "
+        "SELECT RAISE(FAIL,'checkpoint injection'); END"));
+  }
+  AddCookie("lost", "value", "example.test", "/", base::Time::Now());
+  Flush();
+  {
+    sql::Database database(sql::test::kTestTag);
+    ASSERT_TRUE(database.Open(temp_dir_.GetPath().Append(kCookieFilename)));
+    ASSERT_TRUE(database.Execute("DROP TRIGGER reject_checkpoint"));
+  }
+  AddCookie("later", "value", "example.test", "/", base::Time::Now());
+  base::test::TestFuture<bool> result;
+  store_->FlushForCheckpoint(result.GetCallback());
+  EXPECT_FALSE(result.Get());
+  base::test::TestFuture<bool> empty;
+  store_->FlushForCheckpoint(empty.GetCallback());
+  EXPECT_FALSE(empty.Get());
+  EXPECT_TRUE(errors.SawExpectedErrors());
+}
