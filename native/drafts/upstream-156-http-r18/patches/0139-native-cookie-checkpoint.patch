+void SQLitePersistentCookieStore::Backend::FlushForCheckpoint(
+    base::OnceCallback<void(bool)> callback) {
+  auto split = base::SplitOnceCallback(std::move(callback));
+  base::ScopedClosureRunner abandoned(
+      base::BindOnce(std::move(split.second), false));
+  // The guarded closure also covers a task rejected or discarded at shutdown.
+  background_task_runner()->PostTask(
+      FROM_HERE, base::BindOnce(&Backend::FlushForCheckpointInBackground, this,
+                                std::move(split.first), std::move(abandoned)));
+}
+
+void SQLitePersistentCookieStore::Backend::FlushForCheckpointInBackground(
+    base::OnceCallback<void(bool)> callback,
+    base::ScopedClosureRunner abandoned) {
+  DCHECK(background_task_runner()->RunsTasksInCurrentSequence());
+  Commit();
+  abandoned.Release().Reset();
+  std::move(callback).Run(db() && db()->is_open() && !path().empty() &&
+                          !checkpoint_write_failed_);
+}
