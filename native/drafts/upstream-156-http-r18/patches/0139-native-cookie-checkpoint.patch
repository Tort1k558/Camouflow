+TEST_F(SQLitePersistentCookieStoreTest,
+       CheckpointReportsAbandonedBackgroundTask) {
+  base::test::ScopedFeatureList features;
+  features.InitAndDisableFeature(
+      features::kSQLitePersistentCookieStoreEarlyInit);
+  auto background = base::MakeRefCounted<base::TestSimpleTaskRunner>();
+  store_ = base::MakeRefCounted<SQLitePersistentCookieStore>(
+      temp_dir_.GetPath().Append(kCookieFilename), client_task_runner_,
+      background, false, nullptr, false);
+  base::test::TestFuture<bool> result;
+  store_->FlushForCheckpoint(result.GetCallback());
+  EXPECT_FALSE(result.IsReady());
+  background->ClearPendingTasks();
+  EXPECT_FALSE(result.Get());
+  store_ = nullptr;
+  background->RunUntilIdle();
+}
