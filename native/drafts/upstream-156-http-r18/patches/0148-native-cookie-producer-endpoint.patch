+void CookieJar::MarkCheckpointCookieWrite() {
+  if (checkpoint_epoch_ == std::numeric_limits<uint64_t>::max()) {
+    checkpoint_tracking_broken_ = true;
+    return;
+  }
+  checkpoint_last_write_epoch_ = ++checkpoint_epoch_;
+}
+
+void CookieJar::InvalidateCheckpointConnection() {
+  checkpoint_history_lost_ |=
+      checkpoint_last_write_epoch_ > checkpoint_acknowledged_write_epoch_;
+  if (checkpoint_generation_ == std::numeric_limits<uint64_t>::max() ||
+      checkpoint_epoch_ == std::numeric_limits<uint64_t>::max()) {
+    checkpoint_tracking_broken_ = true;
+  } else {
+    ++checkpoint_generation_;
+    ++checkpoint_epoch_;
+  }
+  checkpoint_wire_requests_ = 0;
+}
+
+void CookieJar::DrainWritesForCheckpoint(
+    base::TimeTicks deadline,
+    base::OnceCallback<void(bool)> callback) {
+  CHECK(callback);
+  const auto now = base::TimeTicks::Now();
+  auto reply = std::make_shared<CheckpointReply>(deadline, std::move(callback));
+  auto runner = base::SequencedTaskRunner::GetCurrentDefault();
+  if (deadline <= now || deadline > now + base::Seconds(30) ||
+      checkpoint_tracking_broken_ || checkpoint_history_lost_ || !document_ ||
+      !document_->IsActive() || !document_->GetFrame() ||
+      checkpoint_wire_requests_ >= 64) {
+    runner->PostTask(FROM_HERE,
+                     base::BindOnce(&CheckpointReply::Complete, reply, false));
+    return;
+  }
+  // Independent of Oilpan owner lifetime and of whether Mojo drops its reply.
+  runner->PostDelayedTask(
+      FROM_HERE, base::BindOnce(&CheckpointReply::Complete, reply, false),
+      deadline - now);
+  const auto generation = checkpoint_generation_;
+  const auto epoch = checkpoint_epoch_;
+  if (!backend_.is_bound()) {
+    runner->PostTask(
+        FROM_HERE,
+        BindOnce(&CookieJar::DeliverCheckpointReply, WrapWeakPersistent(this),
+                 reply, generation, epoch, checkpoint_last_write_epoch_ == 0));
+    return;
+  }
+  if (!backend_.is_connected()) {
+    runner->PostTask(FROM_HERE,
+                     base::BindOnce(&CheckpointReply::Complete, reply, false));
+    return;
+  }
+  ++checkpoint_wire_requests_;
+  backend_.QueryVersion(BindOnce(&CookieJar::OnCheckpointVersion,
+                                 WrapWeakPersistent(this), reply, generation,
+                                 epoch));
+}
+
+void CookieJar::OnCheckpointVersion(std::shared_ptr<CheckpointReply> reply,
+                                    uint64_t generation,
+                                    uint64_t epoch,
+                                    uint32_t version) {
+  if (version < 1 || generation != checkpoint_generation_ ||
+      epoch != checkpoint_epoch_ || !reply->callback ||
+      base::TimeTicks::Now() >= reply->deadline || !backend_.is_bound() ||
+      !backend_.is_connected()) {
+    OnCheckpointWireReply(std::move(reply), generation, epoch, false);
+    return;
+  }
+  backend_->DrainCookieWritesForCheckpoint(
+      BindOnce(&CookieJar::OnCheckpointWireReply, WrapWeakPersistent(this),
+               std::move(reply), generation, epoch));
+}
+
+void CookieJar::OnCheckpointWireReply(std::shared_ptr<CheckpointReply> reply,
+                                      uint64_t generation,
+                                      uint64_t epoch,
+                                      bool success) {
+  if (generation == checkpoint_generation_) {
+    if (checkpoint_wire_requests_ > 0) {
+      --checkpoint_wire_requests_;
+    } else {
+      checkpoint_tracking_broken_ = true;
+    }
+  }
+  base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE,
+      BindOnce(&CookieJar::DeliverCheckpointReply, WrapWeakPersistent(this),
+               std::move(reply), generation, epoch, success));
+}
+
+void CookieJar::DeliverCheckpointReply(std::shared_ptr<CheckpointReply> reply,
+                                       uint64_t generation,
+                                       uint64_t epoch,
+                                       bool success) {
+  success = success && generation == checkpoint_generation_ &&
+            epoch == checkpoint_epoch_ && !checkpoint_tracking_broken_ &&
+            !checkpoint_history_lost_ && document_ && document_->IsActive() &&
+            document_->GetFrame() &&
+            (!backend_.is_bound() ? checkpoint_last_write_epoch_ == 0
+                                  : backend_.is_connected()) &&
+            base::TimeTicks::Now() < reply->deadline;
+  if (success && reply->callback) {
+    checkpoint_acknowledged_write_epoch_ = checkpoint_last_write_epoch_;
+  }
+  CheckpointReply::Complete(std::move(reply), success);
+}
+
 void CookieJar::OnBackendDisconnect() {
+  InvalidateCheckpointConnection();
   shared_memory_version_client_.reset();
   InvalidateCache();
 }
