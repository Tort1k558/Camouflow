+bool ServiceWorkerGlobalScope::IsCookieCheckpointCaptureCurrent(
+    uint64_t ticket) const {
+  if (!ticket || ticket != cookie_checkpoint_ticket_ ||
+      !cookie_checkpoint_capture_valid_ || cookie_checkpoint_disposed_ ||
+      IsClosing() || IsContextDestroyed() || !receiver_.is_bound()) {
+    return false;
+  }
+  auto* current = CookieCheckpointParticipant::GetIfExists(*this);
+  if (current != cookie_checkpoint_producer_.Get()) {
+    return false;
+  }
+  if (!cookie_checkpoint_snapshot_) {
+    return !current;
+  }
+  return current && current->IsRegisteredForCheckpoint() &&
+         current->CaptureWritesForCheckpoint() == cookie_checkpoint_snapshot_;
+}
+
+void ServiceWorkerGlobalScope::CaptureCookieProducerForCheckpoint(
+    CaptureCookieProducerForCheckpointCallback callback) {
+  DCHECK(IsContextThread());
+  cookie_checkpoint_capture_valid_ = false;
+  cookie_checkpoint_draining_ = false;
+  cookie_checkpoint_producer_.Clear();
+  cookie_checkpoint_snapshot_.reset();
+  if (cookie_checkpoint_ticket_ == std::numeric_limits<uint64_t>::max()) {
+    std::move(callback).Run(false, 0);
+    return;
+  }
+  ++cookie_checkpoint_ticket_;
+  if (cookie_checkpoint_disposed_ || IsClosing() || IsContextDestroyed() ||
+      !receiver_.is_bound()) {
+    std::move(callback).Run(false, 0);
+    return;
+  }
+  auto* participant = CookieCheckpointParticipant::GetIfExists(*this);
+  if (participant) {
+    auto snapshot = participant->CaptureWritesForCheckpoint();
+    if (!snapshot) {
+      std::move(callback).Run(false, 0);
+      return;
+    }
+    cookie_checkpoint_snapshot_ = *snapshot;
+    cookie_checkpoint_producer_ = participant;
+  }
+  cookie_checkpoint_capture_valid_ = true;
+  std::move(callback).Run(true, cookie_checkpoint_ticket_);
+}
+
+void ServiceWorkerGlobalScope::DrainCookieWritesForCheckpoint(
+    uint64_t ticket,
+    base::TimeTicks deadline,
+    DrainCookieWritesForCheckpointCallback callback) {
+  DCHECK(IsContextThread());
+  CHECK(callback);
+  auto runner = base::SequencedTaskRunner::GetCurrentDefault();
+  const auto now = base::TimeTicks::Now();
+  if (now >= deadline || deadline > now + base::Seconds(30) ||
+      cookie_checkpoint_draining_ || !IsCookieCheckpointCaptureCurrent(ticket)) {
+    runner->PostTask(FROM_HERE, base::BindOnce(std::move(callback), false));
+    return;
+  }
+  cookie_checkpoint_draining_ = true;
+  struct Reply {
+    explicit Reply(DrainCookieWritesForCheckpointCallback completion)
+        : callback(std::move(completion)) {}
+    void Complete(bool success) {
+      if (callback) {
+        std::move(callback).Run(success);
+      }
+    }
+    DrainCookieWritesForCheckpointCallback callback;
+  };
+  auto reply = std::make_shared<Reply>(std::move(callback));
+  runner->PostDelayedTask(
+      FROM_HERE,
+      base::BindOnce([](std::shared_ptr<Reply> pending) { pending->Complete(false); },
+                     reply),
+      deadline - now);
+  auto delivered = base::BindOnce(
+      [reply, runner, owner = WeakPersistent<ServiceWorkerGlobalScope>(this),
+       ticket, deadline](bool success) {
+        runner->PostTask(FROM_HERE, base::BindOnce(
+            [reply, owner, ticket, deadline, success]() {
+              const bool valid = owner && base::TimeTicks::Now() < deadline &&
+                                 owner->IsCookieCheckpointCaptureCurrent(ticket);
+              if (owner && owner->cookie_checkpoint_ticket_ == ticket) {
+                owner->cookie_checkpoint_capture_valid_ = false;
+              }
+              reply->Complete(success && valid);
+            }));
+      });
+  if (auto* participant = cookie_checkpoint_producer_.Get()) {
+    participant->DrainWritesForCheckpoint(deadline, std::move(delivered));
+  } else {
+    runner->PostTask(FROM_HERE, base::BindOnce(std::move(delivered), true));
+  }
+}
+
 void ServiceWorkerGlobalScope::Dispose() {
   DCHECK(IsContextThread());
+  cookie_checkpoint_disposed_ = true;
+  cookie_checkpoint_capture_valid_ = false;
+  cookie_checkpoint_producer_.Clear();
+  cookie_checkpoint_snapshot_.reset();
   controller_receivers_.Clear();
   event_queue_.reset();
   service_worker_host_.reset();
