+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "third_party/blink/renderer/core/loader/cookie_checkpoint_participant.h"
+
+#include "third_party/blink/renderer/core/execution_context/execution_context.h"
+#include "third_party/blink/renderer/core/loader/cookie_jar.h"
+
+namespace blink {
+
+const char CookieCheckpointParticipant::kSupplementName[] =
+    "CookieCheckpointParticipant";
+
+CookieCheckpointParticipant::CookieCheckpointParticipant(ExecutionContext& context)
+    : Supplement<ExecutionContext>(context) {}
+
+CookieCheckpointParticipant::~CookieCheckpointParticipant() = default;
+
+CookieCheckpointParticipant* CookieCheckpointParticipant::GetIfExists(
+    const ExecutionContext& context) {
+  return Supplement<ExecutionContext>::From<CookieCheckpointParticipant>(context);
+}
+
+bool CookieCheckpointParticipant::IsRegisteredForCheckpoint() const {
+  auto* context = GetSupplementable();
+  return registration_valid_ && !context->IsContextDestroyed() &&
+         GetIfExists(*context) == this;
+}
+
+bool CookieCheckpointParticipant::RegisterForCheckpoint() {
+  auto* context = GetSupplementable();
+  if (context->IsContextDestroyed()) {
+    return false;
+  }
+  auto* existing = GetIfExists(*context);
+  if (existing == this) {
+    return IsRegisteredForCheckpoint();
+  }
+  if (context->IsWindow()) {
+    CookieJar::NoteExternalCookieProducerMutationForCheckpoint();
+  }
+  if (existing) {
+    // Never overwrite an actor whose pending writes may still be in flight.
+    existing->registration_valid_ = false;
+    registration_valid_ = false;
+    return false;
+  }
+  Supplement<ExecutionContext>::ProvideTo(*context, this);
+  registration_valid_ = true;
+  return true;
+}
+
+void CookieCheckpointParticipant::Trace(Visitor* visitor) const {
+  Supplement<ExecutionContext>::Trace(visitor);
+}
+
+}  // namespace blink
