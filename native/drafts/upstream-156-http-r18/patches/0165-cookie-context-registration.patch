index 0000000000000000000000000000000000000000..c801cf7ec840fd75354e2e2aed843aceb7904131
--- /dev/null
+++ b/third_party/blink/renderer/core/loader/cookie_checkpoint_participant_test.cc
@@ -0,0 +1,95 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "third_party/blink/renderer/core/loader/cookie_checkpoint_participant.h"
+
+#include <utility>
+
+#include "testing/gtest/include/gtest/gtest.h"
+#include "third_party/blink/renderer/core/dom/document.h"
+#include "third_party/blink/renderer/core/execution_context/execution_context.h"
+#include "third_party/blink/renderer/core/loader/cookie_jar.h"
+#include "third_party/blink/renderer/core/testing/page_test_base.h"
+#include "third_party/blink/renderer/platform/heap/garbage_collected.h"
+
+namespace blink {
+namespace {
+
+class RegistrationParticipant final
+    : public GarbageCollected<RegistrationParticipant>,
+      public CookieCheckpointParticipant {
+ public:
+  explicit RegistrationParticipant(ExecutionContext& context)
+      : CookieCheckpointParticipant(context) {}
+
+  bool Register() { return RegisterForCheckpoint(); }
+  std::optional<Snapshot> CaptureWritesForCheckpoint() const override {
+    if (!IsRegisteredForCheckpoint()) {
+      return std::nullopt;
+    }
+    return Snapshot{0, 0};
+  }
+  void DrainWritesForCheckpoint(base::TimeTicks,
+                                base::OnceCallback<void(bool)> callback) override {
+    ADD_FAILURE() << "Registration-only fake must not authorize a wire drain";
+    std::move(callback).Run(false);
+  }
+};
+
+class CookieCheckpointParticipantTest : public PageTestBase {
+ protected:
+  ExecutionContext& Context() { return *GetDocument().GetExecutionContext(); }
+};
+
+TEST_F(CookieCheckpointParticipantTest, LookupDoesNotCreateOrChangeTheEpoch) {
+  auto epoch = CookieJar::CheckpointProducerEpoch();
+  EXPECT_EQ(CookieCheckpointParticipant::GetIfExists(Context()), nullptr);
+  EXPECT_EQ(CookieCheckpointParticipant::GetIfExists(Context()), nullptr);
+  EXPECT_EQ(CookieJar::CheckpointProducerEpoch(), epoch);
+}
+
+TEST_F(CookieCheckpointParticipantTest, FirstRegistrationOwnsTheContext) {
+  auto epoch = CookieJar::CheckpointProducerEpoch();
+  auto* participant = MakeGarbageCollected<RegistrationParticipant>(Context());
+  EXPECT_FALSE(participant->IsRegisteredForCheckpoint());
+  ASSERT_TRUE(participant->Register());
+  EXPECT_EQ(CookieCheckpointParticipant::GetIfExists(Context()), participant);
+  EXPECT_TRUE(participant->CaptureWritesForCheckpoint());
+  EXPECT_NE(CookieJar::CheckpointProducerEpoch(), epoch);
+}
+
+TEST_F(CookieCheckpointParticipantTest, RepeatedRegistrationIsIdempotent) {
+  auto* participant = MakeGarbageCollected<RegistrationParticipant>(Context());
+  ASSERT_TRUE(participant->Register());
+  auto epoch = CookieJar::CheckpointProducerEpoch();
+  EXPECT_TRUE(participant->Register());
+  EXPECT_TRUE(participant->IsRegisteredForCheckpoint());
+  EXPECT_EQ(CookieJar::CheckpointProducerEpoch(), epoch);
+}
+
+TEST_F(CookieCheckpointParticipantTest, DuplicateDoesNotReplaceOrAuthorizeEither) {
+  auto* first = MakeGarbageCollected<RegistrationParticipant>(Context());
+  auto* second = MakeGarbageCollected<RegistrationParticipant>(Context());
+  ASSERT_TRUE(first->Register());
+  auto epoch = CookieJar::CheckpointProducerEpoch();
+  EXPECT_FALSE(second->Register());
+  EXPECT_EQ(CookieCheckpointParticipant::GetIfExists(Context()), first);
+  EXPECT_FALSE(first->CaptureWritesForCheckpoint());
+  EXPECT_FALSE(second->CaptureWritesForCheckpoint());
+  EXPECT_FALSE(first->Register());
+  EXPECT_NE(CookieJar::CheckpointProducerEpoch(), epoch);
+}
+
+TEST_F(CookieCheckpointParticipantTest, ReplacedRegistryInvalidatesTheOldActor) {
+  auto* first = MakeGarbageCollected<RegistrationParticipant>(Context());
+  auto* second = MakeGarbageCollected<RegistrationParticipant>(Context());
+  ASSERT_TRUE(first->Register());
+  Supplement<ExecutionContext>::ProvideTo(Context(), second);
+  EXPECT_EQ(CookieCheckpointParticipant::GetIfExists(Context()), second);
+  EXPECT_FALSE(first->CaptureWritesForCheckpoint());
+  EXPECT_FALSE(second->CaptureWritesForCheckpoint());
+}
+
+}  // namespace
+}  // namespace blink
