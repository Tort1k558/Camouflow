@@ -0,0 +1,52 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef THIRD_PARTY_BLINK_RENDERER_CORE_LOADER_COOKIE_CHECKPOINT_PARTICIPANT_H_
+#define THIRD_PARTY_BLINK_RENDERER_CORE_LOADER_COOKIE_CHECKPOINT_PARTICIPANT_H_
+
+#include <optional>
+
+#include "base/functional/callback.h"
+#include "base/time/time.h"
+#include "third_party/blink/renderer/core/core_export.h"
+#include "third_party/blink/renderer/core/loader/cookie_checkpoint_state.h"
+#include "third_party/blink/renderer/platform/supplementable.h"
+
+namespace blink {
+
+class ExecutionContext;
+
+// Core can discover a module-owned producer without creating its Web API object
+// or taking a core-to-modules dependency. One live producer owns each context.
+class CORE_EXPORT CookieCheckpointParticipant
+    : public Supplement<ExecutionContext> {
+ public:
+  static const char kSupplementName[];
+  using Snapshot = camouflow::native::CookieCheckpointState::Snapshot;
+
+  static CookieCheckpointParticipant* GetIfExists(const ExecutionContext&);
+  virtual ~CookieCheckpointParticipant();
+
+  CookieCheckpointParticipant(const CookieCheckpointParticipant&) = delete;
+  CookieCheckpointParticipant& operator=(const CookieCheckpointParticipant&) =
+      delete;
+
+  bool IsRegisteredForCheckpoint() const;
+  virtual std::optional<Snapshot> CaptureWritesForCheckpoint() const = 0;
+  virtual void DrainWritesForCheckpoint(
+      base::TimeTicks deadline,
+      base::OnceCallback<void(bool)> callback) = 0;
+  void Trace(Visitor*) const override;
+
+ protected:
+  explicit CookieCheckpointParticipant(ExecutionContext&);
+  bool RegisterForCheckpoint();
+
+ private:
+  bool registration_valid_ = false;
+};
+
+}  // namespace blink
+
+#endif  // THIRD_PARTY_BLINK_RENDERER_CORE_LOADER_COOKIE_CHECKPOINT_PARTICIPANT_H_
