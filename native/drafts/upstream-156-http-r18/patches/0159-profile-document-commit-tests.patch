+class ProfileDocumentCommitTest : public testing::Test {
+ public:
+  void SetUp() override {
+    context_ = std::make_unique<TestBrowserContext>();
+    partition_ = static_cast<StoragePartitionImpl*>(
+        context_->GetDefaultStoragePartition());
+    BindCookies();
+    BindLocalStorage();
+  }
+  void TearDown() override {
+    cookie_receiver_.reset();
+    local_receiver_.reset();
+    DestroyContext();
+    environment_.RunUntilIdle();
+  }
+  void BindCookies() {
+    partition_->RejectCookieCheckpoints();
+    partition_->cookie_manager_for_browser_process_.reset();
+    cookie_receiver_.reset();
+    cookie_receiver_.Bind(partition_->cookie_manager_for_browser_process_
+                              .BindNewPipeAndPassReceiver());
+    partition_->cookie_manager_for_browser_process_.set_disconnect_handler(
+        base::BindOnce(
+            &StoragePartitionImpl::RejectCookieCheckpoints,
+            partition_->cookie_checkpoint_weak_factory_.GetWeakPtr()));
+  }
+  void BindLocalStorage() {
+    auto* storage = partition_->GetDOMStorageContext();
+    storage->RejectLocalStorageCheckpoints();
+    storage->local_storage_control_.reset();
+    local_receiver_.reset();
+    local_receiver_.Bind(
+        storage->local_storage_control_.BindNewPipeAndPassReceiver());
+    storage->local_storage_control_.set_disconnect_handler(
+        base::BindOnce(&DOMStorageContextWrapper::RejectLocalStorageCheckpoints,
+                       storage->checkpoint_weak_factory_.GetWeakPtr()));
+  }
+  void DestroyContext() {
+    partition_ = nullptr;
+    context_.reset();
+  }
+
+ protected:
+  std::unique_ptr<Commit> Start(
+      base::test::TestFuture<Commit::Result>& result) {
+    return Commit::Start(context_.get(),
+                         base::TimeTicks::Now() + base::Seconds(5),
+                         result.GetCallback());
+  }
+  void ReplyCookie(bool success) {
+    CHECK_EQ(cookies_.replies.size(), 1u);
+    auto callback = std::move(cookies_.replies.front());
+    cookies_.replies.clear();
+    std::move(callback).Run(success);
+  }
+  void ReplyLocal(bool success) {
+    CHECK_EQ(local_storage_.replies.size(), 1u);
+    auto callback = std::move(local_storage_.replies.front());
+    local_storage_.replies.clear();
+    std::move(callback).Run(success);
+  }
+  bool BothPending() const {
+    return cookies_.replies.size() == 1u && local_storage_.replies.size() == 1u;
+  }
+  BrowserTaskEnvironment environment_{
+      base::test::TaskEnvironment::TimeSource::MOCK_TIME};
+  std::unique_ptr<TestBrowserContext> context_;
+  raw_ptr<StoragePartitionImpl> partition_ = nullptr;
+  CommitCookieBackend cookies_;
+  CommitLocalBackend local_storage_;
+  mojo::Receiver<network::mojom::CookieManager> cookie_receiver_{&cookies_};
+  mojo::Receiver<storage::mojom::LocalStorageControl> local_receiver_{
+      &local_storage_};
+};
+
+TEST_F(ProfileDocumentCommitTest, ProducersPrecedeBothStoreCommits) {
+  CommitRenderer renderer(context_.get());
+  base::test::TestFuture<Commit::Result> result;
+  auto operation = Start(result);
+  ASSERT_EQ(renderer.local_replies.size(), 1u);
+  ASSERT_EQ(renderer.cookie_replies.size(), 1u);
+  std::move(renderer.local_replies.front()).Run(true);
+  environment_.RunUntilIdle();
+  EXPECT_TRUE(cookies_.replies.empty());
+  EXPECT_TRUE(local_storage_.replies.empty());
+  std::move(renderer.cookie_replies.front()).Run(true);
+  environment_.RunUntilIdle();
+  ASSERT_TRUE(BothPending());
+  ReplyCookie(true);
+  environment_.RunUntilIdle();
+  EXPECT_FALSE(result.IsReady());
+  ReplyLocal(true);
+  EXPECT_EQ(result.Get().status, Status::kCommittedDocumentPrefix);
+  EXPECT_EQ(result.Get().loaded_partition_count, 1u);
+  EXPECT_EQ(cookies_.legacy_flushes, 0u);
+  EXPECT_EQ(local_storage_.legacy_flushes, 0u);
+}
+
+TEST_F(ProfileDocumentCommitTest, ProducerFailureNeverContactsStores) {
+  CommitRenderer renderer(context_.get());
+  base::test::TestFuture<Commit::Result> result;
+  auto operation = Start(result);
+  ASSERT_EQ(renderer.local_replies.size(), 1u);
+  std::move(renderer.local_replies.front()).Run(false);
+  EXPECT_EQ(result.Get().status, Status::kProducerRejected);
+  EXPECT_TRUE(cookies_.replies.empty());
+  EXPECT_TRUE(local_storage_.replies.empty());
+}
