+using Commit = camouflow::native::ProfileDocumentCommit;
+using Status = Commit::Status;
+
+class CommitCookieBackend final : public network::TestCookieManager {
+ public:
+  void FlushCookieStoreForCheckpoint(
+      FlushCookieStoreForCheckpointCallback callback) override {
+    replies.push_back(std::move(callback));
+  }
+  void FlushCookieStore(FlushCookieStoreCallback callback) override {
+    ++legacy_flushes;
+  }
+  std::vector<FlushCookieStoreForCheckpointCallback> replies;
+  size_t legacy_flushes = 0;
+};
+
+class CommitLocalBackend final : public storage::mojom::LocalStorageControl {
+ public:
+  void BindStorageArea(
+      const blink::StorageKey&,
+      mojo::PendingReceiver<blink::mojom::StorageArea>) override {}
+  void GetUsage(GetUsageCallback callback) override {
+    std::move(callback).Run({});
+  }
+  void DeleteStorage(const blink::StorageKey&,
+                     DeleteStorageCallback callback) override {
+    std::move(callback).Run();
+  }
+  void CleanUpStorage(CleanUpStorageCallback callback) override {
+    std::move(callback).Run();
+  }
+  void Flush() override { ++legacy_flushes; }
+  void PurgeMemory() override {}
+  void ApplyPolicyUpdates(
+      std::vector<storage::mojom::StoragePolicyUpdatePtr>) override {}
+  void ForceKeepSessionState() override {}
+  void FlushForCheckpoint(FlushForCheckpointCallback callback) override {
+    replies.push_back(std::move(callback));
+  }
+  std::vector<FlushForCheckpointCallback> replies;
+  size_t legacy_flushes = 0;
+};
+
+class CommitRenderer final : public MockRenderProcessHost {
+ public:
+  explicit CommitRenderer(BrowserContext* context)
+      : MockRenderProcessHost(context) {
+    Init();
+    SimulateReady();
+  }
+  void FenceLocalStorageForCheckpoint(
+      base::TimeTicks deadline,
+      base::OnceCallback<void(bool)> callback) override {
+    local_replies.push_back(std::move(callback));
+  }
+  void FenceDocumentCookiesForCheckpoint(
+      base::TimeTicks deadline,
+      base::OnceCallback<void(bool)> callback) override {
+    cookie_replies.push_back(std::move(callback));
+  }
+  std::vector<base::OnceCallback<void(bool)>> local_replies;
+  std::vector<base::OnceCallback<void(bool)>> cookie_replies;
+};
+
+}  // namespace
