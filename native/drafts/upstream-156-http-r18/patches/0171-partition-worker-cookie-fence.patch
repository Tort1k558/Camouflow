@@ -0,0 +1,335 @@
+// Copyright 2026 CamouFlow contributors.
+// SPDX-License-Identifier: MIT
+
+#include "content/browser/camouflow_native/glint/partition_worker_cookie_fence.h"
+
+#include <utility>
+
+#include "base/check.h"
+#include "base/functional/bind.h"
+#include "base/memory/ref_counted.h"
+#include "base/task/bind_post_task.h"
+#include "base/task/sequenced_task_runner.h"
+#include "base/uuid.h"
+#include "content/browser/service_worker/embedded_worker_instance.h"
+#include "content/browser/service_worker/service_worker_context_core.h"
+#include "content/browser/service_worker/service_worker_context_wrapper.h"
+#include "content/browser/service_worker/service_worker_version.h"
+#include "content/browser/storage_partition_impl.h"
+#include "content/public/browser/browser_thread.h"
+#include "content/public/browser/render_process_host.h"
+
+namespace camouflow::native {
+
+struct PartitionWorkerCookieFence::Actor {
+  scoped_refptr<content::ServiceWorkerVersion> version;
+  blink::ServiceWorkerToken token;
+  content::ChildProcessId process;
+  base::Uuid request_id;
+  uint64_t ticket = 0;
+  bool leased = false;
+};
+
+std::unique_ptr<PartitionWorkerCookieFence> PartitionWorkerCookieFence::Start(
+    content::StoragePartitionImpl* partition,
+    base::TimeTicks deadline,
+    Callback callback) {
+  CHECK_CURRENTLY_ON(content::BrowserThread::UI);
+  CHECK(callback);
+  auto operation = std::unique_ptr<PartitionWorkerCookieFence>(
+      new PartitionWorkerCookieFence(partition, deadline, std::move(callback)));
+  operation->Begin();
+  return operation;
+}
+
+PartitionWorkerCookieFence::PartitionWorkerCookieFence(
+    content::StoragePartitionImpl* partition,
+    base::TimeTicks deadline,
+    Callback callback)
+    : partition_(partition ? partition->GetWeakPtr()
+                           : base::WeakPtr<content::StoragePartitionImpl>()),
+      deadline_(deadline), callback_(std::move(callback)) {}
+
+PartitionWorkerCookieFence::~PartitionWorkerCookieFence() {
+  CHECK_CURRENTLY_ON(content::BrowserThread::UI);
+  weak_factory_.InvalidateWeakPtrs();
+  timer_.Stop();
+  observation_.Reset();
+  ReleaseLeases();
+  if (callback_) {
+    base::BindPostTaskToCurrentDefault(std::move(callback_))
+        .Run(Result{Status::kCancelled, actors_.size()});
+  }
+}
+
+PartitionWorkerCookieFence::Status PartitionWorkerCookieFence::CaptureActors() {
+  if (!partition_ || !owner_ || !core_ ||
+      partition_->GetServiceWorkerContext() != owner_.get() ||
+      owner_->context() != core_.get()) {
+    return Status::kOwnerGone;
+  }
+  if (core_->GetLiveVersions().size() > kMaxLiveVersions ||
+      owner_->GetRunningServiceWorkerInfos().size() > kMaxWorkers) {
+    return Status::kTooManyActors;
+  }
+  for (const auto& [id, version] : core_->GetLiveVersions()) {
+    const auto state = version->running_status();
+    if (state != blink::EmbeddedWorkerStatus::kRunning &&
+        state != blink::EmbeddedWorkerStatus::kStopped) {
+      return Status::kNotReady;
+    }
+    if (state == blink::EmbeddedWorkerStatus::kRunning &&
+        !owner_->GetRunningServiceWorkerInfos().contains(id)) {
+      return Status::kNotReady;
+    }
+  }
+  for (const auto& [id, info] : owner_->GetRunningServiceWorkerInfos()) {
+    auto* version = owner_->GetLiveVersion(id);
+    auto* host = content::RenderProcessHost::FromID(info.render_process_id);
+    if (!version || !host || !host->IsInitializedAndNotDead() || !host->IsReady() ||
+        host->FastShutdownStarted() ||
+        !version->IsCookieCheckpointEndpointCurrent(info.token, deadline_) ||
+        version->embedded_worker()->process_id() != info.render_process_id) {
+      return Status::kNotReady;
+    }
+    actors_.push_back(std::make_unique<Actor>(Actor{
+        base::WrapRefCounted(version), info.token, info.render_process_id,
+        base::Uuid::GenerateRandomV4()}));
+  }
+  return Status::kAcknowledged;
+}
+
+void PartitionWorkerCookieFence::Begin() {
+  const auto now = base::TimeTicks::Now();
+  if (deadline_ <= now || deadline_ > now + base::Seconds(30)) {
+    Finish(Status::kTimedOut);
+    return;
+  }
+  if (!partition_ || !partition_->GetServiceWorkerContext() ||
+      !partition_->GetServiceWorkerContext()->context()) {
+    Finish(Status::kOwnerGone);
+    return;
+  }
+  owner_ = partition_->GetServiceWorkerContext();
+  core_ = owner_->context()->AsWeakPtr();
+  observation_.Observe(owner_.get());
+  const auto status = CaptureActors();
+  if (status != Status::kAcknowledged) {
+    Finish(status);
+    return;
+  }
+  timer_.Start(FROM_HERE, deadline_ - base::TimeTicks::Now(),
+               base::BindOnce(&PartitionWorkerCookieFence::Expired,
+                              weak_factory_.GetWeakPtr()));
+  for (auto& actor : actors_) {
+    if (base::TimeTicks::Now() >= deadline_) {
+      Finish(Status::kTimedOut);
+      return;
+    }
+    const auto result = actor->version->StartExternalRequest(
+        actor->request_id, content::ServiceWorkerExternalRequestTimeoutType::kDefault);
+    actor->leased = result == content::ServiceWorkerExternalRequestResult::kOk;
+    if (completion_queued_) {
+      ReleaseLeases();
+      return;
+    }
+    if (!actor->leased) {
+      Finish(Status::kNotReady);
+      return;
+    }
+  }
+  remaining_ = actors_.size();
+  if (actors_.empty()) {
+    Finish(Status::kAcknowledged);
+    return;
+  }
+  for (size_t index = 0; index < actors_.size(); ++index) {
+    if (completion_queued_) {
+      return;
+    }
+    auto& actor = *actors_[index];
+    actor.version->CaptureCookieProducerForCheckpoint(
+        actor.token, deadline_,
+        base::BindOnce(&PartitionWorkerCookieFence::Captured,
+                       weak_factory_.GetWeakPtr(), index));
+  }
+}
+
+PartitionWorkerCookieFence::Status PartitionWorkerCookieFence::Revalidate() {
+  if (base::TimeTicks::Now() >= deadline_) {
+    return Status::kTimedOut;
+  }
+  if (topology_changed_) {
+    return Status::kTopologyChanged;
+  }
+  if (!partition_ || !owner_ || !core_ ||
+      partition_->GetServiceWorkerContext() != owner_.get() ||
+      owner_->context() != core_.get()) {
+    return Status::kOwnerGone;
+  }
+  if (core_->GetLiveVersions().size() > kMaxLiveVersions) {
+    return Status::kTooManyActors;
+  }
+  if (owner_->GetRunningServiceWorkerInfos().size() != actors_.size()) {
+    return Status::kTopologyChanged;
+  }
+  for (const auto& [id, version] : core_->GetLiveVersions()) {
+    const auto state = version->running_status();
+    if (state != blink::EmbeddedWorkerStatus::kRunning &&
+        state != blink::EmbeddedWorkerStatus::kStopped) {
+      return Status::kTopologyChanged;
+    }
+    if (state == blink::EmbeddedWorkerStatus::kRunning &&
+        !owner_->GetRunningServiceWorkerInfos().contains(id)) {
+      return Status::kTopologyChanged;
+    }
+  }
+  for (const auto& actor : actors_) {
+    const auto& running = owner_->GetRunningServiceWorkerInfos();
+    const auto found = running.find(actor->version->version_id());
+    auto* host = content::RenderProcessHost::FromID(actor->process);
+    if (found == running.end() || found->second.token != actor->token ||
+        found->second.render_process_id != actor->process ||
+        owner_->GetLiveVersion(actor->version->version_id()) != actor->version.get() ||
+        !actor->leased || !host || !host->IsInitializedAndNotDead() ||
+        !host->IsReady() || host->FastShutdownStarted() ||
+        !actor->version->IsCookieCheckpointEndpointCurrent(actor->token, deadline_) ||
+        actor->version->embedded_worker()->process_id() != actor->process) {
+      return Status::kTopologyChanged;
+    }
+  }
+  return Status::kAcknowledged;
+}
+
+void PartitionWorkerCookieFence::Captured(size_t index,
+                                          bool available,
+                                          uint64_t ticket) {
+  if (completion_queued_) {
+    return;
+  }
+  const auto status = Revalidate();
+  if (!available || !ticket || status != Status::kAcknowledged) {
+    Finish(status == Status::kAcknowledged ? Status::kProducerRejected : status);
+    return;
+  }
+  actors_[index]->ticket = ticket;
+  if (--remaining_ != 0) {
+    return;
+  }
+  draining_ = true;
+  remaining_ = actors_.size();
+  for (const auto& actor : actors_) {
+    if (completion_queued_) {
+      return;
+    }
+    actor->version->DrainCookieWritesForCheckpoint(
+        actor->token, actor->ticket, deadline_,
+        base::BindOnce(&PartitionWorkerCookieFence::Drained,
+                       weak_factory_.GetWeakPtr()));
+  }
+}
+
+void PartitionWorkerCookieFence::Drained(bool success) {
+  if (completion_queued_) {
+    return;
+  }
+  CHECK(draining_);
+  const auto status = Revalidate();
+  if (!success || status != Status::kAcknowledged) {
+    Finish(status == Status::kAcknowledged ? Status::kProducerRejected : status);
+  } else if (--remaining_ == 0) {
+    Finish(Status::kAcknowledged);
+  }
+}
+
+void PartitionWorkerCookieFence::ReleaseLeases() {
+  for (auto& actor : actors_) {
+    if (std::exchange(actor->leased, false)) {
+      actor->version->FinishExternalRequest(actor->request_id);
+    }
+  }
+}
+
+void PartitionWorkerCookieFence::Expired() {
+  if (callback_ && !completion_queued_) {
+    Finish(Status::kTimedOut);
+    return;
+  }
+  acknowledged_ = false;
+  observation_.Reset();
+  ReleaseLeases();
+}
+
+void PartitionWorkerCookieFence::Changed() {
+  topology_changed_ = true;
+  if (callback_ && !completion_queued_) {
+    Finish(Status::kTopologyChanged);
+  } else {
+    timer_.Stop();
+    observation_.Reset();
+    ReleaseLeases();
+  }
+}
+
+void PartitionWorkerCookieFence::Finish(Status status) {
+  if (completion_queued_ || !callback_) {
+    return;
+  }
+  completion_queued_ = true;
+  acknowledged_ = status == Status::kAcknowledged;
+  if (!acknowledged_) {
+    timer_.Stop();
+    observation_.Reset();
+    ReleaseLeases();
+  }
+  base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, base::BindOnce(&PartitionWorkerCookieFence::Deliver,
+                                weak_factory_.GetWeakPtr(), status));
+}
+
+void PartitionWorkerCookieFence::Deliver(Status status) {
+  if (status == Status::kAcknowledged) {
+    status = Revalidate();
+  }
+  if (status != Status::kAcknowledged) {
+    acknowledged_ = false;
+    timer_.Stop();
+    observation_.Reset();
+    ReleaseLeases();
+  }
+  std::move(callback_).Run(Result{status, actors_.size()});
+}
+
+PartitionWorkerCookieFence::Status
+PartitionWorkerCookieFence::CheckRetainedCohort() {
+  CHECK_CURRENTLY_ON(content::BrowserThread::UI);
+  if (base::TimeTicks::Now() >= deadline_) {
+    return Status::kTimedOut;
+  }
+  if (!acknowledged_ || callback_) {
+    return Status::kNotReady;
+  }
+  return Revalidate();
+}
+
+void PartitionWorkerCookieFence::OnStartWorkerMessageSentSync(int64_t,
+                                                            const GURL&) {
+  Changed();
+}
+void PartitionWorkerCookieFence::OnStoppingSync(
+    int64_t, const GURL&, const blink::ServiceWorkerToken&) {
+  Changed();
+}
+void PartitionWorkerCookieFence::OnStoppedSync(
+    int64_t, const GURL&, const blink::ServiceWorkerToken&) {
+  Changed();
+}
+void PartitionWorkerCookieFence::OnDestructSync(content::ServiceWorkerContext*) {
+  observation_.Reset();
+  Changed();
+}
+void PartitionWorkerCookieFence::OnWillCreateURLLoaderFactorySync(const GURL&) {
+  Changed();
+}
+
+}  // namespace camouflow::native
