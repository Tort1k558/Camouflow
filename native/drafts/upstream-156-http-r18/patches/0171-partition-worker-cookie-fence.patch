+// Copyright 2026 CamouFlow contributors.
+// SPDX-License-Identifier: MIT
+
+#ifndef CONTENT_BROWSER_CAMOUFLOW_NATIVE_GLINT_PARTITION_WORKER_COOKIE_FENCE_H_
+#define CONTENT_BROWSER_CAMOUFLOW_NATIVE_GLINT_PARTITION_WORKER_COOKIE_FENCE_H_
+
+#include <cstddef>
+#include <cstdint>
+#include <memory>
+#include <vector>
+
+#include "base/functional/callback.h"
+#include "base/memory/scoped_refptr.h"
+#include "base/memory/weak_ptr.h"
+#include "base/scoped_observation.h"
+#include "base/time/time.h"
+#include "base/timer/timer.h"
+#include "content/common/content_export.h"
+#include "content/public/browser/service_worker_context.h"
+
+namespace content {
+class ServiceWorkerContextCore;
+class ServiceWorkerContextWrapper;
+class StoragePartitionImpl;
+}  // namespace content
+
+namespace camouflow::native {
+
+// Prefix of existing CookieStore producers in one already loaded partition.
+// Not a backend commit, HTTP/IDB/cache fence or global atomic profile cut.
+class CONTENT_EXPORT PartitionWorkerCookieFence final
+    : public content::ServiceWorkerContextObserverSynchronous {
+ public:
+  enum class Status {
+    kAcknowledged,
+    kNotReady,
+    kTooManyActors,
+    kTopologyChanged,
+    kProducerRejected,
+    kTimedOut,
+    kOwnerGone,
+    kCancelled,
+  };
+  struct Result {
+    Status status;
+    size_t worker_count;
+  };
+  using Callback = base::OnceCallback<void(Result)>;
+
+  // UI only. Never creates a partition or starts/restarts a worker. Retain the
+  // operation through backend commit and final delivery; keepalives expire at
+  // the original deadline even if the caller keeps an acknowledged operation.
+  static std::unique_ptr<PartitionWorkerCookieFence> Start(
+      content::StoragePartitionImpl* partition,
+      base::TimeTicks deadline,
+      Callback callback);
+  ~PartitionWorkerCookieFence() override;
+  Status CheckRetainedCohort();
+
+  PartitionWorkerCookieFence(const PartitionWorkerCookieFence&) = delete;
+  PartitionWorkerCookieFence& operator=(const PartitionWorkerCookieFence&) = delete;
+
+ private:
+  static constexpr size_t kMaxWorkers = 512;
+  static constexpr size_t kMaxLiveVersions = 4096;
+  struct Actor;
+
+  PartitionWorkerCookieFence(content::StoragePartitionImpl* partition,
+                             base::TimeTicks deadline,
+                             Callback callback);
+  void Begin();
+  Status CaptureActors();
+  Status Revalidate();
+  void Captured(size_t index, bool available, uint64_t ticket);
+  void Drained(bool success);
+  void Expired();
+  void Changed();
+  void Finish(Status status);
+  void Deliver(Status status);
+  void ReleaseLeases();
+
+  void OnStartWorkerMessageSentSync(int64_t version_id, const GURL& scope) override;
+  void OnStoppingSync(int64_t version_id, const GURL& scope,
+                      const blink::ServiceWorkerToken& token) override;
+  void OnStoppedSync(int64_t version_id, const GURL& scope,
+                     const blink::ServiceWorkerToken& token) override;
+  void OnDestructSync(content::ServiceWorkerContext* context) override;
+  void OnWillCreateURLLoaderFactorySync(const GURL& scope) override;
+
+  base::WeakPtr<content::StoragePartitionImpl> partition_;
+  scoped_refptr<content::ServiceWorkerContextWrapper> owner_;
+  base::WeakPtr<content::ServiceWorkerContextCore> core_;
+  const base::TimeTicks deadline_;
+  Callback callback_;
+  std::vector<std::unique_ptr<Actor>> actors_;
+  size_t remaining_ = 0;
+  bool draining_ = false;
+  bool completion_queued_ = false;
+  bool acknowledged_ = false;
+  bool topology_changed_ = false;
+  base::ScopedObservation<content::ServiceWorkerContext,
+                          content::ServiceWorkerContextObserverSynchronous>
+      observation_{this};
+  base::OneShotTimer timer_;
+  base::WeakPtrFactory<PartitionWorkerCookieFence> weak_factory_{this};
+};
+
+}  // namespace camouflow::native
+
+#endif
diff --git a/content/browser/camouflow_native/glint/partition_worker_cookie_fence_unittest.cc b/content/browser/camouflow_native/glint/partition_worker_cookie_fence_unittest.cc
new file mode 100644
index 0000000000000000000000000000000000000000..6ac2c3b1c517bbac7f0d00c39a481932b00df6cb
--- /dev/null
+++ b/content/browser/camouflow_native/glint/partition_worker_cookie_fence_unittest.cc
@@ -0,0 +1,109 @@
+// Copyright 2026 CamouFlow contributors.
+// SPDX-License-Identifier: MIT
+
+#include "content/browser/camouflow_native/glint/partition_worker_cookie_fence.h"
+
+#include <memory>
+
+#include "base/memory/raw_ptr.h"
+#include "base/test/test_future.h"
+#include "content/browser/storage_partition_impl.h"
+#include "content/public/test/browser_task_environment.h"
+#include "content/public/test/test_browser_context.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace content {
+namespace {
+
+using WorkerFence = camouflow::native::PartitionWorkerCookieFence;
+using WorkerFenceStatus = WorkerFence::Status;
+
+class PartitionWorkerCookieFenceTest : public testing::Test {
+ protected:
+  void SetUp() override {
+    context_ = std::make_unique<TestBrowserContext>();
+    partition_ = static_cast<StoragePartitionImpl*>(
+        context_->GetDefaultStoragePartition());
+    environment_.RunUntilIdle();
+  }
+  void TearDown() override { DestroyContext(); }
+  void DestroyContext() {
+    partition_ = nullptr;
+    context_.reset();
+    environment_.RunUntilIdle();
+  }
+  base::TimeTicks Deadline() { return base::TimeTicks::Now() + base::Seconds(5); }
+
+  BrowserTaskEnvironment environment_{
+      BrowserTaskEnvironment::IO_MAINLOOP,
+      base::test::TaskEnvironment::TimeSource::MOCK_TIME};
+  std::unique_ptr<TestBrowserContext> context_;
+  raw_ptr<StoragePartitionImpl> partition_ = nullptr;
+};
+
+TEST_F(PartitionWorkerCookieFenceTest, EmptyPartitionAcknowledgesPosted) {
+  base::test::TestFuture<WorkerFence::Result> done;
+  auto operation = WorkerFence::Start(partition_, Deadline(), done.GetCallback());
+  EXPECT_FALSE(done.IsReady());
+  EXPECT_EQ(done.Get().status, WorkerFenceStatus::kAcknowledged);
+  EXPECT_EQ(done.Get().worker_count, 0u);
+  EXPECT_EQ(operation->CheckRetainedCohort(), WorkerFenceStatus::kAcknowledged);
+}
+
+TEST_F(PartitionWorkerCookieFenceTest, NullPartitionRejectsPosted) {
+  base::test::TestFuture<WorkerFence::Result> done;
+  auto operation = WorkerFence::Start(nullptr, Deadline(), done.GetCallback());
+  EXPECT_FALSE(done.IsReady());
+  EXPECT_EQ(done.Get().status, WorkerFenceStatus::kOwnerGone);
+}
+
+TEST_F(PartitionWorkerCookieFenceTest, ExpiredDeadlineRejectsPosted) {
+  base::test::TestFuture<WorkerFence::Result> done;
+  auto operation = WorkerFence::Start(partition_, base::TimeTicks::Now(),
+                                      done.GetCallback());
+  EXPECT_FALSE(done.IsReady());
+  EXPECT_EQ(done.Get().status, WorkerFenceStatus::kTimedOut);
+}
+
+TEST_F(PartitionWorkerCookieFenceTest, UnboundedDeadlineRejectsPosted) {
+  base::test::TestFuture<WorkerFence::Result> done;
+  auto operation = WorkerFence::Start(partition_, base::TimeTicks::Max(),
+                                      done.GetCallback());
+  EXPECT_FALSE(done.IsReady());
+  EXPECT_EQ(done.Get().status, WorkerFenceStatus::kTimedOut);
+}
+
+TEST_F(PartitionWorkerCookieFenceTest, DestroyedPendingOperationPostsCancellation) {
+  base::test::TestFuture<WorkerFence::Result> done;
+  auto operation = WorkerFence::Start(nullptr, Deadline(), done.GetCallback());
+  operation.reset();
+  EXPECT_FALSE(done.IsReady());
+  EXPECT_EQ(done.Get().status, WorkerFenceStatus::kCancelled);
+}
+
+TEST_F(PartitionWorkerCookieFenceTest, OwnerGoneRejectsQueuedEmptySuccess) {
+  base::test::TestFuture<WorkerFence::Result> done;
+  auto operation = WorkerFence::Start(partition_, Deadline(), done.GetCallback());
+  DestroyContext();
+  EXPECT_EQ(done.Get().status, WorkerFenceStatus::kOwnerGone);
+  EXPECT_NE(operation->CheckRetainedCohort(), WorkerFenceStatus::kAcknowledged);
+}
+
+TEST_F(PartitionWorkerCookieFenceTest, RetentionExpiresAtTheOriginalDeadline) {
+  base::test::TestFuture<WorkerFence::Result> done;
+  auto operation = WorkerFence::Start(partition_, Deadline(), done.GetCallback());
+  ASSERT_EQ(done.Get().status, WorkerFenceStatus::kAcknowledged);
+  environment_.FastForwardBy(base::Seconds(5));
+  EXPECT_EQ(operation->CheckRetainedCohort(), WorkerFenceStatus::kTimedOut);
+}
+
+TEST_F(PartitionWorkerCookieFenceTest, RetainedCheckCannotPrecedeDelivery) {
+  base::test::TestFuture<WorkerFence::Result> done;
+  auto operation = WorkerFence::Start(partition_, Deadline(), done.GetCallback());
+  EXPECT_EQ(operation->CheckRetainedCohort(), WorkerFenceStatus::kNotReady);
+  ASSERT_EQ(done.Get().status, WorkerFenceStatus::kAcknowledged);
+  EXPECT_EQ(operation->CheckRetainedCohort(), WorkerFenceStatus::kAcknowledged);
+}
+
+}  // namespace
+}  // namespace content
