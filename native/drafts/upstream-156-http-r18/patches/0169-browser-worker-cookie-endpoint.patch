+bool ServiceWorkerVersion::IsCookieCheckpointEndpointCurrent(
+    const blink::ServiceWorkerToken& worker,
+    base::TimeTicks deadline) const {
+  DCHECK_CURRENTLY_ON(BrowserThread::UI);
+  const auto now = base::TimeTicks::Now();
+  return context_ && deadline > now && deadline <= now + base::Seconds(30) &&
+         running_status() == blink::EmbeddedWorkerStatus::kRunning &&
+         is_endpoint_ready_ && start_worker_token_ == worker &&
+         service_worker_remote_.is_bound() && service_worker_remote_.is_connected();
+}
+
+void ServiceWorkerVersion::CaptureCookieProducerForCheckpoint(
+    const blink::ServiceWorkerToken& worker,
+    base::TimeTicks deadline,
+    CookieCheckpointCaptureCallback callback) {
+  DCHECK_CURRENTLY_ON(BrowserThread::UI);
+  CHECK(callback);
+  auto guarded = mojo::WrapCallbackWithDefaultInvokeIfNotRun(
+      base::BindPostTaskToCurrentDefault(std::move(callback)), false, uint64_t{0});
+  if (!IsCookieCheckpointEndpointCurrent(worker, deadline)) {
+    std::move(guarded).Run(false, 0);
+    return;
+  }
+  service_worker_remote_.QueryVersion(
+      mojo::WrapCallbackWithDefaultInvokeIfNotRun(
+          base::BindOnce(
+              [](base::WeakPtr<ServiceWorkerVersion> owner,
+                 blink::ServiceWorkerToken expected_worker,
+                 base::TimeTicks expires,
+                 CookieCheckpointCaptureCallback reply,
+                 uint32_t version) {
+                if (!owner || version < 1 ||
+                    !owner->IsCookieCheckpointEndpointCurrent(expected_worker, expires)) {
+                  std::move(reply).Run(false, 0);
+                  return;
+                }
+                owner->service_worker_remote_->CaptureCookieProducerForCheckpoint(
+                    mojo::WrapCallbackWithDefaultInvokeIfNotRun(
+                        base::BindOnce(
+                            [](base::WeakPtr<ServiceWorkerVersion> live,
+                               blink::ServiceWorkerToken expected,
+                               base::TimeTicks limit,
+                               CookieCheckpointCaptureCallback completion,
+                               bool available,
+                               uint64_t ticket) {
+                              const bool valid = available && ticket && live &&
+                                  live->IsCookieCheckpointEndpointCurrent(expected, limit);
+                              std::move(completion).Run(valid, valid ? ticket : 0);
+                            },
+                            owner, expected_worker, expires, std::move(reply)),
+                        false, uint64_t{0}));
+              },
+              weak_factory_.GetWeakPtr(), worker, deadline, std::move(guarded)),
+          uint32_t{0}));
+}
+
+void ServiceWorkerVersion::DrainCookieWritesForCheckpoint(
+    const blink::ServiceWorkerToken& worker,
+    uint64_t ticket,
+    base::TimeTicks deadline,
+    CookieCheckpointDrainCallback callback) {
+  DCHECK_CURRENTLY_ON(BrowserThread::UI);
+  CHECK(callback);
+  auto guarded = mojo::WrapCallbackWithDefaultInvokeIfNotRun(
+      base::BindPostTaskToCurrentDefault(std::move(callback)), false);
+  if (!ticket || !IsCookieCheckpointEndpointCurrent(worker, deadline)) {
+    std::move(guarded).Run(false);
+    return;
+  }
+  service_worker_remote_.QueryVersion(
+      mojo::WrapCallbackWithDefaultInvokeIfNotRun(
+          base::BindOnce(
+              [](base::WeakPtr<ServiceWorkerVersion> owner,
+                 blink::ServiceWorkerToken expected_worker,
+                 uint64_t captured_ticket,
+                 base::TimeTicks expires,
+                 CookieCheckpointDrainCallback reply,
+                 uint32_t version) {
+                if (!owner || version < 1 ||
+                    !owner->IsCookieCheckpointEndpointCurrent(expected_worker, expires)) {
+                  std::move(reply).Run(false);
+                  return;
+                }
+                owner->service_worker_remote_->DrainCookieWritesForCheckpoint(
+                    captured_ticket, expires,
+                    mojo::WrapCallbackWithDefaultInvokeIfNotRun(
+                        base::BindOnce(
+                            [](base::WeakPtr<ServiceWorkerVersion> live,
+                               blink::ServiceWorkerToken expected,
+                               base::TimeTicks limit,
+                               CookieCheckpointDrainCallback completion,
+                               bool success) {
+                              std::move(completion).Run(success && live &&
+                                  live->IsCookieCheckpointEndpointCurrent(expected, limit));
+                            },
+                            owner, expected_worker, expires, std::move(reply)),
+                        false));
+              },
+              weak_factory_.GetWeakPtr(), worker, ticket, deadline, std::move(guarded)),
+          uint32_t{0}));
+}
+
 }  // namespace content
