+TEST_P(AsyncDomStorageDatabaseTest,
+       CommitPendingMapsCompletesLoadedMapsBeforeAck) {
+  base::ScopedTempDir directory;
+  ASSERT_TRUE(directory.CreateUniqueTempDir());
+  std::unique_ptr<AsyncDomStorageDatabase> database;
+  ASSERT_NO_FATAL_FAILURE(OpenOnDiskDatabaseSync(
+      StorageType::kLocalStorage, directory.GetPath(), &database));
+  FakeCommitter first(database.get(),
+                      DomStorageDatabase::MapLocator(kFirstStorageKey));
+  FakeCommitter second(database.get(),
+                       DomStorageDatabase::MapLocator(kSecondStorageKey));
+  base::test::TestFuture<DbStatus> first_done, second_done, checkpoint;
+  first.QueuePutMapKeyValue(ToBytes("key"), ToBytes("first"),
+                            first_done.GetCallback());
+  second.QueuePutMapKeyValue(ToBytes("key"), ToBytes("second"),
+                             second_done.GetCallback());
+  database->CommitPendingMaps(checkpoint.GetCallback());
+  EXPECT_FALSE(checkpoint.IsReady());
+  ASSERT_TRUE(checkpoint.Get().ok());
+  ASSERT_TRUE(first_done.IsReady());
+  ASSERT_TRUE(second_done.IsReady());
+  EXPECT_TRUE(first_done.Get().ok());
+  EXPECT_TRUE(second_done.Get().ok());
+  std::map<DomStorageDatabase::Key, DomStorageDatabase::Value> values;
+  ReadMapKeyValuesSync(
+      *database, DomStorageDatabase::MapLocator(kFirstStorageKey), &values);
+  EXPECT_EQ(values.at(ToBytes("key")), ToBytes("first"));
+  ReadMapKeyValuesSync(
+      *database, DomStorageDatabase::MapLocator(kSecondStorageKey), &values);
+  EXPECT_EQ(values.at(ToBytes("key")), ToBytes("second"));
+}
