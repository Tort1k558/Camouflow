+void AsyncDomStorageDatabase::CommitPendingMaps(StatusCallback callback) {
+  CHECK(callback);
+  auto reply = base::BindPostTaskToCurrentDefault(base::BindOnce(
+      [](base::WeakPtr<AsyncDomStorageDatabase> owner, StatusCallback callback,
+         DbStatus status) {
+        std::move(callback).Run(owner ? std::move(status)
+                                      : DbStatus::IOError("commit owner lost"));
+      },
+      weak_ptr_factory_.GetWeakPtr(), std::move(callback)));
+  if (!is_database_opened_ || dir_to_open_.empty()) {
+    std::move(reply).Run(
+        DbStatus::NotSupported("opened on-disk database required"));
+    return;
+  }
+
+  auto replies = base::SplitOnceCallback(std::move(reply));
+  base::ScopedClosureRunner abandoned(
+      base::BindOnce(std::move(replies.second),
+                     DbStatus::IOError("commit completion abandoned")));
+  InitiateCommitImpl(base::BindOnce(
+      [](base::ScopedClosureRunner abandoned, StatusCallback reply,
+         DbStatus status) {
+        abandoned.Release().Reset();
+        std::move(reply).Run(std::move(status));
+      },
+      std::move(abandoned), std::move(replies.first)));
+}
+
+void AsyncDomStorageDatabase::InitiateCommitImpl(StatusCallback callback) {
+  CHECK(is_database_opened_);
+
+  if (migration_state_ == MigrationState::kMigrating) {
+    tasks_blocked_on_migration_.push_back(
+        base::BindOnce(&AsyncDomStorageDatabase::InitiateCommitImpl,
+                       weak_ptr_factory_.GetWeakPtr(), std::move(callback)));
     return;
   }
 
