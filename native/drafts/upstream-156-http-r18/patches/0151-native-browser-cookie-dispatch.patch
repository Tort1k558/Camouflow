+IN_PROC_BROWSER_TEST_F(RenderProcessHostTestBase,
+                       DocumentCookieCheckpointLiveRendererProducerFence) {
+  ASSERT_TRUE(embedded_test_server()->Start());
+  ASSERT_TRUE(
+      NavigateToURL(shell(), embedded_test_server()->GetURL("/title1.html")));
+  ASSERT_TRUE(ExecJs(
+      shell(), "document.cookie = 'checkpoint-producer=value; SameSite=Lax'"));
+  auto* host = shell()->web_contents()->GetPrimaryMainFrame()->GetProcess();
+  base::test::TestFuture<bool> result;
+  host->FenceDocumentCookiesForCheckpoint(
+      base::TimeTicks::Now() + base::Seconds(10), result.GetCallback());
+  EXPECT_TRUE(result.Get());
+  EXPECT_EQ("checkpoint-producer=value", EvalJs(shell(), "document.cookie"));
+}
+
+IN_PROC_BROWSER_TEST_F(
+    RenderProcessHostTestBase,
+    DocumentCookieCheckpointExpiredDeadlinePreservesRenderer) {
+  ASSERT_TRUE(embedded_test_server()->Start());
+  ASSERT_TRUE(
+      NavigateToURL(shell(), embedded_test_server()->GetURL("/title1.html")));
+  auto* host = shell()->web_contents()->GetPrimaryMainFrame()->GetProcess();
+  base::test::TestFuture<bool> result;
+  host->FenceDocumentCookiesForCheckpoint(base::TimeTicks::Now(),
+                                          result.GetCallback());
+  EXPECT_FALSE(result.IsReady());
+  EXPECT_FALSE(result.Get());
+  EXPECT_EQ(2, EvalJs(shell(), "1 + 1"));
+}
+
+IN_PROC_BROWSER_TEST_F(
+    RenderProcessHostTestBase,
+    DocumentCookieCheckpointRendererExitRejectsInflightFence) {
+  ASSERT_TRUE(embedded_test_server()->Start());
+  ASSERT_TRUE(
+      NavigateToURL(shell(), embedded_test_server()->GetURL("/title1.html")));
+  auto* host = shell()->web_contents()->GetPrimaryMainFrame()->GetProcess();
+  ScopedAllowRendererCrashes allow(host);
+  RenderProcessHostWatcher exit(
+      host, RenderProcessHostWatcher::WATCH_FOR_PROCESS_EXIT);
+  base::test::TestFuture<bool> result;
+  host->FenceDocumentCookiesForCheckpoint(
+      base::TimeTicks::Now() + base::Seconds(10), result.GetCallback());
+  ASSERT_TRUE(host->Shutdown(0));
+  exit.Wait();
+  EXPECT_FALSE(result.Get());
+}
+
+IN_PROC_BROWSER_TEST_F(
+    RenderProcessHostTestBase,
+    DocumentCookieCheckpointHungRendererUsesBrowserDeadline) {
+  ASSERT_TRUE(embedded_test_server()->Start());
+  ASSERT_TRUE(
+      NavigateToURL(shell(), embedded_test_server()->GetURL("/title1.html")));
+  auto* host = shell()->web_contents()->GetPrimaryMainFrame()->GetProcess();
+  ScopedAllowRendererCrashes allow(host);
+  DOMMessageQueue messages(shell()->web_contents());
+  ExecuteScriptAsync(
+      shell(),
+      "domAutomationController.send('checkpoint-busy'); while (true) {}");
+  std::string message;
+  ASSERT_TRUE(messages.WaitForMessage(&message));
+  ASSERT_EQ(JsReplace("$1", "checkpoint-busy"), message);
+  base::test::TestFuture<bool> result;
+  host->FenceDocumentCookiesForCheckpoint(
+      base::TimeTicks::Now() + base::Milliseconds(100), result.GetCallback());
+  EXPECT_FALSE(result.Get());
+  RenderProcessHostWatcher exit(
+      host, RenderProcessHostWatcher::WATCH_FOR_PROCESS_EXIT);
+  ASSERT_TRUE(host->Shutdown(0));
+  exit.Wait();
+}
+
+IN_PROC_BROWSER_TEST_F(RenderProcessHostTestBase,
+                       DocumentCookieCheckpointMultipleDocuments) {
+  ASSERT_TRUE(embedded_test_server()->Start());
+  ASSERT_TRUE(
+      NavigateToURL(shell(), embedded_test_server()->GetURL("/title1.html")));
+  ASSERT_EQ(true,
+            EvalJs(shell(),
+                   JsReplace(R"(
+    new Promise(resolve => {
+      const child = document.createElement('iframe');
+      child.onload = () => {
+        document.cookie = 'checkpoint-parent=1; SameSite=Lax';
+        child.contentDocument.cookie = 'checkpoint-child=1; SameSite=Lax';
+        resolve(true);
+      };
+      child.src = $1;
+      document.body.appendChild(child);
+    });
+  )",
+                             embedded_test_server()->GetURL("/title2.html"))));
+  auto* host = shell()->web_contents()->GetPrimaryMainFrame()->GetProcess();
+  base::test::TestFuture<bool> result;
+  host->FenceDocumentCookiesForCheckpoint(
+      base::TimeTicks::Now() + base::Seconds(10), result.GetCallback());
+  EXPECT_TRUE(result.Get());
+  EXPECT_EQ(true, EvalJs(shell(), R"(
+    document.cookie.includes('checkpoint-parent=1') &&
+    document.cookie.includes('checkpoint-child=1')
+  )"));
+}
