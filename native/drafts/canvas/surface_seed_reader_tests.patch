+TEST_P(DocumentLoaderTest, GlintSurfaceSeedReaderKeepsLegacyCanvasOnlyExplicit) {
+  frame_test_helpers::WebViewHelper helper;
+  helper.Initialize();
+  auto* frame = helper.LocalMainFrame();
+  auto params = GlintSurfaceFixtureParams();
+  params->glint_document_surface_policy_required = false;
+  params->glint_document_surface_policy.reset();
+  std::array<uint8_t, 32> expected;
+  expected.fill(61);
+  const auto encoding = params->storage_key.SerializeForNativePrivacy();
+  ASSERT_TRUE(encoding);
+  params->glint_document_canvas_commit = std::make_unique<GlintDocumentCanvasCommit>(
+      GlintDocumentCanvasCommit{1, *encoding, expected});
+  CommitGlintSurfaceFixture(frame, std::move(params));
+  auto canvas = glint::candidate::CanvasPartitionSeed(frame->GetFrame()->DomWindow());
+  ASSERT_TRUE(canvas.has_value());
+  EXPECT_EQ(canvas.value(), std::optional(expected));
+  auto audio = glint::candidate::SurfacePartitionSeed(frame->GetFrame()->DomWindow(),
+      glint::candidate::SurfaceSeedKind::kAudio);
+  ASSERT_TRUE(audio.has_value());
+  EXPECT_FALSE(audio.value());
+}
