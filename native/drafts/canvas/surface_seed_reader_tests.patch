+TEST_P(DocumentLoaderTest, GlintSurfaceSeedReaderOwnsAllFourIndependentDomains) {
+  frame_test_helpers::WebViewHelper helper;
+  helper.Initialize();
+  auto* frame = helper.LocalMainFrame();
+  CommitGlintSurfaceFixture(frame, GlintSurfaceFixtureParams());
+  const std::array kinds{glint::candidate::SurfaceSeedKind::kCanvas,
+                         glint::candidate::SurfaceSeedKind::kWebGL,
+                         glint::candidate::SurfaceSeedKind::kWebGPU,
+                         glint::candidate::SurfaceSeedKind::kAudio};
+  for (unsigned index = 0; index < kinds.size(); ++index) {
+    auto result = glint::candidate::SurfacePartitionSeed(frame->GetFrame()->DomWindow(), kinds[index]);
+    ASSERT_TRUE(result.has_value());
+    ASSERT_TRUE(result.value());
+    std::array<uint8_t, 32> expected;
+    expected.fill(index + 1);
+    EXPECT_EQ(*result.value(), expected);
+    result.value()->fill(255);
+    auto repeated = glint::candidate::SurfacePartitionSeed(frame->GetFrame()->DomWindow(), kinds[index]);
+    ASSERT_TRUE(repeated.has_value());
+    EXPECT_EQ(repeated.value(), std::optional(expected));
+  }
+}
