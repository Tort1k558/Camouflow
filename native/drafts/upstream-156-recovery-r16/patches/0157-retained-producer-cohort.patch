+ProfileProducerFence::Status ProfileProducerFence::CheckRetainedCohort() {
+  CHECK_CURRENTLY_ON(content::BrowserThread::UI);
+  if (!retain_cohort_) {
+    return Status::kInvalidScope;
+  }
+  if (!acknowledged_) {
+    return Status::kNotReady;
+  }
+  return Revalidate(Status::kAcknowledged);
+}
+
+void ProfileProducerFence::Deliver(Status status) {
+  status = Revalidate(status);
+  acknowledged_ = status == Status::kAcknowledged;
+  if (!retain_cohort_ || !acknowledged_) {
+    observations_.RemoveAllObservations();
+  }
   auto callback = std::move(callback_);
   std::move(callback).Run(
       Result{status, renderers_.size(), partitions_.size()});
diff --git a/content/browser/camouflow_native/glint/profile_producer_fence_unittest.cc b/content/browser/camouflow_native/glint/profile_producer_fence_unittest.cc
--- a/content/browser/camouflow_native/glint/profile_producer_fence_unittest.cc
