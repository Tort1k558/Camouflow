@@ -80,6 +80,71 @@
   content::TestBrowserContext context_;
 };
 
+TEST_F(ProfileProducerFenceTest,
+       RetainedCohortRequiresCompletedAcknowledgment) {
+  CheckpointHost host(&context_);
+  base::test::TestFuture<Result> result;
+  auto operation = ProfileProducerFence::Start(
+      &context_, Deadline(), result.GetCallback(),
+      ProfileProducerFence::ProducerScope::kLocalStorage, true);
+  EXPECT_EQ(operation->CheckRetainedCohort(), Status::kNotReady);
+  host.Reply(true);
+  EXPECT_EQ(result.Get().status, Status::kAcknowledged);
+  EXPECT_EQ(operation->CheckRetainedCohort(), Status::kAcknowledged);
+}
+
+TEST_F(ProfileProducerFenceTest, RetainedCohortRejectsRendererLossAfterAck) {
+  auto host = std::make_unique<CheckpointHost>(&context_);
+  base::test::TestFuture<Result> result;
+  auto operation = ProfileProducerFence::Start(
+      &context_, Deadline(), result.GetCallback(),
+      ProfileProducerFence::ProducerScope::kLocalStorage, true);
+  host->Reply(true);
+  ASSERT_EQ(result.Get().status, Status::kAcknowledged);
+  host.reset();
+  EXPECT_EQ(operation->CheckRetainedCohort(), Status::kTopologyChanged);
+}
+
+TEST_F(ProfileProducerFenceTest, RetainedCohortLatchesTransientNewRenderer) {
+  base::test::TestFuture<Result> result;
+  auto operation = ProfileProducerFence::Start(
+      &context_, Deadline(), result.GetCallback(),
+      ProfileProducerFence::ProducerScope::kLocalStorage, true);
+  ASSERT_EQ(result.Get().status, Status::kAcknowledged);
+  {
+    CheckpointHost transient(&context_);
+  }
+  EXPECT_EQ(operation->CheckRetainedCohort(), Status::kTopologyChanged);
+}
+
+TEST_F(ProfileProducerFenceTest, RetainedCohortRejectsNewPartitionAfterAck) {
+  base::test::TestFuture<Result> result;
+  auto operation = ProfileProducerFence::Start(
+      &context_, Deadline(), result.GetCallback(),
+      ProfileProducerFence::ProducerScope::kLocalStorage, true);
+  ASSERT_EQ(result.Get().status, Status::kAcknowledged);
+  ASSERT_NE(context_.GetDefaultStoragePartition(), nullptr);
+  EXPECT_EQ(operation->CheckRetainedCohort(), Status::kTopologyChanged);
+}
+
+TEST_F(ProfileProducerFenceTest, RetainedCohortKeepsOriginalDeadline) {
+  base::test::TestFuture<Result> result;
+  auto operation = ProfileProducerFence::Start(
+      &context_, Deadline(), result.GetCallback(),
+      ProfileProducerFence::ProducerScope::kLocalStorage, true);
+  ASSERT_EQ(result.Get().status, Status::kAcknowledged);
+  environment_.AdvanceClock(base::Seconds(5));
+  EXPECT_EQ(operation->CheckRetainedCohort(), Status::kTimedOut);
+}
+
+TEST_F(ProfileProducerFenceTest, DefaultOperationCannotAuthorizeBackendPhase) {
+  base::test::TestFuture<Result> result;
+  auto operation =
+      ProfileProducerFence::Start(&context_, Deadline(), result.GetCallback());
+  ASSERT_EQ(result.Get().status, Status::kAcknowledged);
+  EXPECT_EQ(operation->CheckRetainedCohort(), Status::kInvalidScope);
+}
