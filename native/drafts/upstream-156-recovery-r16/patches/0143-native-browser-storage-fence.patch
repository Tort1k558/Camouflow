+void RenderProcessHost::FenceLocalStorageForCheckpoint(
+    base::TimeTicks deadline,
+    base::OnceCallback<void(bool)> callback) {
+  base::BindPostTaskToCurrentDefault(std::move(callback)).Run(false);
