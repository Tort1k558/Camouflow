+
+void WebStorageCheckpoint::FenceLocalStorage(
+    base::TimeTicks deadline,
+    base::OnceCallback<void(bool)> callback) {
+  CHECK(Thread::MainThread()->IsCurrentThread());
+  CHECK(callback);
+  StorageController* existing = StorageController::GetExistingInstance();
+  auto reply = base::BindPostTaskToCurrentDefault(base::BindOnce(
+      [](StorageController* captured, base::TimeTicks deadline,
+         base::OnceCallback<void(bool)> callback, bool success) {
+        std::move(callback).Run(success && base::TimeTicks::Now() < deadline &&
+                                StorageController::GetExistingInstance() ==
+                                    captured);
+      },
+      existing, deadline, std::move(callback)));
+  if (deadline.is_max() || deadline <= base::TimeTicks::Now()) {
+    std::move(reply).Run(false);
+  } else if (existing) {
+    existing->FenceLocalStorageForCheckpoint(deadline, std::move(reply));
+  } else {
+    std::move(reply).Run(true);
+  }
 }
 
