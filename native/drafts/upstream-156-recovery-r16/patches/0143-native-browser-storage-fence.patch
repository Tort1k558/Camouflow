+void RenderThreadImpl::BindStorageCheckpoint(
+    mojo::PendingReceiver<mojom::StorageCheckpoint> receiver) {
+  if (storage_checkpoint_receivers_.size() >= 64) {
+    return;
+  }
+  storage_checkpoint_receivers_.Add(this, std::move(receiver));
+}
+
+void RenderThreadImpl::FenceLocalStorageForCheckpoint(
+    base::TimeTicks deadline,
+    FenceLocalStorageForCheckpointCallback callback) {
+  const bool admitted = !deadline.is_max() &&
+                        deadline > base::TimeTicks::Now() &&
+                        storage_checkpoint_calls_ < 64;
+  if (admitted) {
+    ++storage_checkpoint_calls_;
+  }
+  auto reply = base::BindPostTaskToCurrentDefault(base::BindOnce(
+      [](base::WeakPtr<RenderThreadImpl> owner, base::TimeTicks deadline,
+         bool admitted, FenceLocalStorageForCheckpointCallback callback,
+         bool success) {
+        if (owner && admitted) {
+          CHECK_GT(owner->storage_checkpoint_calls_, 0u);
+          --owner->storage_checkpoint_calls_;
+        }
+        std::move(callback).Run(success && owner &&
+                                base::TimeTicks::Now() < deadline);
+      },
+      weak_factory_.GetWeakPtr(), deadline, admitted, std::move(callback)));
+  if (!admitted) {
+    std::move(reply).Run(false);
+    return;
+  }
+  blink::WebStorageCheckpoint::FenceLocalStorage(
+      deadline,
+      mojo::WrapCallbackWithDefaultInvokeIfNotRun(std::move(reply), false));
+}
+
 void RenderThreadImpl::SetIsLockedToSite() {
   DCHECK(blink_platform_impl_);
   blink_platform_impl_->SetIsLockedToSite();
