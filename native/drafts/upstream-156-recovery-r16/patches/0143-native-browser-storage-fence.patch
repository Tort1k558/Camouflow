+
+void RenderProcessHostImpl::FenceLocalStorageForCheckpoint(
+    base::TimeTicks deadline,
+    base::OnceCallback<void(bool)> callback) {
+  CHECK_CURRENTLY_ON(BrowserThread::UI);
+  CHECK(callback);
+  auto owner = instance_weak_factory_.GetWeakPtr();
+  const bool admitted =
+      !deadline.is_max() && deadline > base::TimeTicks::Now() &&
+      IsInitializedAndNotDead() && IsReady() &&
+      renderer_interface_.is_bound() && storage_checkpoint_wire_calls_ < 64;
+  if (admitted && !storage_checkpoint_interface_.is_bound()) {
+    CHECK_LT(storage_checkpoint_interface_generation_,
+             std::numeric_limits<uint64_t>::max());
+    ++storage_checkpoint_interface_generation_;
+    BindReceiver(storage_checkpoint_interface_.BindNewPipeAndPassReceiver());
+    storage_checkpoint_interface_.reset_on_disconnect();
+  }
+  auto posted = base::BindPostTaskToCurrentDefault(base::BindOnce(
+      [](base::WeakPtr<RenderProcessHostImpl> owner, uint64_t generation,
+         base::TimeTicks deadline, base::OnceCallback<void(bool)> callback,
+         bool success) {
+        std::move(callback).Run(
+            success && owner &&
+            owner->storage_checkpoint_interface_generation_ == generation &&
+            owner->storage_checkpoint_interface_.is_bound() &&
+            owner->storage_checkpoint_interface_.is_connected() &&
+            owner->IsReady() && owner->IsInitializedAndNotDead() &&
+            base::TimeTicks::Now() < deadline);
+      },
+      owner, storage_checkpoint_interface_generation_, deadline,
+      std::move(callback)));
+  if (!admitted) {
+    std::move(posted).Run(false);
+    return;
+  }
+  ++storage_checkpoint_wire_calls_;
+  // Keep the wire slot until its callback settles, even after a deadline. A
+  // hung live renderer cannot accumulate unbounded timed-out Mojo callbacks.
+  base::ScopedClosureRunner slot(base::BindOnce(
+      [](base::WeakPtr<RenderProcessHostImpl> owner) {
+        if (owner) {
+          CHECK_GT(owner->storage_checkpoint_wire_calls_, 0u);
+          --owner->storage_checkpoint_wire_calls_;
+        }
+      },
+      owner));
+  using ReplyState = base::RefCountedData<base::OnceCallback<void(bool)>>;
+  auto reply = base::MakeRefCounted<ReplyState>(std::move(posted));
+  auto complete = [](scoped_refptr<ReplyState> state, bool success) {
+    if (state->data) {
+      std::move(state->data).Run(success);
+    }
+  };
+  auto timer = std::make_unique<base::OneShotTimer>();
+  timer->Start(FROM_HERE, deadline - base::TimeTicks::Now(),
+               base::BindOnce(complete, reply, false));
+  storage_checkpoint_interface_.QueryVersion(
+      mojo::WrapCallbackWithDefaultInvokeIfNotRun(
+          base::BindOnce(
+              [](base::WeakPtr<RenderProcessHostImpl> owner,
+                 uint64_t generation, base::TimeTicks deadline,
+                 scoped_refptr<ReplyState> reply,
+                 std::unique_ptr<base::OneShotTimer> timer,
+                 base::ScopedClosureRunner slot, uint32_t version) {
+                if (!reply->data) {
+                  return;
+                }
+                if (!owner ||
+                    owner->storage_checkpoint_interface_generation_ !=
+                        generation ||
+                    !owner->storage_checkpoint_interface_.is_bound() ||
+                    !owner->storage_checkpoint_interface_.is_connected() ||
+                    version < 1 || !owner->IsReady() ||
+                    !owner->IsInitializedAndNotDead() ||
+                    base::TimeTicks::Now() >= deadline) {
+                  timer->Stop();
+                  std::move(reply->data).Run(false);
+                  return;
+                }
+                owner->storage_checkpoint_interface_
+                    ->FenceLocalStorageForCheckpoint(
+                        deadline,
+                        mojo::WrapCallbackWithDefaultInvokeIfNotRun(
+                            base::BindOnce(
+                                [](scoped_refptr<ReplyState> reply,
+                                   std::unique_ptr<base::OneShotTimer> timer,
+                                   base::ScopedClosureRunner slot,
+                                   bool success) {
+                                  timer->Stop();
+                                  if (reply->data) {
+                                    std::move(reply->data).Run(success);
+                                  }
+                                },
+                                std::move(reply), std::move(timer),
+                                std::move(slot)),
+                            false));
+              },
+              owner, storage_checkpoint_interface_generation_, deadline, reply,
+              std::move(timer), std::move(slot)),
+          0u));
+}
