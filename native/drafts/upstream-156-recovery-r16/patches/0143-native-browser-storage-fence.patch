+import "mojo/public/mojom/base/time.mojom";
+import "sandbox/policy/mojom/context.mojom";
+
+// Separate browser-owned endpoint; the primordial Renderer protocol is unchanged.
+interface StorageCheckpoint {
+  // Producer acknowledgment only, not a database commit or profile checkpoint.
+  // Version 1 is deliberately required: an absent/old endpoint must fail closed.
+  [MinVersion=1, AllowedContext=sandbox.mojom.Context.kBrowser]
+  FenceLocalStorageForCheckpoint(mojo_base.mojom.TimeTicks deadline)
+      => (bool success);
+};
