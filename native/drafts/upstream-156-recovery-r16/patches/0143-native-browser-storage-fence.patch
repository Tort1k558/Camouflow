+IN_PROC_BROWSER_TEST_F(RenderProcessHostTestBase,
+                       CheckpointHungRendererUsesBrowserDeadline) {
+  ASSERT_TRUE(embedded_test_server()->Start());
+  ASSERT_TRUE(
+      NavigateToURL(shell(), embedded_test_server()->GetURL("/title1.html")));
+  auto* host = shell()->web_contents()->GetPrimaryMainFrame()->GetProcess();
+  ScopedAllowRendererCrashes allow(host);
+  DOMMessageQueue messages(shell()->web_contents());
+  ExecuteScriptAsync(
+      shell(),
+      "domAutomationController.send('checkpoint-busy'); while (true) {}");
+  std::string message;
+  ASSERT_TRUE(messages.WaitForMessage(&message));
+  ASSERT_EQ(JsReplace("$1", "checkpoint-busy"), message);
+  base::test::TestFuture<bool> result;
+  host->FenceLocalStorageForCheckpoint(
+      base::TimeTicks::Now() + base::Milliseconds(100), result.GetCallback());
+  EXPECT_FALSE(result.Get());
+  RenderProcessHostWatcher exit(
+      host, RenderProcessHostWatcher::WATCH_FOR_PROCESS_EXIT);
+  ASSERT_TRUE(host->Shutdown(0));
+  exit.Wait();
+}
