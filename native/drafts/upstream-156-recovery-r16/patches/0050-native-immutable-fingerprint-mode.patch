+TEST_F(NativePrivacyKeyServiceTest,
+       SelectedDefaultPreservesPartitionedPrivacy) {
+  PrivacyKeyService service;
+  ASSERT_TRUE(service.InitializeOwnedProfile(owned_.GetPath()));
+  tasks_.RunUntilIdle();
+  EXPECT_EQ(service.derivation_mode(),
+            content::NativeFingerprintDerivationMode::kPartitionedPrivacy);
+  const auto other = blink::StorageKey::CreateFirstParty(
+      url::Origin::Create(GURL("https://other.test")));
+  for (const auto* surface : {"canvas", "webgl", "webgpu", "audio"}) {
+    const auto selected = service.DeriveSelected(Partition(), surface);
+    ASSERT_TRUE(selected);
+    EXPECT_EQ(selected, service.Derive(Partition(), surface));
+    EXPECT_NE(selected, service.DeriveSelected(other, surface));
+    EXPECT_NE(selected, service.DeriveProfileIdentity(Partition(), surface));
+  }
+}
+
+TEST_F(NativePrivacyKeyServiceTest, SelectedIdentityIsStableAcrossPartitions) {
+  PrivacyKeyService service(
+      content::NativeFingerprintDerivationMode::kProfileIdentity);
+  ASSERT_TRUE(service.InitializeOwnedProfile(owned_.GetPath()));
+  tasks_.RunUntilIdle();
+  const auto other = blink::StorageKey::CreateFirstParty(
+      url::Origin::Create(GURL("https://other.test")));
+  for (const auto* surface : {"canvas", "webgl", "webgpu", "audio"}) {
+    const auto selected = service.DeriveSelected(Partition(), surface);
+    ASSERT_TRUE(selected);
+    EXPECT_EQ(selected, service.DeriveProfileIdentity(Partition(), surface));
+    EXPECT_EQ(selected, service.DeriveSelected(other, surface));
+    EXPECT_NE(selected, service.Derive(Partition(), surface));
+  }
+  EXPECT_FALSE(service.DeriveSelected(Partition(), "unknown"));
+}
+
+TEST_F(NativePrivacyKeyServiceTest,
+       SelectedModeRejectsUntilReadyAndAfterShutdown) {
+  PrivacyKeyService service(
+      content::NativeFingerprintDerivationMode::kProfileIdentity);
+  EXPECT_FALSE(service.DeriveSelected(Partition(), "canvas"));
+  ASSERT_TRUE(service.InitializeOwnedProfile(owned_.GetPath()));
+  EXPECT_EQ(service.state(), State::kLoading);
+  EXPECT_FALSE(service.DeriveSelected(Partition(), "canvas"));
+  tasks_.RunUntilIdle();
+  ASSERT_TRUE(service.DeriveSelected(Partition(), "canvas"));
+  service.Shutdown();
+  EXPECT_FALSE(service.DeriveSelected(Partition(), "canvas"));
+  EXPECT_FALSE(service.InitializeEphemeral());
+}
+
+TEST_F(NativePrivacyKeyServiceTest, InvalidModeRejectsBothInitializers) {
+  const auto invalid =
+      static_cast<content::NativeFingerprintDerivationMode>(99);
+  PrivacyKeyService service(invalid);
+  EXPECT_FALSE(service.InitializeOwnedProfile(owned_.GetPath()));
+  EXPECT_FALSE(service.InitializeEphemeral());
+  tasks_.RunUntilIdle();
+  EXPECT_EQ(service.state(), State::kUninitialized);
+  EXPECT_FALSE(service.DeriveSelected(Partition(), "canvas"));
+  std::string persisted;
+  ASSERT_TRUE(base::ReadFileToString(
+      owned_.GetPath().AppendASCII("camouflow-native-privacy.json"),
+      &persisted));
+  EXPECT_EQ(persisted, kIdentity);
+}
+
+TEST_F(NativePrivacyKeyServiceTest, InvalidModeDoesNotInstallAnOwnerService) {
+  struct Owner : base::SupportsUserData {};
+  Owner owner;
+  const auto invalid =
+      static_cast<content::NativeFingerprintDerivationMode>(-1);
+  EXPECT_FALSE(
+      PrivacyKeyService::InstallOwnedProfile(owner, owned_.GetPath(), invalid));
+  EXPECT_FALSE(PrivacyKeyService::InstallOwnedProfileBeforeFirstFrame(
+      owner, owned_.GetPath(), invalid));
+  EXPECT_FALSE(PrivacyKeyService::InstallEphemeral(owner, invalid));
+  EXPECT_EQ(PrivacyKeyService::GetForOwner(owner), nullptr);
+}
+
+TEST_F(NativePrivacyKeyServiceTest, InstalledModeCannotBeReplaced) {
+  struct Owner : base::SupportsUserData {};
+  Owner owner;
+  ASSERT_TRUE(PrivacyKeyService::InstallEphemeral(
+      owner, content::NativeFingerprintDerivationMode::kProfileIdentity));
+  auto* service = PrivacyKeyService::GetForOwner(owner);
+  ASSERT_NE(service, nullptr);
+  const auto selected = service->DeriveSelected(Partition(), "canvas");
+  ASSERT_TRUE(selected);
+  EXPECT_FALSE(PrivacyKeyService::InstallEphemeral(owner));
+  EXPECT_FALSE(PrivacyKeyService::InstallOwnedProfile(owner, owned_.GetPath()));
+  EXPECT_FALSE(PrivacyKeyService::InstallOwnedProfileBeforeFirstFrame(
+      owner, owned_.GetPath()));
+  EXPECT_EQ(PrivacyKeyService::GetForOwner(owner), service);
+  EXPECT_EQ(service->derivation_mode(),
+            content::NativeFingerprintDerivationMode::kProfileIdentity);
+  EXPECT_EQ(selected, service->DeriveSelected(Partition(), "canvas"));
+}
+
+TEST_F(NativePrivacyKeyServiceTest, SelectedIdentityReloadPreservesModeAndKey) {
+  PrivacyKeyService first(
+      content::NativeFingerprintDerivationMode::kProfileIdentity);
+  ASSERT_TRUE(first.InitializeOwnedProfile(owned_.GetPath()));
+  tasks_.RunUntilIdle();
+  const auto selected = first.DeriveSelected(Partition(), "canvas");
+  ASSERT_TRUE(selected);
+  first.Shutdown();
+  PrivacyKeyService restarted(
+      content::NativeFingerprintDerivationMode::kProfileIdentity);
+  ASSERT_TRUE(restarted.InitializeOwnedProfile(owned_.GetPath()));
+  tasks_.RunUntilIdle();
+  EXPECT_EQ(selected, restarted.DeriveSelected(Partition(), "canvas"));
+}
+
+TEST_F(NativePrivacyKeyServiceTest,
+       SelectedEphemeralIdentityOwnersStayIndependent) {
+  PrivacyKeyService first(
+      content::NativeFingerprintDerivationMode::kProfileIdentity);
+  PrivacyKeyService second(
+      content::NativeFingerprintDerivationMode::kProfileIdentity);
+  ASSERT_TRUE(first.InitializeEphemeral());
+  ASSERT_TRUE(second.InitializeEphemeral());
+  const auto selected = first.DeriveSelected(Partition(), "canvas");
+  ASSERT_TRUE(selected);
+  EXPECT_NE(selected, second.DeriveSelected(Partition(), "canvas"));
+  EXPECT_EQ(selected, first.DeriveSelected(Partition(), "canvas"));
+}
