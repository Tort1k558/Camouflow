+void RenderThreadImpl::FenceDocumentCookiesForCheckpoint(
+    base::TimeTicks deadline,
+    FenceDocumentCookiesForCheckpointCallback callback) {
+  const bool admitted =
+      !deadline.is_max() && deadline > base::TimeTicks::Now() &&
+      deadline - base::TimeTicks::Now() <= base::Seconds(30) &&
+      storage_checkpoint_calls_ < 64;
+  if (admitted) {
+    ++storage_checkpoint_calls_;
+  }
+  auto owner = weak_factory_.GetWeakPtr();
+  auto reply = base::BindOnce(
+      [](base::WeakPtr<RenderThreadImpl> owner, base::TimeTicks deadline,
+         bool admitted, FenceDocumentCookiesForCheckpointCallback callback,
+         bool success) {
+        if (owner && admitted) {
+          CHECK_GT(owner->storage_checkpoint_calls_, 0u);
+          --owner->storage_checkpoint_calls_;
+        }
+        std::move(callback).Run(success && owner &&
+                                base::TimeTicks::Now() < deadline);
+      },
+      owner, deadline, admitted, std::move(callback));
+  if (!admitted) {
+    base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE, base::BindOnce(std::move(reply), false));
+    return;
+  }
+  DocumentCookieCheckpoint::Run(
+      deadline,
+      base::BindRepeating(
+          [](base::WeakPtr<RenderThreadImpl> owner)
+              -> std::optional<DocumentCookieCheckpoint::Snapshot> {
+            return owner ? CaptureCookieDocuments() : std::nullopt;
+          },
+          owner),
+      base::BindRepeating(
+          [](base::WeakPtr<RenderThreadImpl> owner,
+             const blink::LocalFrameToken& frame,
+             const blink::DocumentToken& expected, base::TimeTicks deadline,
+             base::OnceCallback<void(bool)> callback) {
+            auto* web_frame =
+                owner ? blink::WebLocalFrame::FromFrameToken(frame) : nullptr;
+            if (!web_frame) {
+              std::move(callback).Run(false);
+              return;
+            }
+            auto document = web_frame->GetDocument();
+            if (document.IsNull() || !document.IsActive() ||
+                document.Token() != expected) {
+              std::move(callback).Run(false);
+              return;
+            }
+            document.DrainCookieWritesForCheckpoint(deadline,
+                                                    std::move(callback));
+          },
+          owner),
+      mojo::WrapCallbackWithDefaultInvokeIfNotRun(std::move(reply), false));
+}
