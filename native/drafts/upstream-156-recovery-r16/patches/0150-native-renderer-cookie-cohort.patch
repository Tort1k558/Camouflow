+#ifndef CONTENT_RENDERER_DOCUMENT_COOKIE_CHECKPOINT_H_
+#define CONTENT_RENDERER_DOCUMENT_COOKIE_CHECKPOINT_H_
+
+#include <cstddef>
+#include <cstdint>
+#include <memory>
+#include <optional>
+#include <utility>
+
+#include "base/check.h"
+#include "base/containers/flat_map.h"
+#include "base/functional/bind.h"
+#include "base/functional/callback.h"
+#include "base/location.h"
+#include "base/memory/ref_counted.h"
+#include "base/task/sequenced_task_runner.h"
+#include "base/time/time.h"
+#include "third_party/blink/public/common/tokens/tokens.h"
+
+namespace content {
+
+// Renderer-main-thread producer acknowledgment only. No cookie data, worker or
+// HTTP producers, backend flush or whole-profile durability is represented.
+class DocumentCookieCheckpoint
+    : public base::RefCounted<DocumentCookieCheckpoint> {
+ public:
+  static constexpr size_t kMaximumDocuments = 512;
+  struct Snapshot {
+    uint64_t epoch = 0;
+    base::flat_map<blink::LocalFrameToken, blink::DocumentToken> documents;
+    bool operator==(const Snapshot&) const = default;
+  };
+  using Capture = base::RepeatingCallback<std::optional<Snapshot>()>;
+  using Drain = base::RepeatingCallback<void(const blink::LocalFrameToken&,
+                                             const blink::DocumentToken&,
+                                             base::TimeTicks,
+                                             base::OnceCallback<void(bool)>)>;
+
+  static void Run(base::TimeTicks deadline,
+                  Capture capture,
+                  Drain drain,
+                  base::OnceCallback<void(bool)> callback) {
+    CHECK(capture);
+    CHECK(drain);
+    CHECK(callback);
+    auto request = base::WrapRefCounted(new DocumentCookieCheckpoint(
+        deadline, std::move(capture), std::move(drain), std::move(callback)));
+    request->Start();
+  }
+
+ private:
+  friend class base::RefCounted<DocumentCookieCheckpoint>;
+  struct Reply {
+    Reply(base::TimeTicks deadline, base::OnceCallback<void(bool)> callback)
+        : deadline(deadline), callback(std::move(callback)) {}
+    static void Complete(std::shared_ptr<Reply> reply, bool success) {
+      if (reply->callback) {
+        std::move(reply->callback)
+            .Run(success && base::TimeTicks::Now() < reply->deadline);
+      }
+    }
+    const base::TimeTicks deadline;
+    base::OnceCallback<void(bool)> callback;
+  };
+  DocumentCookieCheckpoint(base::TimeTicks deadline,
+                           Capture capture,
+                           Drain drain,
+                           base::OnceCallback<void(bool)> callback)
+      : deadline_(deadline),
+        capture_(std::move(capture)),
+        drain_(std::move(drain)),
+        reply_(std::make_shared<Reply>(deadline, std::move(callback))) {}
+  ~DocumentCookieCheckpoint() = default;
+
+  void Start() {
+    const auto now = base::TimeTicks::Now();
+    if (deadline_.is_max() || deadline_ <= now ||
+        deadline_ - now > base::Seconds(30)) {
+      Complete(false);
+      return;
+    }
+    snapshot_ = capture_.Run();
+    if (!snapshot_ || snapshot_->documents.size() > kMaximumDocuments) {
+      Complete(false);
+      return;
+    }
+    pending_ = snapshot_->documents.size();
+    const auto remaining = deadline_ - base::TimeTicks::Now();
+    if (remaining <= base::TimeDelta()) {
+      Complete(false);
+      return;
+    }
+    // The timeout owns only the reply, never a request/timer ownership cycle.
+    // Dropped document callbacks cannot suppress the caller's deadline reply.
+    base::SequencedTaskRunner::GetCurrentDefault()->PostDelayedTask(
+        FROM_HERE, base::BindOnce(&Reply::Complete, reply_, false), remaining);
+    if (pending_ == 0) {
+      Complete(true);
+      return;
+    }
+    for (const auto& [frame, document] : snapshot_->documents) {
+      if (delivery_scheduled_) {
+        break;
+      }
+      drain_.Run(frame, document, deadline_,
+                 base::BindOnce(&DocumentCookieCheckpoint::OnDocument,
+                                base::RetainedRef(this)));
+    }
+  }
+
+  void OnDocument(bool success) {
+    if (!reply_->callback || delivery_scheduled_) {
+      return;
+    }
+    if (!success) {
+      Complete(false);
+      return;
+    }
+    CHECK_GT(pending_, 0u);
+    if (--pending_ == 0) {
+      Complete(true);
+    }
+  }
+
+  void Complete(bool success) {
+    if (!reply_->callback || delivery_scheduled_) {
+      return;
+    }
+    delivery_scheduled_ = true;
+    base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE, base::BindOnce(&DocumentCookieCheckpoint::Deliver,
+                                  base::RetainedRef(this), success));
+  }
+
+  void Deliver(bool success) {
+    if (!reply_->callback) {
+      return;
+    }
+    // Recheck inside final posted delivery, not before posting it. This catches
+    // an early acknowledger writing while another document was still pending.
+    success = success && base::TimeTicks::Now() < deadline_ && snapshot_ &&
+              capture_.Run() == snapshot_;
+    Reply::Complete(reply_, success);
+  }
+
+  const base::TimeTicks deadline_;
+  Capture capture_;
+  Drain drain_;
+  const std::shared_ptr<Reply> reply_;
+  std::optional<Snapshot> snapshot_;
+  size_t pending_ = 0;
+  bool delivery_scheduled_ = false;
+};
+
+}  // namespace content
+#endif  // CONTENT_RENDERER_DOCUMENT_COOKIE_CHECKPOINT_H_
