+class DocumentCookieCheckpointTest : public testing::Test {
+ protected:
+  using Snapshot = DocumentCookieCheckpoint::Snapshot;
+  void AddDocument() {
+    snapshot->documents.emplace(blink::LocalFrameToken(),
+                                blink::DocumentToken());
+  }
+  void Start(base::test::TestFuture<bool>& done,
+             base::TimeTicks deadline = base::TimeTicks()) {
+    if (deadline.is_null()) {
+      deadline = base::TimeTicks::Now() + base::Seconds(5);
+    }
+    DocumentCookieCheckpoint::Run(
+        deadline, base::BindLambdaForTesting([this] {
+          tasks.AdvanceClock(capture_delay);
+          return snapshot;
+        }),
+        base::BindLambdaForTesting(
+            [this](const blink::LocalFrameToken&, const blink::DocumentToken&,
+                   base::TimeTicks, base::OnceCallback<void(bool)> callback) {
+              if (synchronous) {
+                std::move(callback).Run(true);
+              } else {
+                replies.push_back(std::move(callback));
+              }
+            }),
+        done.GetCallback());
+  }
+  base::test::TaskEnvironment tasks{
+      base::test::TaskEnvironment::TimeSource::MOCK_TIME};
+  std::optional<Snapshot> snapshot = Snapshot{};
+  std::vector<base::OnceCallback<void(bool)>> replies;
+  bool synchronous = false;
+  base::TimeDelta capture_delay;
+};
+
+TEST_F(DocumentCookieCheckpointTest, EmptyCohortIsRecheckedAndPosted) {
+  base::test::TestFuture<bool> done;
+  Start(done);
+  EXPECT_FALSE(done.IsReady());
+  EXPECT_TRUE(done.Get());
+}
+
+TEST_F(DocumentCookieCheckpointTest, OutOfOrderRepliesWaitForEveryDocument) {
+  AddDocument();
+  AddDocument();
+  base::test::TestFuture<bool> done;
+  Start(done);
+  ASSERT_EQ(2u, replies.size());
+  std::move(replies[1]).Run(true);
+  tasks.RunUntilIdle();
+  EXPECT_FALSE(done.IsReady());
+  std::move(replies[0]).Run(true);
+  EXPECT_TRUE(done.Get());
+}
+
