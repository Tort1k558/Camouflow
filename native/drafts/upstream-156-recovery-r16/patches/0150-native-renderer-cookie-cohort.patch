 namespace {
 
+class CookieDocumentSnapshotVisitor final : public RenderFrameVisitor {
+ public:
+  bool Visit(RenderFrame* frame) override {
+    auto* web_frame = frame->GetWebFrame();
+    if (!web_frame) {
+      valid = false;
+      return false;
+    }
+    auto document = web_frame->GetDocument();
+    if (document.IsNull() || !document.IsActive() ||
+        !document.IsCookieProducerAvailableForCheckpoint() ||
+        snapshot.documents.size() >=
+            DocumentCookieCheckpoint::kMaximumDocuments) {
+      valid = false;
+      return false;
+    }
+    const auto [entry, inserted] = snapshot.documents.emplace(
+        web_frame->GetLocalFrameToken(), document.Token());
+    valid = inserted;
+    return valid;
+  }
+  bool valid = true;
+  DocumentCookieCheckpoint::Snapshot snapshot;
+};
+
+std::optional<DocumentCookieCheckpoint::Snapshot> CaptureCookieDocuments() {
+  auto epoch = blink::WebDocument::CookieProducerEpochForCheckpoint();
+  if (!epoch) {
+    return std::nullopt;
+  }
+  CookieDocumentSnapshotVisitor visitor;
+  RenderFrame::ForEach(&visitor);
+  if (!visitor.valid ||
+      blink::WebDocument::CookieProducerEpochForCheckpoint() != epoch) {
+    return std::nullopt;
+  }
+  visitor.snapshot.epoch = *epoch;
+  return std::move(visitor.snapshot);
+}
