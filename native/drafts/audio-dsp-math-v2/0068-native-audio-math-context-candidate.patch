+
+glint::candidate::AudioMathPipelineResult CaptureGlintAudioMathPipeline(
+    ExecutionContext* context) {
+  using glint::candidate::AudioMathPipeline;
+  using glint::candidate::AudioMathPolicyError;
+  if (!base::FeatureList::IsEnabled(features::kGlintAudioMathCandidate)) {
+    return AudioMathPipeline::kLegacyReadback;
+  }
+  if (!context || context->IsContextDestroyed()) {
+    return base::unexpected(AudioMathPolicyError::kUnavailablePolicy);
+  }
+  auto seed = glint::candidate::SurfacePartitionSeed(
+      context, glint::candidate::SurfaceSeedKind::kAudio);
+  if (!seed.has_value() || !seed->has_value()) {
+    return base::unexpected(AudioMathPolicyError::kUnavailablePolicy);
+  }
+  constexpr char kDomain[] = "glint.audio.math.backend.v1";
+  const auto domain = base::as_byte_span(kDomain).first(sizeof(kDomain) - 1);
+  std::array<uint8_t, 32> digest{};
+  unsigned length = 0;
+  auto& key = seed->value();
+  const bool derived = HMAC(EVP_sha256(), key.data(), key.size(), domain.data(),
+                            domain.size(), digest.data(), &length) &&
+                       length == digest.size();
+  const auto selector = digest.front() & 1u;
+  OPENSSL_cleanse(key.data(), key.size());
+  OPENSSL_cleanse(digest.data(), digest.size());
+  if (!derived) {
+    return base::unexpected(AudioMathPolicyError::kDerivationFailed);
+  }
+  return selector ? AudioMathPipeline::kFloat32Math
+                  : AudioMathPipeline::kNativeMath;
 }
 
