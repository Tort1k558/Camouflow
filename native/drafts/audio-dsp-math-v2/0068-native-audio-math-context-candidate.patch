+TEST_F(OfflineAudioContextTest,
+       GlintMathDirectConstantDoesNotUseReadbackFarbling) {
+  base::test::ScopedFeatureList features;
+  features.InitAndEnableFeature(blink::features::kGlintAudioMathCandidate);
+  for (uint8_t seed : {3, 4, 5}) {
+    auto holder = GlintOfflineAudioPolicyHolder(true, seed);
+    ASSERT_TRUE(holder);
+    auto* context = OfflineAudioContext::Create(
+        holder->GetFrame().DomWindow(), 1, 128, 44100, ASSERT_NO_EXCEPTION);
+    ASSERT_TRUE(context);
+    V8TestingScope scope(std::move(holder));
+    auto* source = context->createConstantSource(ASSERT_NO_EXCEPTION);
+    ASSERT_TRUE(source);
+    source->offset()->setValue(0.25f);
+    source->connect(context->destination(), 0, 0, ASSERT_NO_EXCEPTION);
+    source->start(0, ASSERT_NO_EXCEPTION);
+    ScriptPromiseTester tester(
+        scope.GetScriptState(),
+        context->startOfflineRendering(scope.GetScriptState(),
+                                       ASSERT_NO_EXCEPTION));
+    tester.WaitUntilSettled();
+    ASSERT_TRUE(tester.IsFulfilled());
+    auto* buffer = ToScriptWrappable<AudioBuffer>(
+        scope.GetIsolate(), tester.Value().V8Value().As<v8::Object>());
+    ASSERT_TRUE(buffer);
+    ASSERT_EQ(buffer->length(), 128u);
+    for (float sample : buffer->getChannelData(0)->AsSpan()) {
+      EXPECT_EQ(sample, 0.25f);
+    }
+  }
+}
 
