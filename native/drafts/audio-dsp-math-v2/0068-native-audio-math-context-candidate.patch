+TEST_F(OfflineAudioContextTest,
+       GlintMathContextModesAreIndependentAndSeedUnchanged) {
+  base::test::ScopedFeatureList features;
+  features.InitAndEnableFeature(blink::features::kGlintAudioMathCandidate);
+  // Public fixed fixture bytes, not profile secrets. HMAC selectors are 1 and
+  // 0.
+  auto float_holder = GlintOfflineAudioPolicyHolder(true, 3);
+  auto native_holder = GlintOfflineAudioPolicyHolder(true, 4);
+  ASSERT_TRUE(float_holder);
+  ASSERT_TRUE(native_holder);
+  auto* float_context = OfflineAudioContext::Create(
+      float_holder->GetFrame().DomWindow(), 1, 128, 44100, ASSERT_NO_EXCEPTION);
+  auto* native_context =
+      OfflineAudioContext::Create(native_holder->GetFrame().DomWindow(), 1, 128,
+                                  44100, ASSERT_NO_EXCEPTION);
+  ASSERT_TRUE(float_context);
+  ASSERT_TRUE(native_context);
+  for (int i = 0; i < 3; ++i) {
+    EXPECT_EQ(float_context->GetGlintAudioMathPipeline(),
+              glint::candidate::AudioMathPipeline::kFloat32Math);
+    EXPECT_EQ(native_context->GetGlintAudioMathPipeline(),
+              glint::candidate::AudioMathPipeline::kNativeMath);
+  }
+  const auto float_seed = glint::candidate::SurfacePartitionSeed(
+      float_context->GetExecutionContext(),
+      glint::candidate::SurfaceSeedKind::kAudio);
+  const auto native_seed = glint::candidate::SurfacePartitionSeed(
+      native_context->GetExecutionContext(),
+      glint::candidate::SurfaceSeedKind::kAudio);
+  ASSERT_TRUE(float_seed.has_value() && float_seed->has_value());
+  ASSERT_TRUE(native_seed.has_value() && native_seed->has_value());
+  EXPECT_TRUE(
+      std::ranges::all_of(**float_seed, [](uint8_t v) { return v == 3; }));
+  EXPECT_TRUE(
+      std::ranges::all_of(**native_seed, [](uint8_t v) { return v == 4; }));
+  EXPECT_TRUE(float_context->createDynamicsCompressor(ASSERT_NO_EXCEPTION));
+  EXPECT_TRUE(native_context->createDynamicsCompressor(ASSERT_NO_EXCEPTION));
+}
