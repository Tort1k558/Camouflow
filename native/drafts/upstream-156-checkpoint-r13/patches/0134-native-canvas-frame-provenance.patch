+TEST(GlintCanvasFrameSourceTest, CommitmentBindsBothSourceKindAndOwnerSeed) {
+  std::array<uint8_t, 32> seed{};
+  blink::GlintCanvasFrameSource source{
+      blink::GlintCanvasFrameSourceKind::kWebGL, {}};
+  ASSERT_TRUE(ComputeCanvasFrameCommitment(source.kind, seed,
+                                          source.seed_commitment));
+  EXPECT_TRUE(MatchesCanvasFrameCommitment(source, seed));
+  auto wrong_kind = source;
+  wrong_kind.kind = blink::GlintCanvasFrameSourceKind::kWebGPU;
+  EXPECT_FALSE(MatchesCanvasFrameCommitment(wrong_kind, seed));
+  seed[0] = 1;
+  EXPECT_FALSE(MatchesCanvasFrameCommitment(source, seed));
+}
+
+TEST(GlintCanvasFrameSourceTest, MissingAndUnavailableDescriptorsAreNotProofs) {
+  const std::array<uint8_t, 32> seed{};
+  blink::GlintCanvasFrameSource source;
+  EXPECT_FALSE(MatchesCanvasFrameCommitment(source, seed));
+  source.kind = blink::GlintCanvasFrameSourceKind::kUnavailable;
+  EXPECT_FALSE(MatchesCanvasFrameCommitment(source, seed));
+}
+
+TEST(GlintCanvasFrameSourceTest, RetainedProofCannotRebindToAnotherOwner) {
+  const std::array<uint8_t, 32> old_seed{};
+  blink::GlintCanvasFrameSource retained{
+      blink::GlintCanvasFrameSourceKind::kWebGPU, {}};
+  ASSERT_TRUE(ComputeCanvasFrameCommitment(retained.kind, old_seed,
+                                          retained.seed_commitment));
+  const auto original = retained.seed_commitment;
+  auto new_seed = old_seed;
+  new_seed[31] = 1;
+  EXPECT_FALSE(MatchesCanvasFrameCommitment(retained, new_seed));
+  EXPECT_EQ(retained.seed_commitment, original);
+  EXPECT_TRUE(MatchesCanvasFrameCommitment(retained, old_seed));
+}
+
+TEST(GlintCanvasFrameSourceTest, NativeCanvasDescriptorCannotCarryGpuProof) {
+  blink::GlintCanvasFrameSource source;
+  EXPECT_FALSE(IsNativeCanvasFrameSource(source));
+  source.kind = blink::GlintCanvasFrameSourceKind::kNativeCanvas;
+  EXPECT_TRUE(IsNativeCanvasFrameSource(source));
+  source.seed_commitment[0] = 1;
+  EXPECT_FALSE(IsNativeCanvasFrameSource(source));
+}
