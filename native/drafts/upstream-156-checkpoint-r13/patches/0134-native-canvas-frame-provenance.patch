-    return std::optional<std::array<uint8_t, 32>>{};
+  if (frame && rendering->pipeline == CanvasPipeline::kRenderingV2) {
+    return CanvasFrameImageSourcePartitionSeed(owner, frame->GlintImageSource());
   }
   return CanvasExportPartitionSeed(
       owner, CanvasExportSurfaceForContext(source_context));
