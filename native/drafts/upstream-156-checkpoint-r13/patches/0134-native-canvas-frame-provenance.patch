+inline bool ComputeCanvasFrameCommitment(
+    blink::GlintCanvasFrameSourceKind kind,
+    const std::array<uint8_t, 32>& seed,
+    std::array<uint8_t, 32>& commitment) {
+  std::string_view domain;
+  switch (kind) {
+    case blink::GlintCanvasFrameSourceKind::kWebGL:
+      domain = "Glint.CanvasFrame.WebGL.v1";
+      break;
+    case blink::GlintCanvasFrameSourceKind::kWebGPU:
+      domain = "Glint.CanvasFrame.WebGPU.v1";
+      break;
+    default:
+      return false;
+  }
+  blink::Digestor digestor(blink::kHashAlgorithmSha256);
+  blink::DigestValue digest;
+  if (!digestor.Update(base::as_byte_span(domain)) ||
+      !digestor.Update(seed) || !digestor.Finish(digest) ||
+      digest.size() != commitment.size()) {
+    return false;
+  }
+  std::copy(digest.begin(), digest.end(), commitment.begin());
+  return true;
+}
+
+inline bool MatchesCanvasFrameCommitment(
+    const blink::GlintCanvasFrameSource& source,
+    const std::array<uint8_t, 32>& seed) {
+  std::array<uint8_t, 32> commitment{};
+  return ComputeCanvasFrameCommitment(source.kind, seed, commitment) &&
+         commitment == source.seed_commitment;
+}
+
+inline bool IsNativeCanvasFrameSource(
+    const blink::GlintCanvasFrameSource& source) {
+  return source.kind == blink::GlintCanvasFrameSourceKind::kNativeCanvas &&
+         std::all_of(source.seed_commitment.begin(), source.seed_commitment.end(),
+                     [](uint8_t value) { return value == 0; });
+}
+
+inline SurfaceSeedResult CanvasFrameImageSourcePartitionSeed(
+    blink::ExecutionContext* owner,
+    const blink::GlintCanvasFrameSource& source) {
+  // Explicit v2 requires a ready, owned profile-identity policy even when the
+  // source is 2D and its validated rendering result is intentionally raw.
+  auto canvas = CanvasPartitionSeed(owner);
+  if (!canvas.has_value() || canvas.value()) {
+    return base::unexpected(SurfaceSeedError::kInvalidPolicy);
+  }
+  if (IsNativeCanvasFrameSource(source)) {
+    return canvas;
+  }
+  CanvasExportSurface surface;
+  switch (source.kind) {
+    case blink::GlintCanvasFrameSourceKind::kWebGL:
+      surface = CanvasExportSurface::kWebGL;
+      break;
+    case blink::GlintCanvasFrameSourceKind::kWebGPU:
+      surface = CanvasExportSurface::kWebGPU;
+      break;
+    default:
+      return base::unexpected(SurfaceSeedError::kInvalidPolicy);
+  }
+  auto seed = CanvasExportPartitionSeed(owner, surface);
+  if (!seed.has_value() || !seed.value() ||
+      !MatchesCanvasFrameCommitment(source, *seed.value())) {
+    return base::unexpected(SurfaceSeedError::kInvalidPolicy);
+  }
+  return seed;
+}
+
 // Resolve against the source owner before detaching a GPU image. Canvas v1 and
 // ordinary 2D sources retain their existing drawing behaviour.
 inline SurfaceSeedResult CanvasImageSourcePartitionSeed(
     blink::ExecutionContext* owner,
+    const blink::CanvasRenderingContext* source_context,
+    const blink::ExportedCanvasResource* frame = nullptr) {
+  const auto rendering = CanvasRenderingPolicyForCommand(
+      *base::CommandLine::ForCurrentProcess());
+  if (!rendering) {
+    return base::unexpected(SurfaceSeedError::kInvalidPolicy);
+  }
+  if (rendering->pipeline != CanvasPipeline::kRenderingV2) {
+    return std::optional<std::array<uint8_t, 32>>{};
+  }
+  if (frame) {
+    return CanvasFrameImageSourcePartitionSeed(owner, frame->GlintImageSource());
+  }
+  if (!source_context ||
+      (!source_context->IsWebGL() && !source_context->IsWebGPU())) {
+    return std::optional<std::array<uint8_t, 32>>{};
+  }
+  return CanvasExportPartitionSeed(
+      owner, CanvasExportSurfaceForContext(source_context));
+}
+
+inline blink::GlintCanvasFrameSource CaptureCanvasFrameImageSource(
+    blink::ExecutionContext* owner,
     const blink::CanvasRenderingContext* source_context) {
   const auto rendering = CanvasRenderingPolicyForCommand(
       *base::CommandLine::ForCurrentProcess());
+  if (rendering && rendering->pipeline == CanvasPipeline::kReadbackV1) {
+    return {};
+  }
+  blink::GlintCanvasFrameSource source{
+      blink::GlintCanvasFrameSourceKind::kUnavailable, {}};
+  if (!rendering || !source_context) {
+    return source;
+  }
+  const auto canvas = CanvasPartitionSeed(owner);
+  if (!canvas.has_value() || canvas.value()) {
+    return source;
+  }
+  if (!source_context->IsWebGL() && !source_context->IsWebGPU()) {
+    source.kind = blink::GlintCanvasFrameSourceKind::kNativeCanvas;
+    return source;
+  }
+  const auto seed = CanvasImageSourcePartitionSeed(owner, source_context);
+  if (!seed.has_value() || !seed.value()) {
+    return source;
+  }
+  source.kind = source_context->IsWebGL()
+                    ? blink::GlintCanvasFrameSourceKind::kWebGL
+                    : blink::GlintCanvasFrameSourceKind::kWebGPU;
+  if (!ComputeCanvasFrameCommitment(source.kind, *seed.value(),
+                                    source.seed_commitment)) {
+    source.kind = blink::GlintCanvasFrameSourceKind::kUnavailable;
+    source.seed_commitment.fill(0);
+  }
+  return source;
+}
