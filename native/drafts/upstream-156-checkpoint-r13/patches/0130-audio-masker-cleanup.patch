+TEST(GlintOfflineAudioCandidateTest, DestructionCleansOwnedSeedAndDerivedCache) {
+  std::array<uint8_t, 32> seed;
+  seed.fill(27);
+  alignas(OfflineAudioMasker) std::byte storage[sizeof(OfflineAudioMasker)];
+  std::ranges::fill(storage, std::byte{0xa5});
+  auto* masker = std::construct_at(
+      reinterpret_cast<OfflineAudioMasker*>(storage), seed);
+  const auto transformed = masker->Transform(0.1234f);
+  std::destroy_at(masker);
+  EXPECT_TRUE(transformed.has_value());
+  EXPECT_TRUE(std::ranges::all_of(storage, [](std::byte value) {
+    return value == std::byte{0};
+  }));
+  EXPECT_TRUE(std::ranges::all_of(seed, [](uint8_t value) {
+    return value == 27;
+  }));
+}
+
+TEST(GlintOfflineAudioCandidateTest, CopiesAndMovesKeepIndependentOwnedState) {
+  OfflineAudioMasker survivor(kAudioSeed);
+  const auto expected = survivor.Transform(0.1234f);
+  ASSERT_TRUE(expected.has_value());
+  {
+    OfflineAudioMasker original(kAudioSeed);
+    EXPECT_EQ(original.Transform(0.1234f), expected);
+    OfflineAudioMasker copied(original);
+    survivor = copied;
+    OfflineAudioMasker moved(std::move(original));
+    copied = std::move(moved);
+    EXPECT_EQ(copied.Transform(0.1234f), expected);
+  }
+  EXPECT_EQ(survivor.Transform(0.1234f), expected);
+}
