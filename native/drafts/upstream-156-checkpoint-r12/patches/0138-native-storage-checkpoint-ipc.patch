+void StorageAreaImpl::FencePendingWrites(
+    AsyncDomStorageDatabase::StatusCallback callback) {
+  CHECK(callback);
+  auto reply = base::BindPostTaskToCurrentDefault(base::BindOnce(
+      [](base::WeakPtr<StorageAreaImpl> owner,
+         AsyncDomStorageDatabase::StatusCallback callback, DbStatus status) {
+        std::move(callback).Run(owner ? std::move(status)
+                                      : DbStatus::IOError("storage area lost"));
+      },
+      weak_ptr_factory_.GetWeakPtr(), std::move(callback)));
+  auto replies = base::SplitOnceCallback(std::move(reply));
+  base::ScopedClosureRunner abandoned(base::BindOnce(
+      std::move(replies.second), DbStatus::IOError("write fence abandoned")));
+  auto completed = base::BindOnce(
+      [](base::ScopedClosureRunner abandoned,
+         AsyncDomStorageDatabase::StatusCallback callback, DbStatus status) {
+        abandoned.Release().Reset();
+        std::move(callback).Run(std::move(status));
+      },
+      std::move(abandoned), std::move(replies.first));
+  if (has_pending_load_read_write_tasks()) {
+    LoadMap(OnLoadCompleteTask(
+        base::BindOnce(&StorageAreaImpl::FencePendingWrites,
+                       weak_ptr_factory_.GetWeakPtr(), std::move(completed)),
+        AccessMode::ReadWrite));
+    return;
+  }
+  std::move(completed).Run(
+      database_ ? DbStatus::OK() : DbStatus::IOError("no storage database"));
 }
 
