+void LocalStorageImpl::AdvanceCheckpointGeneration() {
+  CHECK_NE(checkpoint_generation_, std::numeric_limits<uint64_t>::max());
+  ++checkpoint_generation_;
+}
+
+void LocalStorageImpl::FlushForCheckpoint(FlushForCheckpointCallback callback) {
+  CHECK(callback);
+  if (connection_state_ != CONNECTION_FINISHED) {
+    auto replies = base::SplitOnceCallback(std::move(callback));
+    base::ScopedClosureRunner abandoned(
+        base::BindOnce(std::move(replies.second), false));
+    RunWhenConnected(base::BindOnce(
+        [](base::ScopedClosureRunner abandoned,
+           base::WeakPtr<LocalStorageImpl> owner,
+           FlushForCheckpointCallback callback) {
+          abandoned.Release().Reset();
+          if (owner) {
+            owner->FlushForCheckpoint(std::move(callback));
+          } else {
+            std::move(callback).Run(false);
+          }
+        },
+        std::move(abandoned), weak_ptr_factory_.GetWeakPtr(),
+        std::move(replies.first)));
+    return;
+  }
+  if (in_memory_ || !database_) {
+    std::move(callback).Run(false);
+    return;
+  }
+  auto reply = base::BindPostTaskToCurrentDefault(base::BindOnce(
+      [](base::WeakPtr<LocalStorageImpl> owner, uint64_t generation,
+         FlushForCheckpointCallback callback, bool success) {
+        std::move(callback).Run(success && owner &&
+                                owner->checkpoint_generation_ == generation &&
+                                !owner->in_memory_);
+      },
+      weak_ptr_factory_.GetWeakPtr(), checkpoint_generation_,
+      std::move(callback)));
+  auto replies = base::SplitOnceCallback(std::move(reply));
+  base::ScopedClosureRunner abandoned(
+      base::BindOnce(std::move(replies.second), false));
+  auto completed = base::BindOnce(
+      [](base::ScopedClosureRunner abandoned,
+         FlushForCheckpointCallback callback, bool success) {
+        abandoned.Release().Reset();
+        std::move(callback).Run(success);
+      },
+      std::move(abandoned), std::move(replies.first));
+  auto fenced = base::BarrierCallback<DbStatus>(
+      areas_.size(),
+      base::BindOnce(&LocalStorageImpl::OnCheckpointAreasFenced,
+                     weak_ptr_factory_.GetWeakPtr(), checkpoint_generation_,
+                     std::move(completed)));
+  for (const auto& [key, holder] : areas_) {
+    holder->storage_area()->FencePendingWrites(fenced);
+  }
+}
+
+void LocalStorageImpl::OnCheckpointAreasFenced(
+    uint64_t generation,
+    FlushForCheckpointCallback callback,
+    std::vector<DbStatus> statuses) {
+  if (generation != checkpoint_generation_ || in_memory_ || !database_ ||
+      !std::ranges::all_of(
+          statuses, [](const DbStatus& status) { return status.ok(); })) {
+    std::move(callback).Run(false);
+    return;
+  }
+  database_->CommitPendingMaps(base::BindOnce(
+      [](FlushForCheckpointCallback callback, DbStatus status) {
+        std::move(callback).Run(status.ok());
+      },
+      std::move(callback)));
+}
