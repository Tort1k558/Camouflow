+MaybeError Buffer::EnsureGlintAllocationInitialized(CommandRecordingContext* commandContext) {
+    DAWN_INTERNAL_ERROR_IF(!commandContext || !HasAccess() || !HasPrivateGlintReadbackBacking() ||
+        GetAllocatedSize() < GetSize() || GetAllocatedSize() != GetD3D12Resource()->GetDesc().Width ||
+        !GetDevice()->IsToggleEnabled(Toggle::LazyClearResourceOnFirstUse),
+        "Glint full allocation initialization requires private secure buffer backing.");
+    DAWN_ASSERT(GetDevice()->IsLockedByCurrentThreadIfNeeded());
+    DAWN_TRY(EnsureDataInitialized(commandContext));
+    // Logical full-overwrite initialization does not itself prove initialized padding.
+    if (GetAllocatedSize() > GetSize()) {
+        DAWN_TRY(ClearBuffer(commandContext, 0, GetSize(), GetAllocatedSize() - GetSize()));
+    }
+    return {};
+}
