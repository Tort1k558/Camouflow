+void CookieManager::FlushCookieStoreForCheckpoint(
+    FlushCookieStoreForCheckpointCallback callback) {
+  // This manager's cookie-store binding is immutable. Its weak lifetime also
+  // prevents a reply from acknowledging a replacement manager/context.
+  cookie_store_->FlushStoreForCheckpoint(
+      mojo::WrapCallbackWithDefaultInvokeIfNotRun(
+          base::BindPostTaskToCurrentDefault(base::BindOnce(
+              [](base::WeakPtr<CookieManager> owner,
+                 FlushCookieStoreForCheckpointCallback callback,
+                 bool success) { std::move(callback).Run(owner && success); },
+              weak_factory_.GetWeakPtr(), std::move(callback))),
+          false));
+}
