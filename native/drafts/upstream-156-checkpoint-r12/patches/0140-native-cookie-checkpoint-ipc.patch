+
+void CookieMonster::FlushStoreForCheckpoint(
+    base::OnceCallback<void(bool)> callback) {
+  DCHECK_CALLED_ON_VALID_THREAD(thread_checker_);
+  CHECK(callback);
+  auto reply = base::BindPostTaskToCurrentDefault(base::BindOnce(
+      [](base::WeakPtr<CookieMonster> owner,
+         base::OnceCallback<void(bool)> callback,
+         bool success) { std::move(callback).Run(owner && success); },
+      weak_ptr_factory_.GetWeakPtr(), std::move(callback)));
+  auto split = base::SplitOnceCallback(std::move(reply));
+  base::ScopedClosureRunner abandoned(
+      base::BindOnce(std::move(split.second), false));
+  // The existing global task queue drains received per-key mutations first.
+  // Keeping the guard in that queue rejects owner loss during asynchronous
+  // load.
+  DoCookieCallback(base::BindOnce(
+      [](CookieMonster* owner, base::OnceCallback<void(bool)> callback,
+         base::ScopedClosureRunner abandoned) {
+        if (!owner->store_) {
+          abandoned.RunAndReset();
+          return;
+        }
+        owner->store_->FlushForCheckpoint(base::BindOnce(
+            [](base::OnceCallback<void(bool)> callback,
+               base::ScopedClosureRunner abandoned, bool success) {
+              abandoned.Release().Reset();
+              std::move(callback).Run(success);
+            },
+            std::move(callback), std::move(abandoned)));
+      },
+      base::Unretained(this), std::move(split.first), std::move(abandoned)));
+}
+
 void CookieMonster::SetForceKeepSessionState() {
   DCHECK_CALLED_ON_VALID_THREAD(thread_checker_);
 
