+class TestReadbackFilter final : public BufferReadbackFilter,
+                                 public BufferReadbackFilterFactory,
+                                 public std::enable_shared_from_this<TestReadbackFilter> {
+  public:
+    bool enabled = true;
+    bool wrongSize = false;
+    BufferReadbackDisposition disposition = BufferReadbackDisposition::Protected;
+    size_t classifyCalls = 0;
+    size_t prepareCalls = 0;
+    uint64_t lastOffset = 0;
+    uint64_t lastSize = 0;
+    std::shared_ptr<BufferReadbackFilter> ForDevice(WGPUDevice) override {
+        return enabled ? shared_from_this() : nullptr;
+    }
+    BufferReadbackDisposition Classify(WGPUBuffer,
+                                       uint64_t bufferSize,
+                                       uint64_t offset,
+                                       uint64_t size) override {
+        ++classifyCalls;
+        EXPECT_EQ(bufferSize, 16u);
+        lastOffset = offset;
+        lastSize = size;
+        return disposition;
+    }
+    FilteredBufferReadback Prepare(WGPUBuffer,
+                                   uint64_t,
+                                   uint64_t,
+                                   std::span<const std::byte> original) override {
+        ++prepareCalls;
+        FilteredBufferReadback result;
+        result.disposition = disposition;
+        result.size = original.size() + (wrongSize ? 1 : 0);
+        result.bytes = std::make_unique<uint8_t[]>(result.size);
+        std::fill_n(result.bytes.get(), result.size, 0xe3);
+        return result;
+    }
+};
