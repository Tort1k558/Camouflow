+enum class BufferReadbackDisposition { Denied, Passthrough, Protected };
+struct FilteredBufferReadback {
+    BufferReadbackDisposition disposition = BufferReadbackDisposition::Denied;
+    std::unique_ptr<uint8_t[]> bytes;
+    size_t size = 0;
+};
+
+// Optional embedder policy. Implementations must synchronize spontaneous callbacks.
+// Non-null filters require private native backing before any GPU copy is recorded.
+class DAWN_WIRE_EXPORT BufferReadbackFilter {
+  public:
+    virtual ~BufferReadbackFilter() = default;
+    virtual BufferReadbackDisposition Classify(WGPUBuffer buffer,
+                                               uint64_t bufferSize,
+                                               uint64_t offset,
+                                               uint64_t size) = 0;
+    virtual FilteredBufferReadback Prepare(WGPUBuffer buffer,
+                                           uint64_t bufferSize,
+                                           uint64_t offset,
+                                           std::span<const std::byte> bytes) = 0;
+};
+class DAWN_WIRE_EXPORT BufferReadbackFilterFactory {
+  public:
+    virtual ~BufferReadbackFilterFactory() = default;
+    // Null means explicitly unprotected. A failed protected device must return a
+    // denying filter, never null. Install policy before exposing a device.
+    virtual std::shared_ptr<BufferReadbackFilter> ForDevice(WGPUDevice device) = 0;
+};
