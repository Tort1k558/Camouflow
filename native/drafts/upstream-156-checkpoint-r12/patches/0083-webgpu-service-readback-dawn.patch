+class WireFilteredReadbackTests : public WireTest {
+  protected:
+    std::shared_ptr<BufferReadbackFilterFactory> GetBufferReadbackFilterFactory() override {
+        return filter;
+    }
+    void SetUp() override {
+        WireTest::SetUp();
+        apiBuffer = api.GetNewBuffer();
+        raw.fill(0x23);
+    }
+    void TearDown() override {
+        buffer = nullptr;
+        WireTest::TearDown();
+    }
+    void CreateReadBuffer() {
+        wgpu::BufferDescriptor descriptor = {};
+        descriptor.size = raw.size();
+        descriptor.usage = wgpu::BufferUsage::MapRead | wgpu::BufferUsage::CopyDst;
+        buffer = device.CreateBuffer(&descriptor);
+        EXPECT_CALL(api, DeviceCreateBuffer(apiDevice, _)).WillOnce(Return(apiBuffer));
+        FlushClient();
+    }
+    void Read(size_t offset,
+              size_t size,
+              wgpu::MapAsyncStatus expected,
+              bool mappedRange,
+              WGPUMapAsyncStatus nativeStatus = WGPUMapAsyncStatus_Success) {
+        size_t callbacks = 0;
+        buffer.MapAsync(wgpu::MapMode::Read, offset, size, wgpu::CallbackMode::AllowSpontaneous,
+                        [&](wgpu::MapAsyncStatus status, wgpu::StringView) {
+                            EXPECT_EQ(status, expected);
+                            ++callbacks;
+                        });
+        EXPECT_CALL(api, OnBufferMapAsync(apiBuffer, WGPUMapMode_Read, offset, size, _, _))
+            .WillOnce(WithArg<5>([&](WGPUFuture future) {
+                api.CallBufferMapAsyncCallback(apiBuffer, nativeStatus, kEmptyOutputStringView,
+                                               future);
+            }));
+        if (mappedRange) {
+            EXPECT_CALL(api, BufferGetConstMappedRange(apiBuffer, offset, size))
+                .WillOnce(Return(raw.data() + offset));
+        } else {
+            EXPECT_CALL(api, BufferGetConstMappedRange(apiBuffer, _, _)).Times(0);
+        }
+        if (expected != wgpu::MapAsyncStatus::Success &&
+            nativeStatus == WGPUMapAsyncStatus_Success) {
+            EXPECT_CALL(api, BufferUnmap(apiBuffer)).Times(1);
+        }
+        FlushClient();
+        // The protected temporary has already been destroyed before client deserialization.
+        FlushServer();
+        EXPECT_EQ(callbacks, 1u);
+    }
+    std::shared_ptr<TestReadbackFilter> filter = std::make_shared<TestReadbackFilter>();
+    wgpu::Buffer buffer;
+    WGPUBuffer apiBuffer = nullptr;
+    std::array<uint8_t, 16> raw{};
+};
+
+TEST_F(WireFilteredReadbackTests, ProtectedBytesAreSerializedWithoutModifyingNativeInput) {
+    CreateReadBuffer();
+    Read(0, 16, wgpu::MapAsyncStatus::Success, true);
+    const auto* bytes = static_cast<const uint8_t*>(buffer.GetConstMappedRange());
+    ASSERT_NE(bytes, nullptr);
+    EXPECT_TRUE(std::all_of(bytes, bytes + 16, [](uint8_t v) { return v == 0xe3; }));
+    EXPECT_TRUE(std::all_of(raw.begin(), raw.end(), [](uint8_t v) { return v == 0x23; }));
+    EXPECT_EQ(filter->prepareCalls, 1u);
+}
+
+TEST_F(WireFilteredReadbackTests, ProtectedPartialMapPreservesAbsoluteOffset) {
+    CreateReadBuffer();
+    Read(8, 8, wgpu::MapAsyncStatus::Success, true);
+    const auto* bytes = static_cast<const uint8_t*>(buffer.GetConstMappedRange(8, 8));
+    ASSERT_NE(bytes, nullptr);
+    EXPECT_TRUE(std::all_of(bytes, bytes + 8, [](uint8_t v) { return v == 0xe3; }));
+    EXPECT_EQ(filter->lastOffset, 8u);
+    EXPECT_EQ(filter->lastSize, 8u);
+}
+
+TEST_F(WireFilteredReadbackTests, DenialDoesNotReadOrSerializeNativeBytes) {
+    filter->disposition = BufferReadbackDisposition::Denied;
+    CreateReadBuffer();
+    Read(0, 16, wgpu::MapAsyncStatus::Error, false);
+    EXPECT_EQ(filter->prepareCalls, 0u);
+    EXPECT_EQ(buffer.GetMapState(), wgpu::BufferMapState::Unmapped);
+}
+
+TEST_F(WireFilteredReadbackTests, WrongShadowSizeFailsClosed) {
+    filter->wrongSize = true;
+    CreateReadBuffer();
+    Read(0, 16, wgpu::MapAsyncStatus::Error, true);
+    EXPECT_EQ(filter->prepareCalls, 1u);
+    EXPECT_EQ(buffer.GetMapState(), wgpu::BufferMapState::Unmapped);
+}
+
+TEST_F(WireFilteredReadbackTests, UnprotectedDeviceRetainsExistingReadBehavior) {
+    filter->enabled = false;
+    CreateReadBuffer();
+    Read(0, 16, wgpu::MapAsyncStatus::Success, true);
+    const auto* bytes = static_cast<const uint8_t*>(buffer.GetConstMappedRange());
+    ASSERT_NE(bytes, nullptr);
+    EXPECT_TRUE(std::equal(raw.begin(), raw.end(), bytes));
+    EXPECT_EQ(filter->classifyCalls, 0u);
+    EXPECT_EQ(filter->prepareCalls, 0u);
+}
+
+TEST_F(WireFilteredReadbackTests, NativeMapFailureDoesNotInvokeFilter) {
+    CreateReadBuffer();
+    Read(0, 16, wgpu::MapAsyncStatus::Error, false, WGPUMapAsyncStatus_Error);
+    EXPECT_EQ(filter->classifyCalls, 0u);
+    EXPECT_EQ(filter->prepareCalls, 0u);
+}
