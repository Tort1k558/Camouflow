+TEST_F(GlintPassthroughAttachmentTest,
+       MetadataQueryPreservesPendingClientError) {
+  CreateAttachment(GL_RGBA8, 6, 5);
+  cmds::BindRenderbuffer invalid;
+  invalid.Init(GL_TEXTURE_2D, kClientRenderbufferId);
+  ASSERT_EQ(error::kNoError, ExecuteCmd(invalid));
+  const auto metadata = QueryAttachment();
+  ASSERT_TRUE(metadata);
+  EXPECT_EQ(metadata->width, 6);
+  EXPECT_EQ(metadata->height, 5);
+  EXPECT_EQ(GL_INVALID_ENUM, GetGLError());
+  EXPECT_EQ(GL_NO_ERROR, GetGLError());
+}
