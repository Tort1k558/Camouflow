+TEST_F(GlintPassthroughAttachmentTest,
+       CubeFaceAttachmentReportsNativeExtentsAndPreservesBinding) {
+  GenHelper<cmds::GenTexturesImmediate>(kClientTextureId);
+  DoBindTexture(GL_TEXTURE_CUBE_MAP, kClientTextureId);
+  for (GLenum face = GL_TEXTURE_CUBE_MAP_POSITIVE_X;
+       face <= GL_TEXTURE_CUBE_MAP_NEGATIVE_Z; ++face) {
+    DoTexImage2D(face, 0, GL_RGBA8, 4, 4, 0, GL_RGBA, GL_UNSIGNED_BYTE, 0, 0);
+  }
+  GenHelper<cmds::GenFramebuffersImmediate>(kClientFramebufferId);
+  DoBindFramebuffer(GL_FRAMEBUFFER, kClientFramebufferId);
+  DoFramebufferTexture2D(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0,
+                         GL_TEXTURE_CUBE_MAP_POSITIVE_Y, kClientTextureId, 0);
+  const GLuint other = kClientTextureId + 1;
+  GenHelper<cmds::GenTexturesImmediate>(other);
+  DoBindTexture(GL_TEXTURE_CUBE_MAP, other);
+  GLint before = 0;
+  DoGetIntegerv(GL_TEXTURE_BINDING_CUBE_MAP, &before, 1);
+  ASSERT_EQ(static_cast<GLint>(other), before);
+  ASSERT_EQ(GL_NO_ERROR, GetGLError());
+  const auto metadata = QueryAttachment();
+  ASSERT_TRUE(metadata);
+  EXPECT_EQ(metadata->width, 4);
+  EXPECT_EQ(metadata->height, 4);
+  EXPECT_EQ(metadata->internal_format, GL_RGBA8);
+  EXPECT_EQ(metadata->samples, 0);
+  EXPECT_TRUE(metadata->rgba8_compatible);
+  GLint after = 0;
+  DoGetIntegerv(GL_TEXTURE_BINDING_CUBE_MAP, &after, 1);
+  EXPECT_EQ(after, before);
+  EXPECT_EQ(GL_NO_ERROR, GetGLError());
+}
