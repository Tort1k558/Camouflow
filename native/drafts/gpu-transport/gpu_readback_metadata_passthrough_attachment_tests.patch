+TEST_F(GlintPassthroughAttachmentTest,
+       TextureReattachmentUsesSelectedObjectNotBoundTexture) {
+  GenHelper<cmds::GenTexturesImmediate>(kClientTextureId);
+  DoBindTexture(GL_TEXTURE_2D, kClientTextureId);
+  DoTexImage2D(GL_TEXTURE_2D, 0, GL_RGBA8, 8, 4, 0, GL_RGBA, GL_UNSIGNED_BYTE,
+               0, 0);
+  GenHelper<cmds::GenFramebuffersImmediate>(kClientFramebufferId);
+  DoBindFramebuffer(GL_FRAMEBUFFER, kClientFramebufferId);
+  DoFramebufferTexture2D(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D,
+                         kClientTextureId, 0);
+  const auto first = QueryAttachment();
+  ASSERT_TRUE(first);
+  EXPECT_EQ(first->width, 8);
+  EXPECT_EQ(first->height, 4);
+  const GLuint other = kClientTextureId + 1;
+  GenHelper<cmds::GenTexturesImmediate>(other);
+  DoBindTexture(GL_TEXTURE_2D, other);
+  DoTexImage2D(GL_TEXTURE_2D, 0, GL_RGBA8, 4, 7, 0, GL_RGBA, GL_UNSIGNED_BYTE,
+               0, 0);
+  DoFramebufferTexture2D(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D,
+                         other, 0);
+  DoBindTexture(GL_TEXTURE_2D, kClientTextureId);
+  ASSERT_EQ(GL_NO_ERROR, GetGLError());
+  const auto second = QueryAttachment();
+  ASSERT_TRUE(second);
+  EXPECT_EQ(second->width, 4);
+  EXPECT_EQ(second->height, 7);
+  EXPECT_EQ(second->internal_format, GL_RGBA8);
+  EXPECT_TRUE(second->rgba8_compatible);
+  GLint bound = 0;
+  DoGetIntegerv(GL_TEXTURE_BINDING_2D, &bound, 1);
+  EXPECT_EQ(bound, static_cast<GLint>(kClientTextureId));
+  EXPECT_EQ(GL_NO_ERROR, GetGLError());
+}
