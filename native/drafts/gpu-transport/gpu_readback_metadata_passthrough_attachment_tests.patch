+class GlintPassthroughAttachmentTest : public GLES3DecoderPassthroughTest {
+ protected:
+  void SetUp() override {
+    features_.InitAndEnableFeature(features::kGlintReadbackMetadataCandidate);
+    GLES3DecoderPassthroughTest::SetUp();
+  }
+
+  void CreateAttachment(GLenum format, GLsizei width, GLsizei height) {
+    GenHelper<cmds::GenRenderbuffersImmediate>(kClientRenderbufferId);
+    GenHelper<cmds::GenFramebuffersImmediate>(kClientFramebufferId);
+    DoBindFramebuffer(GL_FRAMEBUFFER, kClientFramebufferId);
+    DoBindRenderbuffer(GL_RENDERBUFFER, kClientRenderbufferId);
+    cmds::RenderbufferStorage storage;
+    storage.Init(GL_RENDERBUFFER, format, width, height);
+    ASSERT_EQ(error::kNoError, ExecuteCmd(storage));
+    DoFramebufferRenderbuffer(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0,
+                              GL_RENDERBUFFER, kClientRenderbufferId);
+    ASSERT_EQ(GL_NO_ERROR, GetGLError());
+  }
+
+  void CreateLayeredAttachment(GLenum target) {
+    GenHelper<cmds::GenTexturesImmediate>(kClientTextureId);
+    DoBindTexture(target, kClientTextureId);
+    cmds::TexImage3D image;
+    image.Init(target, 0, GL_RGBA8, 9, 3, 4, GL_RGBA, GL_UNSIGNED_BYTE, 0, 0);
+    ASSERT_EQ(error::kNoError, ExecuteCmd(image));
+    cmds::TexParameteri max_level;
+    max_level.Init(target, GL_TEXTURE_MAX_LEVEL, 0);
+    ASSERT_EQ(error::kNoError, ExecuteCmd(max_level));
+    GenHelper<cmds::GenFramebuffersImmediate>(kClientFramebufferId);
+    DoBindFramebuffer(GL_FRAMEBUFFER, kClientFramebufferId);
+    cmds::FramebufferTextureLayer attachment;
+    attachment.Init(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, kClientTextureId, 0,
+                    2);
+    ASSERT_EQ(error::kNoError, ExecuteCmd(attachment));
+    ASSERT_EQ(GL_NO_ERROR, GetGLError());
+  }
+
+  std::optional<GlintReadbackMetadata> QueryAttachment() {
+    using Command = cmds::GetGlintReadFramebufferMetadataCHROMIUM;
+    auto* result = GetSharedMemoryAs<Command::Result*>();
+    result->SetNumResults(0);
+    Command command;
+    command.Init(shared_memory_id_, kSharedMemoryOffset);
+    const auto status = ExecuteCmd(command);
+    EXPECT_EQ(error::kNoError, status);
+    if (status != error::kNoError) {
+      return std::nullopt;
+    }
+    EXPECT_EQ(result->GetNumResults(), kGlintReadbackMetadataValues);
+    if (result->GetNumResults() != kGlintReadbackMetadataValues) {
+      return std::nullopt;
+    }
+    return DecodeGlintReadbackMetadata(std::span<const GLint>(
+        result->GetData(), kGlintReadbackMetadataValues));
+  }
+
+ private:
+  base::test::ScopedFeatureList features_;
+};
+
+TEST_F(GlintPassthroughAttachmentTest,
+       ActualRgba8ExtentsPreserveRenderbufferBinding) {
+  CreateAttachment(GL_RGBA8, 9, 3);
+  const GLuint other = kClientRenderbufferId + 1;
+  GenHelper<cmds::GenRenderbuffersImmediate>(other);
+  DoBindRenderbuffer(GL_RENDERBUFFER, other);
+  GLint before = 0;
+  DoGetIntegerv(GL_RENDERBUFFER_BINDING, &before, 1);
+  ASSERT_EQ(static_cast<GLint>(other), before);
+  const auto metadata = QueryAttachment();
+  ASSERT_TRUE(metadata);
+  EXPECT_EQ(metadata->width, 9);
+  EXPECT_EQ(metadata->height, 3);
+  EXPECT_EQ(metadata->internal_format, GL_RGBA8);
+  EXPECT_EQ(metadata->samples, 0);
+  EXPECT_TRUE(metadata->rgba8_compatible);
+  GLint after = 0;
+  DoGetIntegerv(GL_RENDERBUFFER_BINDING, &after, 1);
+  EXPECT_EQ(after, before);
+  EXPECT_EQ(GL_NO_ERROR, GetGLError());
+}
+
+TEST_F(GlintPassthroughAttachmentTest,
+       RedefinedAttachmentUsesCurrentNativeDimensions) {
+  CreateAttachment(GL_RGBA8, 8, 4);
+  const auto first = QueryAttachment();
+  ASSERT_TRUE(first);
+  EXPECT_EQ(first->width, 8);
+  EXPECT_EQ(first->height, 4);
+  cmds::RenderbufferStorage storage;
+  storage.Init(GL_RENDERBUFFER, GL_RGBA8, 4, 7);
+  ASSERT_EQ(error::kNoError, ExecuteCmd(storage));
+  const auto second = QueryAttachment();
+  ASSERT_TRUE(second);
+  EXPECT_EQ(second->width, 4);
+  EXPECT_EQ(second->height, 7);
+  EXPECT_EQ(second->internal_format, GL_RGBA8);
+  EXPECT_TRUE(second->rgba8_compatible);
+  EXPECT_EQ(GL_NO_ERROR, GetGLError());
+}
+
