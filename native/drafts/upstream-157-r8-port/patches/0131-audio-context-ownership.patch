+    auto* original_buffer = context->destinationNode()->DestinationBuffer();
+    auto* listener = MakeGarbageCollected<GlintOfflineCompletionListener>(context, action);
+    context->addEventListener(event_type_names::kComplete, listener);
+    context->OnChunkRendered();
+    tester.WaitUntilSettled();
