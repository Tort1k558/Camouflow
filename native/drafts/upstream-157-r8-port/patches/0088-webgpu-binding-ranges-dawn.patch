   public:
     BindGroupStateTracker(Device* device, DescriptorHeapState* heapState)
         : Base(), mDevice(device), mHeapState(heapState) {}
+
+    void NotifyGlintComputeScope(const SyncScopeResourceUsage& scope,
+                                 BufferBase* indirectBuffer = nullptr,
+                                 uint64_t indirectOffset = 0) {
+        auto observer = mDevice->GetGlintReadbackObserver();
+        if (!observer) {
+            return;
+        }
+        std::vector<GlintShaderBufferUse> uses;
+        auto append = [&](BufferBase* buffer, uint64_t offset, uint64_t size,
+                          bool writable) {
+            if (!buffer || offset > buffer->GetSize() || size > buffer->GetSize() - offset ||
+                uses.size() == kGlintShaderBufferUseLimit) {
+                return false;
+            }
+            uses.push_back({{ToAPI(buffer), buffer->GetSize()}, true, writable,
+                            offset, size, true});
+            return true;
+        };
+        const auto mask = mPipeline->GetLayout()->GetBindGroupLayoutsMask();
+        for (BindGroupIndex groupIndex{0u}; groupIndex < kMaxBindGroupsTyped; ++groupIndex) {
+            if (!mask[groupIndex]) {
+                continue;
+            }
+            auto* group = mBindGroups[groupIndex];
+            if (!group) {
+                observer->OnShaderScope({});
+                return;
+            }
+            const auto* layout = group->GetLayout();
+            const auto dynamic = GetDynamicOffsets(groupIndex);
+            if (dynamic.size() != layout->GetDynamicBufferCount()) {
+                observer->OnShaderScope({});
+                return;
+            }
+            for (BindingIndex index : layout->GetBufferIndices()) {
+                const auto& info = layout->GetBindingInfo(index);
+                if (!(info.visibility & wgpu::ShaderStage::Compute)) {
+                    continue;
+                }
+                const auto& bindingInfo = std::get<BufferBindingInfo>(info.bindingLayout);
+                const auto binding = group->GetBindingAsBufferBinding(index);
+                uint64_t offset = binding.offset;
+                if (bindingInfo.hasDynamicOffset) {
+                    if (index >= dynamic.size() || !binding.buffer ||
+                        offset > binding.buffer->GetSize() ||
+                        dynamic[index] > binding.buffer->GetSize() - offset) {
+                        observer->OnShaderScope({});
+                        return;
+                    }
+                    offset += dynamic[index];
+                }
+                bool writable;
+                switch (bindingInfo.type) {
+                    case wgpu::BufferBindingType::Uniform:
+                    case wgpu::BufferBindingType::ReadOnlyStorage:
+                    case kInternalReadOnlyStorageBufferBinding:
+                        writable = false;
+                        break;
+                    case wgpu::BufferBindingType::Storage:
+                    case kInternalStorageBufferBinding:
+                        writable = true;
+                        break;
+                    default:
+                        observer->OnShaderScope({});
+                        return;
+                }
+                if (!append(binding.buffer, offset, binding.size, writable)) {
+                    observer->OnShaderScope({});
+                    return;
+                }
+            }
+            for (BindingIndex index : layout->GetTexelBufferIndices()) {
+                const auto& info = layout->GetBindingInfo(index);
+                if (!(info.visibility & wgpu::ShaderStage::Compute)) {
+                    continue;
+                }
+                const auto& bindingInfo = std::get<TexelBufferBindingInfo>(info.bindingLayout);
+                bool writable;
+                switch (bindingInfo.access) {
+                    case wgpu::TexelBufferAccess::ReadOnly:
+                        writable = false;
+                        break;
+                    case wgpu::TexelBufferAccess::ReadWrite:
+                        writable = true;
+                        break;
+                    default:
+                        observer->OnShaderScope({});
+                        return;
+                }
+                auto* view = group->GetBindingAsTexelBufferView(index);
+                if (!view || !append(view->GetBuffer(), view->GetOffset(), view->GetSize(), writable)) {
+                    observer->OnShaderScope({});
+                    return;
+                }
+            }
+        }
+        if (indirectBuffer && !append(indirectBuffer, indirectOffset, 3 * sizeof(uint32_t), false)) {
+            observer->OnShaderScope({});
+            return;
+        }
+        NotifyGlintShaderScope(mDevice, scope, false, uses, true);
+    }
 
