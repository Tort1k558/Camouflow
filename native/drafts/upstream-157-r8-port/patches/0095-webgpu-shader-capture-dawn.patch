+HRESULT TextureCapture::RecordBufferBudgeted(
+    ID3D12Device* device,
+    ID3D12GraphicsCommandList* commands,
+    ID3D12Resource* source,
+    uint64_t offset,
+    uint64_t size,
+    bool source_initialized,
+    ID3D12Fence* completion_fence,
+    uint64_t completion_value,
+    const std::shared_ptr<CaptureMemoryBudget>& budget,
+    std::unique_ptr<TextureCapture>* result) {
+    if (!result || *result || !device || !commands || !source || !completion_fence ||
+        !budget || budget->limit_bytes() == 0 || !source_initialized || size == 0 ||
+        completion_value == 0 || completion_value == std::numeric_limits<uint64_t>::max() ||
+        commands->GetType() != D3D12_COMMAND_LIST_TYPE_DIRECT) {
+        return E_INVALIDARG;
+    }
+    const auto desc = source->GetDesc();
+    if (desc.Dimension != D3D12_RESOURCE_DIMENSION_BUFFER || desc.Format != DXGI_FORMAT_UNKNOWN ||
+        offset > desc.Width || size > desc.Width - offset) {
+        return E_INVALIDARG;
+    }
+    if (size > 64 * 1024 * 1024 || size > std::numeric_limits<size_t>::max()) {
+        return E_OUTOFMEMORY;
+    }
+    const auto prior = completion_fence->GetCompletedValue();
+    if (prior == std::numeric_limits<uint64_t>::max()) return DXGI_ERROR_DEVICE_REMOVED;
+    if (prior >= completion_value) return E_INVALIDARG;
