+    HRESULT hr = source->GetDevice(IID_PPV_ARGS(&source_device));
+    if (FAILED(hr)) return hr;
+    hr = commands->GetDevice(IID_PPV_ARGS(&commands_device));
+    if (FAILED(hr)) return hr;
+    hr = completion_fence->GetDevice(IID_PPV_ARGS(&fence_device));
+    if (FAILED(hr)) return hr;
+    if (source_device.Get() != device || commands_device.Get() != device || fence_device.Get() != device) {
+        return E_INVALIDARG;
+    }
+    std::unique_ptr<TextureCapture> capture;
+    hr = AllocateReadback(device, source, completion_fence, completion_value, size,
+                          budget->limit_bytes(), budget, &capture);
+    if (FAILED(hr)) return hr;
+    commands->CopyBufferRegion(capture->resource_.Get(), 0, source, offset, size);
+    *result = std::move(capture);
+    return S_OK;
+}
