+ResultOrError<std::unique_ptr<GlintByteReadbackSnapshot>> RecordGlintNativeByteSnapshot(
+    Device* device,
+    CommandRecordingContext* context,
+    Buffer* source,
+    uint64_t offset,
+    uint64_t size) {
+    DAWN_INTERNAL_ERROR_IF(!device || !context || !source || source->GetDevice() != device ||
+                               !source->HasAccess() || !source->GetD3D12Resource() || size == 0 ||
+                               offset > source->GetSize() || size > source->GetSize() - offset,
+                           "Invalid Glint byte-capture source owner or range.");
+    DAWN_ASSERT(device->IsLockedByCurrentThreadIfNeeded());
+    DAWN_TRY(source->EnsureDataInitialized(context));
+    // Internal GPU copying does not expose a WebGPU CopySrc command or require that API usage.
+    source->TrackUsageAndTransitionNow(context, wgpu::BufferUsage::CopySrc);
+    auto* queue = ToBackend(device->GetQueue());
+    std::unique_ptr<glint::candidate::d3d12::TextureCapture> capture;
+    DAWN_TRY(CheckHRESULT(
+        glint::candidate::d3d12::TextureCapture::RecordBufferBudgeted(
+            device->GetD3D12Device(), context->GetCommandList(), source->GetD3D12Resource(), offset,
+            size, true, queue->GetSharedFence()->GetD3DFence(),
+            uint64_t{queue->GetPendingCommandSerial()}, device->GetGlintReadbackBudget(), &capture),
+        "Glint execution-bound byte capture"));
+    device->ReferenceUntilUnused(capture->retirement_handle());
+    context->AddGlintReadbackSubmission(capture->submission_marker());
+    return std::unique_ptr<GlintByteReadbackSnapshot>(
+        new NativeGlintByteReadbackSnapshot(std::move(capture), size));
+}
 }  // namespace dawn::native::d3d12
