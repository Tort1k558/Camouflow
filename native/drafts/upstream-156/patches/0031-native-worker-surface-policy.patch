+  StartSurface();
+  receiver_.reset();
+  tasks_.RunUntilIdle();
+  ExpectSurfaceError(Error::kDisconnected);
+  tasks_.FastForwardBy(base::Seconds(11));
+  EXPECT_EQ(completions_, 1);
+}
+TEST_F(NativePrivacyWorkerSurfaceBootstrapTest, DeadlineRejectsLateSnapshot) {
+  StartSurface();
+  tasks_.FastForwardBy(base::Seconds(11));
+  ExpectSurfaceError(Error::kTimedOut);
+  ReplySurface(Status::kReady, ValidSurfacePolicy());
+  EXPECT_EQ(completions_, 1);
+}
+TEST_F(NativePrivacyWorkerSurfaceBootstrapTest, DestructionDropsPendingReply) {
+  StartSurface();
+  bootstrap_.reset();
+  ReplySurface(Status::kReady, ValidSurfacePolicy());
+  tasks_.FastForwardBy(base::Seconds(11));
+  EXPECT_EQ(completions_, 0);
+}
+TEST_F(NativePrivacyWorkerSurfaceBootstrapTest, MissingPipeReturnsTypedFailure) {
+  PrivacyWorkerBootstrap bootstrap{mojo::PendingRemote<blink::mojom::NativePrivacyWorker>()};
+  bootstrap.StartSurfacePolicy(selected_partition_, base::BindLambdaForTesting(
+      [&](PrivacyWorkerBootstrap::SurfaceResult result) {
+        ++completions_;
+        surface_result_ = std::move(result);
+      }));
+  ExpectSurfaceError(Error::kDisconnected);
+  EXPECT_EQ(requests_, 0);
+}
+TEST_F(NativePrivacyWorkerSurfaceBootstrapTest, ReadyCallbackCanDestroyConsumer) {
+  StartSurface(true);
+  ReplySurface(Status::kReady, ValidSurfacePolicy());
+  EXPECT_FALSE(bootstrap_);
+  ASSERT_TRUE(surface_result_);
+  EXPECT_TRUE(surface_result_->has_value());
+  tasks_.FastForwardBy(base::Seconds(11));
+  EXPECT_EQ(completions_, 1);
+}
+TEST_F(NativePrivacyWorkerSurfaceBootstrapTest, FailureCallbackCanDestroyConsumer) {
+  StartSurface(true);
+  ReplySurface(Status::kUnavailable, nullptr);
+  EXPECT_FALSE(bootstrap_);
+  ExpectSurfaceError(Error::kUnavailable);
+}
+TEST_F(NativePrivacyWorkerSurfaceBootstrapTest, DeadlineCallbackCanDestroyConsumer) {
+  StartSurface(true);
+  tasks_.FastForwardBy(base::Seconds(11));
+  EXPECT_FALSE(bootstrap_);
+  ExpectSurfaceError(Error::kTimedOut);
+  ReplySurface(Status::kReady, ValidSurfacePolicy());
+  EXPECT_EQ(completions_, 1);
+}
+TEST_F(NativePrivacyWorkerSurfaceBootstrapTest, OpaquePartitionPreservesOwnedIdentity) {
+  selected_partition_ = blink::StorageKey::CreateFirstParty(url::Origin());
+  StartSurface();
+  ReplySurface(Status::kReady, ValidSurfacePolicy());
+  ASSERT_TRUE(surface_result_);
+  ASSERT_TRUE(surface_result_->has_value());
+  EXPECT_TRUE(glint::candidate::ValidateSurfacePolicy(surface_result_->value().policy, selected_partition_));
+}
+TEST_F(NativePrivacyWorkerSurfaceBootstrapTest, OriginOnlyRequestOwnsBrowserPartition) {
+  StartSurface(false, true);
+  ReplySurface(Status::kReady, ValidSurfacePolicy());
+  ASSERT_TRUE(surface_result_);
+  ASSERT_TRUE(surface_result_->has_value());
+  EXPECT_EQ(surface_result_->value().partition.SerializeForNativePrivacy(),
+            selected_partition_.SerializeForNativePrivacy());
+}
+TEST_F(NativePrivacyWorkerSurfaceBootstrapTest, FlagsSelectExactlyOneExplicitMode) {
+  using Mode = WorkerPrivacyBootstrapMode;
+  EXPECT_EQ(SelectWorkerPrivacyBootstrapMode(false, false), Mode::kOff);
+  EXPECT_EQ(SelectWorkerPrivacyBootstrapMode(true, false), Mode::kCanvas);
+  EXPECT_EQ(SelectWorkerPrivacyBootstrapMode(false, true), Mode::kSurfaces);
+  EXPECT_EQ(SelectWorkerPrivacyBootstrapMode(true, true), Mode::kConflict);
+}
+TEST_F(NativePrivacyWorkerSurfaceBootstrapTest, OffModeRejectsUnexpectedBootstrapData) {
+  using Mode = WorkerPrivacyBootstrapMode;
+  EXPECT_TRUE(IsWorkerPrivacyBootstrapReady(Mode::kOff, false, false));
+  EXPECT_FALSE(IsWorkerPrivacyBootstrapReady(Mode::kOff, true, false));
+  EXPECT_FALSE(IsWorkerPrivacyBootstrapReady(Mode::kOff, false, true));
+}
+TEST_F(NativePrivacyWorkerSurfaceBootstrapTest, CanvasModeCannotUseSurfaceFallback) {
+  using Mode = WorkerPrivacyBootstrapMode;
+  EXPECT_TRUE(IsWorkerPrivacyBootstrapReady(Mode::kCanvas, true, false));
+  EXPECT_FALSE(IsWorkerPrivacyBootstrapReady(Mode::kCanvas, false, true));
+  EXPECT_FALSE(IsWorkerPrivacyBootstrapReady(Mode::kCanvas, true, true));
+  EXPECT_FALSE(IsWorkerPrivacyBootstrapReady(Mode::kCanvas, false, false));
+}
+TEST_F(NativePrivacyWorkerSurfaceBootstrapTest, SurfaceModeCannotUseCanvasFallback) {
+  using Mode = WorkerPrivacyBootstrapMode;
+  EXPECT_TRUE(IsWorkerPrivacyBootstrapReady(Mode::kSurfaces, false, true));
+  EXPECT_FALSE(IsWorkerPrivacyBootstrapReady(Mode::kSurfaces, true, false));
+  EXPECT_FALSE(IsWorkerPrivacyBootstrapReady(Mode::kSurfaces, true, true));
+  EXPECT_FALSE(IsWorkerPrivacyBootstrapReady(Mode::kSurfaces, false, false));
+}
+TEST_F(NativePrivacyWorkerSurfaceBootstrapTest, ConflictAndUnknownModeNeverBecomeReady) {
+  EXPECT_FALSE(IsWorkerPrivacyBootstrapReady(WorkerPrivacyBootstrapMode::kConflict, true, true));
+  EXPECT_FALSE(IsWorkerPrivacyBootstrapReady(static_cast<WorkerPrivacyBootstrapMode>(255), false, false));
+}
