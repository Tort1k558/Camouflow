+  frame->SetCssZoomFactor(1.25f);
+  EXPECT_DOUBLE_EQ(frame->DevicePixelRatio(),
+                   3 * WebView().ZoomLevelToZoomFactor(1) * 1.25);
+  EXPECT_FLOAT_EQ(widget->GetScreenInfo().device_scale_factor, 1);
+}
