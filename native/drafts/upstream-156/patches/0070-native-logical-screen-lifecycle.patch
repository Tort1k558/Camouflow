+TEST_F(WebFrameWidgetSimTest, GlintMainLogicalDprFollowsLatestSnapshot) {
+  LoadURL("about:blank");
+  auto* widget = WebView().MainFrameViewWidget();
+  auto properties = GlintLogicalMainScreenPropertiesForTesting();
+  for (float factor : {3.f, 2.f, 1.f, 1.25f}) {
+    properties.glint_logical_screen_infos->mutable_current().device_scale_factor =
+        factor;
+    widget->ApplyVisualProperties(properties);
+    WebView().GetPage()->SetInspectorDeviceScaleFactorOverride(0.5f);
+    EXPECT_DOUBLE_EQ(GetDocument().GetFrame()->DevicePixelRatio(), factor);
+    EXPECT_FLOAT_EQ(widget->GetScreenInfo().device_scale_factor, 1);
+    EXPECT_EQ(widget->GetScreenInfo().rect, gfx::Rect(800, 600));
+  }
+}
