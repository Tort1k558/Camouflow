+TEST_F(WebFrameWidgetImplRemoteFrameSimTest,
+       GlintLogicalRemoteDprIgnoresForeignInspectorAndKeepsZoom) {
+  auto* widget = LocalFrameRootWidget();
+  widget->ApplyVisualProperties(GlintLogicalMainScreenPropertiesForTesting());
+  auto* frame = LocalFrameRoot().GetFrame();
+  for (float factor : {0.5f, 1.f, 2.f, 4.f}) {
