+VisualProperties GlintLogicalMainScreenPropertiesForTesting() {
+  VisualProperties result;
+  display::ScreenInfo physical;
+  physical.device_scale_factor = 1;
+  physical.rect = gfx::Rect(800, 600);
+  physical.available_rect = physical.rect;
+  result.screen_infos = display::ScreenInfos(physical);
+  result.glint_logical_screen_infos = result.screen_infos;
+  result.glint_logical_screen_infos->mutable_current().device_scale_factor = 3;
+  result.glint_logical_screen_infos->mutable_current().rect =
+      gfx::Rect(390, 844);
+  result.glint_logical_screen_infos->mutable_current().available_rect =
+      gfx::Rect(390, 844);
+  result.new_size_device_px = gfx::Size(800, 600);
+  result.visible_viewport_size_device_px = result.new_size_device_px;
+  result.compositor_viewport_pixel_rect = gfx::Rect(result.new_size_device_px);
+  viz::ParentLocalSurfaceIdAllocator allocator;
+  allocator.GenerateId();
+  result.local_surface_id = allocator.GetCurrentLocalSurfaceId();
+  return result;
+}
+
+}  // namespace
+
+TEST_F(WebFrameWidgetSimTest,
+       GlintMainLogicalDprIgnoresForeignPageInspectorState) {
+  LoadURL("about:blank");
+  auto* widget = WebView().MainFrameViewWidget();
+  widget->ApplyVisualProperties(GlintLogicalMainScreenPropertiesForTesting());
+  for (float foreign : {0.5f, 1.f, 2.f, 4.f}) {
+    WebView().GetPage()->SetInspectorDeviceScaleFactorOverride(foreign);
+    EXPECT_DOUBLE_EQ(GetDocument().GetFrame()->DevicePixelRatio(), 3);
+    EXPECT_FLOAT_EQ(widget->GetScreenInfo().device_scale_factor, 1);
+  }
+}
+
+TEST_F(WebFrameWidgetSimTest, GlintMainLogicalDprTracksWidgetZoomAndCss) {
+  LoadURL("about:blank");
+  auto* widget = WebView().MainFrameViewWidget();
+  widget->ApplyVisualProperties(GlintLogicalMainScreenPropertiesForTesting());
+  widget->SetZoomLevel(1);
+  GetDocument().GetFrame()->SetCssZoomFactor(1.25f);
+  WebView().GetPage()->SetInspectorDeviceScaleFactorOverride(0.5f);
+  EXPECT_DOUBLE_EQ(GetDocument().GetFrame()->DevicePixelRatio(),
+                   3 * WebView().ZoomLevelToZoomFactor(1) * 1.25);
+}
+
+TEST_F(WebFrameWidgetSimTest, GlintClearedMainDprRestoresNativeInspectorRules) {
+  LoadURL("about:blank");
+  auto properties = GlintLogicalMainScreenPropertiesForTesting();
+  auto* widget = WebView().MainFrameViewWidget();
+  widget->ApplyVisualProperties(properties);
+  ASSERT_TRUE(widget->GlintLogicalRootDevicePixelRatio());
+  properties.glint_logical_screen_infos.reset();
+  widget->ApplyVisualProperties(properties);
+  EXPECT_FALSE(widget->GlintLogicalRootDevicePixelRatio());
+  WebView().GetPage()->SetInspectorDeviceScaleFactorOverride(2);
+  EXPECT_DOUBLE_EQ(GetDocument().GetFrame()->DevicePixelRatio(),
+                   2 * GetDocument().GetFrame()->LayoutZoomFactor());
+}
