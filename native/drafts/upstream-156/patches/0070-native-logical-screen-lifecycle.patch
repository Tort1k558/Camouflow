+TEST_F(WebFrameWidgetImplRemoteFrameSimTest,
+       GlintLogicalScreenUpdatePreservesPhysicalCompositorMetrics) {
+  auto* widget = LocalFrameRootWidget();
+  auto properties = GlintLogicalMainScreenPropertiesForTesting();
+  properties.glint_logical_screen_infos->mutable_current().available_rect =
+      gfx::Rect(390, 844);
+  widget->ApplyVisualProperties(properties);
+  EXPECT_EQ(widget->GlintWebExposedScreenInfos().current().rect,
+            gfx::Rect(390, 844));
+  EXPECT_EQ(widget->GlintWebExposedScreenInfos().current().available_rect,
+            gfx::Rect(390, 844));
+  EXPECT_FLOAT_EQ(widget->GlintWebExposedScreenInfos()
+                      .current()
+                      .device_scale_factor,
+                  3);
+  properties.glint_logical_screen_infos->mutable_current().rect =
+      gfx::Rect(1280, 720);
+  properties.glint_logical_screen_infos->mutable_current().available_rect =
+      gfx::Rect(10, 20, 1200, 680);
+  properties.glint_logical_screen_infos->mutable_current().device_scale_factor =
+      2;
+  widget->ApplyVisualProperties(properties);
+  EXPECT_EQ(widget->GlintWebExposedScreenInfos().current().rect,
+            gfx::Rect(1280, 720));
+  EXPECT_EQ(widget->GlintWebExposedScreenInfos().current().available_rect,
+            gfx::Rect(10, 20, 1200, 680));
+  ASSERT_TRUE(widget->GlintLogicalRootDevicePixelRatio());
+  EXPECT_DOUBLE_EQ(*widget->GlintLogicalRootDevicePixelRatio(), 2);
+  EXPECT_EQ(widget->GetScreenInfo().rect, gfx::Rect(800, 600));
+  EXPECT_EQ(widget->GetScreenInfo().available_rect, gfx::Rect(800, 600));
+  EXPECT_FLOAT_EQ(widget->GetScreenInfo().device_scale_factor, 1);
+}
+
+TEST_F(WebFrameWidgetImplRemoteFrameSimTest,
+       GlintLogicalScreenClearRestoresNativeSnapshot) {
+  auto* widget = LocalFrameRootWidget();
+  auto properties = GlintLogicalMainScreenPropertiesForTesting();
+  widget->ApplyVisualProperties(properties);
+  ASSERT_TRUE(widget->GlintLogicalRootDevicePixelRatio());
+  properties.glint_logical_screen_infos.reset();
+  widget->ApplyVisualProperties(properties);
+  EXPECT_FALSE(widget->GlintLogicalRootDevicePixelRatio());
+  EXPECT_EQ(widget->GlintWebExposedScreenInfos(), properties.screen_infos);
+  properties.screen_infos.mutable_current().rect = gfx::Rect(1024, 768);
+  properties.screen_infos.mutable_current().available_rect = gfx::Rect(1024, 740);
+  properties.screen_infos.mutable_current().device_scale_factor = 1.25;
+  widget->ApplyVisualProperties(properties);
+  EXPECT_EQ(widget->GlintWebExposedScreenInfos(), properties.screen_infos);
+  EXPECT_FALSE(widget->GlintLogicalRootDevicePixelRatio());
+}
