@@ -0,0 +1,153 @@
+// Copyright 2026 CamouFlow contributors.
+// SPDX-License-Identifier: MIT
+#include "third_party/blink/public/common/widget/glint_logical_screen.h"
+
+#include <limits>
+
+#include "mojo/public/cpp/test_support/test_utils.h"
+#include "testing/gtest/include/gtest/gtest.h"
+#include "third_party/blink/public/common/widget/visual_properties.h"
+#include "third_party/blink/public/common/widget/visual_properties_mojom_traits.h"
+#include "third_party/blink/public/mojom/widget/visual_properties.mojom.h"
+
+namespace blink {
+namespace {
+
+display::ScreenInfos OriginalScreens() {
+  display::ScreenInfo info;
+  info.display_id = 7;
+  info.rect = gfx::Rect(100, 50, 1920, 1080);
+  info.available_rect = gfx::Rect(100, 50, 1920, 1040);
+  info.device_scale_factor = 1.25f;
+  return display::ScreenInfos(info);
+}
+
+TEST(GlintLogicalScreenTest, DesktopExplicitScreenDoesNotMutatePhysicalState) {
+  const auto original = OriginalScreens();
+  DeviceEmulationParams params;
+  params.screen_size = gfx::Size(1366, 768);
+  params.device_scale_factor = 2;
+  const auto logical =
+      GlintEmulatedScreenInfos(original, params, gfx::Size(800, 600));
+  EXPECT_EQ(logical.current().rect, gfx::Rect(1366, 768));
+  EXPECT_EQ(logical.current().available_rect, logical.current().rect);
+  EXPECT_EQ(logical.current().device_scale_factor, 2);
+  EXPECT_EQ(original, OriginalScreens());
+  EXPECT_EQ(original.current().device_scale_factor, 1.25f);
+}
+
+TEST(GlintLogicalScreenTest, DesktopDefaultRetainsOriginalScreenAndDsf) {
+  const auto original = OriginalScreens();
+  const auto logical = GlintEmulatedScreenInfos(
+      original, DeviceEmulationParams(), gfx::Size(320, 240));
+  EXPECT_EQ(logical.current().rect, original.current().rect);
+  EXPECT_EQ(logical.current().device_scale_factor, 1.25f);
+}
+
+TEST(GlintLogicalScreenTest, MobileDefaultUsesTopLevelViewportNotChildSize) {
+  DeviceEmulationParams params;
+  params.screen_type = mojom::EmulatedScreenType::kMobile;
+  params.view_size = gfx::Size(390, 844);
+  params.device_scale_factor = 3;
+  const auto size = GlintEmulatedWidgetSize(gfx::Size(800, 600), params);
+  const auto logical =
+      GlintEmulatedScreenInfos(OriginalScreens(), params, size);
+  EXPECT_EQ(logical.current().rect, gfx::Rect(390, 844));
+  EXPECT_EQ(logical.current().device_scale_factor, 3);
+}
+
+TEST(GlintLogicalScreenTest, MobilePositionAndExplicitScreenAreDistinct) {
+  DeviceEmulationParams params;
+  params.screen_type = mojom::EmulatedScreenType::kMobile;
+  params.view_position = gfx::Point(10, 20);
+  auto logical =
+      GlintEmulatedScreenInfos(OriginalScreens(), params, gfx::Size(390, 844));
+  EXPECT_EQ(logical.current().rect, gfx::Rect(10, 20, 390, 844));
+  params.screen_size = gfx::Size(1080, 1920);
+  logical =
+      GlintEmulatedScreenInfos(OriginalScreens(), params, gfx::Size(390, 844));
+  EXPECT_EQ(logical.current().rect, gfx::Rect(1080, 1920));
+}
+
+TEST(GlintLogicalScreenTest, PartialViewportAndScaleUseExistingRoundingRules) {
+  DeviceEmulationParams params;
+  params.scale = 2;
+  params.view_size.set_width(390);
+  EXPECT_EQ(GlintEmulatedWidgetSize(gfx::Size(801, 601), params),
+            gfx::Size(390, 301));
+  params.view_size = gfx::Size();
+  EXPECT_EQ(GlintEmulatedWidgetSize(gfx::Size(801, 601), params),
+            gfx::Size(401, 301));
+}
+
+TEST(GlintLogicalScreenTest, OrientationDoesNotRewritePhysicalOrOtherDisplays) {
+  auto original = OriginalScreens();
+  auto other = original.current();
+  other.display_id = 8;
+  other.rect = gfx::Rect(2020, 50, 1280, 720);
+  original.screen_infos.push_back(other);
+  DeviceEmulationParams params;
+  params.screen_orientation_type =
+      display::mojom::ScreenOrientation::kPortraitPrimary;
+  params.screen_orientation_angle = 90;
+  const auto logical =
+      GlintEmulatedScreenInfos(original, params, gfx::Size(390, 844));
+  EXPECT_EQ(logical.current().orientation_type, params.screen_orientation_type);
+  EXPECT_EQ(logical.current().orientation_angle, 90);
+  EXPECT_EQ(logical.screen_infos[1], other);
+  EXPECT_EQ(original.current().rect, OriginalScreens().current().rect);
+}
+
+TEST(GlintLogicalScreenTest,
+     OptionalOverrideRoundTripsWithoutChangingPhysical) {
+  VisualProperties input;
+  input.screen_infos = OriginalScreens();
+  DeviceEmulationParams params;
+  params.screen_size = gfx::Size(390, 844);
+  params.device_scale_factor = 3;
+  input.glint_logical_screen_infos =
+      GlintEmulatedScreenInfos(input.screen_infos, params, gfx::Size(390, 844));
+  VisualProperties output;
+  ASSERT_TRUE(mojo::test::SerializeAndDeserialize<mojom::VisualProperties>(
+      input, output));
+  EXPECT_EQ(input, output);
+  EXPECT_EQ(output.screen_infos.current().device_scale_factor, 1.25f);
+  ASSERT_TRUE(output.glint_logical_screen_infos);
+  EXPECT_EQ(output.glint_logical_screen_infos->current().device_scale_factor,
+            3);
+  input.glint_logical_screen_infos.reset();
+  ASSERT_TRUE(mojo::test::SerializeAndDeserialize<mojom::VisualProperties>(
+      input, output));
+  EXPECT_FALSE(output.glint_logical_screen_infos);
+}
+
+TEST(GlintLogicalScreenTest, InvalidLogicalScaleIsRejectedByIpc) {
+  for (float scale : {0.f, -1.f, std::numeric_limits<float>::infinity(),
+                      std::numeric_limits<float>::quiet_NaN()}) {
+    VisualProperties input;
+    input.screen_infos = OriginalScreens();
+    input.glint_logical_screen_infos = OriginalScreens();
+    input.glint_logical_screen_infos->mutable_current().device_scale_factor =
+        scale;
+    VisualProperties output;
+    EXPECT_FALSE(mojo::test::SerializeAndDeserialize<mojom::VisualProperties>(
+        input, output));
+  }
+}
+
+TEST(GlintLogicalScreenTest, IndependentValuesAndDisableCompareDifferently) {
+  VisualProperties a;
+  a.screen_infos = OriginalScreens();
+  VisualProperties b = a;
+  b.glint_logical_screen_infos = OriginalScreens();
+  EXPECT_NE(a, b);
+  VisualProperties c = b;
+  c.glint_logical_screen_infos->mutable_current().rect = gfx::Rect(390, 844);
+  EXPECT_NE(b, c);
+  EXPECT_EQ(b.screen_infos, c.screen_infos);
+  c.glint_logical_screen_infos.reset();
+  EXPECT_EQ(a, c);
+}
+
+}  // namespace
+}  // namespace blink
