+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+#ifndef THIRD_PARTY_BLINK_PUBLIC_COMMON_WIDGET_GLINT_LOGICAL_SCREEN_H_
+#define THIRD_PARTY_BLINK_PUBLIC_COMMON_WIDGET_GLINT_LOGICAL_SCREEN_H_
+
+#include "base/numerics/safe_conversions.h"
+#include "third_party/blink/public/common/widget/device_emulation_params.h"
+#include "ui/display/screen_infos.h"
+
+namespace blink {
+
+inline gfx::Size GlintEmulatedWidgetSize(const gfx::Size& original,
+                                         const DeviceEmulationParams& params) {
+  return gfx::Size(params.view_size.width()
+                       ? params.view_size.width()
+                       : base::ClampRound(original.width() / params.scale),
+                   params.view_size.height()
+                       ? params.view_size.height()
+                       : base::ClampRound(original.height() / params.scale));
+}
+
+// Logical DOM/CSS data only. Never use this as compositor or input geometry.
+inline display::ScreenInfos GlintEmulatedScreenInfos(
+    const display::ScreenInfos& original,
+    const DeviceEmulationParams& params,
+    const gfx::Size& emulated_widget_size) {
+  display::ScreenInfos result = original;
+  auto& screen = result.mutable_current();
+  const bool mobile = params.screen_type == mojom::EmulatedScreenType::kMobile;
+  if (!params.screen_size.IsEmpty()) {
+    screen.rect = gfx::Rect(params.screen_size);
+  } else if (mobile) {
+    screen.rect = gfx::Rect(params.view_position.value_or(gfx::Point()),
+                            emulated_widget_size);
+  }
+  screen.available_rect = screen.rect;
+  if (params.device_scale_factor)
+    screen.device_scale_factor = params.device_scale_factor;
+  if (params.screen_orientation_type !=
+      display::mojom::ScreenOrientation::kUndefined) {
+    screen.orientation_type = params.screen_orientation_type;
+    screen.orientation_angle = params.screen_orientation_angle;
+  }
+  return result;
+}
+
+}  // namespace blink
+
+#endif  // THIRD_PARTY_BLINK_PUBLIC_COMMON_WIDGET_GLINT_LOGICAL_SCREEN_H_
