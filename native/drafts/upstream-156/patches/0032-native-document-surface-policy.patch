+  EXPECT_FALSE(ValidateDocumentSurfacePolicy(owned, partition_, false, false));
+}
+
+TEST_F(GlintDocumentSurfacePolicyTest, FinalDifferentOriginCannotInstall) {
+  const auto other = blink::StorageKey::CreateFirstParty(
