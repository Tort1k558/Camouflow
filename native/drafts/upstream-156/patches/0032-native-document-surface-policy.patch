+std::optional<glint::candidate::DocumentSurfacePolicy> GlintSurfaceSnapshot(
+    const StorageKey& partition) {
+  auto encoding = partition.SerializeForNativePrivacy();
+  if (!encoding) {
+    return std::nullopt;
+  }
+  glint::candidate::SurfacePolicy policy;
+  policy.partition_encoding = *encoding;
+  policy.canvas.fill(1);
+  policy.webgl.fill(2);
+  policy.webgpu.fill(3);
+  policy.audio.fill(4);
+  return glint::candidate::DocumentSurfacePolicy{partition, std::move(policy)};
+}
+
+std::unique_ptr<WebNavigationParams> GlintSurfaceFixtureParams(
+    std::string_view html = kGlintSurfaceInlineHtml) {
+  const KURL url(NullUrl(), "https://surface.test/document");
+  auto params = WebNavigationParams::CreateWithHTMLStringForTesting(base::span(html), WebURL(url));
+  params->origin_to_commit = WebSecurityOrigin::Create(WebURL(url));
+  params->storage_key = StorageKey::CreateFirstParty(url::Origin::Create(GURL("https://surface.test/")));
+  params->glint_document_surface_policy_required = true;
+  params->glint_document_surface_policy = GlintSurfaceSnapshot(params->storage_key);
+  return params;
+}
+
+void CommitGlintSurfaceFixture(WebLocalFrameImpl* frame,
+                              std::unique_ptr<WebNavigationParams> params) {
+  frame->GetFrame()->Loader().CommitNavigation(std::move(params), nullptr);
+  frame_test_helpers::PumpPendingRequestsForFrameToLoad(frame);
+}
+
+void ExpectRejectedGlintSurfaceFixture(WebLocalFrameImpl* frame,
+                                     std::unique_ptr<WebNavigationParams> params) {
+  CommitGlintSurfaceFixture(frame, std::move(params));
+  const auto* document = frame->GetFrame()->GetDocument();
+  EXPECT_TRUE(document->GlintSurfacePolicyRequired());
+  EXPECT_FALSE(document->GlintSurfacePolicyReady());
+  EXPECT_FALSE(document->GlintCanvasPartitionSeed());
+  EXPECT_FALSE(document->GlintWebGLPartitionSeed());
+  EXPECT_FALSE(document->GlintWebGPUPartitionSeed());
+  EXPECT_FALSE(document->GlintAudioPartitionSeed());
+  EXPECT_TRUE(document->title().empty());
+  EXPECT_FALSE(frame->GetFrame()->DomWindow()->CanExecuteScripts(kAboutToExecuteScript));
+}
