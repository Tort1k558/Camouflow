+class GlintSurfaceBeforeScriptClient final : public frame_test_helpers::TestWebFrameClient {
+ public:
+  void Observe(WebLocalFrameImpl* frame) { frame_ = frame; }
+  void DidCreateScriptContext(v8::Local<v8::Context>, int32_t world_id) override {
+    if (world_id == DOMWrapperWorld::kMainWorldId) Record();
+  }
+  void DidClearWindowObject() override { Record(); }
+  std::vector<glint::candidate::DocumentSurfacePolicy> snapshots;
+  std::vector<String> titles;
+  std::vector<bool> readiness;
+
+ private:
+  void Record() {
+    if (!frame_ || !frame_->GetFrame()) return;
+    const auto* document = frame_->GetFrame()->GetDocument();
+    if (document->Url() != KURL(NullUrl(), "https://surface.test/document")) return;
+    readiness.push_back(document->GlintSurfacePolicyReady());
+    titles.push_back(document->title());
+    if (document->GlintSurfacePolicy()) snapshots.push_back(*document->GlintSurfacePolicy());
+  }
+  WeakPersistent<WebLocalFrameImpl> frame_;
+};
