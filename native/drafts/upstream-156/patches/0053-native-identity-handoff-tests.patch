+TEST_P(DocumentLoaderTest, GlintIdentityModeOwnedBeforeFirstInlineScript) {
+  GlintSurfaceBeforeScriptClient client;
+  frame_test_helpers::WebViewHelper helper;
+  helper.Initialize(&client);
+  auto* frame = helper.LocalMainFrame();
+  client.Observe(frame);
+  auto params = GlintSurfaceFixtureParams();
+  ASSERT_TRUE(params->glint_document_surface_policy);
+  params->glint_document_surface_policy->policy.identity_mode =
+      glint::candidate::SurfaceIdentityMode::kProfileIdentity;
+  const auto expected = *params->glint_document_surface_policy;
+  CommitGlintSurfaceFixture(frame, std::move(params));
+  ASSERT_FALSE(client.snapshots.empty());
+  ASSERT_EQ(client.snapshots.size(), client.titles.size());
+  ASSERT_EQ(client.snapshots.size(), client.readiness.size());
+  for (size_t i = 0; i < client.snapshots.size(); ++i) {
+    EXPECT_TRUE(client.readiness[i]);
+    EXPECT_TRUE(client.titles[i].empty());
+    EXPECT_EQ(client.snapshots[i].policy.identity_mode,
+              glint::candidate::SurfaceIdentityMode::kProfileIdentity);
+    EXPECT_EQ(client.snapshots[i].policy.canvas, expected.policy.canvas);
+    EXPECT_EQ(client.snapshots[i].policy.audio, expected.policy.audio);
+  }
+  EXPECT_EQ(frame->GetFrame()->GetDocument()->title(),
+            "glint-surface-inline-ok");
+  client.Observe(nullptr);
+}
+
+TEST_P(DocumentLoaderTest,
+       GlintIdentityModeCloneCannotMutateInstalledDocument) {
+  frame_test_helpers::WebViewHelper helper;
+  helper.Initialize();
+  auto* frame = helper.LocalMainFrame();
+  auto params = GlintSurfaceFixtureParams();
+  ASSERT_TRUE(params->glint_document_surface_policy);
+  params->glint_document_surface_policy->policy.identity_mode =
+      glint::candidate::SurfaceIdentityMode::kProfileIdentity;
+  CommitGlintSurfaceFixture(frame, std::move(params));
+  auto* document = frame->GetFrame()->GetDocument();
+  ASSERT_TRUE(document->GlintSurfacePolicy());
+  const auto expected = document->GlintSurfacePolicy()->policy.audio;
+  auto clone = frame->GetFrame()
+                   ->Loader()
+                   .GetDocumentLoader()
+                   ->CreateWebNavigationParamsToCloneDocument();
+  ASSERT_TRUE(clone->glint_document_surface_policy);
+  EXPECT_EQ(clone->glint_document_surface_policy->policy.identity_mode,
+            glint::candidate::SurfaceIdentityMode::kProfileIdentity);
+  clone->glint_document_surface_policy->policy.identity_mode =
+      glint::candidate::SurfaceIdentityMode::kPartitionedPrivacy;
+  clone->glint_document_surface_policy->policy.audio.fill(255);
+  EXPECT_EQ(document->GlintSurfacePolicy()->policy.identity_mode,
+            glint::candidate::SurfaceIdentityMode::kProfileIdentity);
+  EXPECT_EQ(document->GlintAudioPartitionSeed(), std::optional(expected));
+}
