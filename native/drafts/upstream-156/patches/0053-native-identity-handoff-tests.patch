+TEST_F(GlintWorkerSurfaceThreadTest, IdentityModeOwnedBeforeFirstEvaluation) {
+  auto policy = SurfacePolicy();
+  policy.policy.identity_mode =
+      glint::candidate::SurfaceIdentityMode::kProfileIdentity;
+  const auto expected = policy;
+  testing::InSequence sequence;
+  EXPECT_CALL(*reporting_proxy_, DidCreateWorkerGlobalScope(_))
+      .WillOnce([expected](WorkerOrWorkletGlobalScope* scope) {
+        auto* worker = To<WorkerGlobalScope>(scope);
+        ASSERT_TRUE(worker->GlintSurfacePolicy());
+        EXPECT_EQ(worker->GlintSurfacePolicy()->policy.identity_mode,
+                  glint::candidate::SurfaceIdentityMode::kProfileIdentity);
+        EXPECT_EQ(worker->GlintSurfacePolicy()->partition, expected.partition);
+        EXPECT_EQ(worker->GlintCanvasPartitionSeed(),
+                  std::optional(expected.policy.canvas));
+        EXPECT_EQ(worker->GlintAudioPartitionSeed(),
+                  std::optional(expected.policy.audio));
+      });
+  EXPECT_CALL(*reporting_proxy_, WillEvaluateScriptMock()).Times(1);
+  EXPECT_CALL(*reporting_proxy_, DidEvaluateTopLevelScriptMock(true, _)).Times(1);
+  EXPECT_CALL(*reporting_proxy_, WillDestroyWorkerGlobalScope()).Times(1);
+  EXPECT_CALL(*reporting_proxy_, DidTerminateWorkerThread()).Times(1);
+  worker_thread_->StartWithSourceCode(security_origin_.get(), "//fixture",
+                                      KURL("http://fake.url/"), std::nullopt, policy, true);
+  policy.policy.identity_mode =
+      glint::candidate::SurfaceIdentityMode::kPartitionedPrivacy;
+  policy.policy.audio.fill(255);
