+namespace {
+constexpr char kHalfDomain[] = "glint.canvas.edge.rgba16f.candidate.v2";
+
+bool IsNormalHalf(uint16_t value) {
+  const uint16_t exponent = value & 0x7c00;
+  return exponent != 0 && exponent != 0x7c00;
+}
+
+uint16_t HalfProtectionMask(uint16_t value) {
+  if (!IsNormalHalf(value)) {
+    return 0;
+  }
+  const int exponent = (value & 0x7c00) >> 10;
+  // Target an absolute quantum <= 1/256 for normal SDR samples. At large HDR
+  // magnitudes the smallest representable step is already larger: use one ULP.
+  // Only one mantissa bit changes; sign, exponent and all other bits survive.
+  const int shift = std::clamp(17 - exponent, 0, 9);
+  return static_cast<uint16_t>(1u << shift);
+}
+
+uint16_t StableHalfColour(uint16_t value) {
+  const uint16_t result = value & ~HalfProtectionMask(value);
+  return (result & 0x7fff) == 0 ? 0 : result;
+}
+
+bool IsFiniteOpaqueHalfPixel(std::span<const uint16_t> rgba, size_t offset) {
+  if (rgba[offset + 3] != 0x3c00) {
+    return false;
+  }
+  for (size_t channel = 0; channel < 3; ++channel) {
+    if ((rgba[offset + channel] & 0x7c00) == 0x7c00) {
+      return false;
+    }
+  }
+  return true;
+}
+
+bool DifferentHalfColour(std::span<const uint16_t> rgba,
+                         size_t offset,
+                         size_t neighbour) {
+  if (!IsFiniteOpaqueHalfPixel(rgba, neighbour)) {
+    return false;
+  }
+  for (size_t channel = 0; channel < 3; ++channel) {
+    // The selected bit is not part of classification or key derivation.
+    // Its position depends only on the invariant exponent, so reads are stable.
+    const uint16_t first = StableHalfColour(rgba[offset + channel]);
+    const uint16_t second = StableHalfColour(rgba[neighbour + channel]);
+    if (first != second) {
+      return true;
+    }
+  }
+  return false;
+}
+}  // namespace
+
+bool TransformEdgeCoherentCanvasF16(
+    std::span<uint16_t> rgba,
+    uint32_t width,
+    uint32_t height,
+    const std::array<uint8_t, 32>& partition_seed) {
+  if (width == 0 || height == 0 ||
+      width > std::numeric_limits<size_t>::max() / 4 / height ||
+      rgba.size() != static_cast<size_t>(width) * height * 4) {
+    return false;
+  }
+  struct HalfPaletteEntry {
+    uint64_t key = std::numeric_limits<uint64_t>::max();
+    uint8_t bits = 0;
+  };
+  std::array<HalfPaletteEntry, 256> palette{};
+  std::array<uint8_t, sizeof(kHalfDomain) - 1 + 6> message{};
+  std::copy_n(reinterpret_cast<const uint8_t*>(kHalfDomain),
+              sizeof(kHalfDomain) - 1, message.begin());
+  const size_t row_words = static_cast<size_t>(width) * 4;
+  for (uint32_t y = 0; y < height; ++y) {
+    for (uint32_t x = 0; x < width; ++x) {
+      const size_t offset = (static_cast<size_t>(y) * width + x) * 4;
+      if (!IsFiniteOpaqueHalfPixel(rgba, offset)) {
+        continue;
+      }
+      const bool edge =
+          (x > 0 && DifferentHalfColour(rgba, offset, offset - 4)) ||
+          (x + 1 < width && DifferentHalfColour(rgba, offset, offset + 4)) ||
+          (y > 0 && DifferentHalfColour(rgba, offset, offset - row_words)) ||
+          (y + 1 < height &&
+           DifferentHalfColour(rgba, offset, offset + row_words));
+      if (!edge) {
+        continue;
+      }
+      uint64_t colour = 0;
+      for (size_t channel = 0; channel < 3; ++channel) {
+        const uint16_t value = StableHalfColour(rgba[offset + channel]);
+        colour = (colour << 16) | value;
+        const size_t index = sizeof(kHalfDomain) - 1 + channel * 2;
+        message[index] = static_cast<uint8_t>(value >> 8);
+        message[index + 1] = static_cast<uint8_t>(value);
+      }
+      auto& entry = palette[(colour ^ (colour >> 16) ^ (colour >> 32)) & 255];
+      if (entry.key != colour) {
+        std::array<uint8_t, 32> digest{};
+        unsigned length = 0;
+        if (!HMAC(EVP_sha256(), partition_seed.data(), partition_seed.size(),
+                  message.data(), message.size(), digest.data(), &length) ||
+            length != digest.size()) {
+          return false;
+        }
+        entry.key = colour;
+        entry.bits = digest[0] & 7;
+      }
+      for (size_t channel = 0; channel < 3; ++channel) {
+        const uint16_t value = rgba[offset + channel];
+        if (IsNormalHalf(value)) {
+          const uint16_t mask = HalfProtectionMask(value);
+          rgba[offset + channel] = static_cast<uint16_t>(
+              (value & ~mask) | (((entry.bits >> channel) & 1) * mask));
+        }
+      }
+    }
+  }
+  return true;
+}
 }  // namespace glint::candidate
