+void PrivacyKeyService::WhenReady(base::OnceCallback<void(bool)> callback) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  CHECK(callback);
+  if (state_ == State::kLoading &&
+      ready_callbacks_.size() < kMaxPendingReadyCallbacks) {
+    ready_callbacks_.push_back(std::move(callback));
+    return;
+  }
+  std::move(callback).Run(state_ == State::kReady);
+}
+
+void PrivacyKeyService::NotifyReadiness() {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  auto callbacks = std::move(ready_callbacks_);
+  ready_callbacks_.clear();
+  const auto weak = weak_factory_.GetWeakPtr();
+  for (auto& callback : callbacks) {
+    // A preceding callback may shut down or destroy the service. Do not reuse
+    // the original completion status or dereference this after invoking it.
+    std::move(callback).Run(weak && weak->state_ == State::kReady);
+  }
+}
+
 void PrivacyKeyService::Shutdown() {
   DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
   weak_factory_.InvalidateWeakPtrs();
   key_.reset();
   state_ = State::kStopped;
+  NotifyReadiness();
 }
 
