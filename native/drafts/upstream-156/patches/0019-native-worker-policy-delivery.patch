+void SharedWorkerHost::BindNativePrivacyPolicy(
+    mojo::PendingReceiver<blink::mojom::NativePrivacyWorker> receiver) {
+  auto* process = GetProcessHost();
+  if (!process) {
+    return;
+  }
+  native_privacy_receivers_.Add(
+      std::make_unique<PrivacyWorkerService>(native_privacy_receivers_,
+                                              *process->GetBrowserContext(),
