+TEST_P(NativeDocumentNavigationTest, LateCanvasPolicyLossCancelsAndAllowsNextNavigation) {
+  EnablePolicy();
+  ASSERT_TRUE(InitializeNativePrivacyContext(browser_context(), owned_.GetPath()));
+  task_environment()->RunUntilIdle();
+  shutdown_policy_at_ready_ = true;
+  auto simulator = NavigationSimulator::CreateBrowserInitiated(Target(), web_contents());
+  simulator->ReadyToCommit();
+  task_environment()->RunUntilIdle();
+  EXPECT_EQ(finished_, 1);
+  EXPECT_FALSE(committed_);
+  EXPECT_EQ(error_, net::ERR_ABORTED);
+  ASSERT_TRUE(web_contents());
+  EXPECT_EQ(web_contents()->GetLastCommittedURL(), GURL("https://canvas.test/baseline"));
+  command_line_.GetProcessCommandLine()->RemoveSwitch(kGlintDocumentPrivacyBootstrapSwitch);
+  command_line_.GetProcessCommandLine()->RemoveSwitch(kGlintDocumentSurfaceBootstrapSwitch);
+  NavigateAndCommit(GURL("https://canvas.test/recovery"));
+  EXPECT_EQ(finished_, 2);
+  EXPECT_TRUE(committed_);
+  EXPECT_EQ(error_, net::OK);
+  EXPECT_EQ(web_contents()->GetLastCommittedURL(), GURL("https://canvas.test/recovery"));
+}
