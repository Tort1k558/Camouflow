diff --git a/content/browser/camouflow_native/privacy_key_derivation.cc b/content/browser/camouflow_native/privacy_key_derivation.cc
new file mode 100644
index 0000000..5bca1a4
--- /dev/null
+++ b/content/browser/camouflow_native/privacy_key_derivation.cc
@@ -0,0 +1,25 @@
+// Copyright 2026 CamouFlow contributors.
+// SPDX-License-Identifier: MIT
+#include "content/browser/camouflow_native/privacy_key_derivation.h"
+
+#include "content/browser/camouflow_native/privacy_partition.h"
+#include "crypto/hmac.h"
+
+namespace camouflow::native {
+
+std::optional<std::array<uint8_t, 32>> DerivePrivacyPartitionKey(
+    base::span<const uint8_t, 32> profile_key,
+    const blink::StorageKey& storage_key,
+    std::string_view surface) {
+  const auto partition = storage_key.SerializeForNativePrivacy();
+  if (!partition) {
+    return std::nullopt;
+  }
+  const auto message = PrivacyDerivationMessage(*partition, surface);
+  if (!message) {
+    return std::nullopt;
+  }
+  return crypto::hmac::SignSha256(profile_key, base::as_byte_span(*message));
+}
+
+}  // namespace camouflow::native
diff --git a/content/browser/camouflow_native/privacy_key_derivation.h b/content/browser/camouflow_native/privacy_key_derivation.h
