+class NativePrivacyWorkerSurfaceBootstrapTest : public NativePrivacyWorkerBootstrapTest {
+ protected:
+  using SurfacePolicy = blink::mojom::GlintSurfacePolicyCommitPtr;
+  void GetCanvasPolicy(GetCanvasPolicyCallback callback) override {
+    ADD_FAILURE() << "Surface bootstrap must not fall back to Canvas-only delivery";
+    std::move(callback).Run(Status::kUnavailable, nullptr);
+  }
+  void GetSurfacePolicy(GetSurfacePolicyCallback callback) override {
+    ++requests_;
+    surface_reply_ = std::move(callback);
+  }
+  void StartSurface(bool destroy_on_completion = false, bool origin_only = false) {
+    mojo::PendingRemote<blink::mojom::NativePrivacyWorker> endpoint;
+    receiver_.Bind(endpoint.InitWithNewPipeAndPassReceiver());
+    bootstrap_ = std::make_unique<PrivacyWorkerBootstrap>(std::move(endpoint));
+    auto callback = base::BindLambdaForTesting(
+        [&, destroy_on_completion](PrivacyWorkerBootstrap::SurfaceResult result) {
+          ++completions_;
+          surface_result_ = std::move(result);
+          if (destroy_on_completion) {
+            bootstrap_.reset();
+          }
+        });
+    if (origin_only) {
+      bootstrap_->StartSurfacePolicy(selected_partition_.origin(), std::move(callback));
+    } else {
+      bootstrap_->StartSurfacePolicy(selected_partition_, std::move(callback));
+    }
+    tasks_.RunUntilIdle();
+    ASSERT_EQ(requests_, 1);
+    ASSERT_EQ(completions_, 0);
+  }
+  SurfacePolicy ValidSurfacePolicy() {
+    glint::candidate::SurfacePolicy snapshot;
+    snapshot.partition_encoding = *selected_partition_.SerializeForNativePrivacy();
+    snapshot.canvas.fill(1);
+    snapshot.webgl.fill(2);
+    snapshot.webgpu.fill(3);
+    snapshot.audio.fill(4);
+    return glint::candidate::EncodeSurfacePolicyCommit(snapshot, selected_partition_);
+  }
+  void ReplySurface(Status status, SurfacePolicy policy) {
+    ASSERT_TRUE(surface_reply_);
+    std::move(surface_reply_).Run(status, std::move(policy));
+    tasks_.RunUntilIdle();
+  }
+  void ExpectSurfaceError(Error error) {
+    ASSERT_EQ(completions_, 1);
+    ASSERT_TRUE(surface_result_);
+    ASSERT_FALSE(surface_result_->has_value());
+    EXPECT_EQ(surface_result_->error(), error);
+  }
+  blink::StorageKey selected_partition_ = blink::StorageKey::CreateFirstParty(
+      url::Origin::Create(GURL("https://surface-worker.test/")));
+  GetSurfacePolicyCallback surface_reply_;
+  std::optional<PrivacyWorkerBootstrap::SurfaceResult> surface_result_;
+};
+
+TEST_F(NativePrivacyWorkerSurfaceBootstrapTest, ReadyReturnsOwnedIndependentSnapshotOnce) {
+  StartSurface();
+  ReplySurface(Status::kReady, ValidSurfacePolicy());
+  ASSERT_EQ(completions_, 1);
+  ASSERT_TRUE(surface_result_);
+  ASSERT_TRUE(surface_result_->has_value());
+  const auto& policy = surface_result_->value().policy;
+  EXPECT_TRUE(glint::candidate::ValidateSurfacePolicy(policy, selected_partition_));
+  EXPECT_EQ(policy.canvas[0], 1u);
+  EXPECT_EQ(policy.webgl[0], 2u);
+  EXPECT_EQ(policy.webgpu[0], 3u);
+  EXPECT_EQ(policy.audio[0], 4u);
+  tasks_.FastForwardBy(base::Seconds(11));
+  EXPECT_EQ(completions_, 1);
+}
