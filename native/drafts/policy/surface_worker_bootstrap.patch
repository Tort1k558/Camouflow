+enum class WorkerPrivacyBootstrapMode { kOff, kCanvas, kSurfaces, kConflict };
+inline WorkerPrivacyBootstrapMode SelectWorkerPrivacyBootstrapMode(bool canvas, bool surfaces) {
+  if (canvas && surfaces) return WorkerPrivacyBootstrapMode::kConflict;
+  if (surfaces) return WorkerPrivacyBootstrapMode::kSurfaces;
+  return canvas ? WorkerPrivacyBootstrapMode::kCanvas : WorkerPrivacyBootstrapMode::kOff;
+}
+inline bool IsWorkerPrivacyBootstrapReady(WorkerPrivacyBootstrapMode mode,
+                                         bool canvas, bool surfaces) {
+  switch (mode) {
+    case WorkerPrivacyBootstrapMode::kOff: return !canvas && !surfaces;
+    case WorkerPrivacyBootstrapMode::kCanvas: return canvas && !surfaces;
+    case WorkerPrivacyBootstrapMode::kSurfaces: return surfaces && !canvas;
+    case WorkerPrivacyBootstrapMode::kConflict: return false;
+  }
+  return false;
+}
+WorkerPrivacyBootstrapMode GetWorkerPrivacyBootstrapMode();
 
