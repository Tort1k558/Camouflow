+void PrivacyWorkerBootstrap::OnSurfaceReply(
+    Status status, blink::mojom::GlintSurfacePolicyCommitPtr policy) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  if ((status != Status::kReady && policy) || (status == Status::kReady && !policy)) {
+    Fail(Error::kMalformedPolicy);
+    return;
+  }
+  if (status == Status::kUnavailable) {
+    Fail(Error::kUnavailable);
+    return;
+  }
+  if (status == Status::kTimedOut) {
+    Fail(Error::kTimedOut);
+    return;
+  }
+  if (status != Status::kReady || !browser_worker_origin_) {
+    Fail(Error::kMalformedPolicy);
+    return;
+  }
+  auto owned = glint::candidate::DecodeOwnedWorkerSurfacePolicy(
+      *policy, *browser_worker_origin_, selected_worker_partition_);
+  if (!owned) {
+    Fail(Error::kMalformedPolicy);
+    return;
+  }
+  CompleteSurface(std::move(*owned));
+}
+
 void PrivacyWorkerBootstrap::Fail(Error error) {
+  if (surface_callback_) {
+    CompleteSurface(base::unexpected(error));
+    return;
+  }
   Complete(base::unexpected(error));
 }
 
