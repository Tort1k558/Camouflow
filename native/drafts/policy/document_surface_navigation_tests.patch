+class NativeDocumentSurfaceReadinessTest : public NativeDocumentReadinessThrottleTest {
+ protected:
+  void EnableSurfaces() {
+    command_line_.GetProcessCommandLine()->AppendSwitch(kGlintDocumentSurfaceBootstrapSwitch);
+  }
+};
+
+TEST_F(NativeDocumentSurfaceReadinessTest, ReadyContextProceedsForBothCommitPaths) {
+  EnableSurfaces();
+  Initialize();
+  task_environment()->RunUntilIdle();
+  EXPECT_EQ(GetGlintDocumentPrivacyBootstrapMode(), glint::candidate::DocumentPrivacyBootstrapMode::kSurfaces);
+  EXPECT_EQ(NavigationThrottle::PROCEED, throttle_->WillProcessResponse());
+  EXPECT_EQ(NavigationThrottle::PROCEED, throttle_->WillCommitWithoutUrlLoader());
+}
+
+TEST_F(NativeDocumentSurfaceReadinessTest, LoadingDefersThenResumesOnlyOnce) {
+  EnableSurfaces();
+  Initialize();
+  EXPECT_EQ(NavigationThrottle::DEFER, throttle_->WillProcessResponse());
+  base::RunLoop().RunUntilIdle();
+  EXPECT_EQ(resumed_, 0);
+  task_environment()->RunUntilIdle();
+  EXPECT_EQ(resumed_, 1);
+  EXPECT_EQ(cancelled_, 0);
+  task_environment()->FastForwardBy(base::Seconds(20));
+  EXPECT_EQ(resumed_, 1);
+}
+
+TEST_F(NativeDocumentSurfaceReadinessTest, MissingContextCancelsAfterDeferInstalled) {
+  EnableSurfaces();
+  EXPECT_EQ(NavigationThrottle::DEFER, throttle_->WillCommitWithoutUrlLoader());
+  EXPECT_EQ(cancelled_, 0);
+  base::RunLoop().RunUntilIdle();
+  EXPECT_EQ(cancelled_, 1);
+  EXPECT_EQ(resumed_, 0);
+}
+
+TEST_F(NativeDocumentSurfaceReadinessTest, DeadlineRejectsLateReplyWithoutCanvasFallback) {
+  EnableSurfaces();
+  Initialize();
+  EXPECT_EQ(NavigationThrottle::DEFER, throttle_->WillProcessResponse());
+  base::RunLoop().RunUntilIdle();
+  task_environment()->AdvanceClock(base::Seconds(11));
+  base::RunLoop().RunUntilIdle();
+  EXPECT_EQ(cancelled_, 1);
+  task_environment()->RunUntilIdle();
+  EXPECT_EQ(cancelled_, 1);
+  EXPECT_EQ(resumed_, 0);
+}
+
+TEST_F(NativeDocumentSurfaceReadinessTest, ConflictingFlagsRejectReadyContextWithoutWaiting) {
+  EnableSurfaces();
+  Enable();
+  Initialize();
+  task_environment()->RunUntilIdle();
+  EXPECT_EQ(GetGlintDocumentPrivacyBootstrapMode(), glint::candidate::DocumentPrivacyBootstrapMode::kConflict);
+  EXPECT_EQ(NavigationThrottle::CANCEL_AND_IGNORE, throttle_->WillProcessResponse());
+  EXPECT_EQ(NavigationThrottle::CANCEL_AND_IGNORE, throttle_->WillCommitWithoutUrlLoader());
+  EXPECT_EQ(resumed_, 0);
+}
+
+TEST_F(NativeDocumentSurfaceReadinessTest, ShutdownCancelsPendingReplyExactlyOnce) {
+  EnableSurfaces();
+  Initialize();
+  EXPECT_EQ(NavigationThrottle::DEFER, throttle_->WillProcessResponse());
+  base::RunLoop().RunUntilIdle();
+  ShutdownNativePrivacyContext(browser_context());
+  EXPECT_EQ(cancelled_, 1);
+  task_environment()->RunUntilIdle();
+  EXPECT_EQ(cancelled_, 1);
+  EXPECT_EQ(resumed_, 0);
+}
+
 }  // namespace
