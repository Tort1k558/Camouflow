+TEST_P(NativeDocumentNavigationTest, SurfaceFlagOffCannotCarryPriorNavigationEnvelope) {
+  EnableSurfacePolicy();
+  ASSERT_TRUE(InitializeNativePrivacyContext(browser_context(), owned_.GetPath()));
+  task_environment()->RunUntilIdle();
+  auto first = NavigationSimulator::CreateBrowserInitiated(Target(), web_contents());
+  first->ReadyToCommit();
+  first->Commit();
+  command_line_.GetProcessCommandLine()->RemoveSwitch(kGlintDocumentSurfaceBootstrapSwitch);
+  auto second = NavigationSimulator::CreateBrowserInitiated(GURL("https://canvas.test/after-surface-off"), web_contents());
+  second->ReadyToCommit();
+  auto* request = NavigationRequest::From(second->GetNavigationHandle());
+  ASSERT_TRUE(request);
+  EXPECT_FALSE(request->commit_params().glint_document_surface_policy_required);
+  EXPECT_FALSE(request->commit_params().glint_document_surface_commit);
+  EXPECT_FALSE(request->commit_params().glint_document_canvas_commit);
+  second->Commit();
+  EXPECT_TRUE(committed_);
+}
