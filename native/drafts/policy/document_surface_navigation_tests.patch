+TEST_P(NativeDocumentNavigationTest, SurfaceReadyRequestCarriesAllSelectedPartitionDomains) {
+  EnableSurfacePolicy();
+  ASSERT_TRUE(InitializeNativePrivacyContext(browser_context(), owned_.GetPath()));
+  task_environment()->RunUntilIdle();
+  auto simulator = NavigationSimulator::CreateBrowserInitiated(Target(), web_contents());
+  simulator->ReadyToCommit();
+  auto* request = NavigationRequest::From(simulator->GetNavigationHandle());
+  ASSERT_TRUE(request);
+  const auto& params = request->commit_params();
+  ASSERT_TRUE(params.glint_document_surface_policy_required);
+  ASSERT_TRUE(params.glint_document_surface_commit);
+  EXPECT_FALSE(params.glint_document_canvas_commit);
+  auto owned = glint::candidate::DecodeOwnedDocumentSurfacePolicy(
+      *params.glint_document_surface_commit, params.storage_key, params.origin_to_commit, false);
+  ASSERT_TRUE(owned);
+  EXPECT_EQ(owned->policy.canvas, DeriveNativePrivacyKey(browser_context(), owned->partition, "canvas"));
+  EXPECT_EQ(owned->policy.webgl, DeriveNativePrivacyKey(browser_context(), owned->partition, "webgl"));
+  EXPECT_EQ(owned->policy.webgpu, DeriveNativePrivacyKey(browser_context(), owned->partition, "webgpu"));
+  EXPECT_EQ(owned->policy.audio, DeriveNativePrivacyKey(browser_context(), owned->partition, "audio"));
+  EXPECT_EQ(finished_, 0);
+  simulator->Commit();
+  EXPECT_TRUE(committed_);
+  EXPECT_EQ(error_, net::OK);
+}
+
+TEST_P(NativeDocumentNavigationTest, SurfaceMissingPolicyRejectsBeforeCommitWithoutFallback) {
+  EnableSurfacePolicy();
+  auto simulator = NavigationSimulator::CreateBrowserInitiated(Target(), web_contents());
+  simulator->ReadyToCommit();
+  task_environment()->RunUntilIdle();
+  EXPECT_EQ(simulator->GetLastThrottleCheckResult().action(), NavigationThrottle::CANCEL_AND_IGNORE);
+  EXPECT_EQ(finished_, 1);
+  EXPECT_FALSE(committed_);
+  EXPECT_EQ(error_, net::ERR_ABORTED);
+  EXPECT_EQ(web_contents()->GetLastCommittedURL(), GURL("https://canvas.test/baseline"));
+}
