+  task_environment()->RunUntilIdle();
+  EXPECT_EQ(finished_, 1);
+  EXPECT_FALSE(committed_);
+  EXPECT_EQ(error_, net::ERR_ABORTED);
+  EXPECT_EQ(web_contents()->GetLastCommittedURL(), GURL("https://canvas.test/baseline"));
+}
