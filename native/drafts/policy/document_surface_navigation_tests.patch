+TEST_P(NativeDocumentNavigationTest, SurfaceStaleRejectedTokenCannotCancelNextNavigation) {
+  EnableSurfacePolicy();
+  ASSERT_TRUE(InitializeNativePrivacyContext(browser_context(), owned_.GetPath()));
+  task_environment()->RunUntilIdle();
+  auto first = NavigationSimulator::CreateBrowserInitiated(Target(), web_contents());
+  first->ReadyToCommit();
+  auto* request = NavigationRequest::From(first->GetNavigationHandle());
+  ASSERT_TRUE(request);
+  const auto stale = request->commit_params().navigation_token;
+  static_cast<mojom::FrameHost*>(request->GetRenderFrameHost())->RejectGlintDocumentCanvasCommit(stale);
+  task_environment()->RunUntilIdle();
+  EXPECT_EQ(finished_, 1);
+  auto second = NavigationSimulator::CreateBrowserInitiated(Target(), web_contents());
+  second->ReadyToCommit();
+  auto* next = NavigationRequest::From(second->GetNavigationHandle());
+  ASSERT_TRUE(next);
+  static_cast<mojom::FrameHost*>(next->GetRenderFrameHost())->RejectGlintDocumentCanvasCommit(stale);
+  EXPECT_EQ(finished_, 1);
+  second->Commit();
+  EXPECT_EQ(finished_, 2);
+  EXPECT_TRUE(committed_);
+}
