+void RenderFrameHostImpl::CreateChildFrameWithGlintPolicy(
+    const blink::LocalFrameToken& frame_token,
+    mojo::PendingAssociatedRemote<mojom::Frame> frame_remote,
+    mojo::PendingReceiver<blink::mojom::BrowserInterfaceBroker>
+        browser_interface_broker_receiver,
+    blink::mojom::PolicyContainerBindParamsPtr policy_container_bind_params,
+    mojo::PendingAssociatedReceiver<blink::mojom::AssociatedInterfaceProvider>
+        associated_interface_provider_receiver,
+    blink::mojom::TreeScopeType scope,
+    const std::string& frame_name,
+    const std::string& frame_unique_name,
+    bool is_created_by_script,
+    const blink::FramePolicy& frame_policy,
+    blink::mojom::FrameOwnerPropertiesPtr frame_owner_properties,
+    blink::FrameOwnerElementType owner_type,
+    ukm::SourceId document_ukm_source_id,
+    CreateChildFrameWithGlintPolicyCallback callback) {
+  const auto* command = base::CommandLine::ForCurrentProcess();
+  if (!command->HasSwitch("glint-document-surface-bootstrap-test")) {
+    std::move(callback).Run(false, nullptr);
+    return;
+  }
+  const auto process_id = GetProcess()->GetDeprecatedID();
+  const auto requesting_document = GetDocumentTokenIgnoringSafetyRestrictions();
+  auto requesting_frame = render_frame_scoped_weak_ptr_factory_.GetWeakPtr();
+  // The existing path authenticates preallocated tokens, enforces inherited
+  // sandbox restrictions and creates the browser's initial origin/storage key.
+  CreateChildFrame(frame_token, std::move(frame_remote),
+                   std::move(browser_interface_broker_receiver),
+                   std::move(policy_container_bind_params),
+                   std::move(associated_interface_provider_receiver), scope,
+                   frame_name, frame_unique_name, is_created_by_script,
+                   frame_policy, std::move(frame_owner_properties), owner_type,
+                   document_ukm_source_id);
+  if (!requesting_frame ||
+      requesting_frame->GetDocumentTokenIgnoringSafetyRestrictions() !=
+          requesting_document) {
+    std::move(callback).Run(false, nullptr);
+    return;
+  }
+  auto* child = RenderFrameHostImpl::FromFrameToken(process_id, frame_token);
+  if (!child || child->GetParent() != requesting_frame.get() ||
+      child->GetBrowserContext() != requesting_frame->GetBrowserContext() ||
+      !child->frame_tree_node()->is_on_initial_empty_document()) {
+    std::move(callback).Run(false, nullptr);
+    return;
+  }
+  blink::mojom::GlintSurfacePolicyCommitPtr policy;
+  if (!command->HasSwitch("glint-document-canvas-bootstrap-test")) {
+    policy = glint::candidate::CreateDocumentSurfacePolicyCommit(
+        child->GetBrowserContext(), child->GetStorageKey(),
+        child->GetLastCommittedOrigin());
+  }
+  // Creation success does not authorize a missing/mixed policy. The renderer
+  // keeps such an initial document required-and-inert, without parent fallback.
+  std::move(callback).Run(true, std::move(policy));
+}
