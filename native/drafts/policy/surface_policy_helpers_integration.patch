--- /dev/null
+++ b/third_party/blink/public/common/native_privacy/glint/surface_policy_validation_unittest.cc
@@ -0,0 +1,101 @@
+// Copyright 2026 CamouFlow contributors.
+// SPDX-License-Identifier: MIT
+#include "surface_policy_validation.h"
+
+#include "base/unguessable_token.h"
+#include "net/base/schemeful_site.h"
+#include "testing/gtest/include/gtest/gtest.h"
+#include "url/gurl.h"
+#include "url/origin.h"
+
+namespace glint::candidate {
+namespace {
+blink::StorageKey Partition() {
+  return blink::StorageKey::CreateFirstParty(url::Origin::Create(GURL("https://policy.test/")));
+}
+SurfacePolicy Policy() {
+  SurfacePolicy policy;
+  policy.partition_encoding = *Partition().SerializeForNativePrivacy();
+  policy.canvas.fill(1);
+  policy.webgl.fill(2);
+  policy.webgpu.fill(3);
+  policy.audio.fill(4);
+  return policy;
+}
+
+TEST(GlintSurfacePolicyTest, ValidIndependentSnapshot) {
+  EXPECT_TRUE(ValidateSurfacePolicy(Policy(), Partition()));
+}
+TEST(GlintSurfacePolicyTest, RejectsUnsupportedVersion) {
+  auto policy = Policy();
+  policy.version = 1;
+  EXPECT_FALSE(ValidateSurfacePolicy(policy, Partition()));
+  policy.version = 3;
+  EXPECT_FALSE(ValidateSurfacePolicy(policy, Partition()));
+}
+TEST(GlintSurfacePolicyTest, RejectsEmptyAndOversizedEncoding) {
+  auto policy = Policy();
+  policy.partition_encoding.clear();
+  EXPECT_FALSE(ValidateSurfacePolicy(policy, Partition()));
+  policy.partition_encoding.assign(8193, 'x');
+  EXPECT_FALSE(ValidateSurfacePolicy(policy, Partition()));
+}
+TEST(GlintSurfacePolicyTest, RejectsAnotherOrigin) {
+  EXPECT_FALSE(ValidateSurfacePolicy(Policy(), blink::StorageKey::CreateFirstParty(
+      url::Origin::Create(GURL("https://other.test/")))));
+}
+TEST(GlintSurfacePolicyTest, RejectsEveryPairOfReusedSeeds) {
+  for (unsigned left = 0; left < 4; ++left) {
+    for (unsigned right = left + 1; right < 4; ++right) {
+      auto policy = Policy();
+      std::array<PartitionSeed*, 4> seeds{
+          &policy.canvas, &policy.webgl, &policy.webgpu, &policy.audio};
+      *seeds[right] = *seeds[left];
+      EXPECT_FALSE(ValidateSurfacePolicy(policy, Partition()));
+    }
+  }
+}
+TEST(GlintSurfacePolicyTest, SnapshotOwnsSeedsAndEncoding) {
+  auto original = Policy();
+  auto copy = original;
+  original.audio.fill(1);
+  original.partition_encoding.clear();
+  EXPECT_TRUE(ValidateSurfacePolicy(copy, Partition()));
+  EXPECT_FALSE(ValidateSurfacePolicy(original, Partition()));
+}
+TEST(GlintSurfacePolicyTest, RejectsDifferentOpaquePartition) {
+  EXPECT_FALSE(ValidateSurfacePolicy(Policy(), blink::StorageKey::CreateFirstParty(url::Origin())));
+}
+TEST(GlintSurfacePolicyTest, NonceIdentityIsExact) {
+  const auto origin = url::Origin::Create(GURL("https://policy.test/"));
+  const auto first = blink::StorageKey::CreateWithNonce(origin, base::UnguessableToken::Create());
+  const auto second = blink::StorageKey::CreateWithNonce(origin, base::UnguessableToken::Create());
+  auto policy = Policy();
+  policy.partition_encoding = *first.SerializeForNativePrivacy();
+  EXPECT_TRUE(ValidateSurfacePolicy(policy, first));
+  EXPECT_FALSE(ValidateSurfacePolicy(policy, second));
+}
+TEST(GlintSurfacePolicyTest, RetainedTopLevelSiteCannotBeDropped) {
+  const auto origin = url::Origin::Create(GURL("https://policy.test/"));
+  const auto first = blink::StorageKey::Create(origin, net::SchemefulSite(GURL("https://one.test/")),
+      blink::mojom::AncestorChainBit::kCrossSite, false);
+  const auto second = blink::StorageKey::Create(origin, net::SchemefulSite(GURL("https://two.test/")),
+      blink::mojom::AncestorChainBit::kCrossSite, false);
+  ASSERT_EQ(first, second);
+  auto policy = Policy();
+  policy.partition_encoding = *first.SerializeForNativePrivacy();
+  EXPECT_TRUE(ValidateSurfacePolicy(policy, first));
+  EXPECT_FALSE(ValidateSurfacePolicy(policy, second));
+}
+TEST(GlintSurfacePolicyTest, RejectsEmbeddedNullTruncationAndTrailingData) {
+  auto policy = Policy();
+  const auto null_position = policy.partition_encoding.find('\0');
+  ASSERT_NE(null_position, std::string::npos);
+  policy.partition_encoding.resize(null_position);
+  EXPECT_FALSE(ValidateSurfacePolicy(policy, Partition()));
+  policy = Policy();
+  policy.partition_encoding.push_back('\0');
+  EXPECT_FALSE(ValidateSurfacePolicy(policy, Partition()));
+}
+}  // namespace
+}  // namespace glint::candidate
diff --git a/third_party/blink/public/common/native_privacy/glint/surface_policy_preflight.h b/third_party/blink/public/common/native_privacy/glint/surface_policy_preflight.h
new file mode 100644
--- /dev/null
+++ b/third_party/blink/public/common/native_privacy/glint/surface_policy_preflight.h
@@ -0,0 +1,61 @@
+// Copyright 2026 CamouFlow contributors.
+// SPDX-License-Identifier: MIT
+#ifndef GLINT_SURFACE_POLICY_PREFLIGHT_H_
+#define GLINT_SURFACE_POLICY_PREFLIGHT_H_
+
+#include <algorithm>
+#include <optional>
+#include <span>
+#include <string_view>
+
+#include "surface_policy_validation.h"
+#include "third_party/blink/public/common/native_privacy/document_storage_key_resolution.h"
+
+namespace glint::candidate {
+struct SurfacePolicyView {
+  uint32_t version;
+  std::string_view partition_encoding;
+  std::span<const uint8_t> canvas;
+  std::span<const uint8_t> webgl;
+  std::span<const uint8_t> webgpu;
+  std::span<const uint8_t> audio;
+};
+
+inline bool HasValidSurfacePolicyPayload(const SurfacePolicyView& incoming) {
+  return incoming.version == kSurfacePolicyVersion &&
+         !incoming.partition_encoding.empty() && incoming.partition_encoding.size() <= 8192 &&
+         incoming.canvas.size() == 32 && incoming.webgl.size() == 32 &&
+         incoming.webgpu.size() == 32 && incoming.audio.size() == 32;
+}
+
+// Validate all lengths before allocation/copy. The returned snapshot owns bytes.
+// Final Blink partition validation must still occur before installation.
+inline std::optional<SurfacePolicy> PreflightSurfacePolicyForPartition(
+    const SurfacePolicyView& incoming,
+    const blink::StorageKey& selected_partition) {
+  if (!HasValidSurfacePolicyPayload(incoming)) {
+    return std::nullopt;
+  }
+  SurfacePolicy owned;
+  owned.partition_encoding = incoming.partition_encoding;
+  std::ranges::copy(incoming.canvas, owned.canvas.begin());
+  std::ranges::copy(incoming.webgl, owned.webgl.begin());
+  std::ranges::copy(incoming.webgpu, owned.webgpu.begin());
+  std::ranges::copy(incoming.audio, owned.audio.begin());
+  if (!ValidateSurfacePolicy(owned, selected_partition)) {
+    return std::nullopt;
+  }
+  return owned;
+}
+
+inline std::optional<SurfacePolicy> PreflightSurfacePolicyCommit(
+    const SurfacePolicyView& incoming,
+    const blink::StorageKey& provisional_partition,
+    const url::Origin& browser_origin_to_commit) {
+  return PreflightSurfacePolicyForPartition(
+      incoming, blink::ResolveGlintDocumentStorageKey(
+                    provisional_partition, browser_origin_to_commit));
+}
+}  // namespace glint::candidate
+
+#endif
diff --git a/third_party/blink/public/common/native_privacy/glint/surface_policy_preflight_unittest.cc b/third_party/blink/public/common/native_privacy/glint/surface_policy_preflight_unittest.cc
new file mode 100644
--- /dev/null
+++ b/third_party/blink/public/common/native_privacy/glint/surface_policy_preflight_unittest.cc
@@ -0,0 +1,133 @@
+// Copyright 2026 CamouFlow contributors.
+// SPDX-License-Identifier: MIT
+#include "surface_policy_preflight.h"
+#include "surface_policy_wire.h"
+#include "worker_surface_policy_validation.h"
+
+#include "base/unguessable_token.h"
+#include "testing/gtest/include/gtest/gtest.h"
+#include "url/gurl.h"
+#include "url/origin.h"
+
+namespace glint::candidate {
+namespace {
+class GlintSurfacePolicyPreflightTest : public testing::Test {
+ protected:
+  const url::Origin origin_ = url::Origin::Create(GURL("https://preflight.test/"));
+  const blink::StorageKey partition_ = blink::StorageKey::CreateFirstParty(origin_);
+  std::string encoding_ = *partition_.SerializeForNativePrivacy();
+  PartitionSeed canvas_{1}, webgl_{2}, webgpu_{3}, audio_{4};
+
+  SurfacePolicyView Incoming() {
+    return {kSurfacePolicyVersion, encoding_, canvas_, webgl_, webgpu_, audio_};
+  }
+};
+
+TEST_F(GlintSurfacePolicyPreflightTest, ReturnsOwnedSnapshot) {
+  auto result = PreflightSurfacePolicyCommit(Incoming(), partition_, origin_);
+  ASSERT_TRUE(result);
+  encoding_.clear();
+  audio_.fill(1);
+  EXPECT_TRUE(ValidateSurfacePolicy(*result, partition_));
+  EXPECT_EQ(result->audio[0], 4u);
+}
+TEST_F(GlintSurfacePolicyPreflightTest, RejectsEveryShortAndLongSeedBeforeCopy) {
+  std::array<uint8_t, 33> oversized{};
+  for (unsigned index = 0; index < 4; ++index) {
+    for (unsigned size : {0u, 31u, 33u}) {
+      auto incoming = Incoming();
+      std::array<std::span<const uint8_t>*, 4> seeds{
+          &incoming.canvas, &incoming.webgl, &incoming.webgpu, &incoming.audio};
+      *seeds[index] = std::span<const uint8_t>(oversized).first(size);
+      EXPECT_FALSE(PreflightSurfacePolicyCommit(incoming, partition_, origin_));
+    }
+  }
+}
+TEST_F(GlintSurfacePolicyPreflightTest, RejectsWrongVersionAndHugeEncoding) {
+  auto incoming = Incoming();
+  incoming.version = 1;
+  EXPECT_FALSE(PreflightSurfacePolicyCommit(incoming, partition_, origin_));
+  encoding_.assign(8193, 'x');
+  EXPECT_FALSE(PreflightSurfacePolicyCommit(Incoming(), partition_, origin_));
+}
+TEST_F(GlintSurfacePolicyPreflightTest, ResolvesInheritedProvisionalOrigin) {
+  const auto provisional = blink::StorageKey::CreateFirstParty(url::Origin());
+  EXPECT_TRUE(PreflightSurfacePolicyCommit(Incoming(), provisional, origin_));
+}
+TEST_F(GlintSurfacePolicyPreflightTest, RejectsWrongBrowserOriginAndReusedSurface) {
+  const auto wrong = url::Origin::Create(GURL("https://wrong.test/"));
+  EXPECT_FALSE(PreflightSurfacePolicyCommit(Incoming(), partition_, wrong));
+  auto incoming = Incoming();
+  incoming.audio = incoming.canvas;
+  EXPECT_FALSE(PreflightSurfacePolicyCommit(incoming, partition_, origin_));
+}
+TEST_F(GlintSurfacePolicyPreflightTest, WireRoundtripRetainsBinaryEncodingAndOwnedSeeds) {
+  auto policy = PreflightSurfacePolicyCommit(Incoming(), partition_, origin_);
+  ASSERT_TRUE(policy);
+  auto wire = EncodeSurfacePolicyCommit(*policy, partition_);
+  ASSERT_TRUE(wire);
+  auto decoded = DecodeSurfacePolicyCommit(*wire, partition_, origin_);
+  ASSERT_TRUE(decoded);
+  EXPECT_EQ(decoded->partition_encoding, encoding_);
+  EXPECT_NE(decoded->partition_encoding.find('\0'), std::string::npos);
+  EXPECT_EQ(decoded->audio, audio_);
+  wire->audio_seed.assign(32, 0);
+  EXPECT_EQ(decoded->audio, audio_);
+}
+TEST_F(GlintSurfacePolicyPreflightTest, WireRejectsMalformedSeedAndWrongPartition) {
+  auto policy = PreflightSurfacePolicyCommit(Incoming(), partition_, origin_);
+  ASSERT_TRUE(policy);
+  auto wire = EncodeSurfacePolicyCommit(*policy, partition_);
+  ASSERT_TRUE(wire);
+  wire->audio_seed.pop_back();
+  EXPECT_FALSE(DecodeSurfacePolicyCommit(*wire, partition_, origin_));
+  const auto other = blink::StorageKey::CreateFirstParty(
+      url::Origin::Create(GURL("https://other.test/")));
+  EXPECT_FALSE(EncodeSurfacePolicyCommit(*policy, other));
+}
+TEST_F(GlintSurfacePolicyPreflightTest, WorkerDecoderPreservesExactOpaqueIdentity) {
+  const auto first = blink::StorageKey::CreateFirstParty(url::Origin());
+  const auto second = blink::StorageKey::CreateFirstParty(url::Origin());
+  encoding_ = *first.SerializeForNativePrivacy();
+  auto policy = PreflightSurfacePolicyForPartition(Incoming(), first);
+  ASSERT_TRUE(policy);
+  auto wire = EncodeSurfacePolicyCommit(*policy, first);
+  ASSERT_TRUE(wire);
+  EXPECT_TRUE(DecodeWorkerSurfacePolicy(*wire, first));
+  EXPECT_FALSE(DecodeWorkerSurfacePolicy(*wire, second));
+}
+TEST_F(GlintSurfacePolicyPreflightTest, WorkerDecoderCannotReplaceNoncePartition) {
+  const auto first = blink::StorageKey::CreateWithNonce(origin_, base::UnguessableToken::Create());
+  const auto second = blink::StorageKey::CreateWithNonce(origin_, base::UnguessableToken::Create());
+  encoding_ = *first.SerializeForNativePrivacy();
+  auto policy = PreflightSurfacePolicyForPartition(Incoming(), first);
+  ASSERT_TRUE(policy);
+  auto wire = EncodeSurfacePolicyCommit(*policy, first);
+  ASSERT_TRUE(wire);
+  EXPECT_TRUE(DecodeWorkerSurfacePolicy(*wire, first));
+  EXPECT_FALSE(DecodeWorkerSurfacePolicy(*wire, second));
+  EXPECT_FALSE(DecodeWorkerSurfacePolicy(*wire, partition_));
+}
+TEST_F(GlintSurfacePolicyPreflightTest, BrowserOwnedWorkerPartitionMatchesFinalOrigin) {
+  auto policy = PreflightSurfacePolicyCommit(Incoming(), partition_, origin_);
+  ASSERT_TRUE(policy);
+  auto wire = EncodeSurfacePolicyCommit(*policy, partition_);
+  ASSERT_TRUE(wire);
+  auto owned = DecodeOwnedWorkerSurfacePolicy(*wire, origin_);
+  ASSERT_TRUE(owned);
+  EXPECT_TRUE(ValidateWorkerSurfacePolicy(owned, origin_, false));
+  EXPECT_FALSE(ValidateWorkerSurfacePolicy(owned, origin_, true));
+  EXPECT_FALSE(ValidateWorkerSurfacePolicy(owned,
+      url::Origin::Create(GURL("https://wrong.test/")), false));
+}
+TEST_F(GlintSurfacePolicyPreflightTest, WirePartitionCannotDisagreeWithBinaryCommitment) {
+  auto policy = PreflightSurfacePolicyCommit(Incoming(), partition_, origin_);
+  ASSERT_TRUE(policy);
+  auto wire = EncodeSurfacePolicyCommit(*policy, partition_);
+  ASSERT_TRUE(wire);
+  wire->partition = blink::StorageKey::CreateFirstParty(url::Origin::Create(GURL("https://wrong.test/")));
+  EXPECT_FALSE(DecodeOwnedWorkerSurfacePolicy(*wire, wire->partition.origin()));
+  EXPECT_FALSE(DecodeSurfacePolicyCommit(*wire, partition_, origin_));
+}
+}  // namespace
+}  // namespace glint::candidate
