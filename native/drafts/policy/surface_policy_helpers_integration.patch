+// Copyright 2026 CamouFlow contributors.
+// SPDX-License-Identifier: MIT
+#ifndef GLINT_SURFACE_POLICY_H_
+#define GLINT_SURFACE_POLICY_H_
+
+#include <array>
+#include <cstdint>
+#include <string>
+
+namespace glint::candidate {
+using PartitionSeed = std::array<uint8_t, 32>;
+constexpr uint32_t kSurfacePolicyVersion = 2;
+
+// Browser-owned snapshot for one exact trusted StorageKey. No profile root key.
+struct SurfacePolicy {
+  uint32_t version = kSurfacePolicyVersion;
+  std::string partition_encoding;
+  PartitionSeed canvas{};
+  PartitionSeed webgl{};
+  PartitionSeed webgpu{};
+  PartitionSeed audio{};
+};
+
+inline bool HasIndependentSurfaceSeeds(const SurfacePolicy& policy) {
+  return policy.canvas != policy.webgl && policy.canvas != policy.webgpu &&
+         policy.canvas != policy.audio && policy.webgl != policy.webgpu &&
+         policy.webgl != policy.audio && policy.webgpu != policy.audio;
+}
+}  // namespace glint::candidate
+
+#endif
diff --git a/third_party/blink/public/common/native_privacy/glint/surface_policy_validation.h b/third_party/blink/public/common/native_privacy/glint/surface_policy_validation.h
new file mode 100644
--- /dev/null
+++ b/third_party/blink/public/common/native_privacy/glint/surface_policy_validation.h
@@ -0,0 +1,23 @@
+// Copyright 2026 CamouFlow contributors.
+// SPDX-License-Identifier: MIT
+#ifndef GLINT_SURFACE_POLICY_VALIDATION_H_
+#define GLINT_SURFACE_POLICY_VALIDATION_H_
+
+#include "surface_policy.h"
+#include "third_party/blink/public/common/storage_key/storage_key.h"
+
+namespace glint::candidate {
+// Must be checked against the final Blink-selected partition before installation.
+// IPC sender authentication and safe pre-teardown cancellation are separate gates.
+inline bool ValidateSurfacePolicy(const SurfacePolicy& policy,
+                                  const blink::StorageKey& selected_partition) {
+  if (policy.version != kSurfacePolicyVersion || policy.partition_encoding.empty() ||
+      policy.partition_encoding.size() > 8192 || !HasIndependentSurfaceSeeds(policy)) {
+    return false;
+  }
+  const auto encoding = selected_partition.SerializeForNativePrivacy();
+  return encoding && *encoding == policy.partition_encoding;
+}
+}  // namespace glint::candidate
+
+#endif
diff --git a/third_party/blink/public/common/native_privacy/glint/surface_policy_validation_unittest.cc b/third_party/blink/public/common/native_privacy/glint/surface_policy_validation_unittest.cc
