   std::unique_ptr<MockWorkerReportingProxy> reporting_proxy_;
   std::unique_ptr<WorkerThreadForTest> worker_thread_;
 };
+
+
+class GlintWorkerSurfaceThreadTest : public WorkerThreadTest {
+ protected:
+  glint::candidate::WorkerSurfacePolicy SurfacePolicy() {
+    auto partition = blink::StorageKey::CreateFirstParty(security_origin_->ToUrlOrigin());
+    glint::candidate::SurfacePolicy policy;
+    policy.partition_encoding = *partition.SerializeForNativePrivacy();
+    policy.canvas.fill(1);
+    policy.webgl.fill(2);
+    policy.webgpu.fill(3);
+    policy.audio.fill(4);
+    return {partition, std::move(policy)};
+  }
+  void ExpectRejectedSurface(std::optional<glint::candidate::WorkerSurfacePolicy> policy,
+                             std::optional<std::array<uint8_t, 32>> legacy = std::nullopt) {
+    base::WaitableEvent evaluated;
+    EXPECT_CALL(*reporting_proxy_, DidCreateWorkerGlobalScope(_))
+        .WillOnce([](WorkerOrWorkletGlobalScope* scope) {
+          auto* worker = To<WorkerGlobalScope>(scope);
+          EXPECT_FALSE(worker->GlintCanvasPartitionSeed());
+          EXPECT_FALSE(worker->GlintWebGLPartitionSeed());
+          EXPECT_FALSE(worker->GlintWebGPUPartitionSeed());
+          EXPECT_FALSE(worker->GlintAudioPartitionSeed());
+        });
+    EXPECT_CALL(*reporting_proxy_, WillEvaluateScriptMock()).Times(1);
+    EXPECT_CALL(*reporting_proxy_, DidEvaluateTopLevelScript(_))
+        .WillOnce([&evaluated](bool success) { EXPECT_FALSE(success); evaluated.Signal(); });
+    EXPECT_CALL(*reporting_proxy_, DidCloseWorkerGlobalScope()).Times(AtMost(1));
+    EXPECT_CALL(*reporting_proxy_, WillDestroyWorkerGlobalScope()).Times(1);
+    EXPECT_CALL(*reporting_proxy_, DidTerminateWorkerThread()).Times(1);
+    worker_thread_->StartWithSourceCode(security_origin_.get(), "globalThis.glintFixtureRan = true;",
+        KURL("http://fake.url/"), nullptr, legacy, std::move(policy), true);
+    const bool reported = evaluated.TimedWait(base::Seconds(10));
+    worker_thread_->Terminate();
+    worker_thread_->WaitForShutdownForTesting();
+    EXPECT_TRUE(reported);
+    EXPECT_EQ(ExitCode::kGracefullyTerminated, GetExitCode());
+  }
+};
+
+TEST_F(GlintWorkerSurfaceThreadTest, AllSeedsOwnedBeforeFirstScript) {
+  auto policy = SurfacePolicy();
+  const auto expected = policy;
+  testing::InSequence sequence;
+  EXPECT_CALL(*reporting_proxy_, DidCreateWorkerGlobalScope(_))
+      .WillOnce([expected](WorkerOrWorkletGlobalScope* scope) {
+        auto* worker = To<WorkerGlobalScope>(scope);
+        EXPECT_EQ(worker->GlintCanvasPartitionSeed(), std::optional(expected.policy.canvas));
+        EXPECT_EQ(worker->GlintWebGLPartitionSeed(), std::optional(expected.policy.webgl));
+        EXPECT_EQ(worker->GlintWebGPUPartitionSeed(), std::optional(expected.policy.webgpu));
+        EXPECT_EQ(worker->GlintAudioPartitionSeed(), std::optional(expected.policy.audio));
+        auto copy = worker->GlintAudioPartitionSeed();
+        ASSERT_TRUE(copy);
+        copy->fill(255);
+        EXPECT_EQ(worker->GlintAudioPartitionSeed(), std::optional(expected.policy.audio));
+      });
+  EXPECT_CALL(*reporting_proxy_, WillEvaluateScriptMock()).Times(1);
+  EXPECT_CALL(*reporting_proxy_, DidEvaluateTopLevelScript(true)).Times(1);
+  EXPECT_CALL(*reporting_proxy_, WillDestroyWorkerGlobalScope()).Times(1);
+  EXPECT_CALL(*reporting_proxy_, DidTerminateWorkerThread()).Times(1);
+  worker_thread_->StartWithSourceCode(security_origin_.get(), "//fixture",
+      KURL("http://fake.url/"), nullptr, std::nullopt, policy, true);
+  policy.policy.audio.fill(255);
+  worker_thread_->WaitForInit();
+  worker_thread_->Terminate();
+  worker_thread_->WaitForShutdownForTesting();
+}
+TEST_F(GlintWorkerSurfaceThreadTest, RequiredMissingBundleDoesNotEvaluateScript) {
+  ExpectRejectedSurface(std::nullopt);
+}
+TEST_F(GlintWorkerSurfaceThreadTest, DifferentFinalOriginDoesNotEvaluateScript) {
+  auto policy = SurfacePolicy();
+  policy.partition = blink::StorageKey::CreateFirstParty(
+      url::Origin::Create(GURL("https://wrong.test/")));
+  policy.policy.partition_encoding = *policy.partition.SerializeForNativePrivacy();
+  ExpectRejectedSurface(std::move(policy));
+}
+TEST_F(GlintWorkerSurfaceThreadTest, LegacySeedCannotSubstituteForSurfaceBundle) {
+  ExpectRejectedSurface(SurfacePolicy(), SurfacePolicy().policy.canvas);
+}
 
