+TEST_F(NativePrivacyBrowserContextTest, StartupKeyReadyBeforeEventLoop) {
+  auto context = NewContext("Startup");
+  ASSERT_TRUE(context);
+  ASSERT_TRUE(InitializeNativePrivacyContextBeforeFirstFrame(context.get(), owned_.GetPath()));
+  ASSERT_TRUE(IsNativePrivacyContextReady(context.get()));
+  const auto key = DeriveNativePrivacyKey(context.get(), Partition(), "canvas");
+  ASSERT_TRUE(key);
+  int calls = 0;
+  WhenNativePrivacyContextReady(context.get(), base::BindLambdaForTesting([&](bool ready) {
+    EXPECT_TRUE(ready);
+    ++calls;
+  }));
+  EXPECT_EQ(calls, 1);
+  tasks_.RunUntilIdle();
+  EXPECT_EQ(calls, 1);
+  EXPECT_EQ(key, DeriveNativePrivacyKey(context.get(), Partition(), "canvas"));
+}
+
+TEST_F(NativePrivacyBrowserContextTest, StartupMissingIdentityIsTerminalWithoutCreation) {
+  ASSERT_TRUE(base::DeleteFile(IdentityPath()));
+  auto context = NewContext("Startup");
+  ASSERT_TRUE(context);
+  ASSERT_TRUE(InitializeNativePrivacyContextBeforeFirstFrame(context.get(), owned_.GetPath()));
+  EXPECT_FALSE(IsNativePrivacyContextReady(context.get()));
+  EXPECT_FALSE(DeriveNativePrivacyKey(context.get(), Partition(), "canvas"));
+  EXPECT_FALSE(base::PathExists(IdentityPath()));
+  int calls = 0;
+  WhenNativePrivacyContextReady(context.get(), base::BindLambdaForTesting([&](bool ready) {
+    EXPECT_FALSE(ready);
+    ++calls;
+  }));
+  EXPECT_EQ(calls, 1);
+  ASSERT_TRUE(base::WriteFile(IdentityPath(), kIdentity));
+  EXPECT_FALSE(InitializeNativePrivacyContextBeforeFirstFrame(context.get(), owned_.GetPath()));
+  tasks_.RunUntilIdle();
+  EXPECT_FALSE(IsNativePrivacyContextReady(context.get()));
+  EXPECT_EQ(calls, 1);
+}
+
+TEST_F(NativePrivacyBrowserContextTest, StartupMalformedIdentityIsNotReplaced) {
+  ASSERT_TRUE(base::WriteFile(IdentityPath(), "invalid"));
+  auto context = NewContext("Startup");
+  ASSERT_TRUE(context);
+  ASSERT_TRUE(InitializeNativePrivacyContextBeforeFirstFrame(context.get(), owned_.GetPath()));
+  EXPECT_FALSE(IsNativePrivacyContextReady(context.get()));
+  std::string unchanged;
+  ASSERT_TRUE(base::ReadFileToString(IdentityPath(), &unchanged));
+  EXPECT_EQ(unchanged, "invalid");
+}
+
+TEST_F(NativePrivacyBrowserContextTest, StartupCannotReplaceReadyOrLoadingOwner) {
+  auto ready = NewContext("Ready");
+  auto loading = NewContext("Loading");
+  ASSERT_TRUE(ready);
+  ASSERT_TRUE(loading);
+  ASSERT_TRUE(InitializeNativePrivacyContextBeforeFirstFrame(ready.get(), owned_.GetPath()));
+  const auto key = DeriveNativePrivacyKey(ready.get(), Partition(), "canvas");
+  ASSERT_TRUE(key);
+  ASSERT_TRUE(InitializeNativePrivacyContext(loading.get(), owned_.GetPath()));
+  EXPECT_FALSE(IsNativePrivacyContextReady(loading.get()));
+  ASSERT_TRUE(base::WriteFile(IdentityPath(), kOtherIdentity));
+  EXPECT_FALSE(InitializeNativePrivacyContextBeforeFirstFrame(ready.get(), owned_.GetPath()));
+  EXPECT_FALSE(InitializeNativePrivacyContextBeforeFirstFrame(loading.get(), owned_.GetPath()));
+  EXPECT_FALSE(IsNativePrivacyContextReady(loading.get()));
+  EXPECT_EQ(key, DeriveNativePrivacyKey(ready.get(), Partition(), "canvas"));
+  tasks_.RunUntilIdle();
+  EXPECT_TRUE(IsNativePrivacyContextReady(loading.get()));
+  EXPECT_NE(key, DeriveNativePrivacyKey(loading.get(), Partition(), "canvas"));
+}
+
+TEST_F(NativePrivacyBrowserContextTest, StartupOffTheRecordNeverReadsPersistentIdentity) {
+  auto first = NewContext("First");
+  auto second = NewContext("Second");
+  ASSERT_TRUE(first);
+  ASSERT_TRUE(second);
+  first->set_is_off_the_record(true);
+  second->set_is_off_the_record(true);
+  EXPECT_FALSE(InitializeNativePrivacyContextBeforeFirstFrame(first.get(), owned_.GetPath()));
+  ASSERT_TRUE(base::DeleteFile(IdentityPath()));
+  ASSERT_TRUE(InitializeNativePrivacyContextBeforeFirstFrame(first.get(), base::FilePath()));
+  ASSERT_TRUE(InitializeNativePrivacyContextBeforeFirstFrame(second.get(), base::FilePath()));
+  const auto key = DeriveNativePrivacyKey(first.get(), Partition(), "canvas");
+  ASSERT_TRUE(key);
+  EXPECT_NE(key, DeriveNativePrivacyKey(second.get(), Partition(), "canvas"));
+  EXPECT_FALSE(base::PathExists(IdentityPath()));
+}
+
+TEST_F(NativePrivacyBrowserContextTest, StartupRejectsInvalidRootWithoutInstallingOwner) {
+  auto context = NewContext("Startup");
+  ASSERT_TRUE(context);
+  EXPECT_FALSE(InitializeNativePrivacyContextBeforeFirstFrame(nullptr, owned_.GetPath()));
+  EXPECT_FALSE(InitializeNativePrivacyContextBeforeFirstFrame(context.get(), base::FilePath()));
+  EXPECT_FALSE(InitializeNativePrivacyContextBeforeFirstFrame(
+      context.get(), base::FilePath(FILE_PATH_LITERAL("relative"))));
+  EXPECT_FALSE(InitializeNativePrivacyContextBeforeFirstFrame(
+      context.get(), owned_.GetPath().AppendASCII("..").AppendASCII("other")));
+  ASSERT_TRUE(InitializeNativePrivacyContextBeforeFirstFrame(context.get(), owned_.GetPath()));
+  EXPECT_TRUE(IsNativePrivacyContextReady(context.get()));
+}
