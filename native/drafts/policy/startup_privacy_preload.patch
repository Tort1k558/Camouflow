   return true;
 }
 
+bool PrivacyKeyService::InstallOwnedProfileBeforeFirstFrame(
+    base::SupportsUserData& owner,
+    const base::FilePath& owned_profile) {
+  if (GetForOwner(owner) || !owned_profile.IsAbsolute() ||
+      owned_profile.ReferencesParent()) {
+    return false;
+  }
+  auto service = std::make_unique<PrivacyKeyService>();
+  service->state_ = State::kLoading;
+  service->Loaded(PrivacyProfileKey::LoadOwnedProfile(owned_profile));
+  owner.SetUserData(&kPrivacyKeyServiceUserDataKey, std::move(service));
+  // As with async initialization, installation success is not key readiness.
+  return true;
+}
