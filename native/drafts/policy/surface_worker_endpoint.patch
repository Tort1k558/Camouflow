+class NativePrivacyWorkerSurfaceServiceTest : public NativePrivacyWorkerServiceTest {};
+using SurfacePolicy = blink::mojom::GlintSurfacePolicyCommitPtr;
+
+TEST_F(NativePrivacyWorkerSurfaceServiceTest, MissingServiceReturnsNoSnapshot) {
+  auto remote = Connect();
+  int replies = 0;
+  remote->GetSurfacePolicy(base::BindLambdaForTesting([&](Status status, SurfacePolicy policy) {
+    ++replies;
+    EXPECT_EQ(status, Status::kUnavailable);
+    EXPECT_FALSE(policy);
+  }));
+  remote.FlushForTesting();
+  EXPECT_EQ(replies, 1);
+}
+
+TEST_F(NativePrivacyWorkerSurfaceServiceTest, ReadySnapshotMatchesEveryDomainForAllWorkerKinds) {
+  Initialize();
+  tasks_.RunUntilIdle();
+  for (auto kind : {Kind::kDedicated, Kind::kShared, Kind::kService}) {
+    auto remote = Connect(kind);
+    int replies = 0;
+    remote->GetSurfacePolicy(base::BindLambdaForTesting([&](Status status, SurfacePolicy policy) {
+      ++replies;
+      EXPECT_EQ(status, Status::kReady);
+      ASSERT_TRUE(policy);
+      auto decoded = glint::candidate::DecodeWorkerSurfacePolicy(*policy, Partition());
+      ASSERT_TRUE(decoded);
+      EXPECT_EQ(decoded->canvas, DeriveNativePrivacyKey(context_.get(), Partition(), "canvas"));
+      EXPECT_EQ(decoded->webgl, DeriveNativePrivacyKey(context_.get(), Partition(), "webgl"));
+      EXPECT_EQ(decoded->webgpu, DeriveNativePrivacyKey(context_.get(), Partition(), "webgpu"));
+      EXPECT_EQ(decoded->audio, DeriveNativePrivacyKey(context_.get(), Partition(), "audio"));
+    }));
+    remote.FlushForTesting();
+    EXPECT_EQ(replies, 1);
+  }
+}
+
+TEST_F(NativePrivacyWorkerSurfaceServiceTest, LoadingDoesNotReplyWithPrematureSnapshot) {
+  Initialize();
+  auto remote = Connect();
+  int replies = 0;
+  remote->GetSurfacePolicy(base::BindLambdaForTesting([&](Status status, SurfacePolicy policy) {
+    ++replies;
+    EXPECT_EQ(status, Status::kReady);
+    EXPECT_TRUE(policy);
+  }));
+  remote.FlushForTesting();
+  EXPECT_EQ(replies, 0);
+  tasks_.RunUntilIdle();
+  EXPECT_EQ(replies, 1);
+}
+
+TEST_F(NativePrivacyWorkerSurfaceServiceTest, WrongWorkerOriginCannotGetSnapshot) {
+  Initialize();
