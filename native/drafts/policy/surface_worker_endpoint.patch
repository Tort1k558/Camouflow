+}
+
+TEST_F(NativePrivacyWorkerSurfaceServiceTest, SurfaceThenCanvasCannotRequestTwice) {
+  Initialize();
+  auto remote = Connect();
+  int replies = 0;
+  remote->GetSurfacePolicy(base::BindLambdaForTesting([&](Status, SurfacePolicy) { ++replies; }));
+  remote.FlushForTesting();
+  ASSERT_EQ(replies, 0);
+  mojo::test::BadMessageObserver observer;
+  remote->GetCanvasPolicy(base::BindLambdaForTesting([&](Status, Policy) { ++replies; }));
+  EXPECT_EQ(observer.WaitForBadMessage(), "Glint worker policy requested twice on one pipe");
+  EXPECT_TRUE(receivers_.empty());
+  tasks_.RunUntilIdle();
+  EXPECT_EQ(replies, 0);
+}
