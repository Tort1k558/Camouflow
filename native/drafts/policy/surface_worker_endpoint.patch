+  int replies = 0;
+  remote->GetSurfacePolicy(base::BindLambdaForTesting([&](Status status, SurfacePolicy policy) {
+    ++replies;
+    EXPECT_EQ(status, Status::kUnavailable);
+    EXPECT_FALSE(policy);
+  }));
+  remote.FlushForTesting();
+  EXPECT_EQ(replies, 1);
+}
+
+TEST_F(NativePrivacyWorkerSurfaceServiceTest, ShutdownDuringReadinessReturnsNoSnapshot) {
+  Initialize();
+  auto remote = Connect();
+  int replies = 0;
+  remote->GetSurfacePolicy(base::BindLambdaForTesting([&](Status status, SurfacePolicy policy) {
+    ++replies;
+    EXPECT_EQ(status, Status::kUnavailable);
