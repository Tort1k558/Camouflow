+TEST_P(DocumentLoaderTest, GlintSurfacesOwnAllSeedsBeforeFirstInlineScript) {
+  GlintSurfaceBeforeScriptClient client;
+  frame_test_helpers::WebViewHelper helper;
+  helper.Initialize(&client);
+  auto* frame = helper.LocalMainFrame();
+  client.Observe(frame);
+  auto params = GlintSurfaceFixtureParams();
+  ASSERT_TRUE(params->glint_document_surface_policy);
+  const auto expected = *params->glint_document_surface_policy;
+  CommitGlintSurfaceFixture(frame, std::move(params));
+  ASSERT_FALSE(client.snapshots.empty());
+  ASSERT_EQ(client.snapshots.size(), client.titles.size());
+  ASSERT_EQ(client.snapshots.size(), client.readiness.size());
+  for (size_t i = 0; i < client.snapshots.size(); ++i) {
+    EXPECT_TRUE(client.readiness[i]);
+    EXPECT_TRUE(client.titles[i].empty());
+    EXPECT_EQ(client.snapshots[i].policy.canvas, expected.policy.canvas);
+    EXPECT_EQ(client.snapshots[i].policy.webgl, expected.policy.webgl);
+    EXPECT_EQ(client.snapshots[i].policy.webgpu, expected.policy.webgpu);
+    EXPECT_EQ(client.snapshots[i].policy.audio, expected.policy.audio);
+  }
+  EXPECT_EQ(frame->GetFrame()->GetDocument()->title(), "glint-surface-inline-ok");
+  client.Observe(nullptr);
+}
