+TEST_F(NativePrivacyKeyServiceTest, ReadinessWaitsForLoadingAndDerivesInsideCallback) {
+  PrivacyKeyService service;
+  ASSERT_TRUE(service.InitializeOwnedProfile(owned_.GetPath()));
+  int calls = 0;
+  service.WhenReady(base::BindOnce([&](bool ready) {
+    ++calls;
+    EXPECT_TRUE(ready);
+    EXPECT_TRUE(service.Derive(Partition(), "canvas"));
+  }));
+  EXPECT_EQ(calls, 0);
+  tasks_.RunUntilIdle();
+  EXPECT_EQ(calls, 1);
+}
+
+TEST_F(NativePrivacyKeyServiceTest, ReadyCallbacksCompleteInline) {
+  PrivacyKeyService service;
+  ASSERT_TRUE(service.InitializeEphemeral());
+  int calls = 0;
+  service.WhenReady(base::BindOnce([&](bool ready) { ++calls; EXPECT_TRUE(ready); }));
+  EXPECT_EQ(calls, 1);
+}
+
+TEST_F(NativePrivacyKeyServiceTest, UninitializedReadinessFailsInline) {
+  PrivacyKeyService service;
+  int calls = 0;
+  service.WhenReady(base::BindOnce([&](bool ready) { ++calls; EXPECT_FALSE(ready); }));
+  EXPECT_EQ(calls, 1);
+}
+
+TEST_F(NativePrivacyKeyServiceTest, FailedLoadingSettlesReadinessWithoutRegeneration) {
+  ASSERT_TRUE(base::DeleteFile(owned_.GetPath().AppendASCII("camouflow-native-privacy.json")));
+  PrivacyKeyService service;
+  ASSERT_TRUE(service.InitializeOwnedProfile(owned_.GetPath()));
+  int calls = 0;
+  service.WhenReady(base::BindOnce([&](bool ready) { ++calls; EXPECT_FALSE(ready); }));
+  tasks_.RunUntilIdle();
+  EXPECT_EQ(calls, 1);
+  service.WhenReady(base::BindOnce([&](bool ready) { ++calls; EXPECT_FALSE(ready); }));
+  EXPECT_EQ(calls, 2);
+  EXPECT_FALSE(base::PathExists(owned_.GetPath().AppendASCII("camouflow-native-privacy.json")));
+}
+
+TEST_F(NativePrivacyKeyServiceTest, ShutdownSettlesReadinessAndIgnoresLateLoad) {
+  PrivacyKeyService service;
+  ASSERT_TRUE(service.InitializeOwnedProfile(owned_.GetPath()));
+  int calls = 0;
+  service.WhenReady(base::BindOnce([&](bool ready) { ++calls; EXPECT_FALSE(ready); }));
+  service.Shutdown();
+  EXPECT_EQ(calls, 1);
+  tasks_.RunUntilIdle();
+  service.Shutdown();
+  EXPECT_EQ(calls, 1);
+  service.WhenReady(base::BindOnce([&](bool ready) { ++calls; EXPECT_FALSE(ready); }));
+  EXPECT_EQ(calls, 2);
+}
+
+TEST_F(NativePrivacyKeyServiceTest, DestructionCancelsQueuedReadiness) {
+  auto service = std::make_unique<PrivacyKeyService>();
+  ASSERT_TRUE(service->InitializeOwnedProfile(owned_.GetPath()));
+  int calls = 0;
+  service->WhenReady(base::BindOnce([&](bool) { ++calls; }));
+  service.reset();
+  tasks_.RunUntilIdle();
+  EXPECT_EQ(calls, 0);
+}
+
+TEST_F(NativePrivacyKeyServiceTest, ReadyCallbackShutdownRejectsRemainingCallbacks) {
+  PrivacyKeyService service;
+  ASSERT_TRUE(service.InitializeOwnedProfile(owned_.GetPath()));
+  int calls = 0;
+  service.WhenReady(base::BindOnce([&](bool ready) {
