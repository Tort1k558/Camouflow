+
+TEST_F(NativePrivacyKeyServiceTest, ReadinessQueueHasExplicitBound) {
+  PrivacyKeyService service;
+  ASSERT_TRUE(service.InitializeOwnedProfile(owned_.GetPath()));
+  size_t successes = 0;
+  size_t rejections = 0;
+  for (size_t i = 0; i < PrivacyKeyService::kMaxPendingReadyCallbacks; ++i) {
+    service.WhenReady(base::BindOnce([&](bool ready) {
+      EXPECT_TRUE(ready);
+      ++successes;
+    }));
+  }
+  service.WhenReady(base::BindOnce([&](bool ready) { EXPECT_FALSE(ready); ++rejections; }));
+  EXPECT_EQ(successes, 0u);
+  EXPECT_EQ(rejections, 1u);
+  tasks_.RunUntilIdle();
+  EXPECT_EQ(successes, PrivacyKeyService::kMaxPendingReadyCallbacks);
+  EXPECT_EQ(rejections, 1u);
+}
