+  int calls = 0;
+  service.WhenReady(base::BindOnce([&](bool ready) {
+    ++calls;
+    EXPECT_TRUE(ready);
+    service.WhenReady(base::BindOnce([&](bool nested) { ++calls; EXPECT_TRUE(nested); }));
