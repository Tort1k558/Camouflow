+  task_environment_.FastForwardBy(base::Seconds(30));
+  EXPECT_FALSE(result.Get());
+}
+
+TEST_F(DOMStorageContextWrapperTest, CheckpointShutdownRejectsAndIsIdempotent) {
+  CheckpointLocalStorageControl backend(BindCheckpointControl());
+  backend.hang = true;
+  base::test::TestFuture<bool> result;
+  context_->FlushLocalStorageForCheckpoint(result.GetCallback());
+  task_environment_.RunUntilIdle();
+  context_->Shutdown();
+  context_->Shutdown();
+  EXPECT_FALSE(result.Get());
+  backend.ReplyAll(true);
+  task_environment_.RunUntilIdle();
+  base::test::TestFuture<bool> after_shutdown;
+  context_->FlushLocalStorageForCheckpoint(after_shutdown.GetCallback());
+  EXPECT_FALSE(after_shutdown.Get());
+}
+
+TEST_F(DOMStorageContextWrapperTest, CheckpointTimedOutWireSlotsRemainBounded) {
+  CheckpointLocalStorageControl backend(BindCheckpointControl());
+  backend.hang = true;
+  int failures = 0;
+  for (int i = 0; i < 64; ++i) {
+    context_->FlushLocalStorageForCheckpoint(base::BindOnce([&](bool success) {
+      EXPECT_FALSE(success);
+      ++failures;
+    }));
+  }
+  task_environment_.RunUntilIdle();
+  EXPECT_EQ(backend.calls, 64);
+  task_environment_.FastForwardBy(base::Seconds(30));
+  EXPECT_EQ(failures, 64);
+  base::test::TestFuture<bool> rejected;
+  context_->FlushLocalStorageForCheckpoint(rejected.GetCallback());
+  EXPECT_FALSE(rejected.Get());
+  EXPECT_EQ(backend.calls, 64);
+  backend.ReplyAll(true);
+  task_environment_.RunUntilIdle();
+  backend.hang = false;
+  base::test::TestFuture<bool> next;
+  context_->FlushLocalStorageForCheckpoint(next.GetCallback());
+  EXPECT_TRUE(next.Get());
+}
