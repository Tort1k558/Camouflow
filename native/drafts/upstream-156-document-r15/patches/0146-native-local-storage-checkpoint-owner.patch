+namespace {
+
+class CheckpointLocalStorageControl final
+    : public storage::mojom::LocalStorageControl {
+ public:
+  explicit CheckpointLocalStorageControl(
+      mojo::PendingReceiver<storage::mojom::LocalStorageControl> receiver)
+      : receiver_(this, std::move(receiver)) {}
+
+  void BindStorageArea(
+      const blink::StorageKey&,
+      mojo::PendingReceiver<blink::mojom::StorageArea>) override {}
+  void GetUsage(GetUsageCallback callback) override {
+    std::move(callback).Run({});
+  }
+  void DeleteStorage(const blink::StorageKey&,
+                     DeleteStorageCallback callback) override {
+    std::move(callback).Run();
+  }
+  void CleanUpStorage(CleanUpStorageCallback callback) override {
+    std::move(callback).Run();
+  }
+  void Flush() override { ++legacy_flushes; }
+  void PurgeMemory() override {}
+  void ApplyPolicyUpdates(
+      std::vector<storage::mojom::StoragePolicyUpdatePtr>) override {}
+  void ForceKeepSessionState() override {}
+  void FlushForCheckpoint(FlushForCheckpointCallback callback) override {
+    ++calls;
+    if (hang) {
+      pending.push_back(std::move(callback));
+    } else {
+      std::move(callback).Run(result);
+    }
+  }
+
+  void Disconnect() { receiver_.reset(); }
+  void ReplyAll(bool success) {
+    auto callbacks = std::move(pending);
+    for (auto& callback : callbacks) {
+      std::move(callback).Run(success);
+    }
+  }
+
+  bool result = true;
+  bool hang = false;
+  int calls = 0;
+  int legacy_flushes = 0;
+  std::vector<FlushForCheckpointCallback> pending;
+  mojo::Receiver<storage::mojom::LocalStorageControl> receiver_;
+};
+
+}  // namespace
