+void DOMStorageContextWrapper::RejectLocalStorageCheckpoints() {
+  DCHECK_CURRENTLY_ON(BrowserThread::UI);
+  checkpoint_weak_factory_.InvalidateWeakPtrs();
+  for (auto& [request_id, request] : local_storage_checkpoints_) {
+    request->Complete(false);
+  }
+  local_storage_checkpoints_.clear();
+}
+
+void DOMStorageContextWrapper::FlushLocalStorageForCheckpoint(
+    base::OnceCallback<void(bool)> callback) {
+  DCHECK_CURRENTLY_ON(BrowserThread::UI);
+  CHECK(callback);
+  if (checkpoint_shutdown_ || !local_storage_control_.is_bound() ||
+      !local_storage_control_.is_connected() ||
+      local_storage_checkpoints_.size() >= 64 ||
+      next_local_storage_checkpoint_id_ ==
+          std::numeric_limits<uint64_t>::max()) {
+    PostCheckpointResult(std::move(callback), false);
+    return;
+  }
+  const uint64_t id = ++next_local_storage_checkpoint_id_;
+  local_storage_checkpoints_.emplace(
+      id, std::make_unique<LocalStorageCheckpointRequest>(std::move(callback)));
+  local_storage_control_.QueryVersion(
+      base::BindOnce(&DOMStorageContextWrapper::OnLocalStorageCheckpointVersion,
+                     checkpoint_weak_factory_.GetWeakPtr(), id));
+}
+
+void DOMStorageContextWrapper::OnLocalStorageCheckpointVersion(
+    uint64_t request_id,
+    uint32_t version) {
+  DCHECK_CURRENTLY_ON(BrowserThread::UI);
+  auto it = local_storage_checkpoints_.find(request_id);
+  if (it == local_storage_checkpoints_.end()) {
+    return;
+  }
+  if (version < 1 || !it->second->callback ||
+      !local_storage_control_.is_connected()) {
+    OnLocalStorageCheckpointComplete(request_id, false);
+    return;
+  }
+  local_storage_control_->FlushForCheckpoint(base::BindOnce(
+      &DOMStorageContextWrapper::OnLocalStorageCheckpointComplete,
+      checkpoint_weak_factory_.GetWeakPtr(), request_id));
+}
+
+void DOMStorageContextWrapper::OnLocalStorageCheckpointComplete(
+    uint64_t request_id,
+    bool success) {
+  DCHECK_CURRENTLY_ON(BrowserThread::UI);
+  auto it = local_storage_checkpoints_.find(request_id);
+  if (it == local_storage_checkpoints_.end()) {
+    return;
+  }
+  if (success && local_storage_control_.is_connected()) {
+    it->second->Succeed(checkpoint_weak_factory_.GetWeakPtr());
+  } else {
+    it->second->Complete(false);
+  }
+  local_storage_checkpoints_.erase(it);
+}
