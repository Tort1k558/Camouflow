+    if (callback) {
+      PostCheckpointResult(std::move(callback), success);
+    }
+  }
+
+  void Succeed(base::WeakPtr<DOMStorageContextWrapper> owner) {
+    deadline.Stop();
+    if (!callback) {
+      return;
+    }
+    base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE,
+        base::BindOnce(
+            [](base::WeakPtr<DOMStorageContextWrapper> owner,
+               base::OnceCallback<void(bool)> done) {
+              std::move(done).Run(owner && !owner->checkpoint_shutdown_ &&
+                                  owner->local_storage_control_.is_connected());
+            },
+            std::move(owner), std::move(callback)));
+  }
+
+  base::OnceCallback<void(bool)> callback;
+  base::OneShotTimer deadline;
+};
 
