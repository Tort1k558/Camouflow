+// Native command-recording receipt, not proof of GPU completion. Output snapshots
+// still require their existing submission/fence checks before CPU bytes are exposed.
+class DAWN_NATIVE_EXPORT GlintGpuInputReceipt final {
+  public:
+    GlintGpuInputReceipt(const GlintGpuInputReceipt&) = delete;
+    GlintGpuInputReceipt& operator=(const GlintGpuInputReceipt&) = delete;
+    const std::shared_ptr<const GlintGpuInputPlan>& GetPlan() const { return mPlan; }
+
+  private:
+    friend class d3d12::CommandBuffer;
+    explicit GlintGpuInputReceipt(std::shared_ptr<const GlintGpuInputPlan> plan)
+        : mPlan(std::move(plan)) {}
+    const std::shared_ptr<const GlintGpuInputPlan> mPlan;
 };
 
