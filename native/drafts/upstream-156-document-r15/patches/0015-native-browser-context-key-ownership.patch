@@ -0,0 +1,32 @@
+// Copyright 2026 CamouFlow contributors.
+// SPDX-License-Identifier: MIT
+#ifndef CONTENT_PUBLIC_BROWSER_NATIVE_PRIVACY_CONTEXT_H_
+#define CONTENT_PUBLIC_BROWSER_NATIVE_PRIVACY_CONTEXT_H_
+
+#include <array>
+#include <cstdint>
+#include <optional>
+#include <string_view>
+#include "content/common/content_export.h"
+
+namespace base { class FilePath; }
+namespace blink { class StorageKey; }
+namespace content {
+class BrowserContext;
+
+// Explicit development opt-in; does not enable any protected fingerprint surface.
+inline constexpr char kNativePrivacyKeyServiceSwitch[] = "camouflow-native-privacy-key-service";
+
+// UI thread only. Persistent roots must be owned and process-locked by the embedder.
+// Off-the-record contexts require an empty root and never read the persistent key.
+CONTENT_EXPORT bool InitializeNativePrivacyContext(BrowserContext* context,
+                                                   const base::FilePath& owned_root);
+CONTENT_EXPORT void ShutdownNativePrivacyContext(BrowserContext* context);
+CONTENT_EXPORT bool IsNativePrivacyContextReady(BrowserContext* context);
+// The caller supplies a browser-owned StorageKey, never a renderer-provided URL.
+CONTENT_EXPORT std::optional<std::array<uint8_t, 32>> DeriveNativePrivacyKey(
+    BrowserContext* context, const blink::StorageKey& trusted_partition,
+    std::string_view surface);
+}  // namespace content
+
+#endif  // CONTENT_PUBLIC_BROWSER_NATIVE_PRIVACY_CONTEXT_H_
