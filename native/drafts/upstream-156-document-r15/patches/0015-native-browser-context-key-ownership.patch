+class PrivacyTestOwner final : public base::SupportsUserData {
+ public:
+  ~PrivacyTestOwner() override = default;
+};
+
+TEST_F(NativePrivacyKeyServiceTest, OwnerInstallationIsSingleUse) {
+  PrivacyTestOwner owner;
+  EXPECT_EQ(PrivacyKeyService::GetForOwner(owner), nullptr);
+  ASSERT_TRUE(PrivacyKeyService::InstallOwnedProfile(owner, owned_.GetPath()));
+  auto* service = PrivacyKeyService::GetForOwner(owner);
+  ASSERT_NE(service, nullptr);
+  EXPECT_EQ(service->state(), State::kLoading);
+  EXPECT_FALSE(PrivacyKeyService::InstallEphemeral(owner));
+  EXPECT_FALSE(PrivacyKeyService::InstallOwnedProfile(owner, owned_.GetPath()));
+  tasks_.RunUntilIdle();
+  EXPECT_EQ(service->state(), State::kReady);
+}
+
+TEST_F(NativePrivacyKeyServiceTest, OwnerDestructionDuringLoadDropsReply) {
+  auto owner = std::make_unique<PrivacyTestOwner>();
+  ASSERT_TRUE(PrivacyKeyService::InstallOwnedProfile(*owner, owned_.GetPath()));
+  owner.reset();
+  tasks_.RunUntilIdle();
+}
+
+TEST_F(NativePrivacyKeyServiceTest, FailedOwnerCannotReplaceIdentity) {
+  ASSERT_TRUE(base::DeleteFile(owned_.GetPath().AppendASCII("camouflow-native-privacy.json")));
+  PrivacyTestOwner owner;
+  ASSERT_TRUE(PrivacyKeyService::InstallOwnedProfile(owner, owned_.GetPath()));
+  tasks_.RunUntilIdle();
+  EXPECT_EQ(PrivacyKeyService::GetForOwner(owner)->state(), State::kFailed);
+  EXPECT_FALSE(PrivacyKeyService::InstallEphemeral(owner));
+}
+
+TEST_F(NativePrivacyKeyServiceTest, IndependentOwnersDoNotRedirectToOriginal) {
+  PrivacyTestOwner original;
+  PrivacyTestOwner off_the_record;
+  ASSERT_TRUE(PrivacyKeyService::InstallOwnedProfile(original, owned_.GetPath()));
+  ASSERT_TRUE(PrivacyKeyService::InstallEphemeral(off_the_record));
+  tasks_.RunUntilIdle();
+  auto* persistent = PrivacyKeyService::GetForOwner(original);
+  auto* ephemeral = PrivacyKeyService::GetForOwner(off_the_record);
+  ASSERT_NE(persistent, ephemeral);
+  const auto a = persistent->Derive(Partition(), "canvas");
+  const auto b = ephemeral->Derive(Partition(), "canvas");
+  ASSERT_TRUE(a);
+  ASSERT_TRUE(b);
+  EXPECT_NE(a, b);
+  ephemeral->Shutdown();
+  EXPECT_EQ(a, persistent->Derive(Partition(), "canvas"));
+}
+
+TEST_F(NativePrivacyKeyServiceTest, InvalidOwnerInstallDoesNotOccupySlot) {
+  PrivacyTestOwner owner;
+  EXPECT_FALSE(PrivacyKeyService::InstallOwnedProfile(owner, base::FilePath(FILE_PATH_LITERAL("relative"))));
+  EXPECT_EQ(PrivacyKeyService::GetForOwner(owner), nullptr);
+  EXPECT_TRUE(PrivacyKeyService::InstallEphemeral(owner));
+}
+
+TEST_F(NativePrivacyKeyServiceTest, OwnerDataCloneDoesNotCopyPrivateIdentity) {
+  PrivacyTestOwner original;
+  PrivacyTestOwner cloned;
+  ASSERT_TRUE(PrivacyKeyService::InstallEphemeral(original));
+  cloned.CloneDataFrom(original);
+  EXPECT_EQ(PrivacyKeyService::GetForOwner(cloned), nullptr);
+  ASSERT_TRUE(PrivacyKeyService::InstallEphemeral(cloned));
+  const auto a = PrivacyKeyService::GetForOwner(original)->Derive(Partition(), "canvas");
+  const auto b = PrivacyKeyService::GetForOwner(cloned)->Derive(Partition(), "canvas");
+  ASSERT_TRUE(a);
+  ASSERT_TRUE(b);
+  EXPECT_NE(a, b);
+}
+
 }  // namespace
