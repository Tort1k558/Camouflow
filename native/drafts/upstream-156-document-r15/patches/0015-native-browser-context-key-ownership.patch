diff --git a/content/browser/camouflow_native/privacy_context.cc b/content/browser/camouflow_native/privacy_context.cc
new file mode 100644
index 0000000..9c77a6f
--- /dev/null
+++ b/content/browser/camouflow_native/privacy_context.cc
@@ -0,0 +1,52 @@
+// Copyright 2026 CamouFlow contributors.
+// SPDX-License-Identifier: MIT
+#include "content/public/browser/native_privacy_context.h"
+
+#include "base/files/file_path.h"
+#include "content/browser/camouflow_native/privacy_key_service.h"
+#include "content/public/browser/browser_context.h"
+#include "content/public/browser/browser_thread.h"
+
+namespace content {
+using camouflow::native::PrivacyKeyService;
+
+bool InitializeNativePrivacyContext(BrowserContext* context,
+                                    const base::FilePath& owned_root) {
+  DCHECK_CURRENTLY_ON(BrowserThread::UI);
+  if (!context || context->ShutdownStarted()) {
+    return false;
+  }
+  if (context->IsOffTheRecord()) {
+    return owned_root.empty() && PrivacyKeyService::InstallEphemeral(*context);
+  }
+  return PrivacyKeyService::InstallOwnedProfile(*context, owned_root);
+}
+
+void ShutdownNativePrivacyContext(BrowserContext* context) {
+  DCHECK_CURRENTLY_ON(BrowserThread::UI);
+  if (context) {
+    if (auto* service = PrivacyKeyService::GetForOwner(*context)) {
+      service->Shutdown();
+    }
+  }
+}
+
+bool IsNativePrivacyContextReady(BrowserContext* context) {
+  DCHECK_CURRENTLY_ON(BrowserThread::UI);
+  if (!context || context->ShutdownStarted()) {
+    return false;
+  }
+  auto* service = PrivacyKeyService::GetForOwner(*context);
+  return service && service->state() == PrivacyKeyService::State::kReady;
+}
+
+std::optional<std::array<uint8_t, 32>> DeriveNativePrivacyKey(
+    BrowserContext* context, const blink::StorageKey& trusted_partition,
+    std::string_view surface) {
+  DCHECK_CURRENTLY_ON(BrowserThread::UI);
+  if (!IsNativePrivacyContextReady(context)) {
+    return std::nullopt;
+  }
+  return PrivacyKeyService::GetForOwner(*context)->Derive(trusted_partition, surface);
+}
+}  // namespace content
diff --git a/content/browser/camouflow_native/privacy_key_service.cc b/content/browser/camouflow_native/privacy_key_service.cc
