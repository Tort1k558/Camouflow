@@ -7,6 +7,39 @@
 
 namespace camouflow::native {
 
+namespace {
+const int kPrivacyKeyServiceUserDataKey = 0;
+}  // namespace
+
+PrivacyKeyService* PrivacyKeyService::GetForOwner(base::SupportsUserData& owner) {
+  return static_cast<PrivacyKeyService*>(owner.GetUserData(&kPrivacyKeyServiceUserDataKey));
+}
+
+bool PrivacyKeyService::InstallOwnedProfile(base::SupportsUserData& owner,
+                                           const base::FilePath& owned_profile) {
+  if (GetForOwner(owner)) {
+    return false;
+  }
+  auto service = std::make_unique<PrivacyKeyService>();
+  if (!service->InitializeOwnedProfile(owned_profile)) {
+    return false;
+  }
+  owner.SetUserData(&kPrivacyKeyServiceUserDataKey, std::move(service));
+  return true;
+}
+
+bool PrivacyKeyService::InstallEphemeral(base::SupportsUserData& owner) {
+  if (GetForOwner(owner)) {
+    return false;
+  }
+  auto service = std::make_unique<PrivacyKeyService>();
+  if (!service->InitializeEphemeral()) {
+    return false;
+  }
+  owner.SetUserData(&kPrivacyKeyServiceUserDataKey, std::move(service));
+  return true;
+}
+
 PrivacyKeyService::PrivacyKeyService() = default;
 PrivacyKeyService::~PrivacyKeyService() { Shutdown(); }
 
