+void RestrictedCookieManager::DrainCookieWritesForCheckpoint(
+    base::OnceCallback<void(bool)> callback) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  CHECK(callback);
+  if (checkpoint_cookie_tracking_broken_ || cookie_write_drains_.size() >= 64 ||
+      next_cookie_write_drain_id_ == std::numeric_limits<uint64_t>::max()) {
+    base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE, base::BindOnce(std::move(callback), false));
+    return;
+  }
+  const uint64_t id = ++next_cookie_write_drain_id_;
+  auto request = std::make_unique<CookieWriteDrainRequest>(
+      checkpoint_cookie_write_serial_, std::move(callback));
+  request->deadline.Start(
+      FROM_HERE, base::Seconds(30),
+      base::BindOnce(&RestrictedCookieManager::FinishCookieWriteDrain,
+                     weak_ptr_factory_.GetWeakPtr(), id, false));
+  cookie_write_drains_.emplace(id, std::move(request));
+  if (pending_checkpoint_cookie_writes_.empty()) {
+    FinishCookieWriteDrain(id, true);
+  }
+}
+
+uint64_t RestrictedCookieManager::BeginCheckpointCookieWrite() {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  RejectCookieWriteDrains();
+  if (checkpoint_cookie_tracking_broken_) {
+    return 0;
+  }
+  if (pending_checkpoint_cookie_writes_.size() >= 4096 ||
+      checkpoint_cookie_write_serial_ == std::numeric_limits<uint64_t>::max()) {
+    BreakCookieWriteTracking();
+    return 0;
+  }
+  const uint64_t serial = ++checkpoint_cookie_write_serial_;
+  pending_checkpoint_cookie_writes_.insert(serial);
+  return serial;
+}
+
+void RestrictedCookieManager::CompleteCheckpointCookieWrite(uint64_t serial) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  if (checkpoint_cookie_tracking_broken_ || serial == 0) {
+    return;
+  }
+  if (pending_checkpoint_cookie_writes_.erase(serial) != 1) {
+    BreakCookieWriteTracking();
+    return;
+  }
+  if (pending_checkpoint_cookie_writes_.empty()) {
+    while (!cookie_write_drains_.empty()) {
+      FinishCookieWriteDrain(cookie_write_drains_.begin()->first, true);
+    }
+  }
+}
+
+void RestrictedCookieManager::FinishCookieWriteDrain(uint64_t request_id,
+                                                     bool success) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  auto it = cookie_write_drains_.find(request_id);
+  if (it == cookie_write_drains_.end()) {
+    return;
+  }
+  const uint64_t epoch = it->second->epoch;
+  auto callback = std::move(it->second->callback);
+  cookie_write_drains_.erase(it);
+  base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE,
+      base::BindOnce(
+          [](base::WeakPtr<RestrictedCookieManager> owner, uint64_t epoch,
+             bool success, base::OnceCallback<void(bool)> callback) {
+            std::move(callback).Run(
+                success && owner &&
+                !owner->checkpoint_cookie_tracking_broken_ &&
+                owner->checkpoint_cookie_write_serial_ == epoch &&
+                owner->pending_checkpoint_cookie_writes_.empty());
+          },
+          weak_ptr_factory_.GetWeakPtr(), epoch, success, std::move(callback)));
+}
+
+void RestrictedCookieManager::RejectCookieWriteDrains() {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  while (!cookie_write_drains_.empty()) {
+    FinishCookieWriteDrain(cookie_write_drains_.begin()->first, false);
+  }
+}
+
+void RestrictedCookieManager::BreakCookieWriteTracking() {
+  checkpoint_cookie_tracking_broken_ = true;
+  pending_checkpoint_cookie_writes_.clear();
+  RejectCookieWriteDrains();
 }
 
