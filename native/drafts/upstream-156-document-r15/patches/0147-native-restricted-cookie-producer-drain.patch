+
+TEST_P(RestrictedCookieManagerCheckpointDrainTest,
+       CheckpointDrainEmptyPostsSuccess) {
+  base::test::TestFuture<bool> done;
+  service_->DrainCookieWritesForCheckpoint(done.GetCallback());
+  EXPECT_FALSE(done.IsReady());
+  EXPECT_TRUE(done.Get());
+}
+
+TEST_P(RestrictedCookieManagerCheckpointDrainTest,
+       CheckpointDrainWaitsForAllOutOfOrderWrites) {
+  const auto first = BeginCheckpointWrite();
+  const auto second = BeginCheckpointWrite();
+  base::test::TestFuture<bool> done;
+  service_->DrainCookieWritesForCheckpoint(done.GetCallback());
+  CompleteCheckpointWrite(second);
+  task_environment_.RunUntilIdle();
+  EXPECT_FALSE(done.IsReady());
+  CompleteCheckpointWrite(first);
+  EXPECT_TRUE(done.Get());
+}
+
+TEST_P(RestrictedCookieManagerCheckpointDrainTest,
+       CheckpointDrainNewWriteRejectsPending) {
+  const auto first = BeginCheckpointWrite();
+  base::test::TestFuture<bool> done;
+  service_->DrainCookieWritesForCheckpoint(done.GetCallback());
+  const auto second = BeginCheckpointWrite();
+  EXPECT_FALSE(done.Get());
+  CompleteCheckpointWrite(first);
+  CompleteCheckpointWrite(second);
+}
