+void StorageController::FenceLocalStorageForCheckpoint(
+    base::TimeTicks deadline,
+    base::OnceCallback<void(bool)> callback) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  CHECK(callback);
+  StorageNamespace* current = local_storage_namespace_.Get();
+  const uint64_t namespace_generation =
+      current ? current->LocalStorageCheckpointGeneration() : 0;
+  const bool admitted = !deadline.is_max() &&
+                        deadline > base::TimeTicks::Now() &&
+                        checkpoint_requests_ < 64;
+  if (admitted) {
+    ++checkpoint_requests_;
+  }
+  auto reply = base::BindPostTaskToCurrentDefault(base::BindOnce(
+      [](base::WeakPtr<StorageController> owner,
+         WeakPersistent<StorageNamespace> captured, bool had_namespace,
+         uint64_t generation, uint64_t namespace_generation,
+         base::TimeTicks deadline, bool admitted,
+         base::OnceCallback<void(bool)> callback, bool success) {
+        if (admitted && owner) {
+          CHECK_GT(owner->checkpoint_requests_, 0u);
+          --owner->checkpoint_requests_;
+        }
+        std::move(callback).Run(
+            success && owner && owner->checkpoint_generation_ == generation &&
+            owner->local_storage_namespace_.Get() == captured.Get() &&
+            (!had_namespace ||
+             (captured && captured->LocalStorageCheckpointGeneration() ==
+                              namespace_generation)) &&
+            base::TimeTicks::Now() < deadline);
+      },
+      checkpoint_weak_factory_.GetWeakPtr(),
+      WeakPersistent<StorageNamespace>(current), current != nullptr,
+      checkpoint_generation_, namespace_generation, deadline, admitted,
+      std::move(callback)));
+  if (!admitted) {
+    std::move(reply).Run(false);
+  } else if (current) {
+    current->FenceLocalStorageForCheckpoint(deadline, std::move(reply));
+  } else {
+    // Do not create a namespace just to manufacture a positive fence result.
+    std::move(reply).Run(true);
+  }
+}
