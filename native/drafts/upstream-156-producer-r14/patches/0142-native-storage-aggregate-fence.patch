+void StorageNamespace::FenceLocalStorageForCheckpoint(
+    base::TimeTicks deadline,
+    base::OnceCallback<void(bool)> callback) {
+  CHECK(callback);
+  const uint64_t generation = checkpoint_generation_;
+  const bool admitted = !IsSessionStorage() && !deadline.is_max() &&
+                        deadline > base::TimeTicks::Now() &&
+                        !checkpoint_failed_eviction_ &&
+                        checkpoint_requests_ < 64;
+  if (admitted) {
+    ++checkpoint_requests_;
+  }
+  auto reply = base::BindPostTaskToCurrentDefault(base::BindOnce(
+      [](WeakPersistent<StorageNamespace> owner, uint64_t generation,
+         base::TimeTicks deadline, bool admitted,
+         base::OnceCallback<void(bool)> callback, bool success) {
+        if (admitted && owner) {
+          CHECK_GT(owner->checkpoint_requests_, 0u);
+          --owner->checkpoint_requests_;
+        }
+        // The epoch includes mutations in areas which completed before others.
+        std::move(callback).Run(success && owner &&
+                                !owner->IsSessionStorage() &&
+                                !owner->checkpoint_failed_eviction_ &&
+                                owner->checkpoint_generation_ == generation &&
+                                base::TimeTicks::Now() < deadline);
+      },
+      WeakPersistent<StorageNamespace>(this), generation, deadline, admitted,
+      std::move(callback)));
+  if (!admitted) {
+    std::move(reply).Run(false);
+    return;
+  }
+  if (cached_areas_.empty()) {
+    std::move(reply).Run(true);
+    return;
+  }
+  auto barrier = base::BarrierCallback<bool>(
+      cached_areas_.size(), base::BindOnce(
+                                [](base::OnceCallback<void(bool)> callback,
+                                   std::vector<bool> results) {
+                                  std::move(callback).Run(std::all_of(
+                                      results.begin(), results.end(),
+                                      [](bool success) { return success; }));
+                                },
+                                std::move(reply)));
+  for (const auto& area : cached_areas_) {
+    area.value->FenceMutationsForCheckpoint(deadline, barrier);
+  }
 }
 
