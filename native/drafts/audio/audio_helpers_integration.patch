+// Copyright 2026 CamouFlow contributors.
+// SPDX-License-Identifier: MIT
+#ifndef GLINT_OFFLINE_AUDIO_BUFFER_H_
+#define GLINT_OFFLINE_AUDIO_BUFFER_H_
+
+#include <array>
+#include <cstdint>
+
+namespace blink {
+class AudioBuffer;
+}
+
+namespace glint::candidate {
+// A detached result only. Never exposes a partial transform or mutates source.
+// No caller should fall back to unprotected output when this returns nullptr.
+blink::AudioBuffer* CopyOfflineAudioBuffer(
+    blink::AudioBuffer& source,
+    const std::array<uint8_t, 32>& audio_seed);
+}  // namespace glint::candidate
+
+#endif
diff --git a/third_party/blink/renderer/modules/webaudio/glint/offline_audio_buffer.cc b/third_party/blink/renderer/modules/webaudio/glint/offline_audio_buffer.cc
new file mode 100644
--- /dev/null
+++ b/third_party/blink/renderer/modules/webaudio/glint/offline_audio_buffer.cc
@@ -0,0 +1,44 @@
+// Copyright 2026 CamouFlow contributors.
+// SPDX-License-Identifier: MIT
+#include "offline_audio_buffer.h"
+
+#include "offline_audio_candidate.h"
+#include "offline_audio_limits.h"
+#include "third_party/blink/renderer/modules/webaudio/audio_buffer.h"
+
+namespace glint::candidate {
+blink::AudioBuffer* CopyOfflineAudioBuffer(
+    blink::AudioBuffer& source,
+    const std::array<uint8_t, 32>& audio_seed) {
+  const auto channels = source.numberOfChannels();
+  const auto frames = source.length();
+  if (!CanCopyOfflineAudio(channels, frames)) {
+    return nullptr;
+  }
+  // Check every source before allocation; detached/invalid channel views reject.
+  for (unsigned channel = 0; channel < channels; ++channel) {
+    auto input = source.getChannelData(channel);
+    if (!input || input->AsSpan().size() != frames) {
+      return nullptr;
+    }
+  }
+  auto* output = blink::AudioBuffer::CreateUninitialized(
+      channels, frames, source.sampleRate());
+  if (!output) {
+    return nullptr;
+  }
+  OfflineAudioMasker masker(audio_seed);
+  for (unsigned channel = 0; channel < channels; ++channel) {
+    const auto input = source.getChannelData(channel)->AsSpan();
+    auto destination = output->getChannelData(channel)->AsSpan();
+    for (size_t index = 0; index < input.size(); ++index) {
+      auto value = masker.Transform(input[index]);
+      if (!value) {
+        return nullptr;
+      }
+      destination[index] = *value;
+    }
+  }
+  return output;
+}
+}  // namespace glint::candidate
diff --git a/third_party/blink/renderer/modules/webaudio/glint/offline_audio_candidate_unittest.cc b/third_party/blink/renderer/modules/webaudio/glint/offline_audio_candidate_unittest.cc
