+// Copyright 2026 CamouFlow contributors.
+// SPDX-License-Identifier: MIT
+#include "glint_webgpu_readback_observer.h"
+
+#include <openssl/mem.h>
+
+#include <algorithm>
+#include <limits>
+
+namespace gpu::webgpu {
+namespace {
+using namespace glint::candidate;
+using dawn::native::GlintReadbackMapStatus;
+
+class ScopedSeed {
+ public:
+  explicit ScopedSeed(std::span<const uint8_t, 32> source);
+  ~ScopedSeed();
+  const std::array<uint8_t, 32>& bytes() const { return bytes_; }
+
+ private:
+  std::array<uint8_t, 32> bytes_;
+};
+ScopedSeed::ScopedSeed(std::span<const uint8_t, 32> source) {
+  std::copy(source.begin(), source.end(), bytes_.begin());
+}
+ScopedSeed::~ScopedSeed() {
+  OPENSSL_cleanse(bytes_.data(), bytes_.size());
+}
+
+std::optional<WebGpuPixelFormat> PixelFormat(
+    dawn::native::GlintReadbackFormat format) {
+  switch (format) {
+    case dawn::native::GlintReadbackFormat::Rgba8Unorm:
+      return WebGpuPixelFormat::kRgba8Unorm;
+    case dawn::native::GlintReadbackFormat::Bgra8Unorm:
+      return WebGpuPixelFormat::kBgra8Unorm;
+    default:
+      return std::nullopt;
+  }
+}
+}  // namespace
+
+GlintWebGPUReadbackObserver::BufferState::BufferState(size_t bytes,
+                                                      uint64_t epoch)
+    : size(bytes), provenance(bytes, epoch) {}
+GlintWebGPUReadbackObserver::PendingCapture::PendingCapture() = default;
+GlintWebGPUReadbackObserver::PendingCapture::~PendingCapture() = default;
+GlintWebGPUReadbackObserver::GlintWebGPUReadbackObserver(
+    std::shared_ptr<const GlintWebGPUDevicePolicy> policy,
+    uint64_t epoch,
+    GlintReadbackLimits limits)
+    : policy_(std::move(policy)),
+      epoch_(epoch),
+      limits_(limits),
+      snapshots_(epoch,
+                 policy_ ? policy_->generation() : 0,
+                 limits.snapshots,
+                 limits.shadow) {
+  failed_ = !policy_ || policy_->generation() == 0 || epoch == 0 ||
+            limits.buffers == 0 || limits.snapshots == 0 || limits.shadow == 0;
+}
+GlintWebGPUReadbackObserver::~GlintWebGPUReadbackObserver() = default;
+bool GlintWebGPUReadbackObserver::IsHealthy() const {
+  std::lock_guard lock(mutex_);
+  return !failed_;
+}
+void GlintWebGPUReadbackObserver::Drop(PendingCapture& capture) {
+  if (capture.token.snapshot_id != 0) {
+    snapshots_.Release(capture.token);
+  }
+  capture.native.reset();
+  capture.token = {};
+  capture.layout = {};
+  capture.complete = false;
+}
+void GlintWebGPUReadbackObserver::Fail() {
+  failed_ = true;
+  buffers_.clear();
+  for (auto& capture : pending_) {
+    Drop(capture);
+  }
+  snapshots_.Destroy();
+}
+uint64_t GlintWebGPUReadbackObserver::NextSequence() {
+  if (failed_ || sequence_ == std::numeric_limits<uint64_t>::max()) {
+    Fail();
+    return 0;
+  }
+  return ++sequence_;
+}
+GlintWebGPUReadbackObserver::BufferState*
+GlintWebGPUReadbackObserver::GetBuffer(
+    dawn::native::GlintBufferIdentity buffer) {
+  if (failed_) {
+    return nullptr;
+  }
+  if (!buffer.handle || buffer.size > std::numeric_limits<size_t>::max()) {
+    Fail();
+    return nullptr;
+  }
+  auto found = buffers_.find(buffer.handle);
+  if (found != buffers_.end()) {
+    if (found->second.size != buffer.size) {
+      Fail();
+      return nullptr;
+    }
+    return &found->second;
+  }
+  if (buffers_.size() >= limits_.buffers) {
+    Fail();
+    return nullptr;
+  }
+  return &buffers_
+              .try_emplace(buffer.handle, static_cast<size_t>(buffer.size),
+                           epoch_)
+              .first->second;
+}
+void GlintWebGPUReadbackObserver::Collect() {
+  std::array<bool, kWebGpuReadbackRegionLimit> referenced{};
+  for (const auto& [handle, buffer] : buffers_) {
+    if (buffer.unsafe) {
+      continue;
+    }
+    const auto plan = buffer.provenance.PlanMap(0, buffer.size);
+    for (size_t index = 0; index < plan.count; ++index) {
+      for (size_t slot = 0; slot < pending_.size(); ++slot) {
+        if (pending_[slot].token == plan.regions[index].snapshot) {
+          referenced[slot] = true;
+        }
+      }
+    }
+  }
+  for (size_t slot = 0; slot < pending_.size(); ++slot) {
+    if (!referenced[slot] && pending_[slot].token.snapshot_id != 0) {
+      Drop(pending_[slot]);
+    }
+  }
+}
+void GlintWebGPUReadbackObserver::OnTextureToBufferCopy(
+    const dawn::native::GlintTextureToBufferCopy& copy,
+    std::unique_ptr<dawn::native::GlintReadbackSnapshot> native) {
+  std::lock_guard lock(mutex_);
+  auto* buffer = GetBuffer(copy.destination);
+  const uint64_t sequence = NextSequence();
+  if (!buffer || !sequence) {
+    return;
+  }
+  const auto format = PixelFormat(copy.format);
+  auto free = std::find_if(
+      pending_.begin(), pending_.end(),
+      [](const PendingCapture& value) { return value.token.snapshot_id == 0; });
+  if (buffer->unsafe || !native || !format ||
+      native->GetFormat() != copy.format ||
+      copy.destinationRowPitch > std::numeric_limits<uint32_t>::max() ||
+      snapshot_id_ == std::numeric_limits<uint64_t>::max() ||
+      free == pending_.end()) {
+    buffer->unsafe = true;
+    Collect();
+    return;
+  }
+  const WebGpuReadbackLayout full{0, native->GetRowPitch(), native->GetWidth(),
+                                  native->GetHeight(), *format};
+  const WebGpuReadbackLayout region{
+      copy.destinationOffset, static_cast<uint32_t>(copy.destinationRowPitch),
+      copy.width, copy.height, *format};
+  const WebGpuSourceRect rectangle{copy.sourceX, copy.sourceY, full.width,
+                                   full.height};
+  const WebGpuSnapshotToken token{epoch_, ++snapshot_id_, sequence,
+                                  policy_->generation()};
+  if (!snapshots_.BeginCapture(token, full)) {
+    buffer->unsafe = true;
+    Collect();
+    return;
+  }
+  free->token = token;
+  free->layout = full;
+  free->native = std::move(native);
+  if (!buffer->provenance.RecordTextureCopy(sequence, region, token,
+                                            rectangle)) {
+    buffer->unsafe = true;
+  }
+  Collect();
+}
+void GlintWebGPUReadbackObserver::OnBufferToBufferCopy(
+    dawn::native::GlintBufferIdentity source,
+    uint64_t source_offset,
+    dawn::native::GlintBufferIdentity destination,
+    uint64_t destination_offset,
+    uint64_t size) {
+  std::lock_guard lock(mutex_);
+  auto* from = GetBuffer(source);
+  auto* to = GetBuffer(destination);
+  const uint64_t sequence = NextSequence();
+  if (!from || !to || !sequence) {
+    return;
+  }
+  if (from->unsafe || to->unsafe ||
+      !to->provenance.RecordBufferCopy(sequence, destination_offset,
+                                       from->provenance, source_offset, size)) {
+    to->unsafe = true;
+  }
+  Collect();
+}
+void GlintWebGPUReadbackObserver::OnBufferWrite(
+    dawn::native::GlintBufferIdentity buffer,
+    uint64_t offset,
+    uint64_t size,
+    dawn::native::GlintBufferWriteKind kind) {
+  std::lock_guard lock(mutex_);
+  auto* target = GetBuffer(buffer);
+  const uint64_t sequence = NextSequence();
+  if (!target || !sequence) {
+    return;
+  }
+  bool valid = false;
+  switch (kind) {
+    case dawn::native::GlintBufferWriteKind::KnownBytes:
+      valid = target->provenance.InvalidateWrite(sequence, offset, size);
+      break;
+    case dawn::native::GlintBufferWriteKind::Uncertain:
+      valid = target->provenance.RecordUncertainWrite(sequence, offset, size);
+      break;
+  }
+  if (!valid) {
+    target->unsafe = true;
+  }
+  Collect();
+}
+void GlintWebGPUReadbackObserver::OnBufferDestroyed(WGPUBuffer buffer) {
+  std::lock_guard lock(mutex_);
+  buffers_.erase(buffer);
+  Collect();
+}
+GlintReadbackMapStatus GlintWebGPUReadbackObserver::Classify(
+    BufferState* buffer,
+    uint64_t offset,
+    uint64_t size) const {
+  if (failed_ || !buffer || buffer->unsafe) {
+    return GlintReadbackMapStatus::Denied;
+  }
+  switch (buffer->provenance.PlanMap(offset, size).status) {
+    case WebGpuMapProvenance::kUnrelated:
+      return GlintReadbackMapStatus::Unrelated;
+    case WebGpuMapProvenance::kReadback:
+      return GlintReadbackMapStatus::Protected;
+    default:
+      return GlintReadbackMapStatus::Denied;
+  }
+}
+GlintReadbackMapStatus GlintWebGPUReadbackObserver::ClassifyReadMap(
+    dawn::native::GlintBufferIdentity buffer,
+    uint64_t offset,
+    uint64_t size) {
+  std::lock_guard lock(mutex_);
+  return Classify(GetBuffer(buffer), offset, size);
+}
+dawn::native::GlintReadbackStatus GlintWebGPUReadbackObserver::Complete(
+    const WebGpuReadbackPlan& plan) {
+  using dawn::native::GlintReadbackStatus;
+  for (size_t index = 0; index < plan.count; ++index) {
+    auto found = std::find_if(
+        pending_.begin(), pending_.end(), [&](const PendingCapture& value) {
+          return value.token == plan.regions[index].snapshot;
+        });
+    if (found == pending_.end()) {
+      return GlintReadbackStatus::Failed;
+    }
+    if (found->complete) {
+      continue;
+    }
+    std::span<const uint8_t> original;
+    if (!found->native) {
+      return GlintReadbackStatus::Failed;
+    }
+    const auto status = found->native->Read(&original);
+    if (status != GlintReadbackStatus::Ready) {
+      return status;
+    }
+    const ScopedSeed seed(policy_->seed());
+    if (!snapshots_.CompleteCapture(found->token, found->layout, 0, original,
+                                    seed.bytes())) {
+      return GlintReadbackStatus::Failed;
+    }
+    found->complete = true;
+    found->native.reset();
+  }
+  return GlintReadbackStatus::Ready;
+}
+dawn::native::GlintReadbackMap GlintWebGPUReadbackObserver::PrepareReadMap(
+    dawn::native::GlintBufferIdentity identity,
+    uint64_t offset,
+    std::span<const uint8_t> original) {
+  std::lock_guard lock(mutex_);
+  auto* buffer = GetBuffer(identity);
+  const auto status = Classify(buffer, offset, original.size());
+  if (status != GlintReadbackMapStatus::Protected) {
+    return {status, nullptr, 0};
+  }
+  const auto plan = buffer->provenance.PlanMap(offset, original.size());
+  const auto completion = Complete(plan);
+  if (completion != dawn::native::GlintReadbackStatus::Ready) {
+    if (completion == dawn::native::GlintReadbackStatus::Failed) {
+      buffer->unsafe = true;
+      Collect();
+    }
+    return {};
+  }
+  auto shadow = snapshots_.BuildProtectedShadow(plan, offset, original);
+  if (!shadow) {
+    buffer->unsafe = true;
+    Collect();
+    return {};
+  }
+  return {GlintReadbackMapStatus::Protected, std::move(shadow->bytes),
+          shadow->size};
+}
+}  // namespace gpu::webgpu
