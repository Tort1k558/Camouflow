+// Copyright 2026 CamouFlow contributors.
+// SPDX-License-Identifier: MIT
+#ifndef GPU_COMMAND_BUFFER_SERVICE_GLINT_WEBGPU_READBACK_OBSERVER_H_
+#define GPU_COMMAND_BUFFER_SERVICE_GLINT_WEBGPU_READBACK_OBSERVER_H_
+
+#include <array>
+#include <map>
+#include <memory>
+#include <mutex>
+
+#include "dawn/native/DawnNative.h"
+#include "gpu/command_buffer/common/glint/webgpu_readback_snapshot.h"
+#include "gpu/command_buffer/common/glint_webgpu_device_policy.h"
+
+namespace gpu::webgpu {
+struct GlintReadbackLimits {
+  size_t buffers = 256;
+  size_t snapshots = 64 * 1024 * 1024;
+  size_t shadow = 64 * 1024 * 1024;
+};
+
+class GlintWebGPUReadbackObserver final
+    : public dawn::native::GlintReadbackObserver {
+ public:
+  GlintWebGPUReadbackObserver(
+      std::shared_ptr<const GlintWebGPUDevicePolicy> policy,
+      uint64_t device_epoch,
+      GlintReadbackLimits limits);
+  ~GlintWebGPUReadbackObserver() override;
+  bool IsHealthy() const;
+  void OnTextureToBufferCopy(
+      const dawn::native::GlintTextureToBufferCopy& copy,
+      std::unique_ptr<dawn::native::GlintReadbackSnapshot> snapshot) override;
+  void OnBufferToBufferCopy(dawn::native::GlintBufferIdentity source,
+                            uint64_t source_offset,
+                            dawn::native::GlintBufferIdentity destination,
+                            uint64_t destination_offset,
+                            uint64_t size) override;
+  void OnBufferWrite(dawn::native::GlintBufferIdentity buffer,
+                     uint64_t offset,
+                     uint64_t size,
+                     dawn::native::GlintBufferWriteKind kind) override;
+  void OnBufferDestroyed(WGPUBuffer buffer) override;
+  dawn::native::GlintReadbackMapStatus ClassifyReadMap(
+      dawn::native::GlintBufferIdentity buffer,
+      uint64_t offset,
+      uint64_t size) override;
+  dawn::native::GlintReadbackMap PrepareReadMap(
+      dawn::native::GlintBufferIdentity buffer,
+      uint64_t offset,
+      std::span<const uint8_t> original) override;
+
+ private:
+  struct BufferState {
+    BufferState(size_t size, uint64_t epoch);
+    size_t size;
+    bool unsafe = false;
+    glint::candidate::WebGpuReadbackProvenance provenance;
+  };
+  struct PendingCapture {
+    PendingCapture();
+    ~PendingCapture();
+    glint::candidate::WebGpuSnapshotToken token;
+    glint::candidate::WebGpuReadbackLayout layout;
+    std::unique_ptr<dawn::native::GlintReadbackSnapshot> native;
+    bool complete = false;
+  };
+  BufferState* GetBuffer(dawn::native::GlintBufferIdentity buffer);
+  uint64_t NextSequence();
+  void Fail();
+  void Drop(PendingCapture& capture);
+  void Collect();
+  dawn::native::GlintReadbackStatus Complete(
+      const glint::candidate::WebGpuReadbackPlan& plan);
+  dawn::native::GlintReadbackMapStatus Classify(BufferState* buffer,
+                                                uint64_t offset,
+                                                uint64_t size) const;
+
+  std::shared_ptr<const GlintWebGPUDevicePolicy> policy_;
+  uint64_t epoch_;
+  GlintReadbackLimits limits_;
+  bool failed_ = false;
+  uint64_t sequence_ = 0;
+  uint64_t snapshot_id_ = 0;
+  glint::candidate::WebGpuReadbackSnapshots snapshots_;
+  std::map<WGPUBuffer, BufferState> buffers_;
+  std::array<PendingCapture, glint::candidate::kWebGpuReadbackRegionLimit>
+      pending_;
+  mutable std::mutex mutex_;
+};
+}  // namespace gpu::webgpu
+#endif
