+    MaybeError ValidateGlintProjectedTexelBindings(BindGroupBase* group,
+                                                   wgpu::ShaderStage stages) {
+        DAWN_INTERNAL_ERROR_IF(!group || group->GetDevice() != mDevice,
+                              "Invalid Glint projected texel-buffer bind-group owner.");
+        const auto* layout = group->GetLayout();
+        for (BindingIndex index : layout->GetTexelBufferIndices()) {
+            if (!(layout->GetBindingInfo(index).visibility & stages)) continue;
+            auto* view = group->GetBindingAsTexelBufferView(index);
+            auto* buffer = view ? view->GetBuffer() : nullptr;
+            // Current private buffer overrides build raw CBV/SRV/UAV views only.
+            // A typed texel view must not keep reading the original pixel buffer
+            // while an exact-scope receipt attests projected inputs for that scope.
+            DAWN_INTERNAL_ERROR_IF(!buffer || FindGlintProjectedBuffer(buffer),
+                "Glint projected texel-buffer views are not yet supported.");
+        }
+        return {};
     }
 
