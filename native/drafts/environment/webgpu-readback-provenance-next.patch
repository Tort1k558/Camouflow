+#ifndef GLINT_WEBGPU_READBACK_SNAPSHOT_H_
+#define GLINT_WEBGPU_READBACK_SNAPSHOT_H_
+
+#include <array>
+#include <cstddef>
+#include <cstdint>
+#include <memory>
