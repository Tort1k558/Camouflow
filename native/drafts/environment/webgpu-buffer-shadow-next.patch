+// Copyright 2026 CamouFlow contributors. SPDX-License-Identifier: MIT
+#ifndef GLINT_D3D12_PROJECTED_BUFFER_H_
+#define GLINT_D3D12_PROJECTED_BUFFER_H_
+#include <array>
+
+#include "buffer_scatter_parameters.h"
+#include "texture_capture.h"
+
+namespace glint::candidate::d3d12 {
+struct ProjectedBufferRegion {
+    Microsoft::WRL::ComPtr<ID3D12Resource> canonical_source;
+    Microsoft::WRL::ComPtr<IUnknown> source_retirement;
+    BufferScatterParameters parameters;
+};
+
+class ProjectedBuffer {
+  public:
+    ProjectedBuffer(const ProjectedBuffer&) = delete;
+    ProjectedBuffer& operator=(const ProjectedBuffer&) = delete;
+    // Caller proves native policy/epoch and immutable canonical-plane identities.
+    // Raw allocation must be initialized and COPY_SOURCE; planes must be private
+    // DEFAULT-heap buffers in NON_PIXEL_SHADER_RESOURCE. Requires an open DIRECT
+    // list and the trusted scatter_main root/pipeline ABI. Clobbers compute state.
+    static HRESULT Record(ID3D12Device* device,
+                          ID3D12GraphicsCommandList* commands,
+                          ID3D12Resource* original,
+                          IUnknown* original_retirement,
+                          uint64_t logical_bytes,
+                          bool allocation_initialized,
+                          std::span<const ProjectedBufferRegion> regions,
+                          ID3D12RootSignature* root,
+                          ID3D12PipelineState* pipeline,
+                          ID3D12Fence* fence,
+                          uint64_t completion_value,
+                          const std::shared_ptr<CaptureMemoryBudget>& budget,
+                          std::unique_ptr<ProjectedBuffer>* result);
+    // Borrowed GENERIC_READ resource. Every consumer must retain retirement_handle(),
+    // including dependent shadows; retaining only the resource loses quota ownership.
+    ID3D12Resource* buffer() const { return buffer_; }
+    Microsoft::WRL::ComPtr<IUnknown> retirement_handle() const { return retirement_; }
+    std::shared_ptr<std::atomic<bool>> submission_marker() const { return submitted_; }
+    uint64_t allocation_bytes() const { return allocation_bytes_; }
+
+  private:
+    ProjectedBuffer() = default;
+    ID3D12Resource* buffer_ = nullptr;
+    Microsoft::WRL::ComPtr<IUnknown> retirement_;
+    std::shared_ptr<std::atomic<bool>> submitted_;
+    uint64_t allocation_bytes_ = 0;
+};
+}  // namespace glint::candidate::d3d12
+#endif
