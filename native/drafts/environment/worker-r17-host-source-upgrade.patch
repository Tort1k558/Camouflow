diff --git a/app/core/native/windows_sandbox.py b/app/core/native/windows_sandbox.py
--- /dev/null
+++ b/app/core/native/windows_sandbox.py
@@ -0,0 +1,73 @@
+"""AppContainer read/execute access for an owned, verified installation stage only."""
+
+import ctypes
+import stat
+import subprocess
+import sys
+from ctypes import wintypes
+from pathlib import Path
+
+# The two installation capabilities used by Chromium's ConfigureAppContainerSandbox.
+INSTALL_CAPABILITY_SIDS = (
+    "S-1-15-3-1024-3424233489-972189580-2057154623-747635277-1604371224-316187997-3786583170-1043257646",
+    "S-1-15-3-1024-2302894289-466761758-1166120688-1039016420-2430351297-4240214049-4028510897-3317428798",
+)
+MAX_STAGE_PATHS = 50001
+
+
+def _stage_snapshot(payload: Path) -> dict[Path, tuple[int, int, int, int]]:
+    pending = [payload]
+    checked = {}
+    while pending:
+        path = pending.pop()
+        info = path.lstat()
+        if (path.resolve(strict=True) != path or info.st_file_attributes & 0x400
+                or not (stat.S_ISDIR(info.st_mode) or stat.S_ISREG(info.st_mode))
+                or (stat.S_ISREG(info.st_mode) and info.st_nlink != 1)):
+            raise ValueError("Sandbox installation stage contains a link or non-regular object")
+        checked[path] = (info.st_dev, info.st_ino, info.st_size, info.st_mtime_ns)
+        if len(checked) + len(pending) > MAX_STAGE_PATHS:
+            raise ValueError("Sandbox installation stage exceeds its object limit")
+        if stat.S_ISDIR(info.st_mode):
+            children = list(path.iterdir())
+            if len(checked) + len(pending) + len(children) > MAX_STAGE_PATHS:
+                raise ValueError("Sandbox installation stage exceeds its object limit")
+            pending.extend(children)
+    return checked
+
+
+def _system_icacls() -> Path:
+    kernel = ctypes.WinDLL("kernel32", use_last_error=True)
+    kernel.GetSystemDirectoryW.argtypes = [wintypes.LPWSTR, wintypes.UINT]
+    kernel.GetSystemDirectoryW.restype = wintypes.UINT
+    buffer = ctypes.create_unicode_buffer(32768)
+    count = kernel.GetSystemDirectoryW(buffer, len(buffer))
+    if not 0 < count < len(buffer):
+        raise ctypes.WinError(ctypes.get_last_error())
+    executable = Path(buffer.value) / "icacls.exe"
+    if executable.resolve(strict=True) != executable or not executable.is_file():
+        raise ValueError("Windows system ACL utility is missing or linked")
+    return executable
+
+
+def configure_staged_sandbox_access(payload: Path, stage: Path) -> None:
+    """Call only after archive/manifest verification and before publishing the release."""
+    if sys.platform != "win32":
+        raise OSError("Installation capability configuration requires Windows")
+    if (not isinstance(stage, Path) or not isinstance(payload, Path)
+            or not stage.is_absolute() or stage.resolve(strict=True) != stage
+            or not stage.is_dir() or not stage.name.startswith("native-install-")
+            or payload.parent != stage or payload.name != "payload"
+            or payload.resolve(strict=True) != payload or not payload.is_dir()):
+        raise ValueError("Sandbox access may only be configured on the owned installation payload")
+    before = _stage_snapshot(payload)
+    command = [str(_system_icacls()), str(payload), "/grant",
+               *("*" + sid + ":(OI)(CI)(RX)" for sid in INSTALL_CAPABILITY_SIDS), "/Q"]
+    try:
+        subprocess.run(command, stdin=subprocess.DEVNULL, capture_output=True,
+                       check=True, timeout=30,
+                       creationflags=subprocess.CREATE_NO_WINDOW)
+    except subprocess.SubprocessError as error:
+        raise OSError("Could not configure Native installation sandbox read/execute access") from error
+    if _stage_snapshot(payload) != before:
+        raise ValueError("Installation payload identity or content metadata changed during ACL configuration")
diff --git a/scripts/native_checkpoint_browser.py b/scripts/native_checkpoint_browser.py
--- /dev/null
+++ b/scripts/native_checkpoint_browser.py
@@ -0,0 +1,101 @@
+"""Run discovered ordinary browser tests with isolated, complete PRE chains."""
+import re
+import subprocess
+import time
+from pathlib import Path
+
+from scripts.native_checkpoint_crash import checksum
+from scripts.native_checkpoint_recovery import _run_recovery_process as run_tests
+
+from scripts.package_native_windows import read_record
+from scripts.verify_native_checkpoint_units import validate_results
+
+
+def browser_case_groups(required: dict) -> list[tuple[str, tuple[str, ...]]]:
+    if not isinstance(required, dict) or not required:
+        raise ValueError('Browser execution requires a nonempty discovered selection')
+    grouped = []
+    name_pattern = re.compile(r'[A-Za-z0-9_/]+')
+    for suite, selected in required.items():
+        if (not isinstance(suite, str) or not name_pattern.fullmatch(suite)
+                or 'PRE_' in suite or not isinstance(selected, (set, frozenset, list, tuple))
+                or not selected):
+            raise ValueError('Invalid discovered browser suite/cases')
+        families = {}
+        observed = set()
+        for case in selected:
+            if (not isinstance(case, str) or not name_pattern.fullmatch(case)
+                    or case in observed or ('PRE_' in case and not case.startswith('PRE_'))):
+                raise ValueError('Invalid or duplicate discovered browser case')
+            observed.add(case)
+            leaf, depth = case, 0
+            while leaf.startswith('PRE_'):
+                leaf, depth = leaf[4:], depth + 1
+            if not leaf or 'PRE_' in leaf:
+                raise ValueError('Invalid PRE_ chain name')
+            families.setdefault(leaf, {})[depth] = case
+        for leaf, phases in families.items():
+            deepest = max(phases)
+            if set(phases) != set(range(deepest + 1)):
+                raise ValueError('PRE_ chain is orphaned or missing a declared phase: ' + suite + '.' + leaf)
+            grouped.append((suite, tuple(phases[level] for level in range(deepest, -1, -1))))
+    return sorted(grouped, key=lambda item: (item[0], item[1][-1]))
+
+
+def run_browser_cases(executable: Path, required: dict, *, source: Path, env: dict,
+                      report_dir: Path, timeout: int) -> list[dict]:
+    groups = browser_case_groups(required)
+    deadline = time.monotonic() + timeout
+    runs = []
+    for group_index, (suite, phases) in enumerate(groups):
+        profile = None
+        identity = None
+        if len(phases) > 1:
+            if report_dir != report_dir.resolve() or not report_dir.is_dir():
+                raise ValueError('Paired browser profiles require a canonical report directory')
+            profile = report_dir / (executable.stem + '-chain-' + str(group_index).zfill(3) + '-profile')
+            if profile.resolve() != profile or profile.parent != report_dir or profile.exists():
+                raise ValueError('Paired browser profile must be fresh and owned by this report')
+            profile.mkdir(exist_ok=False)
+            stat = profile.stat()
+            identity = (stat.st_dev, stat.st_ino)
+        previous_failed = False
+        for phase_index, case in enumerate(phases):
+            selected = suite + '.' + case
+            prefix = executable.stem + '-' + str(len(runs)).zfill(3)
+            results = report_dir / (prefix + '-tests.json')
+            row = {'case': selected, 'passed': False}
+            if profile:
+                row.update(profile_directory=profile.name, phase_index=phase_index,
+                           phase_count=len(phases))
+            runs.append(row)
+            if previous_failed:
+                row.update(error='Earlier PRE_ phase failed; dependent phase was not executed',
+                           not_executed=True)
+                continue
+            try:
+                remaining = deadline - time.monotonic()
+                if remaining <= 0:
+                    raise ValueError('Browser test binary execution budget exhausted')
+                command = [str(executable), '--gtest_filter=' + selected,
+                           '--single-process-tests', '--gtest_output=json:' + str(results)]
+                if profile:
+                    stat = profile.stat()
+                    if profile.resolve() != profile or (stat.st_dev, stat.st_ino) != identity:
+                        raise ValueError('Paired browser profile identity changed')
+                    command.append('--user-data-dir=' + str(profile))
+                run_tests(command, source=source, env=env,
+                          log=report_dir / (prefix + '.log'), timeout=remaining)
+                validate_results(read_record(results), {suite: {case}})
+                if profile:
+                    stat = profile.stat()
+                    if (profile.resolve() != profile or (stat.st_dev, stat.st_ino) != identity
+                            or not any(profile.iterdir())):
+                        raise ValueError('Browser did not retain the requested owned profile')
+                    row['profile_identity_verified'] = True
+                row.update(passed=True, results_file=results.name,
+                           results_sha256=checksum(results))
+            except (ValueError, OSError, subprocess.SubprocessError) as error:
+                row['error'] = str(error)
+                previous_failed = True
+    return runs
diff --git a/scripts/native_checkpoint_contract.py b/scripts/native_checkpoint_contract.py
--- /dev/null
+++ b/scripts/native_checkpoint_contract.py
@@ -0,0 +1,82 @@
+"""Bind opted-in browser checkpoint cases to the actual fixture source bytes."""
+
+import hashlib
+from pathlib import Path
+import re
+import stat
+
+
+BROWSER_TEST_SOURCE = "chrome/browser/net/glint_cookie_prefix_browsertest.cc"
+CRASH_SUITE = "GlintCookiePrefixBrowserTest"
+CRASH_PRE_CASE = "PRE_CrashAfterAcknowledgedPrefix"
+CRASH_POST_CASE = "CrashAfterAcknowledgedPrefix"
+MAX_CRASH_PHASE_SECONDS = 300
+MAX_FIXTURE_BYTES = 2 * 1024 * 1024
+_CASE_PATTERN = re.compile(r"\b(TEST(?:_F|_P)?|IN_PROC_BROWSER_TEST_F)\(\s*(\w+),\s*(\w+)")
+
+
+def validate_browser_contract(source: Path, plan: dict) -> dict[str, str]:
+    """Validate this fixture only; compiled provenance and discovery are separate gates."""
+    if (not isinstance(source, Path) or not source.is_absolute()
+            or source.resolve(strict=True) != source or not source.is_dir()):
+        raise ValueError("Browser contract requires a canonical existing source directory")
+    if not isinstance(plan, dict) or not isinstance(plan.get("browser_execution"), dict):
+        raise ValueError("Browser execution requires its explicit versioned contract")
+    contract = plan["browser_execution"]
+    expected = {
+        "schema": 1,
+        "mode": "source-bound-acknowledged-crash-v1",
+        "binary": "browser_tests",
+        "source": BROWSER_TEST_SOURCE,
+        "expected_termination_case": CRASH_SUITE + "." + CRASH_PRE_CASE,
+        "recovery_case": CRASH_SUITE + "." + CRASH_POST_CASE,
+        "ordinary_pre_chains_require_fresh_shared_profiles": True,
+        "maximum_crash_phase_seconds": MAX_CRASH_PHASE_SECONDS,
+        "forced_phase_is_gtest_pass": False,
+    }
+    if (set(contract) != set(expected) | {"source_sha256"}
+            or any(type(contract[key]) is not type(value) or contract[key] != value
+                   for key, value in expected.items())
+            or not isinstance(contract["source_sha256"], str)
+            or re.fullmatch(r"[a-f0-9]{64}", contract["source_sha256"]) is None):
+        raise ValueError("Unsupported or mismatched browser execution contract")
+    cases = plan.get("cases")
+    binaries = plan.get("binaries")
+    if (not isinstance(cases, list) or not cases or len(cases) > 50000
+            or type(plan.get("native_case_bodies_prepared")) is not int
+            or plan["native_case_bodies_prepared"] != len(cases)
+            or not isinstance(binaries, list) or not binaries
+            or any(not isinstance(binary, str) for binary in binaries)
+            or len(set(binaries)) != len(binaries) or "browser_tests" not in binaries
+            or any(not isinstance(row, dict) or row.get("binary") not in binaries for row in cases)):
+        raise ValueError("Browser contract requires a complete structurally valid case plan")
+    rows = [row for row in cases if row.get("source") == BROWSER_TEST_SOURCE]
+    if (not rows or any(row.get("binary") != "browser_tests"
+                       or row.get("kind") != "IN_PROC_BROWSER_TEST_F"
+                       or not isinstance(row.get("fixture"), str)
+                       or not isinstance(row.get("case"), str) for row in rows)):
+        raise ValueError("Browser fixture declarations have the wrong source or test kind")
+    declared = [(row["kind"], row["fixture"], row["case"]) for row in rows]
+    fixture = source / BROWSER_TEST_SOURCE
+    before = fixture.lstat()
+    if (not stat.S_ISREG(before.st_mode) or fixture.resolve(strict=True) != fixture
+            or not 0 < before.st_size <= MAX_FIXTURE_BYTES
+            or (hasattr(before, "st_file_attributes") and before.st_file_attributes & 0x400)):
+        raise ValueError("Browser fixture must be a bounded regular source file without links")
+    with fixture.open("rb") as stream:
+        raw = stream.read(MAX_FIXTURE_BYTES + 1)
+    digest = hashlib.sha256(raw).hexdigest()
+    if len(raw) > MAX_FIXTURE_BYTES or digest != contract["source_sha256"]:
+        raise ValueError("Browser fixture source hash differs from the declared contract")
+    actual = _CASE_PATTERN.findall(raw.decode("utf-8-sig"))
+    if actual != declared or len(set(actual)) != len(actual):
+        raise ValueError("Browser fixture cases are missing, duplicated or differ from source order")
+    if any(("IN_PROC_BROWSER_TEST_F", CRASH_SUITE, case) not in actual
+           for case in (CRASH_PRE_CASE, CRASH_POST_CASE)):
+        raise ValueError("The exact expected-crash pair is not declared in the bound fixture")
+    after = fixture.lstat()
+    if (fixture.resolve(strict=True) != fixture
+            or any(getattr(before, field) != getattr(after, field)
+                   for field in ("st_dev", "st_ino", "st_size", "st_mtime_ns"))):
+        raise ValueError("Browser fixture identity or content changed during validation")
+    return {str(fixture): digest}
