+ResultOrError<std::shared_ptr<const GlintGpuReadbackSnapshot>>
+GlintTextureProjector::RecordCopySnapshot(CommandRecordingContext* context, Texture* texture) {
+    std::unique_ptr<glint::candidate::d3d12::ProjectedTexture> projected;
+    DAWN_TRY_ASSIGN(projected, RecordCopy(context, texture));
+    const auto desc = projected->texture()->GetDesc();
+    const auto nativeFormat = projected->canonical_pixel_format();
+    auto* const pixels = projected->canonical_pixel_buffer();
+    DAWN_INTERNAL_ERROR_IF(!pixels || !desc.Width || !desc.Height ||
+        desc.Width > 8192 || desc.Height > 8192 ||
+        (nativeFormat != DXGI_FORMAT_R8G8B8A8_UNORM && nativeFormat != DXGI_FORMAT_B8G8R8A8_UNORM) ||
+        desc.Format != nativeFormat || pixels->GetDesc().Width != desc.Width * desc.Height * 4,
+        "Invalid Glint GPU pixel snapshot metadata.");
+    const auto format = nativeFormat == DXGI_FORMAT_B8G8R8A8_UNORM
+                            ? GlintReadbackFormat::Bgra8Unorm : GlintReadbackFormat::Rgba8Unorm;
+    auto native = std::shared_ptr<const GlintGpuPixelSnapshot>(
+        new GlintGpuPixelSnapshot(mIdentity, std::move(projected)));
+    return std::shared_ptr<const GlintGpuReadbackSnapshot>(new GlintGpuReadbackSnapshot(
+        std::move(native), static_cast<uint32_t>(desc.Width), desc.Height, format));
+}
+
+std::shared_ptr<const GlintGpuPixelSnapshot> GlintTextureProjector::ResolveSnapshot(
+    const std::shared_ptr<const GlintGpuReadbackSnapshot>& snapshot) const {
+    if (!snapshot || !snapshot->mNative || snapshot->mNative->mIdentity != mIdentity) {
+        return nullptr;
+    }
+    return snapshot->mNative;
+}
