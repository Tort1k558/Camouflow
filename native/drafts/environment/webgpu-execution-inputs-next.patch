+namespace {
+bool AppendGlintOriginalIndirectUses(std::vector<GlintNativeBufferUse>* uses,
+                                     const GlintIndirectInputs& inputs,
+                                     uint64_t argumentBytes) {
+    if (!uses || !inputs.buffer || !argumentBytes || !inputs.maxCount ||
+        argumentBytes > std::numeric_limits<uint64_t>::max() / inputs.maxCount) {
+        return false;
+    }
+    const uint64_t size = argumentBytes * inputs.maxCount;
+    const size_t count = inputs.countBuffer ? 2 : 1;
+    if (uses->size() > kGlintShaderBufferUseLimit - count ||
+        inputs.offset > inputs.buffer->GetSize() ||
+        size > inputs.buffer->GetSize() - inputs.offset ||
+        (inputs.countBuffer &&
+         (inputs.countOffset > inputs.countBuffer->GetSize() ||
+          sizeof(uint32_t) > inputs.countBuffer->GetSize() - inputs.countOffset))) {
+        return false;
+    }
+    uses->push_back({inputs.buffer, inputs.offset, size});
+    if (inputs.countBuffer) {
+        uses->push_back({inputs.countBuffer, inputs.countOffset, sizeof(uint32_t)});
+    }
+    return true;
+}
+
+bool HasGlintUnprojectedAttachmentInputs(const BeginRenderPassCmd& pass) {
+    const auto& depthStencil = pass.depthStencilAttachment;
+    if (depthStencil.view) {
+        const auto aspects = depthStencil.view->GetAspects();
+        if (((aspects & Aspect::Depth) &&
+             (depthStencil.depthReadOnly || depthStencil.depthLoadOp != wgpu::LoadOp::Clear)) ||
+            ((aspects & Aspect::Stencil) &&
+             (depthStencil.stencilReadOnly || depthStencil.stencilLoadOp != wgpu::LoadOp::Clear))) {
+            return true;
+        }
+    }
+    // Pixel-local storage can feed shader values independently of sampled bindings.
+    for (const auto& attachment : pass.storageAttachments) {
+        if (attachment.storage) {
+            return true;
+        }
+    }
+    return false;
+}
