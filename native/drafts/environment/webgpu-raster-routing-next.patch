+            DAWN_TRY_ASSIGN(view, texture->CreateView());
+            GlintTextureProjector* projector;
+            DAWN_TRY_ASSIGN(projector, mDevice->GetGlintTextureProjector());
+            std::unique_ptr<glint::candidate::d3d12::ProjectedTexture> projected;
+            DAWN_TRY_ASSIGN(projected, projector->Record(context, ToBackend(view.Get())));
+            DAWN_INTERNAL_ERROR_IF(mGlintRenderTextures.contains(texture),
+                                   "Duplicate Glint render-pass sampled texture.");
+            mGlintRenderTextures.emplace(texture, std::move(projected));
+        }
+        if (!mGlintRenderTextures.empty()) RestoreAfterGlintProjection(context->GetCommandList());
+        return {};
+    }
