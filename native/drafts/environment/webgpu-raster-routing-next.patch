+            DAWN_INTERNAL_ERROR_IF(usage & (kReadOnlyStorageTexture | wgpu::TextureUsage::StorageBinding),
+                                   "Glint readable render storage-texture projection is unsupported.");
+            if (!(usage & wgpu::TextureUsage::TextureBinding)) continue;
+            // A pass-wide sampled source must never be written during that pass, including bundles.
+            DAWN_INTERNAL_ERROR_IF(usage & ~kReadOnlyTextureUsages,
+                                   "Glint sampled render source has an in-pass write dependency.");
