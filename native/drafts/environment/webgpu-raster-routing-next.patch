   private:
+    void ResetGlintViewOverrides() {
+        for (BindGroupIndex index{0u}; index < kMaxBindGroupsTyped; ++index) {
+            if (!mGlintViews[index].empty()) {
+                mDirtyBindGroups.set(index);
+                mDirtyBindGroupsObjectChangedOrIsDynamic.set(index);
+            }
+            mGlintViews[index].clear();
+            mGlintViewAllocations[index] = {};
+        }
+        mGlintGroupSources = {};
+    }
+
+    MaybeError ValidateGlintInputGroup(BindGroupBase* group, wgpu::ShaderStage stages) {
+        DAWN_INTERNAL_ERROR_IF(!group || group->GetDevice() != mDevice,
+                           "Invalid Glint bind-group owner.");
+        const auto* layout = group->GetLayout();
+        for (const auto& external : group->GetBoundExternalTextures()) {
+            DAWN_INTERNAL_ERROR_IF(external, "Glint external-texture projection is unsupported.");
+        }
+        for (BindingIndex index : layout->GetStorageTextureIndices()) {
+            const auto& info = layout->GetBindingInfo(index);
+            if (!(info.visibility & stages)) continue;
+            const auto access = std::get<StorageTextureBindingInfo>(info.bindingLayout).access;
+            DAWN_INTERNAL_ERROR_IF(access != wgpu::StorageTextureAccess::WriteOnly,
+                           "Glint readable storage-texture projection is unsupported.");
+        }
+        return {};
+    }
+
+    MaybeError PrepareGlintRenderBindings() {
+        if (!mDevice->GetGlintReadbackObserver()) return {};
+        DAWN_INTERNAL_ERROR_IF(!mPipeline || mPipeline->GetLayout()->UsesResourceTable(),
+                               "Unsupported Glint render pipeline input scope.");
+        constexpr auto stages = wgpu::ShaderStage::Vertex | wgpu::ShaderStage::Fragment;
+        for (BindGroupIndex groupIndex : mPipeline->GetLayout()->GetBindGroupLayoutsMask()) {
+            auto* group = mBindGroups[groupIndex];
+            DAWN_TRY(ValidateGlintInputGroup(group, stages));
+            if (mGlintGroupSources[groupIndex].Get() == group) continue;
+            mGlintViews[groupIndex].clear();
+            mGlintViewAllocations[groupIndex] = {};
+            const auto* layout = group->GetLayout();
+            for (BindingIndex index : layout->GetSampledTextureIndices()) {
+                if (!(layout->GetBindingInfo(index).visibility & stages)) continue;
+                auto* view = ToBackend(group->GetBindingAsTextureView(index));
+                DAWN_INTERNAL_ERROR_IF(!view || view->GetDevice() != mDevice ||
+                    view->GetDimension() != wgpu::TextureViewDimension::e2D ||
+                    view->GetBaseMipLevel() != 0 || view->GetLevelCount() != 1 ||
+                    view->GetBaseArrayLayer() != 0 || view->GetLayerCount() != 1 ||
+                    !view->IsSwizzleIdentity(), "Unsupported Glint render sampled view.");
+                auto found = mGlintRenderTextures.find(view->GetTexture());
+                DAWN_INTERNAL_ERROR_IF(found == mGlintRenderTextures.end(),
+                                       "Glint sampled texture was absent from the validated pass scope.");
+                auto* projected = found->second.get();
+                mGlintViews[groupIndex].push_back(
+                    {index, projected->retirement_handle(), projected->texture()});
+            }
+            mGlintGroupSources[groupIndex] = ToBackend(group);
+            mDirtyBindGroups.set(groupIndex);
+            mDirtyBindGroupsObjectChangedOrIsDynamic.set(groupIndex);
+        }
+        return {};
+    }
