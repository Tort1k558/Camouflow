+        if (!mDevice->GetGlintReadbackObserver()) return {};
+        DAWN_INTERNAL_ERROR_IF(scope.resourceTable || scope.usesFramebufferFetch ||
+                               !scope.externalTextures.empty() ||
+                               scope.textures.size() != scope.textureSyncInfos.size(),
+                               "Unsupported Glint render-pass input scope.");
+        for (size_t index = 0; index < scope.textures.size(); ++index) {
+            auto* texture = scope.textures[index];
+            DAWN_INTERNAL_ERROR_IF(!texture || texture->GetDevice() != mDevice,
+                                   "Invalid Glint render-pass texture owner.");
+            wgpu::TextureUsage usage = wgpu::TextureUsage::None;
+            DAWN_TRY(scope.textureSyncInfos[index].Iterate(
+                [&](const SubresourceRange&, const TextureSyncInfo& info) -> MaybeError {
+                    usage |= info.usage;
+                    return {};
