+struct WebGpuReadbackRegion {
+  uint64_t buffer_offset = 0;
+  uint64_t size = 0;
+  uint64_t snapshot_offset = 0;
+  WebGpuReadbackLayout snapshot_layout;
+  WebGpuSnapshotToken snapshot;
+  WebGpuSourceRect source_rect;
+};
+
+enum class WebGpuMapProvenance {
+  kUnrelated,
+  kReadback,
+  kUnreliable,
+  kDestroyed
+};
+constexpr size_t kWebGpuReadbackRegionLimit = 16;
+
+struct WebGpuReadbackPlan {
+  WebGpuMapProvenance status = WebGpuMapProvenance::kUnrelated;
+  uint64_t mapping_offset = 0;
+  uint64_t mapping_size = 0;
+  size_t count = 0;
+  std::array<WebGpuReadbackRegion, kWebGpuReadbackRegionLimit> regions{};
+};
+
+// Native validated/executed writes only, under the device's queue lock. A
+// sequence is a strictly increasing device execution order, not a renderer
+// encoding ID. Tokens refer to retained full-surface snapshots owned by the
+// future native hook. No pixels, keys, GPU resources or JavaScript state are
+// owned by this tracker.
+class GPU_COMMAND_BUFFER_COMMON_EXPORT WebGpuReadbackProvenance {
+ public:
+  WebGpuReadbackProvenance(size_t buffer_bytes, uint64_t device_epoch);
+  bool RecordTextureCopy(uint64_t sequence,
+                         const WebGpuReadbackLayout& layout,
+                         const WebGpuSnapshotToken& snapshot,
+                         const WebGpuSourceRect& source_rect);
+  bool RecordFullTextureCopy(uint64_t sequence,
+                             const WebGpuReadbackLayout& layout,
+                             const WebGpuSnapshotToken& snapshot);
+  bool RecordBufferCopy(uint64_t sequence,
+                        uint64_t destination_offset,
+                        const WebGpuReadbackProvenance& source,
+                        uint64_t source_offset,
+                        uint64_t size);
+  // A trusted complete overwrite of every byte in this range, e.g. writeBuffer.
+  bool InvalidateWrite(uint64_t sequence, uint64_t offset, uint64_t size);
+  // A shader may write zero, some or all bytes. Never erase provenance on that
+  // assumption: intersecting tracked pixels makes this buffer fail closed.
+  // Shader input/output taint propagation remains the native caller's duty.
+  bool RecordUncertainWrite(uint64_t sequence, uint64_t offset, uint64_t size);
+  WebGpuReadbackPlan PlanMap(uint64_t offset, uint64_t size) const;
+  void Destroy();
+
+ private:
+  bool Advance(uint64_t sequence);
+  bool Poison();
+  bool Erase(uint64_t offset, uint64_t size);
+  bool Append(const WebGpuReadbackRegion& region);
+  bool Fits(uint64_t offset, uint64_t size) const;
+
+  size_t buffer_bytes_;
+  uint64_t device_epoch_;
+  uint64_t sequence_ = 0;
+  bool reliable_;
+  bool destroyed_ = false;
+  size_t count_ = 0;
+  std::array<WebGpuReadbackRegion, kWebGpuReadbackRegionLimit> regions_{};
+};
+
+// Maps one copied byte to a full snapshot's packed RGBA8 coordinate; padding
+// and out-of-range bytes have no coordinate. BGRA channels map without changing
+// alpha.
+GPU_COMMAND_BUFFER_COMMON_EXPORT std::optional<size_t> WebGpuCanonicalByte(
+    const WebGpuReadbackRegion& region,
+    uint64_t buffer_offset);
