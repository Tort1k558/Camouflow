+// Copyright 2026 CamouFlow contributors.
+// SPDX-License-Identifier: MIT
+#include "gpu/command_buffer/service/glint_webgpu_wire_filter.h"
+
+#include "base/compiler_specific.h"
+#include "dawn/native/DawnNative.h"
+
+namespace gpu::webgpu {
+namespace {
+using dawn::wire::BufferReadbackDisposition;
+
+BufferReadbackDisposition Disposition(
+    dawn::native::GlintReadbackMapStatus status) {
+  switch (status) {
+    case dawn::native::GlintReadbackMapStatus::Unrelated:
+      return BufferReadbackDisposition::Passthrough;
+    case dawn::native::GlintReadbackMapStatus::Protected:
+      return BufferReadbackDisposition::Protected;
+    default:
+      return BufferReadbackDisposition::Denied;
+  }
+}
+
+class NativeReadbackFilter final : public dawn::wire::BufferReadbackFilter {
+ public:
+  explicit NativeReadbackFilter(
+      std::shared_ptr<dawn::native::GlintReadbackObserver> observer)
+      : observer_(std::move(observer)) {}
+  BufferReadbackDisposition Classify(WGPUBuffer buffer,
+                                     uint64_t size,
+                                     uint64_t offset,
+                                     uint64_t count) override {
+    return Disposition(
+        observer_->ClassifyReadMap({buffer, size}, offset, count));
+  }
+  dawn::wire::FilteredBufferReadback Prepare(
+      WGPUBuffer buffer,
+      uint64_t size,
+      uint64_t offset,
+      std::span<const std::byte> bytes) override {
+    // SAFETY: Byte-sized alias of the complete caller-owned span; no size
+    // change.
+    const auto original = UNSAFE_BUFFERS(std::span<const uint8_t>(
+        reinterpret_cast<const uint8_t*>(bytes.data()), bytes.size()));
+    auto mapped = observer_->PrepareReadMap({buffer, size}, offset, original);
+    return {Disposition(mapped.status), std::move(mapped.bytes), mapped.size};
+  }
+
+ private:
+  const std::shared_ptr<dawn::native::GlintReadbackObserver> observer_;
+};
+
+class NativeReadbackFilterFactory final
+    : public dawn::wire::BufferReadbackFilterFactory {
+ public:
+  std::shared_ptr<dawn::wire::BufferReadbackFilter> ForDevice(
+      WGPUDevice device) override {
+    // Query the alive device itself: a raw-handle registry would need
+    // generation tracking and could select a stale policy after device-address
+    // reuse.
+    auto observer = dawn::native::GetGlintReadbackObserver(device);
+    if (!observer) {
+      return nullptr;
+    }
+    return std::make_shared<NativeReadbackFilter>(std::move(observer));
+  }
+};
+}  // namespace
+
+std::shared_ptr<dawn::wire::BufferReadbackFilterFactory>
+CreateGlintWebGPUReadbackFilterFactory() {
+  return std::make_shared<NativeReadbackFilterFactory>();
+}
+}  // namespace gpu::webgpu
