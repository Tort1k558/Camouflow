+class ProbeBackingTransferService final : public server::MemoryTransferService {
+  public:
+    size_t wrapCalls = 0;
+    WGPUBuffer wrappedBuffer = nullptr;
+    class Handle final : public MemoryHandle {
+      public:
+        explicit Handle(ProbeBackingTransferService& owner) : owner_(owner) {}
+        WGPUBuffer TryWrapInBuffer(const DawnProcTable*,
+                                   WGPUDevice,
+                                   const WGPUBufferDescriptor*) override {
+            ++owner_.wrapCalls;
+            return owner_.wrappedBuffer;
+        }
+        size_t GetSerializeDataUpdateSize(size_t, size_t) const override {
+            ADD_FAILURE() << "Creation-only probe must not serialize mapped data";
+            return 0;
+        }
+        void SerializeDataUpdate(std::span<volatile std::byte>,
+                                 size_t,
+                                 size_t,
+                                 std::span<const std::byte>) const override {
+            ADD_FAILURE() << "Creation-only probe must not serialize mapped data";
+        }
+        bool DeserializeDataUpdate(std::span<const std::byte>,
+                                   size_t,
+                                   size_t,
+                                   std::span<std::byte>) override {
+            ADD_FAILURE() << "Creation-only probe must not update mapped data";
+            return false;
+        }
+
+      private:
+        ProbeBackingTransferService& owner_;
+    };
+    std::unique_ptr<MemoryHandle> DeserializeMemoryHandle(std::span<const std::byte>) override {
+        return std::make_unique<Handle>(*this);
+    }
+};
+
+class WireFilteredBackingTests : public WireFilteredReadbackTests {
+  protected:
+    server::MemoryTransferService* GetServerMemoryTransferService() override { return &transfer; }
+    void CreateProbeBuffer(bool expectPrivate) {
+        transfer.wrappedBuffer = apiBuffer;
+        wgpu::BufferDescriptor descriptor = {};
+        descriptor.size = raw.size();
+        descriptor.usage = wgpu::BufferUsage::MapRead | wgpu::BufferUsage::CopyDst;
+        buffer = device.CreateBuffer(&descriptor);
+        if (expectPrivate) {
+            EXPECT_CALL(api, DeviceCreateBuffer(apiDevice, _)).WillOnce(Return(apiBuffer));
+        } else {
+            EXPECT_CALL(api, DeviceCreateBuffer(apiDevice, _)).Times(0);
+        }
+        FlushClient();
+    }
+    ProbeBackingTransferService transfer;
+};
+
+TEST_F(WireFilteredBackingTests, ProtectedDeviceNeverAttemptsDirectSharedBacking) {
+    CreateProbeBuffer(true);
+    EXPECT_EQ(transfer.wrapCalls, 0u);
+}
+
+TEST_F(WireFilteredBackingTests, UnprotectedDeviceRetainsDirectBackingOptimization) {
+    filter->enabled = false;
+    CreateProbeBuffer(false);
+    EXPECT_EQ(transfer.wrapCalls, 1u);
+}
