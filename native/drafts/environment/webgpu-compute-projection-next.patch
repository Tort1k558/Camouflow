+ResultOrError<std::unique_ptr<GlintTextureProjector>> GlintTextureProjector::Create(Device* device) {
+    DAWN_INTERNAL_ERROR_IF(!device || !device->GetGlintReadbackObserver(),
+                           "Glint projection requires an installed device policy.");
+    DAWN_ASSERT(device->IsLockedByCurrentThreadIfNeeded());
+    auto projector = std::unique_ptr<GlintTextureProjector>(new GlintTextureProjector(device));
+    const auto* functions = device->GetFunctions();
+    DAWN_INTERNAL_ERROR_IF(!functions->d3d12SerializeRootSignature,
+                           "Glint root serialization is unavailable.");
+    D3D12_DESCRIPTOR_RANGE ranges[2]{};
+    ranges[0].RangeType = D3D12_DESCRIPTOR_RANGE_TYPE_SRV;
+    ranges[1].RangeType = D3D12_DESCRIPTOR_RANGE_TYPE_UAV;
+    D3D12_ROOT_PARAMETER parameters[3]{};
+    for (size_t i = 0; i < 2; ++i) {
+        ranges[i].NumDescriptors = 1;
+        parameters[i].ParameterType = D3D12_ROOT_PARAMETER_TYPE_DESCRIPTOR_TABLE;
+        parameters[i].DescriptorTable.NumDescriptorRanges = 1;
+        parameters[i].DescriptorTable.pDescriptorRanges = &ranges[i];
+    }
+    parameters[2].ParameterType = D3D12_ROOT_PARAMETER_TYPE_32BIT_CONSTANTS;
+    parameters[2].Constants.Num32BitValues = 16;
+    D3D12_ROOT_SIGNATURE_DESC root{};
+    root.NumParameters = 3;
+    root.pParameters = parameters;
+    ComPtr<ID3DBlob> serialized, errors;
+    DAWN_TRY(CheckHRESULT(functions->d3d12SerializeRootSignature(
+        &root, D3D_ROOT_SIGNATURE_VERSION_1, &serialized, &errors), "Glint root serialization"));
+    DAWN_TRY(CheckHRESULT(device->GetD3D12Device()->CreateRootSignature(
+        0, serialized->GetBufferPointer(), serialized->GetBufferSize(), IID_PPV_ARGS(&projector->mRoot)),
+        "Glint projection root creation"));
+    D3D12_COMPUTE_PIPELINE_STATE_DESC desc{};
+    desc.pRootSignature = projector->mRoot.Get();
+    // Follow the device's existing compiler selection; never silently retry another compiler.
+    if (device->IsToggleEnabled(Toggle::UseDXC)) {
+        auto compiler = device->GetDxcCompiler();
+        DAWN_INTERNAL_ERROR_IF(!compiler, "Glint selected DXC compiler is unavailable.");
+        DxcBuffer source{};
+        source.Ptr = kGlintEdgeProjectionHlsl;
+        source.Size = sizeof(kGlintEdgeProjectionHlsl) - 1;
+        source.Encoding = DXC_CP_UTF8;
+        std::array<LPCWSTR, 8> arguments{
+            L"-E", L"edge_main", L"-T", L"cs_6_0", L"-HV", L"2018", L"-WX", L"-Ges"};
+        ComPtr<IDxcResult> result;
+        DAWN_TRY(CheckHRESULT(compiler->Compile(&source, arguments.data(), arguments.size(), nullptr,
+                                               IID_PPV_ARGS(&result)), "Glint DXC compile"));
+        HRESULT status = E_FAIL;
+        DAWN_TRY(CheckHRESULT(result->GetStatus(&status), "Glint DXC status"));
+        DAWN_TRY(CheckHRESULT(status, "Glint DXC shader compilation"));
+        ComPtr<IDxcBlob> shader;
+        DAWN_TRY(CheckHRESULT(result->GetResult(&shader), "Glint DXC bytecode"));
+        desc.CS = {shader->GetBufferPointer(), shader->GetBufferSize()};
+        DAWN_TRY(CheckHRESULT(device->GetD3D12Device()->CreateComputePipelineState(
+            &desc, IID_PPV_ARGS(&projector->mPipeline)), "Glint DXC pipeline creation"));
+    } else {
+        DAWN_INTERNAL_ERROR_IF(!functions->d3dCompile, "Glint selected FXC compiler is unavailable.");
+        ComPtr<ID3DBlob> shader;
+        DAWN_TRY(CheckHRESULT(functions->d3dCompile(
+            kGlintEdgeProjectionHlsl, sizeof(kGlintEdgeProjectionHlsl) - 1, nullptr, nullptr,
+            nullptr, "edge_main", "cs_5_0", D3DCOMPILE_ENABLE_STRICTNESS | D3DCOMPILE_WARNINGS_ARE_ERRORS,
+            0, &shader, &errors), "Glint FXC shader compilation"));
+        desc.CS = {shader->GetBufferPointer(), shader->GetBufferSize()};
+        DAWN_TRY(CheckHRESULT(device->GetD3D12Device()->CreateComputePipelineState(
+            &desc, IID_PPV_ARGS(&projector->mPipeline)), "Glint FXC pipeline creation"));
+    }
+    return std::move(projector);
+}
+
+ResultOrError<std::unique_ptr<glint::candidate::d3d12::ProjectedTexture>>
+GlintTextureProjector::Record(CommandRecordingContext* context, TextureView* view) {
+    DAWN_INTERNAL_ERROR_IF(!context || !view || view->GetDevice() != mDevice,
+                           "Invalid Glint texture-view owner.");
+    DAWN_ASSERT(mDevice->IsLockedByCurrentThreadIfNeeded());
+    auto* texture = ToBackend(view->GetTexture());
+    DAWN_INTERNAL_ERROR_IF(!texture || texture->GetDevice() != mDevice || !texture->HasAccess() ||
+                           !texture->GetD3D12Resource(), "Glint projection source is inaccessible.");
+    DAWN_INTERNAL_ERROR_IF(view->GetDimension() != wgpu::TextureViewDimension::e2D ||
+        view->GetBaseMipLevel() != 0 || view->GetLevelCount() != 1 || texture->GetNumMipLevels() != 1 ||
+        view->GetBaseArrayLayer() != 0 || view->GetLayerCount() != 1 || !view->IsSwizzleIdentity(),
+        "Unsupported Glint projection texture-view range.");
+    const auto format = view->GetFormat().format;
+    DAWN_INTERNAL_ERROR_IF(format != wgpu::TextureFormat::RGBA8Unorm &&
+                           format != wgpu::TextureFormat::BGRA8Unorm,
+                           "Unsupported Glint projection texture-view format.");
+    auto observer = mDevice->GetGlintReadbackObserver();
+    ProjectionSeed seed;
+    DAWN_INTERNAL_ERROR_IF(!observer || !observer->CopyShaderProjectionSeed(seed.bytes),
+                           "Glint projection policy is invalid.");
+    const auto range = SubresourceRange::SingleMipAndLayer(0, 0, Aspect::Color);
+    DAWN_TRY(texture->EnsureSubresourceContentInitialized(context, range));
+    // Private backend copying does not require exposing CopySrc in the WebGPU API usage.
+    texture->TrackUsageAndTransitionNow(context, D3D12_RESOURCE_STATE_COPY_SOURCE, range);
+    auto* queue = ToBackend(mDevice->GetQueue());
+    std::unique_ptr<glint::candidate::d3d12::ProjectedTexture> projected;
+    DAWN_TRY(CheckHRESULT(glint::candidate::d3d12::ProjectedTexture::Record(
+        mDevice->GetD3D12Device(), context->GetCommandList(), texture->GetD3D12Resource(),
+        view->GetD3D12Format(), true, mRoot.Get(), mPipeline.Get(), seed.bytes,
+        queue->GetSharedFence()->GetD3DFence(), uint64_t{queue->GetPendingCommandSerial()},
+        mDevice->GetGlintReadbackBudget(), &projected), "Glint protected texture projection"));
+    mDevice->ReferenceUntilUnused(projected->retirement_handle());
+    context->AddGlintReadbackSubmission(projected->submission_marker());
+    return std::move(projected);
+}
