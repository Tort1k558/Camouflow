+    if (FAILED(status)) return status;
+    status = create(output_desc, D3D12_RESOURCE_STATE_UNORDERED_ACCESS, &hold->output);
+    if (FAILED(status)) return status;
+    status = create(shadow_desc, D3D12_RESOURCE_STATE_COPY_DEST, &hold->shadow);
+    if (FAILED(status)) return status;
