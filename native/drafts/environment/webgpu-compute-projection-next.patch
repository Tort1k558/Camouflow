+ResultOrError<bool> BindGroup::PopulateGlintViews(
+    ShaderVisibleDescriptorAllocator* allocator,
+    std::span<const GlintTextureViewOverride> overrides,
+    GPUDescriptorHeapAllocation* allocation) {
+    auto* device = ToBackend(GetDevice());
+    const auto* layout = ToBackend(GetLayout());
+    const auto count = layout->GetCbvUavSrvDescriptorCount();
+    DAWN_INTERNAL_ERROR_IF(!allocator || allocator->GetDevice() != device || !allocation ||
+                           overrides.empty() || count == 0,
+                           "Invalid Glint dispatch-local descriptor allocation.");
+    const auto offsets = layout->GetDescriptorHeapOffsets();
+    std::vector<BindingIndex> seen;
+    for (const auto& replacement : overrides) {
+        DAWN_INTERNAL_ERROR_IF(replacement.binding >= layout->GetBindingCount() ||
+                               !replacement.resource || !replacement.retirement ||
+                               std::find(seen.begin(), seen.end(), replacement.binding) != seen.end(),
+                               "Invalid or duplicate Glint sampled-texture override.");
+        const auto& info = layout->GetBindingInfo(replacement.binding);
+        DAWN_INTERNAL_ERROR_IF(!std::holds_alternative<TextureBindingInfo>(info.bindingLayout) ||
+                               info.visibility == wgpu::ShaderStage::None ||
+                               offsets[replacement.binding] >= count,
+                               "Glint overrides require a visible sampled-texture binding.");
+        auto* view = ToBackend(GetBindingAsTextureView(replacement.binding));
+        DAWN_INTERNAL_ERROR_IF(!view || view->GetDevice() != device,
+                               "Glint sampled-texture view belongs to another logical device.");
+        auto* source = ToBackend(view->GetTexture())->GetD3D12Resource();
+        DAWN_INTERNAL_ERROR_IF(!source, "Glint source texture was destroyed.");
+        const auto& srv = view->GetSRVDescriptor();
+        const auto projected = replacement.resource->GetDesc();
+        const auto original = source->GetDesc();
+        ComPtr<ID3D12Device> owner;
+        DAWN_TRY(CheckHRESULT(replacement.resource->GetDevice(IID_PPV_ARGS(&owner)),
+                              "Glint projected texture physical owner"));
+        DAWN_INTERNAL_ERROR_IF(owner.Get() != device->GetD3D12Device() ||
+                               projected.Dimension != D3D12_RESOURCE_DIMENSION_TEXTURE2D ||
+                               projected.Format != srv.Format || projected.Width != original.Width ||
+                               projected.Height != original.Height || projected.DepthOrArraySize != 1 ||
+                               projected.MipLevels != 1 || projected.SampleDesc.Count != 1 ||
+                               (projected.Flags & D3D12_RESOURCE_FLAG_DENY_SHADER_RESOURCE) ||
+                               srv.ViewDimension != D3D12_SRV_DIMENSION_TEXTURE2D ||
+                               srv.Texture2D.MostDetailedMip != 0 || srv.Texture2D.MipLevels != 1,
+                               "Glint projection descriptor is incompatible with its source view.");
+        seen.push_back(replacement.binding);
+    }
+    D3D12_CPU_DESCRIPTOR_HANDLE base;
+    if (!allocator->AllocateGPUDescriptors(count, device->GetQueue()->GetPendingCommandSerial(),
+                                            &base, allocation)) {
+        return false;
+    }
+    device->GetD3D12Device()->CopyDescriptorsSimple(
+        count, base, mCPUViewAllocation.GetBaseDescriptor(), D3D12_DESCRIPTOR_HEAP_TYPE_CBV_SRV_UAV);
+    for (const auto& replacement : overrides) {
+        const auto& srv = ToBackend(GetBindingAsTextureView(replacement.binding))->GetSRVDescriptor();
+        D3D12_CPU_DESCRIPTOR_HANDLE slot{
+            base.ptr + uint64_t{offsets[replacement.binding]} * layout->GetViewSizeIncrement()};
+        device->GetD3D12Device()->CreateShaderResourceView(replacement.resource.Get(), &srv, slot);
+    }
+    return true;
+}
