index 0000000..9717a35
--- /dev/null
+++ b/native/drafts/environment/first-script/retained_webgpu_objects.js
@@ -0,0 +1,74 @@
+async () => {
+  const key = 'glintOwnedRetainedWebGpu';
+  if (!Object.hasOwn(globalThis, key)) {
+    if (!isSecureContext || !navigator.gpu) throw new Error('WebGPU unavailable; no retained-resource coverage');
+    const adapter = await navigator.gpu.requestAdapter();
+    if (!adapter) throw new Error('No default WebGPU adapter');
+    const device = await adapter.requestDevice();
+    const state = {id: crypto.randomUUID(), timeOrigin: performance.timeOrigin,
+      read: 0, device, resources: [], unexpected: [], lost: false, closed: false};
+    device.addEventListener('uncapturederror', event => state.unexpected.push(event.error.message));
+    device.lost.then(() => {if (!state.closed) state.lost = true;});
+    state.close = () => {state.closed = true; for (const value of state.resources) value.destroy(); device.destroy();};
+    try {
+      device.pushErrorScope('validation');
+      const buffer = (size, usage) => {
+        const value = device.createBuffer({size, usage}); state.resources.push(value); return value;
+      };
+      state.output = buffer(256, GPUBufferUsage.STORAGE | GPUBufferUsage.COPY_SRC);
+      state.staging = buffer(256, GPUBufferUsage.COPY_DST | GPUBufferUsage.MAP_READ);
+      state.pixels = buffer(768, GPUBufferUsage.COPY_DST | GPUBufferUsage.MAP_READ);
+      state.shader = device.createShaderModule({code: `
+        @group(0) @binding(0) var<storage, read_write> output: array<u32>;
+        @compute @workgroup_size(8) fn main(@builtin(global_invocation_id) id: vec3<u32>) {
+          output[id.x] = id.x * 17u + 31u;
+        }`});
+      state.pipeline = await device.createComputePipelineAsync({layout: 'auto', compute: {module: state.shader, entryPoint: 'main'}});
+      state.bindings = device.createBindGroup({layout: state.pipeline.getBindGroupLayout(0), entries: [{binding: 0, resource: {buffer: state.output}}]});
+      state.texture = device.createTexture({size: [7, 3], format: 'rgba8unorm',
+        usage: GPUTextureUsage.RENDER_ATTACHMENT | GPUTextureUsage.COPY_SRC});
+      state.resources.push(state.texture);
+      state.view = state.texture.createView();
+      state.refs = [device, state.output, state.staging, state.pixels, state.shader,
+        state.pipeline, state.bindings, state.texture, state.view];
+      const error = await device.popErrorScope();
+      if (error) throw new Error('Retained GPU initialization rejected: ' + error.message);
+      Object.defineProperty(globalThis, key, {value: state});
+    } catch (error) {state.close(); throw error;}
+  }
+  const state = globalThis[key];
+  if (state.closed || state.lost || state.unexpected.length) throw new Error('Retained WebGPU resources lost or closed');
+  const {device, output, staging, pixels, texture, view, shader, pipeline, bindings} = state;
+  const sameReferences = state.refs.map((value, index) => value === [device, output, staging, pixels, shader, pipeline, bindings, texture, view][index]);
+  device.pushErrorScope('validation');
+  const encoder = device.createCommandEncoder();
+  const compute = encoder.beginComputePass();
+  compute.setPipeline(pipeline); compute.setBindGroup(0, bindings); compute.dispatchWorkgroups(8); compute.end();
+  encoder.copyBufferToBuffer(output, 0, staging, 0, 256);
+  const render = encoder.beginRenderPass({colorAttachments: [{view,
+    clearValue: {r: 1, g: 0, b: 1, a: 1}, loadOp: 'clear', storeOp: 'store'}]});
+  render.end();
+  encoder.copyTextureToBuffer({texture}, {buffer: pixels, bytesPerRow: 256, rowsPerImage: 3}, [7, 3]);
+  device.queue.submit([encoder.finish()]);
+  await staging.mapAsync(GPUMapMode.READ);
+  let computeMatched;
+  const computeBuffer = staging.getMappedRange();
+  try {computeMatched = new Uint32Array(computeBuffer).every((value, index) => value === index * 17 + 31);}
+  finally {staging.unmap();}
+  await pixels.mapAsync(GPUMapMode.READ);
+  const pixelBuffer = pixels.getMappedRange();
+  let textureMatched = true, paddingZero = true;
+  try {
+    const bytes = new Uint8Array(pixelBuffer);
+    for (let row = 0; row < 3; row++) {
+      for (let column = 0; column < 28; column++) textureMatched &&= bytes[row * 256 + column] === [255, 0, 255, 255][column % 4];
+      for (let column = 28; column < 256; column++) paddingZero &&= bytes[row * 256 + column] === 0;
+    }
+  } finally {pixels.unmap();}
+  const validation = await device.popErrorScope();
+  if (validation || !computeMatched || !textureMatched || !paddingZero || state.lost || state.unexpected.length) throw new Error('Retained WebGPU readback failed');
+  return {id: state.id, timeOrigin: state.timeOrigin, read: ++state.read,
+    sameReferences, computeMatched, textureMatched, paddingZero,
+    detached: computeBuffer.byteLength === 0 && pixelBuffer.byteLength === 0,
+    deviceLost: state.lost, unexpected: [...state.unexpected]};
+}
diff --git a/native/drafts/environment/first-script/retained_webgpu_objects.py b/native/drafts/environment/first-script/retained_webgpu_objects.py
new file mode 100644
index 0000000..dc32cdb
--- /dev/null
+++ b/native/drafts/environment/first-script/retained_webgpu_objects.py
@@ -0,0 +1,80 @@
+"""Original owned WebGPU resources across real document BFCache; no native protection."""
+import math
+from pathlib import Path
+import re
+from urllib.parse import urlsplit
+
+READ = Path(__file__).with_suffix('.js').read_text(encoding='utf-8-sig')
+
+
+def validate_record(value):
+    if (not isinstance(value, dict) or not isinstance(value.get('id'), str)
+            or re.fullmatch('[0-9a-f]{8}(?:-[0-9a-f]{4}){3}-[0-9a-f]{12}', value['id']) is None
+            or type(value.get('timeOrigin')) not in (int, float) or not math.isfinite(value['timeOrigin'])
+            or value['timeOrigin'] <= 0 or type(value.get('read')) is not int or value['read'] <= 0
+            or not isinstance(value.get('sameReferences'), list) or len(value['sameReferences']) != 9
+            or any(item is not True for item in value['sameReferences'])
+            or any(value.get(key) is not True for key in ('computeMatched', 'textureMatched', 'paddingZero', 'detached'))
+            or value.get('deviceLost') is not False or value.get('unexpected') != []):
+        raise ValueError('Retained WebGPU resource/readback observation invalid')
+
+
+def validate_pair(before, after):
+    roles = {'main', 'same', 'cross', 'about-blank', 'srcdoc', 'nested-return'}
+    if not isinstance(before, dict) or not isinstance(after, dict) or set(before) != roles or set(after) != roles:
+        raise ValueError('Six exact document roles required')
+    instances, ports = set(), set()
+    for role in roles:
+        a, b = before[role], after[role]
+        if (not isinstance(a, dict) or not isinstance(b, dict)
+                or set(a) != {'nonce', 'origin', 'location', 'persisted', 'timeOrigin', 'observed'}
+                or set(b) != set(a)
+                or a.get('persisted') is not False or b.get('persisted') is not True
+                or any(a.get(key) != b.get(key) for key in ('nonce', 'origin', 'location', 'timeOrigin'))):
+            raise ValueError('Retained WebGPU document lifecycle changed')
+        if not isinstance(a.get('nonce'), str) or re.fullmatch('[0-9a-f]{48}', a['nonce']) is None:
+            raise ValueError('Missing owned document nonce')
+        if not isinstance(a.get('origin'), str) or not isinstance(a.get('location'), str) or not a['location']:
+            raise ValueError('Owned document origin/location missing')
+        origin = urlsplit(a['origin'])
+        if origin.scheme != 'http' or origin.hostname not in {'127.0.0.1', 'localhost'} or origin.port is None:
+            raise ValueError('Only owned loopback documents allowed')
+        ports.add(origin.port)
+        x, y = a.get('observed'), b.get('observed')
+        validate_record(x)
+        validate_record(y)
+        if x['id'] != y['id'] or y['read'] <= x['read'] or x['id'] in instances or x['timeOrigin'] != a['timeOrigin'] or y['timeOrigin'] != b['timeOrigin']:
+            raise ValueError('Retained WebGPU objects replaced or stale')
+        instances.add(x['id'])
+    if len(ports) != 1:
+        raise ValueError('Document registrations mixed fixture servers')
+    return dict(passed=True, document_contexts=6, original_webgpu_objects_verified=True,
+        native_webgpu_readback_protection=False, workers_verified=False,
+        privacy_admitted=False, production_admitted=False)
+
+
+def validate_runs(runs):
+    if (not isinstance(runs, list) or len(runs) != 2
+            or any(not isinstance(row, dict) or not isinstance(row.get('mode'), str) for row in runs)
+            or {row['mode'] for row in runs} != {'manager-desktop', 'manager-mobile-web'}):
+        raise ValueError('Two actual manager mode runs required')
+    instances = set()
+    for row in runs:
+        if any(row.get(key) is not True for key in ('passed', 'bfcache_restored', 'protected_arguments_verified',
+                'post_surfaces_screen_verified', 'runtime_resources_released', 'browser_connection_closed')):
+            raise ValueError('WebGPU runtime/lifecycle cleanup failed')
+        if (not isinstance(row.get('history_navigation'), dict)
+                or row['history_navigation'].get('type') != 'BackForwardCacheRestore'
+                or type(row.get('observed_processes')) is not int or row['observed_processes'] <= 1
+                or type(row.get('remaining_observed_processes')) is not int or row['remaining_observed_processes'] != 0):
+            raise ValueError('Real BFCache restoration and owned process cleanup required')
+        result = validate_pair(row.get('retained_documents_before'), row.get('retained_documents_after'))
+        if row.get('retained_gpu_object_validation') != result:
+            raise ValueError('Stored WebGPU validation differs from actual observations')
+        current = {value['observed']['id'] for value in row['retained_documents_before'].values()}
+        if instances.intersection(current):
+            raise ValueError('Manager modes reused WebGPU resource instances')
+        instances.update(current)
+    return dict(passed=True, original_webgpu_objects_verified=True,
+        native_webgpu_readback_protection=False, workers_verified=False,
+        privacy_admitted=False, production_admitted=False)
