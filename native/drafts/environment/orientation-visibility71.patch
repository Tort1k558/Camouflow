+class GlintScreenOrientationVisibilityTest
+    : public ScreenOrientationControllerTest {
+ protected:
+  void CheckSameAngleVisibilityRestore(bool explicit_type) {
+    frame_test_helpers::WebViewHelper helper;
+    helper.InitializeAndLoad("about:blank");
+    auto* page = helper.GetWebView()->GetPage();
+    auto* frame = To<LocalFrame>(page->MainFrame());
+    auto* widget =
+        static_cast<WebFrameWidgetImpl*>(frame->GetWidgetForLocalRoot());
+    display::ScreenInfos screens((display::ScreenInfo()));
+    auto& current = screens.mutable_current();
+    current.rect = gfx::Rect(800, 600);
+    current.available_rect = current.rect;
+    current.orientation_angle = 0;
+    current.orientation_type =
+        explicit_type ? display::mojom::blink::ScreenOrientation::kLandscapePrimary
+                      : display::mojom::blink::ScreenOrientation::kUndefined;
+    widget->UpdateScreenInfo(screens);
+    auto* orientation = ScreenOrientation::Create(frame->DomWindow());
+    EXPECT_EQ(orientation->type().AsEnum(),
+              V8OrientationType::Enum::kLandscapePrimary);
+    for (bool portrait : {true, false}) {
+      page->SetVisibilityState(mojom::blink::PageVisibilityState::kHidden, false);
+      current.rect = portrait ? gfx::Rect(390, 844) : gfx::Rect(800, 600);
+      current.available_rect = current.rect;
+      current.orientation_type =
+          explicit_type
+              ? (portrait
+                     ? display::mojom::blink::ScreenOrientation::kPortraitPrimary
+                     : display::mojom::blink::ScreenOrientation::kLandscapePrimary)
+              : display::mojom::blink::ScreenOrientation::kUndefined;
+      widget->UpdateScreenInfo(screens);
+      EXPECT_EQ(orientation->angle(), 0);
+      page->SetVisibilityState(mojom::blink::PageVisibilityState::kVisible, false);
+      EXPECT_EQ(orientation->type().AsEnum(),
+                portrait ? V8OrientationType::Enum::kPortraitPrimary
+                         : V8OrientationType::Enum::kLandscapePrimary);
+      EXPECT_EQ(orientation->angle(), 0);
+    }
+    test::RunPendingTasks();
+    helper.Reset();
+  }
+
+  void CheckLogicalVisibilityRestore(bool hidden) {
+    frame_test_helpers::WebViewHelper helper;
+    helper.InitializeAndLoad("about:blank");
+    auto* page = helper.GetWebView()->GetPage();
+    auto* frame = To<LocalFrame>(page->MainFrame());
+    auto* widget =
+        static_cast<WebFrameWidgetImpl*>(frame->GetWidgetForLocalRoot());
+    VisualProperties properties;
+    display::ScreenInfo physical;
+    physical.rect = gfx::Rect(800, 600);
+    physical.available_rect = physical.rect;
+    physical.orientation_type =
+        display::mojom::blink::ScreenOrientation::kLandscapePrimary;
+    properties.screen_infos = display::ScreenInfos(physical);
+    properties.new_size_device_px = gfx::Size(800, 600);
+    properties.visible_viewport_size_device_px = properties.new_size_device_px;
+    properties.compositor_viewport_pixel_rect =
+        gfx::Rect(properties.new_size_device_px);
+    viz::ParentLocalSurfaceIdAllocator allocator;
+    allocator.GenerateId();
+    properties.local_surface_id = allocator.GetCurrentLocalSurfaceId();
+    widget->ApplyVisualProperties(properties);
+    auto* orientation = ScreenOrientation::Create(frame->DomWindow());
+    EXPECT_EQ(orientation->type().AsEnum(),
+              V8OrientationType::Enum::kLandscapePrimary);
+    if (hidden)
+      page->SetVisibilityState(mojom::blink::PageVisibilityState::kHidden, false);
+    properties.glint_logical_screen_infos = properties.screen_infos;
+    auto& logical = properties.glint_logical_screen_infos->mutable_current();
+    logical.rect = gfx::Rect(390, 844);
+    logical.available_rect = logical.rect;
+    logical.orientation_type =
+        display::mojom::blink::ScreenOrientation::kPortraitPrimary;
+    logical.orientation_angle = 0;
+    widget->ApplyVisualProperties(properties);
+    if (hidden)
+      page->SetVisibilityState(mojom::blink::PageVisibilityState::kVisible, false);
+    EXPECT_EQ(orientation->type().AsEnum(),
+              V8OrientationType::Enum::kPortraitPrimary);
+    EXPECT_EQ(orientation->angle(), 0);
+    properties.glint_logical_screen_infos.reset();
+    widget->ApplyVisualProperties(properties);
+    EXPECT_EQ(orientation->type().AsEnum(),
+              V8OrientationType::Enum::kLandscapePrimary);
+    EXPECT_EQ(widget->GetScreenInfo().rect, gfx::Rect(800, 600));
+    test::RunPendingTasks();
+    helper.Reset();
+  }
+};
+
+TEST_F(GlintScreenOrientationVisibilityTest,
+       GlintExplicitTypeRestoresAtUnchangedAngle) {
+  CheckSameAngleVisibilityRestore(true);
+}
+
+TEST_F(GlintScreenOrientationVisibilityTest,
+       GlintComputedTypeRestoresAtUnchangedAngle) {
+  CheckSameAngleVisibilityRestore(false);
+}
+
+TEST_F(GlintScreenOrientationVisibilityTest,
+       GlintVisibleMainLogicalOrientationUpdatesAndClears) {
+  CheckLogicalVisibilityRestore(false);
+}
+
+TEST_F(GlintScreenOrientationVisibilityTest,
+       GlintHiddenMainLogicalOrientationRestoresAndClears) {
+  CheckLogicalVisibilityRestore(true);
+}
