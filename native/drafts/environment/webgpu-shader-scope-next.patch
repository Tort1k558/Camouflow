+void NotifyGlintShaderScope(DeviceBase* device,
+                            const SyncScopeResourceUsage& scope,
+                            bool framebufferFetch = false) {
+    auto observer = device->GetGlintReadbackObserver();
+    if (!observer) {
+        return;
+    }
+    if (scope.buffers.size() != scope.bufferSyncInfos.size() ||
+        scope.textures.size() != scope.textureSyncInfos.size() ||
+        scope.buffers.size() > kGlintShaderBufferUseLimit) {
+        observer->OnShaderScope({});
+        return;
+    }
+    if (scope.buffers.empty()) {
+        return;
+    }
+    bool textureInputs =
+        framebufferFetch || scope.resourceTable != nullptr || !scope.externalTextures.empty();
+    constexpr auto textureReads = wgpu::TextureUsage::TextureBinding |
+                                  wgpu::TextureUsage::StorageBinding | kReadOnlyStorageTexture;
+    for (const auto& info : scope.textureSyncInfos) {
+        if (textureInputs) {
+            break;
+        }
+        info.Iterate([&](const SubresourceRange&, const TextureSyncInfo& usage) {
+            if (usage.usage & textureReads) {
+                textureInputs = true;
+            }
+        });
+    }
+    std::vector<GlintShaderBufferUse> uses;
+    uses.reserve(scope.buffers.size());
+    for (size_t index = 0; index < scope.buffers.size(); ++index) {
+        auto* buffer = scope.buffers[index];
+        const auto usage = scope.bufferSyncInfos[index].usage;
+        const bool writable = !IsSubset(usage, kReadOnlyBufferUsages);
+        const bool readable =
+            (usage & (kReadOnlyBufferUsages | kShaderBufferUsages)) != wgpu::BufferUsage::None;
+        if (readable || writable) {
+            uses.push_back({{ToAPI(buffer), buffer->GetSize()}, readable, writable});
+        }
+    }
+    observer->OnShaderScope({uses, textureInputs, true});
+}
