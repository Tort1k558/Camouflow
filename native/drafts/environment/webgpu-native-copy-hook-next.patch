+namespace dawn::native::d3d12 {
+namespace {
+class NativeGlintReadbackSnapshot final : public GlintReadbackSnapshot {
+  public:
+    explicit NativeGlintReadbackSnapshot(
+        std::unique_ptr<glint::candidate::d3d12::TextureCapture> capture)
+        : mCapture(std::move(capture)) {}
+    GlintReadbackStatus Read(std::span<const uint8_t>* pixels) const override {
+        const HRESULT result = mCapture->ReadCompleted(pixels);
+        if (result == E_PENDING) {
+            return GlintReadbackStatus::Pending;
+        }
+        return SUCCEEDED(result) ? GlintReadbackStatus::Ready : GlintReadbackStatus::Failed;
+    }
+    uint32_t GetWidth() const override { return mCapture->width(); }
+    uint32_t GetHeight() const override { return mCapture->height(); }
+    uint32_t GetRowPitch() const override { return mCapture->row_pitch(); }
+    GlintReadbackFormat GetFormat() const override {
+        return mCapture->format() == DXGI_FORMAT_B8G8R8A8_UNORM ? GlintReadbackFormat::Bgra8Unorm
+                                                                : GlintReadbackFormat::Rgba8Unorm;
+    }
+
+  private:
+    std::unique_ptr<glint::candidate::d3d12::TextureCapture> mCapture;
+};
+}  // namespace
+
+ResultOrError<std::unique_ptr<glint::candidate::d3d12::TextureCapture>>
+RecordGlintTextureReadbackSnapshot(Device* device,
+                                   CommandRecordingContext* context,
+                                   Texture* texture) {
+    DAWN_INTERNAL_ERROR_IF(!device || !context || !texture || texture->GetDevice() != device,
+                           "Invalid Glint texture capture owner.");
+    DAWN_ASSERT(device->IsLockedByCurrentThreadIfNeeded());
+    DAWN_INTERNAL_ERROR_IF(!texture->HasAccess() || !texture->GetD3D12Resource(),
+                           "Glint texture capture has no resource access.");
+    const auto format = texture->GetFormat().format;
+    DAWN_INTERNAL_ERROR_IF(
+        format != wgpu::TextureFormat::RGBA8Unorm && format != wgpu::TextureFormat::BGRA8Unorm,
+        "Unsupported Glint texture capture format.");
+    DAWN_INTERNAL_ERROR_IF(!(texture->GetInternalUsage() & wgpu::TextureUsage::CopySrc),
+                           "Glint texture capture requires native copy access.");
+    const auto range = SubresourceRange::SingleMipAndLayer(0, 0, Aspect::Color);
+    DAWN_TRY(texture->EnsureSubresourceContentInitialized(context, range));
+    texture->TrackUsageAndTransitionNow(context, wgpu::TextureUsage::CopySrc, range);
+    auto* queue = ToBackend(device->GetQueue());
+    std::unique_ptr<glint::candidate::d3d12::TextureCapture> capture;
+    DAWN_TRY(CheckHRESULT(
+        glint::candidate::d3d12::TextureCapture::RecordBudgeted(
+            device->GetD3D12Device(), context->GetCommandList(), texture->GetD3D12Resource(),
+            queue->GetSharedFence()->GetD3DFence(), uint64_t{queue->GetPendingCommandSerial()},
+            device->GetGlintReadbackBudget(), &capture),
+        "Glint full texture capture"));
+    // GPU ownership survives cancellation of the CPU snapshot ticket.
+    device->ReferenceUntilUnused(capture->retirement_handle());
+    context->AddGlintReadbackSubmission(capture->submission_marker());
+    return std::move(capture);
+}
+ResultOrError<std::unique_ptr<GlintReadbackSnapshot>> RecordGlintNativeTextureSnapshot(
+    Device* device,
+    CommandRecordingContext* context,
+    Texture* texture) {
+    std::unique_ptr<glint::candidate::d3d12::TextureCapture> capture;
+    DAWN_TRY_ASSIGN(capture, RecordGlintTextureReadbackSnapshot(device, context, texture));
+    return std::unique_ptr<GlintReadbackSnapshot>(
+        new NativeGlintReadbackSnapshot(std::move(capture)));
+}
+}  // namespace dawn::native::d3d12
