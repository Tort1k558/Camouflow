+bool DeviceBase::InstallGlintReadbackObserver(std::shared_ptr<GlintReadbackObserver> observer) {
+    DAWN_ASSERT(IsLockedByCurrentThreadIfNeeded());
+    if (!observer || IsLost() ||
+        GetPhysicalDevice()->GetBackendType() != wgpu::BackendType::D3D12) {
+        return false;
+    }
+    return mGlintReadbackObserver.Use([&](auto current) {
+        if (*current) {
+            return false;
+        }
+        *current = std::move(observer);
+        return true;
+    });
+}
+
+std::shared_ptr<GlintReadbackObserver> DeviceBase::GetGlintReadbackObserver() const {
+    return mGlintReadbackObserver.Use([](auto current) { return *current; });
+}
