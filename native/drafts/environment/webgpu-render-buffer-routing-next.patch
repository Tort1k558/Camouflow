+    template <typename Visitor>
+    auto ReadWithoutAdvancing(Visitor&& visitor) {
+        struct RestoreCursor {
+            CommandIterator* iterator;
+            BlockDef* blocks;
+            size_t count;
+            size_t index;
+            Span<std::byte> current;
+            MemoryBlockAllocator* pool;
+
+            ~RestoreCursor() {
+                DAWN_CHECK(iterator->mBlocks.data() == blocks &&
+                           iterator->mBlocks.size() == count && iterator->mPool == pool);
+                iterator->mCurrentBlockIndex = index;
+                iterator->mCurrentBlock = current;
+            }
+        } restore{this, mBlocks.data(), mBlocks.size(), mCurrentBlockIndex, mCurrentBlock, mPool};
+        return visitor(this);
+    }
 
