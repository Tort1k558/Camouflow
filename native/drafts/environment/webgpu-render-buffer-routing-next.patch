+    static bool SameGlintRenderScope(const GlintBoundScope& expected,
+                                     const GlintBoundScope& actual) {
+        if (expected.textureInputs != actual.textureInputs ||
+            expected.uses.size() != actual.uses.size() ||
+            expected.owners.size() != actual.owners.size()) {
+            return false;
+        }
+        for (size_t i = 0; i < expected.owners.size(); ++i) {
+            if (expected.owners[i].Get() != actual.owners[i].Get()) {
+                return false;
+            }
+        }
+        for (size_t i = 0; i < expected.uses.size(); ++i) {
+            const auto& a = expected.uses[i];
+            const auto& b = actual.uses[i];
+            if (a.buffer.handle != b.buffer.handle || a.buffer.size != b.buffer.size ||
+                a.readable != b.readable || a.writable != b.writable || a.offset != b.offset ||
+                a.size != b.size || a.rangeKnown != b.rangeKnown) {
+                return false;
+            }
+        }
+        return true;
+    }
