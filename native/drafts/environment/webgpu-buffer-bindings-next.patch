+MaybeError BindGroup::ValidateGlintBufferOverrides(std::span<const GlintBufferViewOverride> buffers) {
+    auto* device = ToBackend(GetDevice());
+    const auto* layout = ToBackend(GetLayout());
+    std::vector<BindingIndex> seen;
+    for (const auto& replacement : buffers) {
+        DAWN_INTERNAL_ERROR_IF(replacement.binding >= layout->GetBindingCount() ||
+            !replacement.resource || !replacement.retirement ||
+            std::find(seen.begin(), seen.end(), replacement.binding) != seen.end(),
+            "Invalid or duplicate Glint buffer override.");
+        const auto& info = layout->GetBindingInfo(replacement.binding);
+        const auto* bufferInfo = std::get_if<BufferBindingInfo>(&info.bindingLayout);
+        DAWN_INTERNAL_ERROR_IF(!bufferInfo || info.visibility == wgpu::ShaderStage::None,
+            "Glint buffer override requires a visible buffer binding.");
+        const auto type = bufferInfo->type;
+        const bool uniform = type == wgpu::BufferBindingType::Uniform;
+        const bool writable = type == wgpu::BufferBindingType::Storage || type == kInternalStorageBufferBinding;
+        const bool readonly = type == wgpu::BufferBindingType::ReadOnlyStorage || type == kInternalReadOnlyStorageBufferBinding;
+        DAWN_INTERNAL_ERROR_IF(!uniform && !writable && !readonly, "Unsupported Glint buffer binding type.");
+        const auto binding = GetBindingAsBufferBinding(replacement.binding);
+        auto* source = ToBackend(binding.buffer);
+        DAWN_INTERNAL_ERROR_IF(!source || source->GetDevice() != device ||
+            !source->HasAccess() || !source->HasPrivateGlintReadbackBacking() || !binding.size ||
+            binding.offset > source->GetSize() || binding.size > source->GetSize() - binding.offset,
+            "Glint buffer override requires a private live logical owner and valid range.");
+        const auto original = source->GetD3D12Resource()->GetDesc();
+        const auto projected = replacement.resource->GetDesc();
+        ComPtr<ID3D12Device> owner;
+        DAWN_TRY(CheckHRESULT(replacement.resource->GetDevice(IID_PPV_ARGS(&owner)), "Glint buffer physical owner"));
+        D3D12_HEAP_PROPERTIES heap{};
+        D3D12_HEAP_FLAGS flags{};
+        DAWN_TRY(CheckHRESULT(replacement.resource->GetHeapProperties(&heap, &flags), "Glint buffer private heap"));
+        DAWN_INTERNAL_ERROR_IF(owner.Get() != device->GetD3D12Device() ||
+            replacement.resource.Get() == source->GetD3D12Resource() ||
+            source->GetVA() != source->GetD3D12Resource()->GetGPUVirtualAddress() ||
+            heap.Type != D3D12_HEAP_TYPE_DEFAULT ||
+            (flags & (D3D12_HEAP_FLAG_SHARED | D3D12_HEAP_FLAG_SHARED_CROSS_ADAPTER)) ||
+            projected.Dimension != D3D12_RESOURCE_DIMENSION_BUFFER || projected.Format != DXGI_FORMAT_UNKNOWN ||
+            projected.Width != original.Width || source->GetSize() > projected.Width || projected.Height != 1 || projected.DepthOrArraySize != 1 ||
+            projected.MipLevels != 1 || projected.SampleDesc.Count != 1 || projected.SampleDesc.Quality != 0 ||
+            projected.Layout != D3D12_TEXTURE_LAYOUT_ROW_MAJOR ||
+            (writable && !(projected.Flags & D3D12_RESOURCE_FLAG_ALLOW_UNORDERED_ACCESS)) ||
+            (readonly && (projected.Flags & D3D12_RESOURCE_FLAG_DENY_SHADER_RESOURCE)),
+            "Glint buffer shadow is incompatible with its source allocation.");
+        const bool root = uniform && replacement.binding < layout->GetDynamicBufferCount();
+        DAWN_INTERNAL_ERROR_IF(!root && layout->GetDescriptorHeapOffsets()[replacement.binding] >= layout->GetCbvUavSrvDescriptorCount(),
+            "Glint buffer descriptor offset is invalid.");
+        DAWN_INTERNAL_ERROR_IF(binding.offset % (uniform ? 256 : 4) != 0 ||
+            (!uniform && binding.size % 4 != 0) ||
+            (uniform && (binding.size > uint64_t{D3D12_REQ_CONSTANT_BUFFER_ELEMENT_COUNT} * 16 || binding.size > std::numeric_limits<uint64_t>::max() - 255 || binding.offset > projected.Width ||
+                Align(binding.size, uint64_t{256}) > projected.Width - binding.offset)),
+            "Glint buffer view range is incompatible with its shadow.");
+        seen.push_back(replacement.binding);
