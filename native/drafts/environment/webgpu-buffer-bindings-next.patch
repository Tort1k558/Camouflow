+void WriteBufferDescriptor(ID3D12Device* device, ID3D12Resource* resource, D3D12_GPU_VIRTUAL_ADDRESS baseAddress,
+                           const BufferBinding& binding, wgpu::BufferBindingType type,
+                           bool dynamic, D3D12_CPU_DESCRIPTOR_HANDLE slot) {
+    const uint64_t elements = (dynamic ? binding.buffer->GetSize() - binding.offset : binding.size) / 4;
+    switch (type) {
+        case wgpu::BufferBindingType::Uniform: {
+            D3D12_CONSTANT_BUFFER_VIEW_DESC desc{};
+            desc.BufferLocation = baseAddress + binding.offset;
+            desc.SizeInBytes = static_cast<UINT>(Align(binding.size, D3D12_CONSTANT_BUFFER_DATA_PLACEMENT_ALIGNMENT));
+            device->CreateConstantBufferView(&desc, slot);
+            break;
+        }
+        case wgpu::BufferBindingType::Storage:
+        case kInternalStorageBufferBinding: {
+            D3D12_UNORDERED_ACCESS_VIEW_DESC desc{};
+            desc.Format = DXGI_FORMAT_R32_TYPELESS;
+            desc.ViewDimension = D3D12_UAV_DIMENSION_BUFFER;
+            desc.Buffer.FirstElement = binding.offset / 4;
+            desc.Buffer.NumElements = static_cast<UINT>(elements);
+            desc.Buffer.Flags = D3D12_BUFFER_UAV_FLAG_RAW;
+            device->CreateUnorderedAccessView(resource, nullptr, &desc, slot);
+            break;
+        }
+        case wgpu::BufferBindingType::ReadOnlyStorage:
+        case kInternalReadOnlyStorageBufferBinding: {
+            D3D12_SHADER_RESOURCE_VIEW_DESC desc{};
+            desc.Format = DXGI_FORMAT_R32_TYPELESS;
+            desc.ViewDimension = D3D12_SRV_DIMENSION_BUFFER;
+            desc.Shader4ComponentMapping = D3D12_DEFAULT_SHADER_4_COMPONENT_MAPPING;
+            desc.Buffer.FirstElement = binding.offset / 4;
+            desc.Buffer.NumElements = static_cast<UINT>(elements);
+            desc.Buffer.Flags = D3D12_BUFFER_SRV_FLAG_RAW;
+            device->CreateShaderResourceView(resource, &desc, slot);
+            break;
+        }
+        case wgpu::BufferBindingType::BindingNotUsed:
+        case wgpu::BufferBindingType::Undefined:
+            DAWN_UNREACHABLE();
+    }
+}
