+ResultOrError<D3D12_GPU_VIRTUAL_ADDRESS> BindGroup::ResolveGlintRootBufferAddress(
+    BindingIndex index, uint32_t dynamicOffset, std::span<const GlintBufferViewOverride> buffers) {
+    DAWN_TRY(ValidateGlintBufferOverrides(buffers));
+    const auto* layout = GetLayout();
+    DAWN_INTERNAL_ERROR_IF(index >= layout->GetDynamicBufferCount() ||
+        !std::holds_alternative<BufferBindingInfo>(layout->GetBindingInfo(index).bindingLayout) ||
+        std::get<BufferBindingInfo>(layout->GetBindingInfo(index).bindingLayout).type != wgpu::BufferBindingType::Uniform,
+        "Glint root override requires a dynamic uniform binding.");
+    const auto binding = GetBindingAsBufferBinding(index);
+    const auto found = std::find_if(buffers.begin(), buffers.end(), [&](const auto& value) { return value.binding == index; });
+    DAWN_INTERNAL_ERROR_IF(found == buffers.end() || dynamicOffset % 256 != 0 ||
+        dynamicOffset > binding.buffer->GetSize() - binding.offset ||
+        binding.size > binding.buffer->GetSize() - binding.offset - dynamicOffset,
+        "Missing or out-of-range Glint dynamic uniform override.");
+    return found->resource->GetGPUVirtualAddress() + binding.offset + dynamicOffset;
+}
