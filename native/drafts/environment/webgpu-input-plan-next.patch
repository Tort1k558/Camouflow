+std::shared_ptr<const dawn::native::GlintGpuInputPlan>
+GlintWebGPUReadbackObserver::PrepareGpuInputPlan(
+    const dawn::native::GlintShaderScope& scope) {
+  std::lock_guard lock(mutex_);
+  gpu_input_plan_.reset();
+  if (failed_ || active_scope_ || !ValidateShaderScope(scope)) return nullptr;
+  std::vector<dawn::native::GlintShaderBufferUse> ranges;
+  for (const auto& use : scope.buffers) {
+    if (use.size && (use.readable || use.writable)) ranges.push_back(use);
+  }
+  std::sort(ranges.begin(), ranges.end(), [](const auto& a, const auto& b) {
+    if (a.buffer.handle != b.buffer.handle)
+      return std::less<WGPUBuffer>{}(a.buffer.handle, b.buffer.handle);
+    return a.offset < b.offset;
+  });
+  std::vector<dawn::native::GlintShaderBufferUse> merged;
+  for (const auto& use : ranges) {
+    if (!merged.empty() && merged.back().buffer.handle == use.buffer.handle &&
+        use.offset <= merged.back().offset + merged.back().size) {
+      auto& last = merged.back();
+      last.size = std::max(last.offset + last.size, use.offset + use.size) - last.offset;
+      last.readable |= use.readable;
+      last.writable |= use.writable;
+    } else {
+      merged.push_back(use);
+    }
+  }
+  auto result = std::make_shared<dawn::native::GlintGpuInputPlan>();
+  result->deviceEpoch = epoch_;
+  result->policyGeneration = policy_->generation();
+  result->sequence = sequence_;
+  WGPUBuffer currentBuffer = nullptr;
+  size_t bufferRegions = 0;
+  for (const auto& use : merged) {
+    if (currentBuffer != use.buffer.handle) {
+      currentBuffer = use.buffer.handle;
+      bufferRegions = 0;
+    }
+    const auto found = buffers_.find(use.buffer.handle);
+    if (found == buffers_.end()) continue;
+    if (found->second.unsafe) return nullptr;
+    const auto plan = found->second.provenance.PlanMap(use.offset, use.size);
+    if (plan.status == WebGpuMapProvenance::kUnrelated) continue;
+    if (plan.status != WebGpuMapProvenance::kReadback) return nullptr;
+    for (size_t index = 0; index < plan.count; ++index) {
+      const auto& region = plan.regions[index];
+      if (++bufferRegions > kWebGpuReadbackRegionLimit) return nullptr;
+      if (region.snapshot.device_epoch != epoch_ ||
+          region.snapshot.policy_generation != policy_->generation()) return nullptr;
+      const auto capture = std::find_if(pending_.begin(), pending_.end(),
+          [&](const auto& value) { return value.token == region.snapshot; });
+      if (capture == pending_.end()) return nullptr;
+      // Existing trusted shader-byte results already have protected GPU contents.
+      // Preserve the established eligibility contract without a pixel-plane rewrite.
+      if (region.kind == WebGpuReadbackRegionKind::kCapturedBytes) {
+        if (!capture->byte_native ||
+            region.snapshot_offset > capture->byte_native->GetByteSize() ||
+            region.size > capture->byte_native->GetByteSize() - region.snapshot_offset) return nullptr;
+        continue;
+      }
+      if (region.kind != WebGpuReadbackRegionKind::kPixels || !capture->native) return nullptr;
+      auto gpu = capture->native->GetGpuSnapshot();
+      if (!gpu || gpu->GetWidth() != capture->layout.width ||
+          gpu->GetHeight() != capture->layout.height ||
+          gpu->GetWidth() != region.source_rect.full_width ||
+          gpu->GetHeight() != region.source_rect.full_height ||
+          PixelFormat(gpu->GetFormat()) != std::optional{capture->layout.format} ||
+          PixelFormat(gpu->GetFormat()) != std::optional{region.snapshot_layout.format}) return nullptr;
+      if (result->regions.size() >= dawn::native::kGlintShaderBufferUseLimit * kWebGpuReadbackRegionLimit)
+        return nullptr;
+      result->regions.push_back({use.buffer, region.buffer_offset, region.size,
+          region.snapshot_offset, region.snapshot_layout.offset, region.snapshot_layout.row_pitch,
+          region.snapshot_layout.width, region.snapshot_layout.height,
+          region.source_rect.x, region.source_rect.y, gpu->GetFormat(), std::move(gpu)});
+    }
+  }
+  gpu_input_plan_ = result;
+  return result;
+}
+
+bool GlintWebGPUReadbackObserver::CommitGpuInputPlan(
+    std::shared_ptr<const dawn::native::GlintGpuInputPlan> plan) {
+  std::lock_guard lock(mutex_);
+  const auto active = gpu_input_plan_.lock();
+  gpu_input_plan_.reset();
+  return !failed_ && !active_scope_ && plan && active == plan &&
+      plan->deviceEpoch == epoch_ && plan->policyGeneration == policy_->generation() &&
+      plan->sequence == sequence_;
+}
