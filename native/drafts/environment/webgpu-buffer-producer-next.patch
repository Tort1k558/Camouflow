+class GlintNativeBufferOwner final : public IUnknown {
+  public:
+    explicit GlintNativeBufferOwner(Ref<Buffer> buffer) : mBuffer(std::move(buffer)) {}
+    HRESULT STDMETHODCALLTYPE QueryInterface(REFIID iid, void** result) override {
+        if (!result) return E_POINTER;
+        *result = nullptr;
+        if (iid != __uuidof(IUnknown)) return E_NOINTERFACE;
+        *result = static_cast<IUnknown*>(this);
+        AddRef();
+        return S_OK;
+    }
+    ULONG STDMETHODCALLTYPE AddRef() override {
+        return mReferences.fetch_add(1, std::memory_order_relaxed) + 1;
+    }
+    ULONG STDMETHODCALLTYPE Release() override {
+        const ULONG left = mReferences.fetch_sub(1, std::memory_order_acq_rel) - 1;
+        if (!left) delete this;
+        return left;
+    }
+
+  private:
+    ~GlintNativeBufferOwner() = default;
+    std::atomic<ULONG> mReferences{1};
+    Ref<Buffer> mBuffer;
+};
+
+class GlintInputPlanTransaction {
+  public:
+    explicit GlintInputPlanTransaction(std::shared_ptr<GlintReadbackObserver> observer)
+        : mObserver(std::move(observer)) {}
+    ~GlintInputPlanTransaction() {
+        if (!mComplete) mObserver->OnExecutionError();
+    }
+    void Complete() { mComplete = true; }
+
+  private:
+    std::shared_ptr<GlintReadbackObserver> mObserver;
+    bool mComplete = false;
+};
+
+bool GlintRangeCovered(const GlintShaderScope& scope, WGPUBuffer handle,
+                       uint64_t offset, uint64_t size) {
+    const uint64_t end = offset + size;
+    while (offset < end) {
+        uint64_t next = offset;
+        for (const auto& use : scope.buffers) {
+            if (use.buffer.handle == handle && (use.readable || use.writable) &&
+                use.offset <= offset && use.offset + use.size > next) {
+                next = std::min(end, use.offset + use.size);
+            }
+        }
+        if (next == offset) return false;
+        offset = next;
+    }
+    return true;
+}
