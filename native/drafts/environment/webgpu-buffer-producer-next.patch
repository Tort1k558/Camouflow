+ResultOrError<std::unique_ptr<GlintBufferProjectionBatch>>
+GlintTextureProjector::RecordBuffers(CommandRecordingContext* context,
+                                    const GlintShaderScope& scope,
+                                    std::span<const Ref<BufferBase>> owners) {
+    auto observer = mDevice->GetGlintReadbackObserver();
+    DAWN_INTERNAL_ERROR_IF(!context || !observer || !scope.complete ||
+        scope.buffers.size() > kGlintShaderBufferUseLimit ||
+        owners.size() > kGlintShaderBufferUseLimit,
+        "Invalid Glint native buffer projection scope.");
+    DAWN_ASSERT(mDevice->IsLockedByCurrentThreadIfNeeded());
+    GlintInputPlanTransaction transaction(observer);
+    for (const auto& use : scope.buffers) {
+        const auto owner = std::find_if(owners.begin(), owners.end(), [&](const auto& value) {
+            return value && ToAPI(value.Get()) == use.buffer.handle;
+        });
+        DAWN_INTERNAL_ERROR_IF(owner == owners.end() || (*owner)->GetDevice() != mDevice ||
+            !ToBackend(owner->Get())->HasAccess() ||
+            !ToBackend(owner->Get())->HasPrivateGlintReadbackBacking() ||
+            use.buffer.size != (*owner)->GetSize() || !use.rangeKnown ||
+            use.offset > use.buffer.size || use.size > use.buffer.size - use.offset,
+            "Glint input scope has no accessible matching native owner.");
+    }
+    auto batch = std::make_unique<GlintBufferProjectionBatch>();
+    batch->plan = observer->PrepareGpuInputPlan(scope);
+    DAWN_INTERNAL_ERROR_IF(!batch->plan ||
+        batch->plan->regions.size() > kGlintShaderBufferUseLimit * 16,
+        "Glint GPU input metadata plan was denied.");
+    struct Pending {
+        Ref<Buffer> buffer;
+        std::vector<glint::candidate::d3d12::ProjectedBufferRegion> regions;
+        std::vector<GlintBufferWriteRange> writes;
+    };
+    std::vector<Pending> pending;
+    for (const auto& region : batch->plan->regions) {
+        const auto owner = std::find_if(owners.begin(), owners.end(), [&](const auto& value) {
+            return value && ToAPI(value.Get()) == region.buffer.handle;
+        });
+        DAWN_INTERNAL_ERROR_IF(owner == owners.end() || (*owner)->GetDevice() != mDevice ||
+            region.buffer.size != (*owner)->GetSize() || !region.size ||
+            region.bufferOffset > region.buffer.size ||
+            region.size > region.buffer.size - region.bufferOffset ||
+            !GlintRangeCovered(scope, region.buffer.handle, region.bufferOffset, region.size),
+            "Glint projected region exceeds its actual native binding scope.");
+        auto* buffer = ToBackend(owner->Get());
+        auto pixels = ResolveSnapshot(region.snapshot);
+        const auto parameters = std::bit_cast<glint::candidate::BufferScatterParameters>(region.mapping);
+        DAWN_INTERNAL_ERROR_IF(!pixels || !pixels->PixelBuffer() ||
+            parameters.destination_offset != region.bufferOffset ||
+            parameters.region_bytes != region.size ||
+            parameters.destination_bytes != buffer->GetSize() ||
+            parameters.protected_bytes != pixels->PixelBuffer()->GetDesc().Width ||
+            parameters.full_width != region.snapshot->GetWidth() ||
+            parameters.full_height != region.snapshot->GetHeight() ||
+            parameters.bgra || region.format != region.snapshot->GetFormat(),
+            "Glint GPU input capability or scatter geometry differs.");
+        auto found = std::find_if(pending.begin(), pending.end(), [&](const auto& value) {
+            return value.buffer.Get() == buffer;
+        });
+        if (found == pending.end()) {
+            pending.push_back({Ref<Buffer>(buffer), {}, {}});
+            found = std::prev(pending.end());
+        }
+        DAWN_INTERNAL_ERROR_IF(found->regions.size() == 16,
+                              "Too many Glint projected regions for one native buffer.");
+        found->regions.push_back({pixels->PixelBuffer(), pixels->RetirementHandle(), parameters});
+    }
+    for (auto& item : pending) {
+        for (const auto& use : scope.buffers) {
+            if (use.buffer.handle == ToAPI(item.buffer.Get()) && use.writable && use.size) {
+                item.writes.push_back({use.offset, use.size});
+            }
+        }
+        std::sort(item.writes.begin(), item.writes.end(), [](const auto& a, const auto& b) {
+            return a.offset < b.offset;
+        });
+        std::vector<GlintBufferWriteRange> merged;
+        for (const auto& range : item.writes) {
+            if (!merged.empty() && range.offset <= merged.back().offset + merged.back().size) {
+                auto& last = merged.back();
+                last.size = std::max(last.offset + last.size, range.offset + range.size) - last.offset;
+            } else {
+                merged.push_back(range);
+            }
+        }
+        item.writes = std::move(merged);
+    }
+    DAWN_INTERNAL_ERROR_IF(!observer->CommitGpuInputPlan(batch->plan),
+                          "Glint GPU input plan became stale before native recording.");
+    if (!pending.empty()) DAWN_TRY(EnsureBufferPipeline());
+    auto* queue = ToBackend(mDevice->GetQueue());
+    for (auto& item : pending) {
+        DAWN_TRY(item.buffer->EnsureGlintAllocationInitialized(context));
+        item.buffer->TrackUsageAndTransitionNow(context, wgpu::BufferUsage::CopySrc);
+        ComPtr<GlintNativeBufferOwner> owner;
+        owner.Attach(new (std::nothrow) GlintNativeBufferOwner(item.buffer));
+        DAWN_INTERNAL_ERROR_IF(!owner, "Glint native buffer owner allocation failed.");
+        std::unique_ptr<glint::candidate::d3d12::ProjectedBuffer> projected;
+        DAWN_TRY(CheckHRESULT(glint::candidate::d3d12::ProjectedBuffer::Record(
+            mDevice->GetD3D12Device(), context->GetCommandList(), item.buffer->GetD3D12Resource(),
+            owner.Get(), item.buffer->GetSize(), true, item.regions, mRoot.Get(), mBufferPipeline.Get(),
+            queue->GetSharedFence()->GetD3DFence(), uint64_t{queue->GetPendingCommandSerial()},
+            mDevice->GetGlintReadbackBudget(), &projected), "Glint private buffer projection"));
+        mDevice->ReferenceUntilUnused(projected->retirement_handle());
+        context->AddGlintReadbackSubmission(projected->submission_marker());
+        batch->buffers.push_back({item.buffer, std::move(projected), std::move(item.writes)});
+    }
+    transaction.Complete();
+    return std::move(batch);
+}
