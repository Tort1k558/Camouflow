+#include "src/dawn/native/d3d12/GlintTextureReadbackD3D12.h"
+
+#include "src/dawn/native/d3d/D3DError.h"
+#include "src/dawn/native/d3d12/CommandRecordingContext.h"
+#include "src/dawn/native/d3d12/DeviceD3D12.h"
+#include "src/dawn/native/d3d12/QueueD3D12.h"
+#include "src/dawn/native/d3d12/SharedFenceD3D12.h"
+#include "src/dawn/native/d3d12/TextureD3D12.h"
+namespace dawn::native::d3d12 {
+ResultOrError<std::unique_ptr<glint::candidate::d3d12::TextureCapture>>
+RecordGlintTextureReadbackSnapshot(Device* device,
+                                   CommandRecordingContext* context,
+                                   Texture* texture) {
+    DAWN_INTERNAL_ERROR_IF(!device || !context || !texture || texture->GetDevice() != device,
+                           "Invalid Glint texture capture owner.");
+    DAWN_ASSERT(device->IsLockedByCurrentThreadIfNeeded());
+    DAWN_INTERNAL_ERROR_IF(!texture->HasAccess() || !texture->GetD3D12Resource(),
+                           "Glint texture capture has no resource access.");
+    const auto format = texture->GetFormat().format;
+    DAWN_INTERNAL_ERROR_IF(
+        format != wgpu::TextureFormat::RGBA8Unorm && format != wgpu::TextureFormat::BGRA8Unorm,
+        "Unsupported Glint texture capture format.");
+    DAWN_INTERNAL_ERROR_IF(!(texture->GetInternalUsage() & wgpu::TextureUsage::CopySrc),
+                           "Glint texture capture requires native copy access.");
+    const auto range = SubresourceRange::SingleMipAndLayer(0, 0, Aspect::Color);
+    DAWN_TRY(texture->EnsureSubresourceContentInitialized(context, range));
+    texture->TrackUsageAndTransitionNow(context, wgpu::TextureUsage::CopySrc, range);
+    auto* queue = ToBackend(device->GetQueue());
+    std::unique_ptr<glint::candidate::d3d12::TextureCapture> capture;
+    DAWN_TRY(
+        CheckHRESULT(glint::candidate::d3d12::TextureCapture::RecordBudgeted(
+                         device->GetD3D12Device(), context->GetCommandList(),
+                         texture->GetD3D12Resource(), queue->GetSharedFence()->GetD3DFence(),
+                         uint64_t{queue->GetPendingCommandSerial()}, device->GetGlintReadbackBudget(), &capture),
+                     "Glint full texture capture"));
+    // GPU ownership survives cancellation of the CPU snapshot ticket.
+    device->ReferenceUntilUnused(capture->retirement_handle());
+    context->AddGlintReadbackSubmission(capture->submission_marker());
+    return std::move(capture);
+}
