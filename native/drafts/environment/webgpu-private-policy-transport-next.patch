+error::Error WebGPUDecoderImpl::HandleSetGlintDevicePolicy(
+    uint32_t /*immediate_data_size*/,
+    const volatile void* cmd_data) {
+  const auto& command =
+      *static_cast<const volatile webgpu::cmds::SetGlintDevicePolicy*>(
+          cmd_data);
+  const uint32_t size = command.policy_size;
+  if (size != kGlintWebGPUPolicyPacketBytes) {
+    return error::kInvalidArguments;
+  }
+  auto memory = GetSharedMemoryAsSpan(command.policy_shm_id,
+                                      command.policy_shm_offset, size);
+  if (!memory) {
+    return error::kOutOfBounds;
+  }
+  // Decode once into owned memory. Shared memory is untrusted and transient.
+  auto policy = GlintWebGPUDevicePolicy::Decode(
+      std::span<const uint8_t>(memory->data(), memory->size()));
+  if (!policy) {
+    return error::kInvalidArguments;
+  }
+  wgpu::Device device =
+      wire_server_->GetDevice(command.device_id, command.device_generation);
+  if (!device) {
+    return error::kInvalidArguments;
+  }
+  auto metadata = known_device_metadata_.find(device);
+  if (metadata == known_device_metadata_.end()) {
+    return error::kInvalidArguments;
+  }
+  // Device identity is immutable; exact retries are allowed, replacement is
+  // not.
+  auto& current = metadata->second.glint_policy;
+  if (current) {
+    return current->Matches(*policy) ? error::kNoError
+                                     : error::kInvalidArguments;
+  }
+  current = std::make_shared<const GlintWebGPUDevicePolicy>(std::move(*policy));
+  return error::kNoError;
+}
