+bool WebGPUImplementation::ConfigureGlintDevicePolicy(
+    WGPUDevice device,
+    const GlintWebGPUDevicePolicy& policy) {
+#if BUILDFLAG(USE_DAWN)
+  if (!device || !dawn_wire_ || helper_->IsContextLost()) {
+    return false;
+  }
+  auto packet = policy.Encode();
+  if (!packet) {
+    return false;
+  }
+  const auto handle = dawn_wire_->GetDeviceWireHandle(device);
+  if (handle.id == 0) {
+    return false;
+  }
+  // Creation/free commands must reach the server before resolving wire IDs.
+  dawn_wire_->Commit();
+  auto* command_buffer = helper_->command_buffer();
+  int32_t id = -1;
+  auto memory = command_buffer->CreateTransferBuffer(
+      kGlintWebGPUPolicyPacketBytes, &id, 0,
+      TransferBufferAllocationOption::kReturnNullOnOOM);
+  if (!memory || id <= 0) {
+    return false;
+  }
+  auto bytes = memory->as_byte_span();
+  if (bytes.size() < kGlintWebGPUPolicyPacketBytes) {
+    OPENSSL_cleanse(bytes.data(), bytes.size());
+    command_buffer->DestroyTransferBuffer(id);
+    return false;
+  }
+  // Dedicated allocation: never leave a secret in the pooled transfer buffer.
+  std::copy(packet->bytes().begin(), packet->bytes().end(), bytes.begin());
+  helper_->SetGlintDevicePolicy(handle.id, handle.generation, id, 0,
+                                kGlintWebGPUPolicyPacketBytes);
+  const int32_t token = helper_->InsertToken();
+  helper_->OrderingBarrier();
+  helper_->WaitForToken(token);
+  const bool consumed =
+      helper_->HasTokenPassed(token) && !helper_->IsContextLost();
+  OPENSSL_cleanse(bytes.data(), bytes.size());
+  command_buffer->DestroyTransferBuffer(id);
+  return consumed;
+#else
+  return false;
+#endif
 }
 
