+constexpr char kSurfaceFeatureNames[] =
+    "ThirdPartyStoragePartitioning,GlintAudioMathCandidate,"
+    "GlintWebGLReadbackCandidate,GlintReadbackMetadataCandidate,"
+    "GlintWebGPUPolicyTransportCandidate";
+
+base::CommandLine SurfacePolicyCommand(const char* mode) {
+  base::CommandLine command(base::CommandLine::NO_PROGRAM);
+  command.AppendSwitchASCII(glint::candidate::kProfileSurfacePolicySwitch, "1");
+  command.AppendSwitchASCII(kNativePrivacyKeyServiceSwitch, "1");
+  command.AppendSwitchASCII(kNativeFingerprintDerivationModeSwitch, mode);
+  return command;
+}
+
+TEST(NativeSurfaceLaunchTest, ExplicitModesUseProductionBootstrap) {
+  base::test::ScopedFeatureList features;
+  features.InitFromCommandLine(kSurfaceFeatureNames, "");
+  for (const auto* mode : {"profile-identity", "partitioned-privacy"}) {
+    auto command = SurfacePolicyCommand(mode);
+    EXPECT_EQ(ResolveNativeFingerprintDerivationModeForLaunch(command),
+              std::string_view(mode) == "profile-identity"
+                  ? NativeFingerprintDerivationMode::kProfileIdentity
+                  : NativeFingerprintDerivationMode::kPartitionedPrivacy);
+    EXPECT_TRUE(glint::candidate::HasDocumentSurfacePolicy(command));
+    EXPECT_TRUE(glint::candidate::HasWorkerSurfacePolicy(command));
+    EXPECT_FALSE(command.HasSwitch("glint-document-surface-bootstrap-test"));
+    EXPECT_FALSE(command.HasSwitch("glint-worker-surface-bootstrap-test"));
+  }
+}
+
+TEST(NativeSurfaceLaunchTest, RejectsEveryMissingEffectiveFeature) {
+  const char* names[] = {"ThirdPartyStoragePartitioning", "GlintAudioMathCandidate",
+                         "GlintWebGLReadbackCandidate", "GlintReadbackMetadataCandidate",
+                         "GlintWebGPUPolicyTransportCandidate"};
+  for (const auto* disabled : names) {
+    SCOPED_TRACE(disabled);
+    std::string enabled;
+    for (const auto* name : names) {
+      if (std::string_view(name) != disabled) {
+        if (!enabled.empty()) {
+          enabled += ',';
+        }
+        enabled += name;
+      }
+    }
+    base::test::ScopedFeatureList features;
+    features.InitFromCommandLine(enabled, disabled);
+    for (const auto* mode : {"profile-identity", "partitioned-privacy"}) {
+      EXPECT_FALSE(ResolveNativeFingerprintDerivationModeForLaunch(
+          SurfacePolicyCommand(mode)));
+    }
+  }
+}
+
+TEST(NativeSurfaceLaunchTest, RejectsVersionKeyModeAndDiagnosticConflicts) {
+  base::test::ScopedFeatureList features;
+  features.InitFromCommandLine(kSurfaceFeatureNames, "");
+  for (const auto* mode : {"profile-identity", "partitioned-privacy"}) {
+    for (const auto* version : {"", "0", "2", "01", " 1", "1 "}) {
+      auto command = SurfacePolicyCommand(mode);
+      command.RemoveSwitch(glint::candidate::kProfileSurfacePolicySwitch);
+      command.AppendSwitchASCII(glint::candidate::kProfileSurfacePolicySwitch,
+                                version);
+      EXPECT_FALSE(ResolveNativeFingerprintDerivationModeForLaunch(command));
+    }
+    for (const auto* version : {"", "0", "2", "01"}) {
+      auto command = SurfacePolicyCommand(mode);
+      command.RemoveSwitch(kNativePrivacyKeyServiceSwitch);
+      command.AppendSwitchASCII(kNativePrivacyKeyServiceSwitch, version);
+      EXPECT_FALSE(ResolveNativeFingerprintDerivationModeForLaunch(command));
+    }
+    for (const auto* missing : {kNativePrivacyKeyServiceSwitch,
+                                kNativeFingerprintDerivationModeSwitch}) {
+      auto command = SurfacePolicyCommand(mode);
+      command.RemoveSwitch(missing);
+      EXPECT_FALSE(ResolveNativeFingerprintDerivationModeForLaunch(command));
+    }
+    for (const auto* diagnostic : {"glint-document-surface-bootstrap-test",
+                                   "glint-worker-surface-bootstrap-test",
+                                   "glint-document-canvas-bootstrap-test",
+                                   "glint-worker-canvas-bootstrap-test"}) {
+      auto command = SurfacePolicyCommand(mode);
+      command.AppendSwitch(diagnostic);
+      EXPECT_FALSE(ResolveNativeFingerprintDerivationModeForLaunch(command));
+    }
+  }
+}
+
+TEST(NativeSurfaceLaunchTest, AbsentVersionRetainsOrdinaryStartup) {
+  base::CommandLine command(base::CommandLine::NO_PROGRAM);
+  EXPECT_EQ(ResolveNativeFingerprintDerivationModeForLaunch(command),
+            NativeFingerprintDerivationMode::kPartitionedPrivacy);
+  EXPECT_FALSE(glint::candidate::HasDocumentSurfacePolicy(command));
+  EXPECT_FALSE(glint::candidate::HasWorkerSurfacePolicy(command));
+}
