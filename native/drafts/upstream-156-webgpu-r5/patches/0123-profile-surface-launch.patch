 std::optional<NativeFingerprintDerivationMode>
 ResolveNativeFingerprintDerivationModeForLaunch(
     const base::CommandLine& command) {
+  if (command.HasSwitch(glint::candidate::kProfileSurfacePolicySwitch)) {
+    const auto version = command.GetSwitchValueASCII(
+        glint::candidate::kProfileSurfacePolicySwitch);
+    const auto key_version = command.GetSwitchValueASCII(kNativePrivacyKeyServiceSwitch);
+    const auto mode = command.GetSwitchValueASCII(kNativeFingerprintDerivationModeSwitch);
+    const glint::candidate::ProfileSurfaceLaunchInput input{
+        version,
+        command.HasSwitch(kNativePrivacyKeyServiceSwitch)
+            ? std::optional<std::string_view>(key_version) : std::nullopt,
+        mode,
+        command.HasSwitch("glint-document-surface-bootstrap-test") ||
+            command.HasSwitch("glint-worker-surface-bootstrap-test") ||
+            command.HasSwitch("glint-document-canvas-bootstrap-test") ||
+            command.HasSwitch("glint-worker-canvas-bootstrap-test"),
+        base::FeatureList::IsEnabled(net::features::kThirdPartyStoragePartitioning),
+        base::FeatureList::IsEnabled(blink::features::kGlintAudioMathCandidate),
+        base::FeatureList::IsEnabled(blink::features::kGlintWebGLReadbackCandidate),
+        base::FeatureList::IsEnabled(::features::kGlintReadbackMetadataCandidate),
+        base::FeatureList::IsEnabled(gpu::webgpu::kGlintWebGPUPolicyTransportCandidate)};
+    if (glint::candidate::ValidateProfileSurfaceLaunch(input) !=
+        glint::candidate::ProfileSurfaceLaunchStatus::kValidated) {
+      return std::nullopt;
+    }
+    return mode == "profile-identity"
+               ? NativeFingerprintDerivationMode::kProfileIdentity
+               : NativeFingerprintDerivationMode::kPartitionedPrivacy;
+  }
   if (!command.HasSwitch(kNativeFingerprintDerivationModeSwitch)) {
     return NativeFingerprintDerivationMode::kPartitionedPrivacy;
   }
