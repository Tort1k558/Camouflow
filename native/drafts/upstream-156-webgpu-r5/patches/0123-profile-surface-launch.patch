+// Copyright 2026 CamouFlow contributors.
+// SPDX-License-Identifier: MIT
+#ifndef THIRD_PARTY_BLINK_PUBLIC_COMMON_NATIVE_PRIVACY_GLINT_PROFILE_SURFACE_ACTIVATION_H_
+#define THIRD_PARTY_BLINK_PUBLIC_COMMON_NATIVE_PRIVACY_GLINT_PROFILE_SURFACE_ACTIVATION_H_
+
+#include "base/command_line.h"
+
+namespace glint::candidate {
+inline constexpr char kProfileSurfacePolicySwitch[] = "glint-profile-surface-policy";
+
+// Browser launch validation must run before forwarding this version to children.
+// These predicates select IPC bootstrap paths; they never authorize a policy.
+inline bool HasProfileSurfacePolicy(const base::CommandLine& command) {
+  return command.HasSwitch(kProfileSurfacePolicySwitch) &&
+         command.GetSwitchValueASCII(kProfileSurfacePolicySwitch) == "1";
+}
+
+inline bool HasDocumentSurfacePolicy(const base::CommandLine& command) {
+  return HasProfileSurfacePolicy(command) ||
+         command.HasSwitch("glint-document-surface-bootstrap-test");
+}
+
+inline bool HasWorkerSurfacePolicy(const base::CommandLine& command) {
+  return HasProfileSurfacePolicy(command) ||
+         command.HasSwitch("glint-worker-surface-bootstrap-test");
+}
+}  // namespace glint::candidate
+#endif
