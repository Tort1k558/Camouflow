+  ASSERT_EQ(handlers.size(), 1u);
+  auto other = Request(handlers.front());
+  base::RunLoop().RunUntilIdle();
+  ASSERT_TRUE(other->data.scope);
+  EXPECT_TRUE(other->data.scope->IsValid());
+  EXPECT_TRUE(first->data.scope->IsValid());
+}
+
+TEST_F(GlintScreenshotEmulationTest, DestroyedTargetCancelsSafely) {
+  auto first = Request(a_);
+  base::RunLoop().RunUntilIdle();
+  ASSERT_TRUE(first->data.scope);
