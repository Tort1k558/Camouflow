+  EXPECT_FALSE(reply->data.scope->IsValid());
+  EXPECT_EQ(contents()->GetRenderWidgetHostView()->GetViewBounds(), bounds);
+  EXPECT_EQ(a_->GetDeviceEmulationParams(), params);
+}
+
+TEST_F(GlintScreenshotEmulationTest, StaleOwnerClearKeepsCurrentOverride) {
