+    std::move(request.ready).Run(std::move(scope));
+  }
+
+  template <typename Predicate>
+  void CancelQueued(Predicate predicate) {
+    base::circular_deque<Request> retained;
+    while (!requests_.empty()) {
+      Request request = std::move(requests_.front());
+      requests_.pop_front();
+      if (predicate(request)) {
+        base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+            FROM_HERE, base::BindOnce(
+                           [](Ready ready) { std::move(ready).Run(nullptr); },
+                           std::move(request.ready)));
+      } else {
+        retained.push_back(std::move(request));
+      }
+    }
+    requests_.swap(retained);
+    Schedule();
+  }
+
+  void CancelActive() {
+    if (!active_) {
+      return;
+    }
+    const uint64_t id = active_->id;
+    active_->cancelled = true;
+    Finish(id);
+  }
+
+  void RestoreEffects() {
+    if (!active_ || active_->restored) {
+      return;
+    }
+    active_->restored = true;
+    const auto frame = active_->frame;
+    const auto document_token = active_->document_token;
+    if (!CanTouch(frame.get()) ||
+        frame->GetDocumentToken() != document_token) {
+      return;
+    }
+    auto weak = weak_factory_.GetWeakPtr();
+    const bool mutated = active_->mutated;
+    const bool resized = active_->resized;
+    const gfx::Size size = active_->original_view_size;
+    const auto preferences = active_->preferences;
+    if (resized) {
+      frame->GetRenderWidgetHost()->GetView()->SetSize(size);
+    }
+    if (!weak || !CanTouch(frame.get()) ||
+        frame->GetDocumentToken() != document_token) {
+      return;
+    }
+    if (mutated) {
+      ApplyTargetEmulation(frame.get(), params_, params_,
+                          blink::mojom::DeviceEmulationCacheBehavior::kClearCache);
+    }
+    if (!weak || !CanTouch(frame.get()) ||
+        frame->GetDocumentToken() != document_token) {
+      return;
+    }
+    if (preferences) {
+      auto* view = frame->render_view_host();
+      auto prefs = view->GetDelegate()->GetOrCreateWebPreferences(view);
+      // Only undo the two capture-owned fields, not unrelated preference updates.
+      if (prefs.hide_scrollbars) {
+        prefs.hide_scrollbars = preferences->first;
+      }
+      if (prefs.record_whole_document) {
+        prefs.record_whole_document = preferences->second;
+      }
+      view->GetDelegate()->SetWebPreferences(prefs);
+    }
+  }
