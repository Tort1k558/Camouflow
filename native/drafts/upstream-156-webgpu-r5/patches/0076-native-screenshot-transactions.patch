+  ASSERT_TRUE(reply->data.scope->UseFullPagePreferences());
+  auto prefs = view->GetDelegate()->GetOrCreateWebPreferences(view);
+  EXPECT_TRUE(prefs.hide_scrollbars);
+  EXPECT_TRUE(prefs.record_whole_document);
