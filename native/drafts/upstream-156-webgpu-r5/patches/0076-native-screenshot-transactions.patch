+class ScreenshotEmulationTargetRegistry : public base::SupportsUserData::Data {
+ public:
+  base::flat_map<std::string, base::WeakPtr<ScreenshotEmulationTargetState>> targets;
+};
+
+ScreenshotEmulationTargetRegistry& ScreenshotRegistry(WebContentsImpl& contents) {
+  auto* registry = static_cast<ScreenshotEmulationTargetRegistry*>(
+      contents.GetUserData(kScreenshotEmulationTargetStateKey));
+  if (!registry) {
+    auto owned = std::make_unique<ScreenshotEmulationTargetRegistry>();
+    registry = owned.get();
+    contents.SetUserData(kScreenshotEmulationTargetStateKey, std::move(owned));
+  }
+  return *registry;
+}
+
+}  // namespace
+
+scoped_refptr<ScreenshotEmulationTargetState>
+ScreenshotEmulationTargetState::For(
+    WebContentsImpl& contents,
+    const std::string& target_id,
+    scoped_refptr<ScreenshotEmulationTargetState> previous) {
+  auto& targets = ScreenshotRegistry(contents).targets;
+  for (auto it = targets.begin(); it != targets.end();) {
+    if (!it->second || it->second->contents() != &contents) {
+      it = targets.erase(it);
+    } else {
+      ++it;
+    }
+  }
+  auto found = targets.find(target_id);
+  if (found != targets.end()) {
+    return base::WrapRefCounted(found->second.get());
+  }
+  auto state = previous && previous->target_id_ == target_id
+                   ? std::move(previous)
+                   : base::MakeRefCounted<ScreenshotEmulationTargetState>(
+                         contents.GetWeakPtr(), target_id);
+  targets.emplace(target_id, state->weak_factory_.GetWeakPtr());
+  return state;
+}
+
+bool ScreenshotEmulationTargetState::BeforeContentsMutation(
+    WebContentsImpl& contents) {
+  auto alive = contents.GetWeakPtr();
+  std::vector<base::WeakPtr<ScreenshotEmulationTargetState>> states;
+  for (const auto& entry : ScreenshotRegistry(contents).targets) {
+    if (entry.second && entry.second->contents() == &contents) {
+      states.push_back(entry.second);
+    }
+  }
+  for (auto state : states) {
+    if (state) {
+      state->BeforeMutation();
+    }
+    if (!alive || alive->IsBeingDestroyed()) {
+      return false;
+    }
+  }
+  return true;
+}
+
+ScopedScreenshotEmulation::ScopedScreenshotEmulation(
+    base::WeakPtr<ScreenshotEmulationTargetState> state,
+    uint64_t capture_id,
+    std::optional<blink::DeviceEmulationParams> original_params)
+    : state_(std::move(state)),
+      capture_id_(capture_id),
+      original_params_(std::move(original_params)) {}
+
+ScopedScreenshotEmulation::~ScopedScreenshotEmulation() {
+  Finish();
+}
+
+bool ScopedScreenshotEmulation::IsValid() const {
+  return state_ && state_->IsValid(capture_id_);
+}
+
+const std::optional<blink::DeviceEmulationParams>&
+ScopedScreenshotEmulation::original_params() const {
+  return original_params_;
+}
+
+bool ScopedScreenshotEmulation::Apply(const blink::DeviceEmulationParams& params) {
+  return state_ && state_->ApplyCapture(capture_id_, params);
+}
+
+bool ScopedScreenshotEmulation::SetViewSize(const gfx::Size& size) {
+  return state_ && state_->SetViewSize(capture_id_, size);
+}
+
+bool ScopedScreenshotEmulation::UseFullPagePreferences() {
+  return state_ && state_->UseFullPagePreferences(capture_id_);
+}
+
+void ScopedScreenshotEmulation::Finish() {
+  if (state_) {
+    state_->Finish(capture_id_);
+    state_.reset();
+  }
+}
