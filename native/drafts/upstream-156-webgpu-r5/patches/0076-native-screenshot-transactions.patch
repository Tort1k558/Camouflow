+}
+
+TEST_F(GlintScreenshotEmulationTest, OwnerDetachCancelsForeignCaptureAndClearsOverride) {
+  a_->SetDeviceEmulationParams(Metrics());
+  auto reply = Request(b_);
+  base::RunLoop().RunUntilIdle();
+  ASSERT_TRUE(reply->data.scope);
+  ASSERT_TRUE(reply->data.scope->Apply(Metrics(8, 8, 1)));
+  DetachA();
+  EXPECT_FALSE(reply->data.scope->IsValid());
+  auto next = Request(b_);
+  base::RunLoop().RunUntilIdle();
+  ASSERT_TRUE(next->data.scope);
+  EXPECT_FALSE(next->data.scope->original_params().has_value());
+}
+
+TEST_F(GlintScreenshotEmulationTest, NavigationDropsOldDocumentLeaseAndQueue) {
+  const auto params = Metrics();
+  a_->SetDeviceEmulationParams(params);
+  auto first = Request(b_);
+  base::RunLoop().RunUntilIdle();
+  ASSERT_TRUE(first->data.scope);
+  auto queued = Request(a_);
+  contents()->NavigateAndCommit(GURL("https://other.glint.test/capture"));
+  base::RunLoop().RunUntilIdle();
+  EXPECT_FALSE(first->data.scope->IsValid());
+  EXPECT_TRUE(queued->data.called);
+  EXPECT_FALSE(queued->data.scope);
+  auto next = Request(b_);
+  base::RunLoop().RunUntilIdle();
+  ASSERT_TRUE(next->data.scope);
+  EXPECT_EQ(*next->data.scope->original_params(), params);
+}
+
+TEST_F(GlintScreenshotEmulationTest, FullPageRestoresOnlyItsPreferenceFields) {
+  auto* view = test_rvh();
+  const auto initial = view->GetDelegate()->GetOrCreateWebPreferences(view);
+  auto reply = Request(a_);
+  base::RunLoop().RunUntilIdle();
