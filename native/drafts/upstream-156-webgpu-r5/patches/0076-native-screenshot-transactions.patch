+  auto other_agent = DevToolsAgentHost::GetOrCreateFor(other_contents.get());
+  GlintScreenshotCaptureClient client;
+  client.InspectAgentHost(other_agent.get());
+  base::ScopedClosureRunner close(base::BindOnce(
