+constexpr char kScreenshotEmulationTargetStateKey[] =
+    "glint-screenshot-emulation-target-state";
+
+void ApplyTargetEmulation(
+    RenderFrameHostImpl* frame,
+    const std::optional<blink::DeviceEmulationParams>& render_params,
+    const std::optional<blink::DeviceEmulationParams>& logical_params,
+    blink::mojom::DeviceEmulationCacheBehavior cache_behavior) {
+  frame->ForEachRenderFrameHostImplIncludingSpeculative(
+      [&render_params, &logical_params, cache_behavior](RenderFrameHostImpl* host) {
+        if (!host->is_main_frame()) {
+          return;
+        }
+        auto* widget = host->GetRenderWidgetHost();
+        widget->SetGlintLogicalScreenEmulation(logical_params);
+        auto& remote = widget->GetAssociatedFrameWidget();
+        if (remote) {
+          if (render_params) {
+            remote->EnableDeviceEmulation(*render_params, cache_behavior);
+          } else {
+            remote->DisableDeviceEmulation();
+          }
+        }
+      });
+  frame->ForEachRenderFrameHostImplIncludingSpeculative(
+      [](RenderFrameHostImpl* host) {
+        host->GetRenderWidgetHost()->SynchronizeVisualProperties();
+      });
+}
+
+}  // namespace
+
+class ScreenshotEmulationTargetState
+    : public base::RefCounted<ScreenshotEmulationTargetState>,
+      public WebContentsObserver {
+ public:
+  using Ready =
+      base::OnceCallback<void(std::unique_ptr<ScopedScreenshotEmulation>)>;
+
+  static scoped_refptr<ScreenshotEmulationTargetState> For(
+      WebContentsImpl& contents,
+      const std::string& target_id,
+      scoped_refptr<ScreenshotEmulationTargetState> previous);
+  static bool BeforeContentsMutation(WebContentsImpl& contents);
+
+  ScreenshotEmulationTargetState(base::WeakPtr<WebContents> contents,
+                                  std::string target_id)
+      : WebContentsObserver(contents.get()),
+        contents_(std::move(contents)),
+        target_id_(std::move(target_id)) {}
+
+  void Bind(WebContentsImpl& contents, RenderFrameHostImpl* frame) {
+    if (bound_frame_.get() != frame || contents_.get() != &contents) {
+      if (bound_frame_) {
+        InvalidateFrame(bound_frame_.get());
+      }
+      Observe(&contents);
+      contents_ = contents.GetWeakPtr();
+      bound_frame_ = frame->GetWeakPtr();
+    }
+  }
+
+  WebContentsImpl* contents() const {
+    return contents_ && !contents_->IsBeingDestroyed()
+               ? static_cast<WebContentsImpl*>(contents_.get())
+               : nullptr;
+  }
+
+  bool Owns(const base::UnguessableToken& owner) const {
+    return !owner_.is_empty() && owner_ == owner;
+  }
+
+  bool HasOwner() const { return !owner_.is_empty(); }
+
+  bool SetOwner(const base::UnguessableToken& owner,
+                std::optional<blink::DeviceEmulationParams> params) {
+    DCHECK_CURRENTLY_ON(BrowserThread::UI);
+    auto weak = weak_factory_.GetWeakPtr();
+    CancelActive();
+    if (!weak || (!contents() && params)) {
+      return false;
+    }
+    owner_ = params ? owner : base::UnguessableToken();
+    params_ = std::move(params);
+    return true;
+  }
+
+  const std::optional<blink::DeviceEmulationParams>& params() const {
+    return params_;
+  }
+
+  void ApplyPersistent(
+      RenderFrameHostImpl* frame,
+      blink::mojom::DeviceEmulationCacheBehavior cache_behavior) {
+    if (contents() && frame && !frame->GetParentOrOuterDocument()) {
+      ApplyTargetEmulation(frame, params_, params_, cache_behavior);
+    }
+  }
+
+  bool BeforeMutation() {
+    DCHECK_CURRENTLY_ON(BrowserThread::UI);
+    auto weak = weak_factory_.GetWeakPtr();
+    CancelActive();
+    return weak && contents();
+  }
+
+  void Acquire(base::WeakPtr<RenderFrameHostImpl> frame,
+               const base::UnguessableToken& requester,
+               Ready ready) {
+    DCHECK_CURRENTLY_ON(BrowserThread::UI);
+    if (!frame) {
+      std::move(ready).Run(nullptr);
+      return;
+    }
+    const auto document_token = frame->GetDocumentToken();
+    requests_.push_back(
+        {std::move(frame), document_token, requester, std::move(ready)});
+    Schedule();
+  }
+
+  void CancelClient(const base::UnguessableToken& requester) {
+    DCHECK_CURRENTLY_ON(BrowserThread::UI);
+    auto weak = weak_factory_.GetWeakPtr();
+    if (active_ && active_->requester == requester) {
+      CancelActive();
+    }
+    if (!weak) {
+      return;
+    }
+    CancelQueued([&requester](const Request& request) {
+      return request.requester == requester;
+    });
+  }
+
+  void InvalidateFrame(RenderFrameHostImpl* frame) {
+    DCHECK_CURRENTLY_ON(BrowserThread::UI);
+    auto weak = weak_factory_.GetWeakPtr();
+    if (active_ && active_->frame.get() == frame) {
+      CancelActive();
+    }
+    if (!weak) {
+      return;
+    }
+    CancelQueued([frame](const Request& request) {
+      return !request.frame || request.frame.get() == frame;
+    });
+  }
+
+  bool IsValid(uint64_t id) const {
+    return active_ && active_->id == id && !active_->cancelled &&
+           !active_->restored && CanTouch(active_->frame.get()) &&
+           active_->frame->GetDocumentToken() == active_->document_token;
+  }
+
+  bool ApplyCapture(uint64_t id,
+                    const blink::DeviceEmulationParams& params) {
+    DCHECK_CURRENTLY_ON(BrowserThread::UI);
+    if (!IsValid(id)) {
+      return false;
+    }
+    active_->mutated = true;
+    auto weak = weak_factory_.GetWeakPtr();
+    ApplyTargetEmulation(active_->frame.get(), params, params_,
+                        blink::mojom::DeviceEmulationCacheBehavior::kClearCache);
+    return weak && weak->IsValid(id);
+  }
+
+  bool SetViewSize(uint64_t id, const gfx::Size& size) {
+    DCHECK_CURRENTLY_ON(BrowserThread::UI);
+    if (!IsValid(id)) {
+      return false;
+    }
+    active_->resized = true;
+    auto weak = weak_factory_.GetWeakPtr();
+    active_->frame->GetRenderWidgetHost()->GetView()->SetSize(size);
+    return weak && weak->IsValid(id);
+  }
+
+  bool UseFullPagePreferences(uint64_t id) {
+    DCHECK_CURRENTLY_ON(BrowserThread::UI);
+    if (!IsValid(id)) {
+      return false;
+    }
+    auto* view = active_->frame->render_view_host();
+    auto prefs = view->GetDelegate()->GetOrCreateWebPreferences(view);
+    active_->preferences = std::make_pair(
+        prefs.hide_scrollbars, prefs.record_whole_document);
+    prefs.hide_scrollbars = true;
+    prefs.record_whole_document = true;
+    auto weak = weak_factory_.GetWeakPtr();
+    view->GetDelegate()->SetWebPreferences(prefs);
+    return weak && weak->IsValid(id);
+  }
+
+  void Finish(uint64_t id) {
+    DCHECK_CURRENTLY_ON(BrowserThread::UI);
+    if (!active_ || active_->id != id) {
+      return;
+    }
+    auto weak = weak_factory_.GetWeakPtr();
+    RestoreEffects();
+    if (!weak || !active_ || active_->id != id) {
+      return;
+    }
+    active_.reset();
+    Schedule();
+  }
+
+ private:
+  friend class base::RefCounted<ScreenshotEmulationTargetState>;
+  ~ScreenshotEmulationTargetState() override = default;
+
+  void DidStartNavigation(NavigationHandle* navigation) override {
+    if (navigation->IsInPrimaryMainFrame() &&
+        !navigation->IsSameDocument() && bound_frame_) {
+      InvalidateFrame(bound_frame_.get());
+    }
+  }
+
+  void ReadyToCommitNavigation(NavigationHandle* navigation) override {
+    if (navigation->IsInPrimaryMainFrame() && bound_frame_) {
+      InvalidateFrame(bound_frame_.get());
+    }
+  }
+
+  void WebContentsDestroyed() override {
+    if (bound_frame_) {
+      InvalidateFrame(bound_frame_.get());
+    }
+    bound_frame_.reset();
+    contents_.reset();
+  }
+
+  struct Request {
+    base::WeakPtr<RenderFrameHostImpl> frame;
+    blink::DocumentToken document_token;
+    base::UnguessableToken requester;
+    Ready ready;
+  };
+
+  struct Active {
+    uint64_t id;
+    base::WeakPtr<RenderFrameHostImpl> frame;
+    blink::DocumentToken document_token;
+    base::UnguessableToken requester;
+    gfx::Size original_view_size;
+    bool mutated = false;
+    bool resized = false;
+    bool restored = false;
+    bool cancelled = false;
+    std::optional<std::pair<bool, bool>> preferences = std::nullopt;
+  };
+
+  bool CanTouch(RenderFrameHostImpl* frame) const {
+    return contents_ && !contents_->IsBeingDestroyed() && frame &&
+           frame == bound_frame_.get() && frame->IsActive() &&
+           contents_->GetPrimaryMainFrame() == frame &&
+           frame->GetRenderWidgetHost() &&
+           frame->GetRenderWidgetHost()->GetView();
+  }
+
+  void Schedule() {
+    if (scheduled_ || active_ || requests_.empty()) {
+      return;
+    }
+    scheduled_ = true;
+    base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE, base::BindOnce(&ScreenshotEmulationTargetState::Pump,
+                                 weak_factory_.GetWeakPtr()));
+  }
+
+  void Pump() {
+    DCHECK_CURRENTLY_ON(BrowserThread::UI);
+    scheduled_ = false;
+    if (active_ || requests_.empty()) {
+      return;
+    }
+    Request request = std::move(requests_.front());
+    requests_.pop_front();
+    if (!CanTouch(request.frame.get()) ||
+        request.frame->GetDocumentToken() != request.document_token) {
+      Schedule();
+      std::move(request.ready).Run(nullptr);
+      return;
+    }
+    CHECK_NE(++next_id_, 0u);
+    const uint64_t id = next_id_;
+    active_ = std::make_unique<Active>(Active{
+        .id = id,
+        .frame = request.frame,
+        .document_token = request.document_token,
+        .requester = request.requester,
+        .original_view_size = request.frame->GetRenderWidgetHost()
