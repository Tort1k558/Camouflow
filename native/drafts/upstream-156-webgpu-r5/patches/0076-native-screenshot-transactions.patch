+class GlintScreenshotCaptureClient : public TestDevToolsClientHost {
+ public:
+  bool IsTrusted() override { return true; }
+  void AgentHostClosed(DevToolsAgentHost* agent_host) override {
+    target_closed = true;
+  }
+  bool target_closed = false;
+};
+
+class GlintScreenshotEmulationTest : public DevToolsAgentHostImplTest {
+ protected:
+  using Scope = protocol::ScopedScreenshotEmulation;
+  using Handler = protocol::EmulationHandler;
+  struct Reply {
+    bool called = false;
+    std::unique_ptr<Scope> scope;
+  };
+
+  void SetUp() override {
+    DevToolsAgentHostImplTest::SetUp();
+    contents()->NavigateAndCommit(GURL("https://glint.test/capture"));
+    ASSERT_TRUE(contents()->GetRenderWidgetHostView());
+    contents()->GetRenderWidgetHostView()->SetSize(gfx::Size(800, 600));
+    agent_ = DevToolsAgentHost::GetOrCreateFor(web_contents());
+    client_a_ = std::make_unique<GlintScreenshotCaptureClient>();
+    client_a_->InspectAgentHost(agent_.get());
+    auto handlers = Handler::ForAgentHost(
+        static_cast<DevToolsAgentHostImpl*>(agent_.get()));
+    ASSERT_EQ(handlers.size(), 1u);
+    a_ = handlers.front();
+    client_b_ = std::make_unique<GlintScreenshotCaptureClient>();
+    client_b_->InspectAgentHost(agent_.get());
+    handlers = Handler::ForAgentHost(
+        static_cast<DevToolsAgentHostImpl*>(agent_.get()));
+    ASSERT_EQ(handlers.size(), 2u);
+    b_ = handlers[0] == a_ ? handlers[1] : handlers[0];
+    base::RunLoop().RunUntilIdle();
+  }
+
+  void TearDown() override {
+    DetachB();
+    DetachA();
+    agent_.reset();
+    base::RunLoop().RunUntilIdle();
+    DevToolsAgentHostImplTest::TearDown();
+  }
+
+  void DetachA() {
+    if (client_a_) {
+      a_ = nullptr;
+      client_a_->Close();
+      client_a_.reset();
+    }
+  }
+
+  void DetachB() {
+    if (client_b_) {
+      b_ = nullptr;
+      client_b_->Close();
+      client_b_.reset();
+    }
+  }
+
+  blink::DeviceEmulationParams Metrics(int width = 390,
+                                      int height = 844,
+                                      float dpr = 3) {
+    blink::DeviceEmulationParams params;
+    params.screen_size = gfx::Size(width, height);
+    params.view_size = gfx::Size(width, height);
+    params.device_scale_factor = dpr;
+    params.scale = 1;
+    return params;
+  }
+
+  scoped_refptr<base::RefCountedData<Reply>> Request(Handler* handler) {
+    auto reply = base::MakeRefCounted<base::RefCountedData<Reply>>();
+    handler->AcquireScreenshot(base::BindOnce(
+        [](scoped_refptr<base::RefCountedData<Reply>> reply,
+           std::unique_ptr<Scope> scope) {
+          reply->data.called = true;
+          reply->data.scope = std::move(scope);
+        },
+        reply));
+    return reply;
+  }
+
+  raw_ptr<Handler> a_ = nullptr;
+  raw_ptr<Handler> b_ = nullptr;
+  scoped_refptr<DevToolsAgentHost> agent_;
+  std::unique_ptr<GlintScreenshotCaptureClient> client_a_;
+  std::unique_ptr<GlintScreenshotCaptureClient> client_b_;
+};
+
+TEST_F(GlintScreenshotEmulationTest, CrossSessionUsesEffectiveParameters) {
+  const auto params = Metrics();
+  a_->SetDeviceEmulationParams(params);
+  auto reply = Request(b_);
+  base::RunLoop().RunUntilIdle();
+  ASSERT_TRUE(reply->data.scope);
+  EXPECT_TRUE(reply->data.scope->IsValid());
+  ASSERT_TRUE(reply->data.scope->original_params());
+  EXPECT_EQ(*reply->data.scope->original_params(), params);
+  EXPECT_FALSE(b_->device_emulation_enabled());
+}
+
+TEST_F(GlintScreenshotEmulationTest, TemporaryReadbackNeverClaimsPersistentOwnership) {
+  const auto params = Metrics();
+  a_->SetDeviceEmulationParams(params);
+  auto reply = Request(b_);
+  base::RunLoop().RunUntilIdle();
+  ASSERT_TRUE(reply->data.scope);
+  auto transient = Metrics(16, 16, 1);
+  ASSERT_TRUE(reply->data.scope->Apply(transient));
+  EXPECT_EQ(a_->GetDeviceEmulationParams(), params);
+  EXPECT_FALSE(b_->device_emulation_enabled());
+  reply->data.scope->Finish();
+  auto next = Request(b_);
+  base::RunLoop().RunUntilIdle();
+  ASSERT_TRUE(next->data.scope);
+  EXPECT_EQ(*next->data.scope->original_params(), params);
+}
+
+TEST_F(GlintScreenshotEmulationTest, CapturesAreFifoPerTarget) {
+  auto first = Request(a_);
+  auto second = Request(b_);
+  auto third = Request(a_);
+  base::RunLoop().RunUntilIdle();
+  ASSERT_TRUE(first->data.scope);
+  EXPECT_FALSE(second->data.called);
+  EXPECT_FALSE(third->data.called);
+  first->data.scope->Finish();
+  base::RunLoop().RunUntilIdle();
+  ASSERT_TRUE(second->data.scope);
+  EXPECT_FALSE(third->data.called);
+  second->data.scope->Finish();
+  base::RunLoop().RunUntilIdle();
+  ASSERT_TRUE(third->data.scope);
+  EXPECT_TRUE(third->data.scope->IsValid());
+}
+
+TEST_F(GlintScreenshotEmulationTest, PermanentUpdateInvalidatesOldLease) {
+  a_->SetDeviceEmulationParams(Metrics());
+  auto first = Request(b_);
+  base::RunLoop().RunUntilIdle();
+  ASSERT_TRUE(first->data.scope);
+  ASSERT_TRUE(first->data.scope->Apply(Metrics(10, 10, 1)));
+  ASSERT_TRUE(first->data.scope->SetViewSize(gfx::Size(1200, 900)));
+  const auto updated = Metrics(1280, 720, 2);
+  a_->SetDeviceEmulationParams(updated);
+  EXPECT_FALSE(first->data.scope->IsValid());
+  auto next = Request(b_);
+  base::RunLoop().RunUntilIdle();
+  ASSERT_TRUE(next->data.scope);
+  EXPECT_EQ(*next->data.scope->original_params(), updated);
+  first->data.scope->Finish();
+  EXPECT_TRUE(next->data.scope->IsValid());
+}
+
+TEST_F(GlintScreenshotEmulationTest, SameValueUpdateRestoresOriginalView) {
+  const auto params = Metrics();
+  a_->SetDeviceEmulationParams(params);
+  const auto bounds = contents()->GetRenderWidgetHostView()->GetViewBounds();
+  auto reply = Request(b_);
+  base::RunLoop().RunUntilIdle();
