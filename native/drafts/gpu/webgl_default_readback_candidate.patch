+bool WebGLRenderingContextBase::PrepareGlintDefaultRgba8Readback(
+    GLint x,
+    GLint y,
+    GLsizei width,
+    GLsizei height,
+    GLenum format,
+    GLenum type,
+    SkBitmap& protected_rectangle) {
+  const auto reject = [this](const char* reason) {
+    SynthesizeGLError(GL_INVALID_OPERATION, "readPixels", reason);
+    return false;
+  };
+  if (isContextLost() || !GetDrawingBuffer()) {
+    return false;
+  }
+  WebGLFramebuffer* framebuffer = nullptr;
+  if (!ValidateReadBufferAndGetInfo("readPixels", framebuffer)) {
+    return false;
+  }
+  const auto pack = GetPackPixelStoreParams();
+  const auto storage = GetDrawingBuffer()->StorageFormat();
+  if (framebuffer || format != GL_RGBA || type != GL_UNSIGNED_BYTE ||
+      (storage != GL_RGBA8 && storage != GL_RGB8) ||
+      GetColorSpace() != gfx::ColorSpace::CreateSRGB() ||
+      (pack.row_length > 0 &&
+       static_cast<int64_t>(pack.skip_pixels) + width > pack.row_length)) {
+    return reject(
+        "Glint WebGL candidate supports nonoverlapping default RGBA8/sRGB "
+        "readback only.");
+  }
+  auto seed = glint::candidate::SurfacePartitionSeed(
+      GetExecutionContext(), glint::candidate::SurfaceSeedKind::kWebGL);
+  if (!seed.has_value() || !seed.value()) {
+    return reject("Glint WebGL policy is unavailable.");
+  }
+  const int frame_width = drawingBufferWidth();
+  const int frame_height = drawingBufferHeight();
+  if (frame_width <= 0 || frame_height <= 0 || width <= 0 || height <= 0) {
+    return reject("Glint WebGL readback dimensions are unavailable.");
+  }
+  base::CheckedNumeric<size_t> frame_bytes = frame_width;
+  frame_bytes *= frame_height;
+  frame_bytes *= 4;
+  base::CheckedNumeric<size_t> rectangle_bytes = width;
+  rectangle_bytes *= height;
+  rectangle_bytes *= 4;
+  auto total_bytes = frame_bytes + rectangle_bytes;
+  if (!total_bytes.IsValid() ||
+      total_bytes.ValueOrDie() >
+          glint::candidate::kCandidateAdditionalPixelBudget) {
+    return reject("Glint WebGL detached readback budget exceeded.");
+  }
+  SkBitmap frame;
+  const auto frame_info =
+      SkImageInfo::Make(frame_width, frame_height, kRGBA_8888_SkColorType,
+                        kUnpremul_SkAlphaType, SkColorSpace::MakeSRGB());
+  const auto rectangle_info = frame_info.makeWH(width, height);
+  if (!frame.tryAllocPixels(frame_info, static_cast<size_t>(frame_width) * 4) ||
+      !protected_rectangle.tryAllocPixels(rectangle_info,
+                                          static_cast<size_t>(width) * 4)) {
+    return reject("Glint WebGL detached allocation failed.");
+  }
+  auto canonical = std::span(static_cast<uint8_t*>(frame.getPixels()),
+                             frame_bytes.ValueOrDie());
+  auto rectangle =
+      std::span(static_cast<uint8_t*>(protected_rectangle.getPixels()),
+                rectangle_bytes.ValueOrDie());
+  std::fill(canonical.begin(), canonical.end(), 0);
+  std::fill(rectangle.begin(), rectangle.end(), 0);
+  ScopedDrawingBufferBinder binder(GetDrawingBuffer(), framebuffer);
+  if (!binder.Succeeded()) {
+    return false;
+  }
+  base::ScopedClosureRunner restore(base::BindOnce([this] {
+    DrawingBufferClientRestorePixelPackParameters();
+    DrawingBufferClientRestorePixelPackBufferBinding();
+  }));
+  // Only the service-side GL state changes. Keep WebGL's cached pack/buffer
+  // bindings intact so the existing virtual restorers restore the real state.
+  ContextGL()->PixelStorei(GL_PACK_ALIGNMENT, 1);
+  if (IsWebGL2()) {
+    ContextGL()->BindBuffer(GL_PIXEL_PACK_BUFFER, 0);
+    ContextGL()->PixelStorei(GL_PACK_ROW_LENGTH, 0);
+    ContextGL()->PixelStorei(GL_PACK_SKIP_PIXELS, 0);
+    ContextGL()->PixelStorei(GL_PACK_SKIP_ROWS, 0);
+  }
+  // Preserve the driver's requested-rectangle/out-of-bounds behavior privately.
+  // Never publish an unprotected intermediate, including SharedArrayBuffer.
+  ContextGL()->ReadPixels(x, y, width, height, GL_RGBA, GL_UNSIGNED_BYTE,
+                          rectangle.data());
+  ContextGL()->ReadPixels(0, 0, frame_width, frame_height, GL_RGBA,
+                          GL_UNSIGNED_BYTE, canonical.data());
+  if (isContextLost() ||
+      ContextGL()->GetGraphicsResetStatusKHR() != GL_NO_ERROR) {
+    return false;
+  }
+  if (!glint::candidate::ProtectWebGLCanonicalPixels(
+          canonical, frame_width, frame_height, *seed.value())) {
+    return reject("Glint WebGL canonical readback could not be protected.");
+  }
+  for (int row = 0; row < height; ++row) {
+    const int64_t source_y = static_cast<int64_t>(y) + row;
+    if (source_y < 0 || source_y >= frame_height)
+      continue;
+    for (int column = 0; column < width; ++column) {
+      const int64_t source_x = static_cast<int64_t>(x) + column;
+      if (source_x < 0 || source_x >= frame_width)
+        continue;
+      const size_t input =
+          (static_cast<size_t>(source_y) * frame_width + source_x) * 4;
+      const size_t output = (static_cast<size_t>(row) * width + column) * 4;
+      const auto pixel = canonical.subspan(input, 4);
+      auto target = rectangle.subspan(output, 4);
+      std::copy(pixel.begin(), pixel.end(), target.begin());
+    }
+  }
+  protected_rectangle.setImmutable();
+  return true;
+}
