+def _seed_patch_index(source: Path, env: dict[str, str], paths: set[str]) -> None:
+    if not paths:
+        raise ValueError("Native patch index requires explicit owned source paths")
+    run(["git", "read-tree", "--empty"], source, env)
+    baseline = run(["git", "ls-tree", "HEAD", "--", *sorted(paths)], source, env, capture=True)
+    for entry in baseline.splitlines():
+        metadata, _ = entry.split("\t", 1)
+        _, kind, _ = metadata.split()
+        if kind != "blob":
+            raise ValueError("Native patches must only change ordinary source files")
+    if baseline:
+        subprocess.run(["git", "update-index", "--index-info"], cwd=source, env=env,
+                       input=(baseline + "\n").encode("utf-8"), check=True)
+
