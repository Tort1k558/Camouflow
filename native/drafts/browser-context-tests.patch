+TEST_F(NativePrivacyBrowserContextTest, BrowserBridgeSeparatesSurfacesAndTopLevelSites) {
+  auto context = NewContext("OffTheRecord");
+  ASSERT_TRUE(context);
+  context->set_is_off_the_record(true);
+  ASSERT_TRUE(InitializeNativePrivacyContext(context.get(), base::FilePath()));
+  const auto origin = url::Origin::Create(GURL("https://same.test"));
+  const auto a_partition = blink::StorageKey::Create(origin, net::SchemefulSite(GURL("https://first.test")),
+                                                     blink::mojom::AncestorChainBit::kCrossSite);
+  const auto b_partition = blink::StorageKey::Create(origin, net::SchemefulSite(GURL("https://second.test")),
+                                                     blink::mojom::AncestorChainBit::kCrossSite);
+  const auto a = DeriveNativePrivacyKey(context.get(), a_partition, "canvas");
+  const auto b = DeriveNativePrivacyKey(context.get(), b_partition, "canvas");
+  const auto audio = DeriveNativePrivacyKey(context.get(), a_partition, "audio");
+  ASSERT_TRUE(a);
+  ASSERT_TRUE(b);
+  ASSERT_TRUE(audio);
+  EXPECT_NE(a, b);
+  EXPECT_NE(a, audio);
+  EXPECT_FALSE(DeriveNativePrivacyKey(context.get(), a_partition, "unknown"));
+}
