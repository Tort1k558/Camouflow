+TEST_F(NativePrivacyBrowserContextTest, ContextReadinessRejectsMissingServiceAndNullContext) {
+  auto context = NewContext("Default");
+  ASSERT_TRUE(context);
+  int calls = 0;
+  WhenNativePrivacyContextReady(context.get(), base::BindOnce([&](bool ready) {
+    ++calls;
+    EXPECT_FALSE(ready);
+  }));
+  WhenNativePrivacyContextReady(nullptr, base::BindOnce([&](bool ready) {
+    ++calls;
+    EXPECT_FALSE(ready);
+  }));
+  EXPECT_EQ(calls, 2);
+}
