+constexpr char kIdentity[] = R"({"schema":1,"seed":"000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f"})";
+constexpr char kOtherIdentity[] = R"({"schema":1,"seed":"ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff"})";
+
+class NativePrivacyBrowserContextTest : public testing::Test {
+ protected:
+  void SetUp() override {
+    ASSERT_TRUE(owned_.CreateUniqueTempDir());
+    ASSERT_TRUE(base::WriteFile(IdentityPath(), kIdentity));
+  }
+
+  base::FilePath IdentityPath() {
+    return owned_.GetPath().AppendASCII("camouflow-native-privacy.json");
+  }
+
+  std::unique_ptr<TestBrowserContext> NewContext(const char* name) {
+    const auto path = owned_.GetPath().AppendASCII(name);
+    if (!base::CreateDirectory(path)) {
+      ADD_FAILURE() << "Cannot create owned context directory";
+      return nullptr;
+    }
+    return std::make_unique<TestBrowserContext>(path);
+  }
+
+  blink::StorageKey Partition() {
+    return blink::StorageKey::CreateFirstParty(url::Origin::Create(GURL("https://same.test")));
+  }
+
+  BrowserTaskEnvironment tasks_{base::test::TaskEnvironment::ThreadPoolExecutionMode::QUEUED};
+  base::ScopedTempDir owned_;
+};
+
+TEST_F(NativePrivacyBrowserContextTest, PersistentLoadingGatesReadinessAndDerivation) {
+  auto context = NewContext("Default");
+  ASSERT_TRUE(context);
+  EXPECT_FALSE(IsNativePrivacyContextReady(context.get()));
+  EXPECT_FALSE(DeriveNativePrivacyKey(context.get(), Partition(), "canvas"));
+  ASSERT_TRUE(InitializeNativePrivacyContext(context.get(), owned_.GetPath()));
+  EXPECT_FALSE(IsNativePrivacyContextReady(context.get()));
+  EXPECT_FALSE(DeriveNativePrivacyKey(context.get(), Partition(), "canvas"));
+  tasks_.RunUntilIdle();
+  ASSERT_TRUE(IsNativePrivacyContextReady(context.get()));
+  const auto key = DeriveNativePrivacyKey(context.get(), Partition(), "canvas");
+  ASSERT_TRUE(key);
+  EXPECT_EQ(key, DeriveNativePrivacyKey(context.get(), Partition(), "canvas"));
+  EXPECT_FALSE(InitializeNativePrivacyContext(context.get(), owned_.GetPath()));
+}
+
+TEST_F(NativePrivacyBrowserContextTest, PersistentIdentitySurvivesActualContextRecreation) {
+  std::optional<std::array<uint8_t, 32>> original;
+  {
+    auto context = NewContext("Default");
+    ASSERT_TRUE(context);
+    ASSERT_TRUE(InitializeNativePrivacyContext(context.get(), owned_.GetPath()));
+    tasks_.RunUntilIdle();
+    original = DeriveNativePrivacyKey(context.get(), Partition(), "canvas");
+    ASSERT_TRUE(original);
+  }
+  auto restarted = NewContext("Default");
+  ASSERT_TRUE(restarted);
+  ASSERT_TRUE(InitializeNativePrivacyContext(restarted.get(), owned_.GetPath()));
+  tasks_.RunUntilIdle();
+  EXPECT_EQ(original, DeriveNativePrivacyKey(restarted.get(), Partition(), "canvas"));
+}
+
+TEST_F(NativePrivacyBrowserContextTest, PersistentProfilesHaveIndependentKeys) {
+  base::ScopedTempDir other_root;
+  ASSERT_TRUE(other_root.CreateUniqueTempDir());
+  ASSERT_TRUE(base::WriteFile(other_root.GetPath().AppendASCII("camouflow-native-privacy.json"), kOtherIdentity));
+  auto first = NewContext("First");
+  auto second = NewContext("Second");
+  ASSERT_TRUE(first);
+  ASSERT_TRUE(second);
+  ASSERT_TRUE(InitializeNativePrivacyContext(first.get(), owned_.GetPath()));
+  ASSERT_TRUE(InitializeNativePrivacyContext(second.get(), other_root.GetPath()));
+  tasks_.RunUntilIdle();
+  const auto a = DeriveNativePrivacyKey(first.get(), Partition(), "canvas");
+  const auto b = DeriveNativePrivacyKey(second.get(), Partition(), "canvas");
+  ASSERT_TRUE(a);
+  ASSERT_TRUE(b);
+  EXPECT_NE(a, b);
+}
