+TEST_F(NativePrivacyBrowserContextTest, ContextReadinessWaitsForKeyAndAllowsDerivation) {
+  auto context = NewContext("Default");
+  ASSERT_TRUE(context);
+  ASSERT_TRUE(InitializeNativePrivacyContext(context.get(), owned_.GetPath()));
+  int calls = 0;
+  WhenNativePrivacyContextReady(context.get(), base::BindOnce([&](bool ready) {
+    ++calls;
+    EXPECT_TRUE(ready);
+    EXPECT_TRUE(DeriveNativePrivacyKey(context.get(), Partition(), "canvas"));
+  }));
+  EXPECT_EQ(calls, 0);
+  tasks_.RunUntilIdle();
+  EXPECT_EQ(calls, 1);
+}
