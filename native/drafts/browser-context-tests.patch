+TEST_F(NativePrivacyBrowserContextTest, NullContextIsRejected) {
+  EXPECT_FALSE(InitializeNativePrivacyContext(nullptr, owned_.GetPath()));
+  EXPECT_FALSE(IsNativePrivacyContextReady(nullptr));
+  EXPECT_FALSE(DeriveNativePrivacyKey(nullptr, Partition(), "canvas"));
+  ShutdownNativePrivacyContext(nullptr);
+}
