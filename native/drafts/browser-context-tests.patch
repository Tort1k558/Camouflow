+TEST_F(NativePrivacyBrowserContextTest, BrowserContextShutdownClearsReadyService) {
+  auto context = NewContext("OffTheRecord");
+  ASSERT_TRUE(context);
+  context->set_is_off_the_record(true);
+  ASSERT_TRUE(InitializeNativePrivacyContext(context.get(), base::FilePath()));
+  ASSERT_TRUE(IsNativePrivacyContextReady(context.get()));
+  auto* service = camouflow::native::PrivacyKeyService::GetForOwner(*context);
+  ASSERT_NE(service, nullptr);
+  context->NotifyWillBeDestroyed();
+  EXPECT_EQ(service->state(), camouflow::native::PrivacyKeyService::State::kStopped);
+  EXPECT_FALSE(service->Derive(Partition(), "canvas"));
+  EXPECT_TRUE(context->ShutdownStarted());
+  EXPECT_FALSE(IsNativePrivacyContextReady(context.get()));
+  EXPECT_FALSE(DeriveNativePrivacyKey(context.get(), Partition(), "canvas"));
+  EXPECT_FALSE(InitializeNativePrivacyContext(context.get(), base::FilePath()));
+  context->NotifyWillBeDestroyed();
+}
+
+TEST_F(NativePrivacyBrowserContextTest, ShutdownDuringLoadRejectsLateReply) {
+  auto context = NewContext("Default");
+  ASSERT_TRUE(context);
+  ASSERT_TRUE(InitializeNativePrivacyContext(context.get(), owned_.GetPath()));
+  auto* service = camouflow::native::PrivacyKeyService::GetForOwner(*context);
+  ASSERT_NE(service, nullptr);
+  EXPECT_EQ(service->state(), camouflow::native::PrivacyKeyService::State::kLoading);
+  context->NotifyWillBeDestroyed();
+  tasks_.RunUntilIdle();
+  EXPECT_EQ(service->state(), camouflow::native::PrivacyKeyService::State::kStopped);
+  EXPECT_FALSE(IsNativePrivacyContextReady(context.get()));
+  EXPECT_FALSE(DeriveNativePrivacyKey(context.get(), Partition(), "canvas"));
+}
