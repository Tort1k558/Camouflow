+TEST_F(NativePrivacyBrowserContextTest, OffTheRecordContextsDoNotShareOriginalOrEachOther) {
+  auto original = NewContext("Default");
+  auto first = NewContext("OffTheRecordFirst");
+  auto second = NewContext("OffTheRecordSecond");
+  ASSERT_TRUE(original);
+  ASSERT_TRUE(first);
+  ASSERT_TRUE(second);
+  first->set_is_off_the_record(true);
+  second->set_is_off_the_record(true);
+  ASSERT_TRUE(InitializeNativePrivacyContext(original.get(), owned_.GetPath()));
+  ASSERT_TRUE(InitializeNativePrivacyContext(first.get(), base::FilePath()));
+  ASSERT_TRUE(InitializeNativePrivacyContext(second.get(), base::FilePath()));
+  tasks_.RunUntilIdle();
+  const auto a = DeriveNativePrivacyKey(original.get(), Partition(), "canvas");
+  const auto b = DeriveNativePrivacyKey(first.get(), Partition(), "canvas");
+  const auto c = DeriveNativePrivacyKey(second.get(), Partition(), "canvas");
+  ASSERT_TRUE(a);
+  ASSERT_TRUE(b);
+  ASSERT_TRUE(c);
+  EXPECT_NE(a, b);
+  EXPECT_NE(a, c);
+  EXPECT_NE(b, c);
+  EXPECT_FALSE(base::PathExists(first->GetPath().AppendASCII("camouflow-native-privacy.json")));
+  EXPECT_FALSE(base::PathExists(second->GetPath().AppendASCII("camouflow-native-privacy.json")));
+  std::string unchanged;
+  ASSERT_TRUE(base::ReadFileToString(IdentityPath(), &unchanged));
+  EXPECT_EQ(unchanged, kIdentity);
+  ShutdownNativePrivacyContext(first.get());
+  EXPECT_FALSE(DeriveNativePrivacyKey(first.get(), Partition(), "canvas"));
+  EXPECT_EQ(a, DeriveNativePrivacyKey(original.get(), Partition(), "canvas"));
+  EXPECT_EQ(c, DeriveNativePrivacyKey(second.get(), Partition(), "canvas"));
+}
