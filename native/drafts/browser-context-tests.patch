+TEST_F(NativePrivacyBrowserContextTest, DestructionDuringLoadDoesNotUseDestroyedContext) {
+  auto context = NewContext("Default");
+  ASSERT_TRUE(context);
+  ASSERT_TRUE(InitializeNativePrivacyContext(context.get(), owned_.GetPath()));
+  context.reset();
+  tasks_.RunUntilIdle();
+}
