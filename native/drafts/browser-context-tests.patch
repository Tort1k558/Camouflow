+TEST_F(NativePrivacyBrowserContextTest, ContextShutdownSettlesQueuedReadinessOnce) {
+  auto context = NewContext("Default");
+  ASSERT_TRUE(context);
+  ASSERT_TRUE(InitializeNativePrivacyContext(context.get(), owned_.GetPath()));
+  int calls = 0;
+  WhenNativePrivacyContextReady(context.get(), base::BindOnce([&](bool ready) {
+    ++calls;
+    EXPECT_FALSE(ready);
+  }));
+  context->NotifyWillBeDestroyed();
+  EXPECT_EQ(calls, 1);
+  tasks_.RunUntilIdle();
+  EXPECT_EQ(calls, 1);
+  WhenNativePrivacyContextReady(context.get(), base::BindOnce([&](bool ready) {
+    ++calls;
+    EXPECT_FALSE(ready);
+  }));
+  EXPECT_EQ(calls, 2);
+}
