+GlintReadbackMetadataWire GLES2DecoderImpl::QueryGlintReadbackMetadata() {
+  if (!base::FeatureList::IsEnabled(
+          features::kGlintReadbackMetadataCandidate) ||
+      WasContextLost()) {
+    return kGlintReadbackMetadataUnavailable;
+  }
+  Framebuffer* framebuffer = GetBoundReadFramebuffer();
+  if (!framebuffer ||
+      !CheckFramebufferValid(framebuffer, GetReadFramebufferTarget(),
+                             GL_INVALID_FRAMEBUFFER_OPERATION,
+                             "GetGlintReadFramebufferMetadataCHROMIUM")) {
+    return kGlintReadbackMetadataUnavailable;
+  }
+  const auto* attachment = framebuffer->GetReadBufferAttachment();
+  if (!attachment) {
+    return kGlintReadbackMetadataUnavailable;
+  }
+  const GLenum format = attachment->internal_format();
+  const bool byte_colour = format == GL_RGBA8 || format == GL_RGB8 ||
+                           ((format == GL_RGBA || format == GL_RGB) &&
+                            attachment->texture_type() == GL_UNSIGNED_BYTE);
+  return EncodeGlintReadbackMetadata(attachment->width(), attachment->height(),
+                                     format, attachment->samples(),
+                                     byte_colour);
+}
+
+error::Error GLES2DecoderImpl::HandleGetGlintReadFramebufferMetadataCHROMIUM(
+    uint32_t immediate_data_size,
+    const volatile void* cmd_data) {
+  using Command = cmds::GetGlintReadFramebufferMetadataCHROMIUM;
+  const auto& command = *static_cast<const volatile Command*>(cmd_data);
+  using Result = Command::Result;
+  uint32_t size = 0;
+  if (!Result::ComputeSize(kGlintReadbackMetadataValues).AssignIfValid(&size)) {
+    return error::kOutOfBounds;
+  }
+  auto* result = GetSharedMemoryAs<Result*>(command.params_shm_id,
+                                            command.params_shm_offset, size);
+  if (!result) {
+    return error::kOutOfBounds;
+  }
+  if (result->size != 0) {
+    return error::kInvalidArguments;
+  }
+  const auto metadata = QueryGlintReadbackMetadata();
+  std::copy(metadata.begin(), metadata.end(), result->GetData());
+  result->SetNumResults(kGlintReadbackMetadataValues);
+  return error::kNoError;
+}
