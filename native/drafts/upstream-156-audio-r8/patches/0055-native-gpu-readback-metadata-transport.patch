+GlintReadbackMetadataWire
+GLES2DecoderPassthroughImpl::QueryGlintReadbackMetadata() {
+  if (!base::FeatureList::IsEnabled(
+          features::kGlintReadbackMetadataCandidate) ||
+      WasContextLost() || bound_read_framebuffer_ == 0) {
+    return kGlintReadbackMetadataUnavailable;
+  }
+  const bool es3 = feature_info_->IsWebGL2OrES3OrHigherContext();
+  const GLenum target = es3 ? GL_READ_FRAMEBUFFER : GL_FRAMEBUFFER;
+  CheckErrorCallbackState();
+  const GLenum status = api()->glCheckFramebufferStatusEXTFn(target);
+  if (CheckErrorCallbackState() || status != GL_FRAMEBUFFER_COMPLETE) {
+    return kGlintReadbackMetadataUnavailable;
+  }
+  auto integer = [this](GLenum pname, GLint& value) {
+    GLsizei length = 0;
+    api()->glGetIntegervRobustANGLEFn(pname, 1, &length, &value);
+    return !CheckErrorCallbackState() && length == 1;
+  };
+  GLint selected = GL_COLOR_ATTACHMENT0;
+  if (es3 && !integer(GL_READ_BUFFER, selected)) {
+    return kGlintReadbackMetadataUnavailable;
+  }
+  if (selected == GL_NONE) {
+    return kGlintReadbackMetadataUnavailable;
+  }
+  auto attachment = [this, target, selected](GLenum pname, GLint& value) {
+    GLsizei length = 0;
+    const auto command_error = DoGetFramebufferAttachmentParameteriv(
+        target, selected, pname, 1, &length, &value);
+    return command_error == error::kNoError && length == 1;
+  };
+  GLint kind = 0, object = 0, width = 0, height = 0, format = 0, samples = 0;
+  bool byte_colour = false;
+  if (!attachment(GL_FRAMEBUFFER_ATTACHMENT_OBJECT_TYPE, kind) ||
+      !attachment(GL_FRAMEBUFFER_ATTACHMENT_OBJECT_NAME, object) || !object) {
+    return kGlintReadbackMetadataUnavailable;
+  }
+  GLint native_object = 0;
+  GLsizei native_length = 0;
+  api()->glGetFramebufferAttachmentParameterivRobustANGLEFn(
+      target, selected, GL_FRAMEBUFFER_ATTACHMENT_OBJECT_NAME, 1,
+      &native_length, &native_object);
+  if (CheckErrorCallbackState() || native_length != 1 || !native_object) {
+    return kGlintReadbackMetadataUnavailable;
+  }
+  if (kind == GL_RENDERBUFFER) {
+    GLuint service_id = 0;
+    if (!resources_->renderbuffer_id_map.GetServiceID(
+            static_cast<GLuint>(object), &service_id)) {
+      return kGlintReadbackMetadataUnavailable;
+    }
+    if (service_id != static_cast<GLuint>(native_object)) {
+      return kGlintReadbackMetadataUnavailable;
+    }
+    GLint previous = 0;
+    if (!integer(GL_RENDERBUFFER_BINDING, previous)) {
+      return kGlintReadbackMetadataUnavailable;
+    }
+    base::ScopedClosureRunner restore(base::BindOnce(
+        [](GLES2DecoderPassthroughImpl* decoder, GLint binding) {
+          decoder->api()->glBindRenderbufferEXTFn(GL_RENDERBUFFER,
+                                                  static_cast<GLuint>(binding));
+          decoder->CheckErrorCallbackState();
+        },
+        base::Unretained(this), previous));
+    api()->glBindRenderbufferEXTFn(GL_RENDERBUFFER, service_id);
+    if (CheckErrorCallbackState()) {
+      return kGlintReadbackMetadataUnavailable;
+    }
+    auto renderbuffer = [this](GLenum pname, GLint& value) {
+      GLsizei length = 0;
+      api()->glGetRenderbufferParameterivRobustANGLEFn(GL_RENDERBUFFER, pname,
+                                                       1, &length, &value);
+      return !CheckErrorCallbackState() && length == 1;
+    };
+    if (!renderbuffer(GL_RENDERBUFFER_WIDTH, width) ||
+        !renderbuffer(GL_RENDERBUFFER_HEIGHT, height) ||
+        !renderbuffer(GL_RENDERBUFFER_INTERNAL_FORMAT, format)) {
+      return kGlintReadbackMetadataUnavailable;
+    }
+    if ((es3 || context_->HasExtension("GL_ANGLE_framebuffer_multisample") ||
+         context_->HasExtension("GL_EXT_framebuffer_multisample") ||
+         context_->HasExtension("GL_APPLE_framebuffer_multisample")) &&
+        !renderbuffer(GL_RENDERBUFFER_SAMPLES, samples)) {
+      return kGlintReadbackMetadataUnavailable;
+    }
+    byte_colour = format == GL_RGBA8 || format == GL_RGB8;
+  } else if (kind == GL_TEXTURE) {
+    if (!context_->HasExtension("GL_ANGLE_get_tex_level_parameter")) {
+      return kGlintReadbackMetadataUnavailable;
+    }
+    scoped_refptr<TexturePassthrough> texture;
+    if (!resources_->texture_object_map.GetServiceID(
+            static_cast<GLuint>(object), &texture) ||
+        !texture) {
+      return kGlintReadbackMetadataUnavailable;
+    }
+    if (texture->service_id() != static_cast<GLuint>(native_object)) {
+      return kGlintReadbackMetadataUnavailable;
+    }
+    const GLenum texture_target = texture->target();
+    GLenum binding = 0;
+    switch (texture_target) {
+      case GL_TEXTURE_2D:
+        binding = GL_TEXTURE_BINDING_2D;
+        break;
+      case GL_TEXTURE_CUBE_MAP:
+        binding = GL_TEXTURE_BINDING_CUBE_MAP;
+        break;
+      case GL_TEXTURE_3D:
+        if (es3) {
+          binding = GL_TEXTURE_BINDING_3D;
+        }
+        break;
+      case GL_TEXTURE_2D_ARRAY:
+        if (es3) {
+          binding = GL_TEXTURE_BINDING_2D_ARRAY;
+        }
+        break;
+    }
+    if (!binding) {
+      return kGlintReadbackMetadataUnavailable;
+    }
+    GLint level = 0, face = 0, previous = 0, layer = 0;
+    if (!attachment(GL_FRAMEBUFFER_ATTACHMENT_TEXTURE_LEVEL, level) ||
+        level < 0 ||
+        !attachment(GL_FRAMEBUFFER_ATTACHMENT_TEXTURE_CUBE_MAP_FACE, face) ||
+        !integer(binding, previous)) {
+      return kGlintReadbackMetadataUnavailable;
+    }
+    GLenum query_target = texture_target;
+    if (texture_target == GL_TEXTURE_CUBE_MAP) {
+      if (face < GL_TEXTURE_CUBE_MAP_POSITIVE_X ||
+          face > GL_TEXTURE_CUBE_MAP_NEGATIVE_Z) {
+        return kGlintReadbackMetadataUnavailable;
+      }
+      query_target = static_cast<GLenum>(face);
+    } else if (face != 0) {
+      return kGlintReadbackMetadataUnavailable;
+    }
+    const bool layered = texture_target == GL_TEXTURE_3D ||
+                         texture_target == GL_TEXTURE_2D_ARRAY;
+    if (layered &&
+        (!attachment(GL_FRAMEBUFFER_ATTACHMENT_TEXTURE_LAYER, layer) ||
+         layer < 0)) {
+      return kGlintReadbackMetadataUnavailable;
+    }
+    if (context_->HasExtension("GL_OVR_multiview")) {
+      GLint views = 0;
+      if (!attachment(GL_FRAMEBUFFER_ATTACHMENT_TEXTURE_NUM_VIEWS_OVR, views) ||
+          views != 0) {
+        return kGlintReadbackMetadataUnavailable;
+      }
+    }
+    if (context_->HasExtension("GL_EXT_multisampled_render_to_texture")) {
+      if (!attachment(GL_FRAMEBUFFER_ATTACHMENT_TEXTURE_SAMPLES_EXT, samples)) {
+        return kGlintReadbackMetadataUnavailable;
+      }
+    } else if (context_->HasExtension(
+                   "GL_IMG_multisampled_render_to_texture")) {
+      if (!attachment(GL_TEXTURE_SAMPLES_IMG, samples)) {
+        return kGlintReadbackMetadataUnavailable;
+      }
+    }
+    base::ScopedClosureRunner restore(base::BindOnce(
+        [](GLES2DecoderPassthroughImpl* decoder, GLenum target, GLint binding) {
+          decoder->api()->glBindTextureFn(target, static_cast<GLuint>(binding));
+          decoder->CheckErrorCallbackState();
+        },
+        base::Unretained(this), texture_target, previous));
+    api()->glBindTextureFn(texture_target, texture->service_id());
+    if (CheckErrorCallbackState()) {
+      return kGlintReadbackMetadataUnavailable;
+    }
+    auto texture_parameter = [this, query_target, level](GLenum pname,
+                                                         GLint& value) {
+      GLsizei length = 0;
+      api()->glGetTexLevelParameterivRobustANGLEFn(query_target, level, pname,
+                                                   1, &length, &value);
+      return !CheckErrorCallbackState() && length == 1;
+    };
+    if (!texture_parameter(GL_TEXTURE_WIDTH, width) ||
+        !texture_parameter(GL_TEXTURE_HEIGHT, height) ||
+        !texture_parameter(GL_TEXTURE_INTERNAL_FORMAT, format)) {
+      return kGlintReadbackMetadataUnavailable;
+    }
+    if (format == GL_RGBA8 || format == GL_RGB8 || format == GL_RGBA ||
+        format == GL_RGB) {
+      GLint red_type = 0, red = 0, green = 0, blue = 0, alpha = 0;
+      if (!texture_parameter(GL_TEXTURE_RED_TYPE, red_type) ||
+          !texture_parameter(GL_TEXTURE_RED_SIZE, red) ||
+          !texture_parameter(GL_TEXTURE_GREEN_SIZE, green) ||
+          !texture_parameter(GL_TEXTURE_BLUE_SIZE, blue) ||
+          !texture_parameter(GL_TEXTURE_ALPHA_SIZE, alpha)) {
+        return kGlintReadbackMetadataUnavailable;
+      }
+      byte_colour =
+          red_type == GL_UNSIGNED_NORMALIZED && red == 8 && green == 8 &&
+          blue == 8 &&
+          ((format == GL_RGBA8 || format == GL_RGBA) ? alpha == 8 : alpha == 0);
+    }
+    if (layered) {
+      GLint depth = 0;
+      if (!texture_parameter(GL_TEXTURE_DEPTH, depth) || depth <= 0 ||
+          layer >= depth) {
+        return kGlintReadbackMetadataUnavailable;
+      }
+    }
+  } else {
+    return kGlintReadbackMetadataUnavailable;
+  }
+  return EncodeGlintReadbackMetadata(width, height, static_cast<GLenum>(format),
+                                     samples, byte_colour);
+}
