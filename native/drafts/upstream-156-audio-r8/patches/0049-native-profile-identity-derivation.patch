 #ifndef CAMOUFLOW_NATIVE_CORE_PRIVACY_PARTITION_H_
 #define CAMOUFLOW_NATIVE_CORE_PRIVACY_PARTITION_H_
 
+#include <cstddef>
 #include <optional>
 #include <string>
 #include <string_view>
 
 namespace camouflow::native {
 
+inline bool IsNativeFingerprintSurface(std::string_view surface) {
+  return surface == "canvas" || surface == "webgl" || surface == "webgpu" ||
+         surface == "audio";
+}
+
+// Stable profile-identity purpose, distinct from the existing privacy/v1
+// domain. This does not authorize a document or change the partitioned privacy
+// policy.
+inline std::optional<std::string> ProfileIdentityDerivationMessage(
+    std::string_view surface) {
+  if (!IsNativeFingerprintSurface(surface)) {
+    return std::nullopt;
+  }
+  std::string message("Glint/profile-identity/v1");
+  message.push_back('\0');
+  for (int shift = 24; shift >= 0; shift -= 8) {
+    message.push_back(static_cast<char>((surface.size() >> shift) & 0xff));
+  }
+  message.append(surface);
+  return message;
+}
+
 // The browser must supply its canonical storage partition, not a caller URL.
 // Sign this message with crypto::hmac::SignSha256 and the private profile key.
 inline std::optional<std::string> PrivacyDerivationMessage(
     std::string_view partition, std::string_view surface) {
   if (partition.empty() || partition.size() > 8192 ||
-      (surface != "canvas" && surface != "webgl" && surface != "webgpu" &&
-       surface != "audio")) {
+      !IsNativeFingerprintSurface(surface)) {
     return std::nullopt;
   }
   std::string message("CamouFlowNative/privacy/v1");
