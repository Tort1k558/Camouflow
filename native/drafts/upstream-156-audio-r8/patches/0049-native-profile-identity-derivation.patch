+std::optional<std::array<uint8_t, 32>> DeriveProfileIdentityKey(
+    base::span<const uint8_t, 32> profile_key,
+    const blink::StorageKey& trusted_partition,
+    std::string_view surface) {
+  const auto partition = trusted_partition.SerializeForNativePrivacy();
+  if (!partition || partition->empty() || partition->size() > 8192) {
+    return std::nullopt;
+  }
+  const auto message = ProfileIdentityDerivationMessage(surface);
+  if (!message) {
+    return std::nullopt;
+  }
+  return crypto::hmac::SignSha256(profile_key, base::as_byte_span(*message));
+}
+
 }  // namespace camouflow::native
