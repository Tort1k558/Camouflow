 void DedicatedWorkerHostFactoryClient::OnScriptLoadStartFailed() {
+  pending_script_start_.Reset();
+  privacy_bootstrap_.reset();
+  weak_factory_.InvalidateWeakPtrs();
   worker_->OnScriptLoadStartFailed();
   // |this| may be destroyed at this point.
 }
 
+void DedicatedWorkerHostFactoryClient::OnPrivacyBootstrap(
+    PrivacyWorkerBootstrap::Result result) {
+  privacy_bootstrap_.reset();
+  if (!result.has_value()) {
+    OnScriptLoadStartFailed();
+    return;
+  }
+  canvas_partition_seed_ = std::move(result).value();
+  if (pending_script_start_) {
+    // Starting or failing the worker can destroy its factory client.
+    std::move(pending_script_start_).Run();
+  }
+}
