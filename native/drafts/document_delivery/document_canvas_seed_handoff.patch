+TEST_F(DocumentTest, GlintCanvasSeedAbsentWithoutTrustedInitializer) {
+  EXPECT_FALSE(GetDocument().GlintCanvasPartitionSeed());
+}
+
+TEST_F(DocumentTest, GlintCanvasSeedIsOwnedBeforeDocumentUse) {
+  std::array<uint8_t, 32> seed{};
+  seed.fill(29);
+  const auto expected = seed;
+  auto initializer = DocumentInit::Create()
+                         .ForTest(*GetDocument().GetExecutionContext())
+                         .WithTypeFrom("text/html")
+                         .WithGlintCanvasPartitionSeed(seed);
+  auto copied_initializer = initializer;
+  seed.fill(255);
+  Document* document = copied_initializer.CreateDocument();
+  EXPECT_EQ(document->GlintCanvasPartitionSeed(), std::optional(expected));
+  auto snapshot = document->GlintCanvasPartitionSeed();
+  ASSERT_TRUE(snapshot);
+  snapshot->fill(0);
+  EXPECT_EQ(document->GlintCanvasPartitionSeed(), std::optional(expected));
+}
+
+TEST_F(DocumentTest, GlintDocumentsDoNotReusePreviousCanvasSeed) {
+  std::array<uint8_t, 32> first_seed{};
+  std::array<uint8_t, 32> second_seed{};
+  first_seed.fill(17);
+  second_seed.fill(42);
+  Document* first = DocumentInit::Create()
+                        .ForTest(*GetDocument().GetExecutionContext())
+                        .WithTypeFrom("text/html")
+                        .WithGlintCanvasPartitionSeed(first_seed)
+                        .CreateDocument();
+  Document* second = DocumentInit::Create()
+                         .ForTest(*GetDocument().GetExecutionContext())
+                         .WithTypeFrom("text/html")
+                         .WithGlintCanvasPartitionSeed(second_seed)
+                         .CreateDocument();
+  EXPECT_EQ(first->GlintCanvasPartitionSeed(), std::optional(first_seed));
+  EXPECT_EQ(second->GlintCanvasPartitionSeed(), std::optional(second_seed));
+  EXPECT_FALSE(GetDocument().GlintCanvasPartitionSeed());
+}
