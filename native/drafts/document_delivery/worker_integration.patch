+void DedicatedWorkerHost::BindNativePrivacyPolicy(
+    mojo::PendingReceiver<blink::mojom::NativePrivacyWorker> receiver) {
+  auto* process = GetProcessHost();
+  if (!process) {
+    return;
+  }
+  native_privacy_receivers_.Add(
+      std::make_unique<PrivacyWorkerService>(*process->GetBrowserContext(),
+                                              GetWorkerStorageKey(),
+                                              PrivacyWorkerService::Kind::kDedicated),
+      std::move(receiver));
+}
+
 }  // namespace content
