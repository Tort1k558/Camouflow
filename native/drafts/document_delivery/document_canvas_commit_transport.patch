+TEST_P(DocumentLoaderTest, GlintCanvasCommitInstallsOwnedDocumentSeed) {
+  WebViewImpl* view =
+      web_view_helper_.InitializeAndLoad("https://example.com/foo.html");
+  LocalFrame* frame = To<LocalFrame>(view->GetPage()->MainFrame());
+  const KURL url(NullUrl(), "https://example.com/canvas.html");
+  auto params = WebNavigationParams::CreateWithEmptyHTMLForTesting(url);
+  params->origin_to_commit = WebSecurityOrigin::Create(WebURL(url));
+  params->storage_key = StorageKey::CreateFirstParty(
+      url::Origin::Create(GURL("https://example.com/canvas.html")));
+  auto encoding = params->storage_key.SerializeForNativePrivacy();
+  ASSERT_TRUE(encoding);
+  std::array<uint8_t, 32> seed{};
+  seed.fill(61);
+  const auto expected = seed;
+  params->glint_document_canvas_commit =
+      std::make_unique<GlintDocumentCanvasCommit>(
+          GlintDocumentCanvasCommit{1, *encoding, seed});
+  frame->Loader().CommitNavigation(std::move(params), nullptr);
+  seed.fill(0);
+  EXPECT_EQ(frame->GetDocument()->GlintCanvasPartitionSeed(),
+            std::optional(expected));
+
+  auto cloned = frame->Loader().GetDocumentLoader()
+                    ->CreateWebNavigationParamsToCloneDocument();
+  ASSERT_TRUE(cloned->glint_document_canvas_commit);
+  EXPECT_EQ(cloned->glint_document_canvas_commit->version, 1u);
+  EXPECT_EQ(cloned->glint_document_canvas_commit->partition_encoding, *encoding);
+  EXPECT_EQ(cloned->glint_document_canvas_commit->partition_seed, expected);
+  cloned->glint_document_canvas_commit->partition_seed.fill(0);
+  EXPECT_EQ(frame->GetDocument()->GlintCanvasPartitionSeed(),
+            std::optional(expected));
+
+  auto next = WebNavigationParams::CreateWithEmptyHTMLForTesting(url);
+  frame->Loader().CommitNavigation(std::move(next), nullptr);
+  EXPECT_FALSE(frame->GetDocument()->GlintCanvasPartitionSeed());
+  auto unprotected_clone = frame->Loader().GetDocumentLoader()
+                               ->CreateWebNavigationParamsToCloneDocument();
+  EXPECT_FALSE(unprotected_clone->glint_document_canvas_commit);
+}
