+TEST_P(NativeDocumentNavigationTest, RepeatedRejectedTokenCannotCancelNextCommit) {
+  EnablePolicy();
+  ASSERT_TRUE(InitializeNativePrivacyContext(browser_context(), owned_.GetPath()));
+  task_environment()->RunUntilIdle();
+  auto first = NavigationSimulator::CreateBrowserInitiated(Target(), web_contents());
+  first->ReadyToCommit();
+  auto* request = NavigationRequest::From(first->GetNavigationHandle());
+  ASSERT_TRUE(request);
+  const auto rejected_token = request->commit_params().navigation_token;
+  static_cast<mojom::FrameHost*>(request->GetRenderFrameHost())
+      ->RejectGlintDocumentCanvasCommit(rejected_token);
+  task_environment()->RunUntilIdle();
+  ASSERT_EQ(finished_, 1);
+  ASSERT_FALSE(committed_);
+  ASSERT_EQ(error_, net::ERR_ABORTED);
+  first.reset();
+
+  auto next = NavigationSimulator::CreateBrowserInitiated(Target(), web_contents());
+  next->ReadyToCommit();
+  request = NavigationRequest::From(next->GetNavigationHandle());
+  ASSERT_TRUE(request);
+  ASSERT_NE(request->commit_params().navigation_token, rejected_token);
+  static_cast<mojom::FrameHost*>(request->GetRenderFrameHost())
+      ->RejectGlintDocumentCanvasCommit(rejected_token);
+  EXPECT_EQ(finished_, 1);
+  next->Commit();
+  EXPECT_EQ(finished_, 2);
+  EXPECT_TRUE(committed_);
+  EXPECT_EQ(error_, net::OK);
+}
