--- /dev/null
+++ b/third_party/blink/public/common/native_privacy/glint/canvas_rendering_policy.h
@@ -0,0 +1,78 @@
+// Copyright 2026 CamouFlow contributors.
+// SPDX-License-Identifier: MIT
+#ifndef GLINT_CANVAS_RENDERING_POLICY_H_
+#define GLINT_CANVAS_RENDERING_POLICY_H_
+
+#include <optional>
+#include <string_view>
+
+namespace glint::candidate {
+inline constexpr char kCanvasPipelineVersionSwitch[] =
+    "glint-canvas-pipeline-version";
+inline constexpr char kCanvasRenderingPresetSwitch[] =
+    "glint-canvas-rendering-preset";
+
+enum class CanvasPipeline { kReadbackV1, kRenderingV2 };
+enum class CanvasRenderingPreset {
+  kNative, kAliased, kGrayscale, kClearTypeRgb, kClearTypeBgr,
+  kGamma1400Contrast300, kGamma2200Contrast500,
+};
+struct CanvasRenderingPolicy {
+  CanvasPipeline pipeline;
+  CanvasRenderingPreset preset;
+};
+struct CanvasRenderingInput {
+  std::optional<std::string_view> version;
+  std::optional<std::string_view> preset;
+  std::optional<std::string_view> rasterization;
+  std::optional<std::string_view> gamma;
+  std::optional<std::string_view> contrast;
+};
+
+// No profile migration or random selection. Version 2 must match the actual
+// native font switches; a descriptive preset alone cannot change the pipeline.
+constexpr std::optional<CanvasRenderingPolicy> ParseCanvasRenderingPolicy(
+    const CanvasRenderingInput& input) {
+  if (!input.version || *input.version == "1") {
+    if (input.preset) {
+      return std::nullopt;
+    }
+    return CanvasRenderingPolicy{CanvasPipeline::kReadbackV1,
+                                 CanvasRenderingPreset::kNative};
+  }
+  if (*input.version != "2" || !input.preset) {
+    return std::nullopt;
+  }
+  const bool native_raster = !input.rasterization ||
+                            *input.rasterization == "native";
+  const bool native_tuning = !input.gamma && !input.contrast;
+  const auto selected = *input.preset;
+  std::optional<CanvasRenderingPreset> preset;
+  if (selected == "native" && native_raster && native_tuning) {
+    preset = CanvasRenderingPreset::kNative;
+  } else if (selected == "aliased" && input.rasterization == "aliased" &&
+             native_tuning) {
+    preset = CanvasRenderingPreset::kAliased;
+  } else if (selected == "grayscale" && input.rasterization == "grayscale" &&
+             native_tuning) {
+    preset = CanvasRenderingPreset::kGrayscale;
+  } else if (selected == "cleartype-rgb" &&
+             input.rasterization == "cleartype-rgb" && native_tuning) {
+    preset = CanvasRenderingPreset::kClearTypeRgb;
+  } else if (selected == "cleartype-bgr" &&
+             input.rasterization == "cleartype-bgr" && native_tuning) {
+    preset = CanvasRenderingPreset::kClearTypeBgr;
+  } else if (selected == "gamma-1400-contrast-300" && native_raster &&
+             input.gamma == "1.4" && input.contrast == "0.3") {
+    preset = CanvasRenderingPreset::kGamma1400Contrast300;
+  } else if (selected == "gamma-2200-contrast-500" && native_raster &&
+             input.gamma == "2.2" && input.contrast == "0.5") {
+    preset = CanvasRenderingPreset::kGamma2200Contrast500;
+  }
+  if (!preset) {
+    return std::nullopt;
+  }
+  return CanvasRenderingPolicy{CanvasPipeline::kRenderingV2, *preset};
+}
+}  // namespace glint::candidate
+#endif
diff --git a/third_party/blink/public/common/native_privacy/glint/canvas_rendering_command.h b/third_party/blink/public/common/native_privacy/glint/canvas_rendering_command.h
