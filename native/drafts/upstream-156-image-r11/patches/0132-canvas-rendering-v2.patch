diff --git a/third_party/blink/common/native_privacy/glint/canvas_rendering_policy_unittest.cc b/third_party/blink/common/native_privacy/glint/canvas_rendering_policy_unittest.cc
new file mode 100644
--- /dev/null
+++ b/third_party/blink/common/native_privacy/glint/canvas_rendering_policy_unittest.cc
@@ -0,0 +1,74 @@
+// Copyright 2026 CamouFlow contributors.
+// SPDX-License-Identifier: MIT
+#include "third_party/blink/public/common/native_privacy/glint/canvas_rendering_command.h"
+
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace glint::candidate {
+namespace {
+constexpr CanvasRenderingInput kNativeV2{"2", "native", std::nullopt,
+                                        std::nullopt, std::nullopt};
+static_assert(ParseCanvasRenderingPolicy(kNativeV2)->pipeline ==
+              CanvasPipeline::kRenderingV2);
+static_assert(ParseCanvasRenderingPolicy({{}, {}, {}, {}, {}})->pipeline ==
+              CanvasPipeline::kReadbackV1);
+
+TEST(GlintCanvasRenderingPolicyTest, LegacyAbsenceDoesNotMigrateSettings) {
+  const auto policy = ParseCanvasRenderingPolicy(
+      {std::nullopt, std::nullopt, "grayscale", "2.2", "0.5"});
+  ASSERT_TRUE(policy);
+  EXPECT_EQ(policy->pipeline, CanvasPipeline::kReadbackV1);
+}
+
+TEST(GlintCanvasRenderingPolicyTest, ExplicitLegacyRejectsRenderingPreset) {
+  EXPECT_FALSE(ParseCanvasRenderingPolicy({"1", "native", {}, {}, {}}));
+  EXPECT_TRUE(ParseCanvasRenderingPolicy({"1", std::nullopt, {}, {}, {}}));
+}
+
+TEST(GlintCanvasRenderingPolicyTest, AcceptsSevenExactNativeConfigurations) {
+  constexpr CanvasRenderingInput inputs[] = {
+      kNativeV2, {"2", "aliased", "aliased", {}, {}},
+      {"2", "grayscale", "grayscale", {}, {}},
+      {"2", "cleartype-rgb", "cleartype-rgb", {}, {}},
+      {"2", "cleartype-bgr", "cleartype-bgr", {}, {}},
+      {"2", "gamma-1400-contrast-300", "native", "1.4", "0.3"},
+      {"2", "gamma-2200-contrast-500", std::nullopt, "2.2", "0.5"}};
+  for (const auto& input : inputs) {
+    const auto policy = ParseCanvasRenderingPolicy(input);
+    ASSERT_TRUE(policy);
+    EXPECT_EQ(policy->pipeline, CanvasPipeline::kRenderingV2);
+  }
+}
+
+TEST(GlintCanvasRenderingPolicyTest, RejectsOrphanUnknownAndEmptyVersions) {
+  EXPECT_FALSE(ParseCanvasRenderingPolicy({std::nullopt, "native", {}, {}, {}}));
+  EXPECT_FALSE(ParseCanvasRenderingPolicy({"", "native", {}, {}, {}}));
+  EXPECT_FALSE(ParseCanvasRenderingPolicy({"3", "native", {}, {}, {}}));
+  EXPECT_FALSE(ParseCanvasRenderingPolicy({"2", std::nullopt, {}, {}, {}}));
+  EXPECT_FALSE(ParseCanvasRenderingPolicy({"2", "unknown", {}, {}, {}}));
+}
+
+TEST(GlintCanvasRenderingPolicyTest, MetadataMustMatchActualRenderingSwitches) {
+  EXPECT_FALSE(ParseCanvasRenderingPolicy({"2", "grayscale", "aliased", {}, {}}));
+  EXPECT_FALSE(ParseCanvasRenderingPolicy({"2", "native", "", "1.4", "0.3"}));
+  EXPECT_FALSE(ParseCanvasRenderingPolicy({"2", "grayscale", "grayscale", "1.4", {}}));
+  EXPECT_FALSE(ParseCanvasRenderingPolicy(
+      {"2", "gamma-1400-contrast-300", "native", "2.2", "0.3"}));
+  EXPECT_FALSE(ParseCanvasRenderingPolicy(
+      {"2", "gamma-1400-contrast-300", "native", "1.4", std::nullopt}));
+}
+
+TEST(GlintCanvasRenderingPolicyTest, V2RequiresProfileSurfaceBootstrap) {
+  base::CommandLine command(base::CommandLine::NO_PROGRAM);
+  command.AppendSwitchASCII(kCanvasPipelineVersionSwitch, "2");
+  command.AppendSwitchASCII(kCanvasRenderingPresetSwitch, "native");
+  EXPECT_FALSE(CanvasRenderingPolicyForCommand(command));
+  command.AppendSwitchASCII(kProfileSurfacePolicySwitch, "1");
+#if BUILDFLAG(IS_WIN)
+  ASSERT_TRUE(CanvasRenderingPolicyForCommand(command));
+#else
+  EXPECT_FALSE(CanvasRenderingPolicyForCommand(command));
+#endif
+}
+}  // namespace
+}  // namespace glint::candidate
