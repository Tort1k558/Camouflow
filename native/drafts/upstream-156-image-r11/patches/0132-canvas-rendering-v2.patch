@@ -0,0 +1,41 @@
+// Copyright 2026 CamouFlow contributors.
+// SPDX-License-Identifier: MIT
+#ifndef GLINT_CANVAS_RENDERING_COMMAND_H_
+#define GLINT_CANVAS_RENDERING_COMMAND_H_
+
+#include "base/command_line.h"
+#include "build/build_config.h"
+#include "canvas_rendering_policy.h"
+#include "profile_surface_activation.h"
+
+namespace glint::candidate {
+inline std::optional<CanvasRenderingPolicy> CanvasRenderingPolicyForCommand(
+    const base::CommandLine& command) {
+  const auto version = command.GetSwitchValueASCII(kCanvasPipelineVersionSwitch);
+  const auto preset = command.GetSwitchValueASCII(kCanvasRenderingPresetSwitch);
+  const auto raster = command.GetSwitchValueASCII("glint-windows-font-rasterization");
+  const auto gamma = command.GetSwitchValueASCII("text-gamma");
+  const auto contrast = command.GetSwitchValueASCII("text-contrast");
+  const auto present = [&](const char* name, const std::string& value)
+      -> std::optional<std::string_view> {
+    return command.HasSwitch(name) ? std::optional<std::string_view>(value)
+                                   : std::nullopt;
+  };
+  auto policy = ParseCanvasRenderingPolicy({
+      present(kCanvasPipelineVersionSwitch, version),
+      present(kCanvasRenderingPresetSwitch, preset),
+      present("glint-windows-font-rasterization", raster),
+      present("text-gamma", gamma), present("text-contrast", contrast)});
+  if (policy && policy->pipeline == CanvasPipeline::kRenderingV2) {
+#if BUILDFLAG(IS_WIN)
+    if (!HasProfileSurfacePolicy(command)) {
+      return std::nullopt;
+    }
+#else
+    return std::nullopt;
+#endif
+  }
+  return policy;
+}
+}  // namespace glint::candidate
+#endif
