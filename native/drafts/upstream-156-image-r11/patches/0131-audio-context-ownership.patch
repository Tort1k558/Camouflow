+TEST_F(OfflineAudioContextTest, GlintCompletionClaimsResolverAndClearsSeedBeforeCallbacks) {
+  using Action = GlintOfflineCompletionListener::Action;
+  for (Action action : {Action::kNone, Action::kDetach, Action::kReenter}) {
+    auto holder = GlintOfflineAudioPolicyHolder(true, 27);
+    ASSERT_TRUE(holder);
+    Persistent<OfflineAudioContext> context = OfflineAudioContext::Create(
+        holder->GetFrame().DomWindow(), 1, 128, 44100, ASSERT_NO_EXCEPTION);
+    V8TestingScope scope(std::move(holder));
+    ScriptPromiseTester tester(scope.GetScriptState(),
+        OfflineAudioContextTestPeer::Prime(*context, scope.GetScriptState()));
+    auto* original_buffer = context->destinationNode()->DestinationBuffer();
+    auto* listener = MakeGarbageCollected<GlintOfflineCompletionListener>(context, action);
+    context->addEventListener(event_type_names::kComplete, listener);
+    context->FireCompletionEvent();
+    tester.WaitUntilSettled();
+    ASSERT_TRUE(tester.IsFulfilled());
+    auto* result = ToScriptWrappable<AudioBuffer>(scope.GetIsolate(),
+        tester.Value().V8Value().As<v8::Object>());
+    EXPECT_EQ(listener->calls, 1u);
+    EXPECT_FALSE(listener->seed_during_callback);
+    EXPECT_FALSE(listener->resolver_during_callback);
+    EXPECT_EQ(result, listener->buffer());
+    ASSERT_NE(result, original_buffer);
+    EXPECT_EQ(result->getChannelData(0)->AsSpan()[0], 0.375f);
+    EXPECT_EQ(original_buffer->getChannelData(0)->AsSpan()[0], 0.25f);
+    EXPECT_FALSE(OfflineAudioContextTestPeer::HasSeed(*context));
+    EXPECT_FALSE(OfflineAudioContextTestPeer::HasResolver(*context));
+  }
