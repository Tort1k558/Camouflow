 namespace blink {
 
 class OfflineAudioContextTest : public PageTestBase {};
+
+
+class OfflineAudioContextTestPeer {
+ public:
+  static bool HasSeed(const OfflineAudioContext& context) {
+    return context.glint_audio_partition_seed_.has_value();
+  }
+  static bool HasResolver(const OfflineAudioContext& context) {
+    return context.complete_resolver_ != nullptr;
+  }
+  static base::span<const uint8_t, 32> SeedBytes(
+      const OfflineAudioContext& context) {
+    return base::span(*context.glint_audio_partition_seed_);
+  }
+  static void Detach(OfflineAudioContext& context) {
+    context.DetachPendingResolvers();
+  }
+  static ScriptPromise<AudioBuffer> Prime(OfflineAudioContext& context,
+                                         ScriptState* script_state,
+                                         bool with_buffer = true) {
+    std::array<uint8_t, 32> seed;
+    seed.fill(27);
+    context.glint_audio_partition_seed_ = seed;
+    context.complete_resolver_ =
+        MakeGarbageCollected<ScriptPromiseResolver<AudioBuffer>>(script_state);
+    context.complete_resolver_->SuppressDetachCheck();
+    context.is_rendering_started_ = true;
+    if (with_buffer) {
+      auto* buffer = AudioBuffer::CreateUninitialized(1, 128, 44100);
+      CHECK(buffer);
+      std::ranges::fill(buffer->getChannelData(0)->AsSpan(), 0.25f);
+      context.destinationNode()->SetDestinationBuffer(buffer);
+    }
+    return context.complete_resolver_->Promise();
+  }
+};
+
+class GlintOfflineCompletionListener final : public NativeEventListener {
+ public:
+  enum class Action { kNone, kDetach, kReenter };
+  GlintOfflineCompletionListener(OfflineAudioContext* context, Action action)
+      : context_(context), action_(action) {}
+  void Invoke(ExecutionContext*, Event* event) override {
+    ++calls;
+    seed_during_callback = OfflineAudioContextTestPeer::HasSeed(*context_);
+    resolver_during_callback = OfflineAudioContextTestPeer::HasResolver(*context_);
+    buffer_ = static_cast<OfflineAudioCompletionEvent*>(event)->renderedBuffer();
+    buffer_->getChannelData(0)->AsSpan()[0] = 0.375f;
+    if (action_ == Action::kDetach) {
+      OfflineAudioContextTestPeer::Detach(*context_);
+    } else if (action_ == Action::kReenter) {
+      context_->FireCompletionEvent();
+    }
+  }
+  AudioBuffer* buffer() const { return buffer_.Get(); }
+  void Trace(Visitor* visitor) const override {
+    visitor->Trace(context_);
+    visitor->Trace(buffer_);
+    NativeEventListener::Trace(visitor);
+  }
+  unsigned calls = 0;
+  bool seed_during_callback = false;
+  bool resolver_during_callback = false;
+
+ private:
+  Member<OfflineAudioContext> context_;
+  Member<AudioBuffer> buffer_;
+  Action action_;
+};
 
