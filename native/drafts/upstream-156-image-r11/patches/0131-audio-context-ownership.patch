+TEST_F(OfflineAudioContextTest, GlintRejectClearsSeedAndBlocksLateCompletion) {
+  auto holder = GlintOfflineAudioPolicyHolder(true, 27);
+  ASSERT_TRUE(holder);
+  Persistent<OfflineAudioContext> context = OfflineAudioContext::Create(
+      holder->GetFrame().DomWindow(), 1, 128, 44100, ASSERT_NO_EXCEPTION);
+  V8TestingScope scope(std::move(holder));
+  ScriptPromiseTester tester(scope.GetScriptState(),
+      OfflineAudioContextTestPeer::Prime(*context, scope.GetScriptState()));
+  const auto seed_bytes = OfflineAudioContextTestPeer::SeedBytes(*context);
+  auto* listener = MakeGarbageCollected<GlintOfflineCompletionListener>(
+      context, GlintOfflineCompletionListener::Action::kNone);
+  context->addEventListener(event_type_names::kComplete, listener);
+  context->RejectPendingResolvers();
+  tester.WaitUntilSettled();
+  EXPECT_TRUE(tester.IsRejected());
+  EXPECT_FALSE(OfflineAudioContextTestPeer::HasSeed(*context));
+  EXPECT_FALSE(OfflineAudioContextTestPeer::HasResolver(*context));
+  for (uint8_t value : seed_bytes) {
+    EXPECT_EQ(value, 0);
+  }
+  context->FireCompletionEvent();
+  EXPECT_EQ(listener->calls, 0u);
+  EXPECT_TRUE(tester.IsRejected());
