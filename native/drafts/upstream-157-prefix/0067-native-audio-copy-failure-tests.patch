+TEST_F(OfflineAudioContextTest,
+       GlintProtectedCopyFailureRejectsPendingQueueWithoutRawResult) {
+  ScopedOfflineAudioContextIncrementalRenderingForTest incremental(true);
+  auto holder = GlintOfflineAudioPolicyHolder(true, 5);
+  ASSERT_TRUE(holder);
+  V8TestingScope scope(std::move(holder));
+  auto* context = OfflineAudioContext::Create(scope.GetFrame().DomWindow(), 1,
+                                              256, 44100, ASSERT_NO_EXCEPTION);
+  ASSERT_TRUE(context);
+  ASSERT_NO_FATAL_FAILURE(GlintConnectConstantSource(*context));
+  auto* completion = MakeGarbageCollected<GlintOfflineCompletionProbe>(context);
+  context->addEventListener(AtomicString("complete"), completion);
+  ScriptPromiseTester suspended(
+      scope.GetScriptState(),
+      context->suspendContext(scope.GetScriptState(), 0.0,
+                              ASSERT_NO_EXCEPTION));
+  ScriptPromiseTester future_suspend(
+      scope.GetScriptState(),
+      context->suspendContext(scope.GetScriptState(), 128.0 / 44100.0,
+                              ASSERT_NO_EXCEPTION));
+  ScriptPromiseTester first(
+      scope.GetScriptState(),
+      context->startOfflineRendering(scope.GetScriptState(), 128,
+                                     ASSERT_NO_EXCEPTION));
+  ScriptPromiseTester second(
+      scope.GetScriptState(),
+      context->startOfflineRendering(scope.GetScriptState(), 128,
+                                     ASSERT_NO_EXCEPTION));
+  suspended.WaitUntilSettled();
+  ASSERT_TRUE(suspended.IsFulfilled());
+  ASSERT_EQ(context->ContextState(), V8AudioContextState::Enum::kSuspended);
+  ASSERT_TRUE(context->glint_audio_partition_seed_.has_value());
+  ASSERT_EQ(context->pending_render_targets_.size(), 2u);
+  ASSERT_EQ(context->start_rendering_resolvers_.size(), 2u);
+  ASSERT_FALSE(first.IsFulfilled());
+  ASSERT_FALSE(first.IsRejected());
+  ASSERT_FALSE(second.IsFulfilled());
+  ASSERT_FALSE(second.IsRejected());
+  ASSERT_FALSE(future_suspend.IsFulfilled());
+  ASSERT_FALSE(future_suspend.IsRejected());
+
+  // Inject an invalid completed target, not the audio thread's shared buffer.
+  // Rendering is paused at frame zero; no allocator/HMAC failure hook is added.
+  auto* invalid_target = AudioBuffer::Create(1, 128, 44100);
+  ASSERT_TRUE(invalid_target);
+  auto channel = invalid_target->getChannelData(0);
+  ASSERT_TRUE(channel);
+  ASSERT_TRUE(channel->buffer()->IsDetachable(scope.GetIsolate()));
+  ArrayBufferContents transferred;
+  DummyExceptionStateForTesting transfer_exception;
+  ASSERT_TRUE(channel->buffer()->Transfer(scope.GetIsolate(), transferred,
+                                          transfer_exception));
+  ASSERT_FALSE(transfer_exception.HadException());
+  ASSERT_TRUE(channel->buffer()->IsDetached());
+  ASSERT_EQ(transferred.DataLength(), 128u * sizeof(float));
+  ASSERT_TRUE(channel->AsSpan().empty());
+  ASSERT_EQ(invalid_target->length(), 128u);
+  context->pending_render_targets_.front() = invalid_target;
+  context->OnChunkRendered();
+
+  first.WaitUntilSettled();
+  second.WaitUntilSettled();
+  future_suspend.WaitUntilSettled();
+  auto expect_rejection = [&](ScriptPromiseTester& tester,
+                              const char* expected_name) {
+    ASSERT_TRUE(tester.IsRejected());
+    auto value = tester.Value().V8Value();
+    ASSERT_TRUE(value->IsObject());
+    auto* error = ToScriptWrappable<DOMException>(scope.GetIsolate(),
+                                                  value.As<v8::Object>());
+    ASSERT_TRUE(error);
+    EXPECT_EQ(error->name(), expected_name);
+  };
+  ASSERT_NO_FATAL_FAILURE(expect_rejection(first, "NotReadableError"));
+  ASSERT_NO_FATAL_FAILURE(expect_rejection(second, "AbortError"));
+  ASSERT_NO_FATAL_FAILURE(
+      expect_rejection(future_suspend, "InvalidStateError"));
+  EXPECT_EQ(completion->count(), 0);
+  EXPECT_TRUE(context->pending_render_targets_.empty());
+  EXPECT_TRUE(context->start_rendering_resolvers_.empty());
+  EXPECT_EQ(context->ContextState(), V8AudioContextState::Enum::kClosed);
+  context->OnChunkRendered();
+  test::RunPendingTasks();
+  EXPECT_EQ(completion->count(), 0);
+
+  DummyExceptionStateForTesting retry_exception;
+  auto retry = context->startOfflineRendering(nullptr, 128, retry_exception);
+  EXPECT_TRUE(retry.IsEmpty());
+  ASSERT_TRUE(retry_exception.HadException());
+  EXPECT_EQ(retry_exception.CodeAs<DOMExceptionCode>(),
+            DOMExceptionCode::kInvalidStateError);
+}
