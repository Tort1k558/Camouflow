+TEST_F(OfflineAudioContextTest,
+       GlintSeparatePoliciesUseIndependentAudioVectors) {
+  ScopedOfflineAudioContextIncrementalRenderingForTest incremental(true);
+  for (uint8_t seed : {uint8_t{4}, uint8_t{5}, uint8_t{4}}) {
+    auto holder = GlintOfflineAudioPolicyHolder(true, seed);
+    ASSERT_TRUE(holder);
+    V8TestingScope scope(std::move(holder));
+    auto* context = OfflineAudioContext::Create(
+        scope.GetFrame().DomWindow(), 1, 128, 44100, ASSERT_NO_EXCEPTION);
+    ASSERT_TRUE(context);
+    ASSERT_NO_FATAL_FAILURE(GlintConnectConstantSource(*context));
+    ScriptPromiseTester rendered(
+        scope.GetScriptState(),
+        context->startOfflineRendering(scope.GetScriptState(), 128,
+                                       ASSERT_NO_EXCEPTION));
+    rendered.WaitUntilSettled();
+    ASSERT_TRUE(rendered.IsFulfilled());
+    auto* buffer = ToScriptWrappable<AudioBuffer>(
+        scope.GetIsolate(), rendered.Value().V8Value().As<v8::Object>());
+    ASSERT_TRUE(buffer);
+    ASSERT_EQ(buffer->length(), 128u);
+    auto channel = buffer->getChannelData(0);
+    ASSERT_TRUE(channel);
+    ASSERT_EQ(channel->AsSpan().size(), 128u);
+    const uint32_t expected = seed == 4 ? 0x3e800000u : 0x3e800001u;
+    for (float sample : channel->AsSpan()) {
+      EXPECT_EQ(std::bit_cast<uint32_t>(sample), expected);
+    }
+  }
+}
