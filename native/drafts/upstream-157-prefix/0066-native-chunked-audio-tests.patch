+TEST_F(OfflineAudioContextTest,
+       GlintChunkMissingPolicyRejectsBeforeResolverOrRenderThread) {
+  ScopedOfflineAudioContextIncrementalRenderingForTest incremental(true);
+  auto holder = GlintOfflineAudioPolicyHolder(false);
+  ASSERT_TRUE(holder);
+  auto* context = OfflineAudioContext::Create(holder->GetFrame().DomWindow(), 1,
+                                              256, 44100, ASSERT_NO_EXCEPTION);
+  ASSERT_TRUE(context);
+  DummyExceptionStateForTesting exception;
+  auto promise = context->startOfflineRendering(nullptr, 128, exception);
+  EXPECT_TRUE(promise.IsEmpty());
+  ASSERT_TRUE(exception.HadException());
+  EXPECT_EQ(exception.CodeAs<DOMExceptionCode>(),
+            DOMExceptionCode::kNotReadableError);
+  EXPECT_EQ(context->ContextState(), V8AudioContextState::Enum::kSuspended);
+}
