+TEST_F(OfflineAudioContextTest, GlintRoundedChunkBudgetRejectsAndAllowsRetry) {
+  ScopedOfflineAudioContextIncrementalRenderingForTest incremental(true);
+  auto holder = GlintOfflineAudioPolicyHolder(true);
+  ASSERT_TRUE(holder);
+  V8TestingScope scope(std::move(holder));
+  auto* options = OfflineAudioContextOptions::Create();
+  options->setNumberOfChannels(3);
+  options->setSampleRate(44100);
+  auto* context = OfflineAudioContext::Create(scope.GetFrame().DomWindow(),
+                                              options, ASSERT_NO_EXCEPTION);
+  ASSERT_TRUE(context);
+  ASSERT_EQ(context->renderQuantumSize(), 128u);
+  constexpr uint32_t kUnroundedFrames =
+      glint::candidate::kMaxOfflineAudioCopyBytes / (3 * sizeof(float));
+  static_assert(glint::candidate::CanCopyOfflineAudio(3, kUnroundedFrames));
+  static_assert(kUnroundedFrames % 128 != 0);
+  DummyExceptionStateForTesting exception;
+  auto promise =
+      context->startOfflineRendering(nullptr, kUnroundedFrames, exception);
+  EXPECT_TRUE(promise.IsEmpty());
+  ASSERT_TRUE(exception.HadException());
+  EXPECT_EQ(exception.CodeAs<DOMExceptionCode>(),
+            DOMExceptionCode::kNotReadableError);
+  EXPECT_EQ(context->ContextState(), V8AudioContextState::Enum::kSuspended);
+
+  ScriptPromiseTester retry(
+      scope.GetScriptState(),
+      context->startOfflineRendering(scope.GetScriptState(), 128,
+                                     ASSERT_NO_EXCEPTION));
+  retry.WaitUntilSettled();
+  ASSERT_TRUE(retry.IsFulfilled());
+  auto* buffer = ToScriptWrappable<AudioBuffer>(
+      scope.GetIsolate(), retry.Value().V8Value().As<v8::Object>());
+  ASSERT_TRUE(buffer);
+  EXPECT_EQ(buffer->length(), 128u);
+  EXPECT_EQ(buffer->numberOfChannels(), 3u);
+  ScriptPromiseTester closed(
+      scope.GetScriptState(),
+      context->closeContext(scope.GetScriptState(), ASSERT_NO_EXCEPTION));
+  closed.WaitUntilSettled();
+  EXPECT_TRUE(closed.IsFulfilled());
+}
