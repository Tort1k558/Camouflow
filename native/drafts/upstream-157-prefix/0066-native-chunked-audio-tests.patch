+TEST_F(OfflineAudioContextTest,
+       GlintQueuedChunksShareOnlyFinalMutableEventResult) {
+  ScopedOfflineAudioContextIncrementalRenderingForTest incremental(true);
+  auto holder = GlintOfflineAudioPolicyHolder(true, 5);
+  ASSERT_TRUE(holder);
+  V8TestingScope scope(std::move(holder));
+  auto* context = OfflineAudioContext::Create(scope.GetFrame().DomWindow(), 1,
+                                              300, 44100, ASSERT_NO_EXCEPTION);
+  ASSERT_TRUE(context);
+  ASSERT_NO_FATAL_FAILURE(GlintConnectConstantSource(*context));
+  auto* completion =
+      MakeGarbageCollected<GlintOfflineCompletionProbe>(context, true);
+  context->addEventListener(AtomicString("complete"), completion);
+  ScriptPromiseTester first(
+      scope.GetScriptState(),
+      context->startOfflineRendering(scope.GetScriptState(), 128,
+                                     ASSERT_NO_EXCEPTION));
+  ScriptPromiseTester second(
+      scope.GetScriptState(),
+      context->startOfflineRendering(scope.GetScriptState(), 128,
+                                     ASSERT_NO_EXCEPTION));
+  ScriptPromiseTester final_tester(
+      scope.GetScriptState(),
+      context->startOfflineRendering(scope.GetScriptState(), 128,
+                                     ASSERT_NO_EXCEPTION));
+  first.WaitUntilSettled();
+  second.WaitUntilSettled();
+  final_tester.WaitUntilSettled();
+  ASSERT_TRUE(first.IsFulfilled());
+  ASSERT_TRUE(second.IsFulfilled());
+  ASSERT_TRUE(final_tester.IsFulfilled());
+  auto* first_buffer = ToScriptWrappable<AudioBuffer>(
+      scope.GetIsolate(), first.Value().V8Value().As<v8::Object>());
+  auto* second_buffer = ToScriptWrappable<AudioBuffer>(
+      scope.GetIsolate(), second.Value().V8Value().As<v8::Object>());
+  auto* final_buffer = ToScriptWrappable<AudioBuffer>(
+      scope.GetIsolate(), final_tester.Value().V8Value().As<v8::Object>());
+  ASSERT_TRUE(first_buffer);
+  ASSERT_TRUE(second_buffer);
+  ASSERT_TRUE(final_buffer);
+  EXPECT_EQ(first_buffer->length(), 128u);
+  EXPECT_EQ(second_buffer->length(), 128u);
+  ASSERT_EQ(final_buffer->length(), 44u);
+  EXPECT_EQ(completion->count(), 1);
+  EXPECT_EQ(completion->buffer(), final_buffer);
+  EXPECT_NE(first_buffer, second_buffer);
+  EXPECT_NE(first_buffer, final_buffer);
+  EXPECT_NE(second_buffer, final_buffer);
+  // Independent HMAC vector: seed=32 bytes of 0x05, input float bits=3e800000.
+  for (auto* buffer : {first_buffer, second_buffer, final_buffer}) {
+    auto channel = buffer->getChannelData(0);
+    ASSERT_TRUE(channel);
+    auto samples = channel->AsSpan();
+    ASSERT_FALSE(samples.empty());
+    EXPECT_EQ(std::bit_cast<uint32_t>(samples.front()), 0x3e800001u);
+  }
+  auto final_channel = final_buffer->getChannelData(0);
+  ASSERT_TRUE(final_channel);
+  EXPECT_EQ(final_channel->AsSpan().back(), 0.5f);
+  auto first_channel = first_buffer->getChannelData(0);
+  auto second_channel = second_buffer->getChannelData(0);
+  ASSERT_TRUE(first_channel);
+  ASSERT_TRUE(second_channel);
+  EXPECT_EQ(std::bit_cast<uint32_t>(first_channel->AsSpan().back()),
+            0x3e800001u);
+  first_channel->AsSpan().back() = 0.75f;
+  EXPECT_EQ(std::bit_cast<uint32_t>(second_channel->AsSpan().back()),
+            0x3e800001u);
+  EXPECT_EQ(context->ContextState(), V8AudioContextState::Enum::kClosed);
+}
