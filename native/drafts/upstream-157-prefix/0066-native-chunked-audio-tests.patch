+class GlintOfflineCompletionProbe final : public NativeEventListener {
+ public:
+  explicit GlintOfflineCompletionProbe(OfflineAudioContext* context,
+                                       bool mutate_last_sample = false)
+      : context_(context), mutate_last_sample_(mutate_last_sample) {}
+
+  void Invoke(ExecutionContext*, Event* event) override {
+    ASSERT_TRUE(event);
+    ASSERT_EQ(event->InterfaceName(),
+              event_interface_names::kOfflineAudioCompletionEvent);
+    auto* completion = static_cast<OfflineAudioCompletionEvent*>(event);
+    ++count_;
+    buffer_ = completion->renderedBuffer();
+    ASSERT_TRUE(buffer_);
+    EXPECT_EQ(context_->ContextState(), V8AudioContextState::Enum::kClosed);
+    if (mutate_last_sample_) {
+      auto channel = buffer_->getChannelData(0);
+      ASSERT_TRUE(channel);
+      auto samples = channel->AsSpan();
+      ASSERT_FALSE(samples.empty());
+      samples.back() = 0.5f;
+    }
+  }
+
+  int count() const { return count_; }
+  AudioBuffer* buffer() const { return buffer_.Get(); }
+
+  void Trace(Visitor* visitor) const override {
+    visitor->Trace(context_);
+    visitor->Trace(buffer_);
+    NativeEventListener::Trace(visitor);
+  }
+
+ private:
+  Member<OfflineAudioContext> context_;
+  Member<AudioBuffer> buffer_;
+  bool mutate_last_sample_;
+  int count_ = 0;
+};
+
+void GlintConnectConstantSource(OfflineAudioContext& context) {
+  auto* source = ConstantSourceNode::Create(context, ASSERT_NO_EXCEPTION);
+  ASSERT_TRUE(source);
+  source->offset()->setValue(0.25f);
+  source->connect(context.destinationNode(), 0, 0, ASSERT_NO_EXCEPTION);
+  source->start(0.0, ASSERT_NO_EXCEPTION);
+}
