+TEST_F(GLES2DecoderPassthroughTest,
+       GlintMetadataInvalidSharedMemoryDoesNotWrite) {
+  base::test::ScopedFeatureList scoped_features;
+  scoped_features.InitAndDisableFeature(
+      features::kGlintReadbackMetadataCandidate);
+  using Command = cmds::GetGlintReadFramebufferMetadataCHROMIUM;
+  Command command;
+  command.Init(kInvalidSharedMemoryId, kSharedMemoryOffset);
+  std::array<uint8_t, kSharedBufferSize> before;
+  const auto* memory = static_cast<const uint8_t*>(shared_memory_base_.get());
+  std::copy_n(memory, before.size(), before.begin());
+  EXPECT_EQ(error::kOutOfBounds, ExecuteCmd(command));
+  EXPECT_TRUE(std::equal(before.begin(), before.end(), memory));
+}
