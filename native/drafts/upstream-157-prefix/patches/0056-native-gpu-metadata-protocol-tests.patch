+TEST_F(GLES2DecoderPassthroughTest,
+       GlintMetadataFeatureOffPublishesOnlyUnavailable) {
+  base::test::ScopedFeatureList scoped_features;
+  scoped_features.InitAndDisableFeature(
+      features::kGlintReadbackMetadataCandidate);
+  using Command = cmds::GetGlintReadFramebufferMetadataCHROMIUM;
+  auto* result = GetSharedMemoryAs<Command::Result*>();
+  result->SetNumResults(0);
+  result->GetData()[kGlintReadbackMetadataValues] = 0x4c;
+  Command command;
+  command.Init(shared_memory_id_, kSharedMemoryOffset);
+  ASSERT_EQ(error::kNoError, ExecuteCmd(command));
+  ASSERT_EQ(result->GetNumResults(), static_cast<int>(kGlintReadbackMetadataValues));
+  EXPECT_TRUE(std::equal(kGlintReadbackMetadataUnavailable.begin(),
+                         kGlintReadbackMetadataUnavailable.end(),
+                         result->GetData()));
+  EXPECT_EQ(result->GetData()[kGlintReadbackMetadataValues], 0x4c);
+}
