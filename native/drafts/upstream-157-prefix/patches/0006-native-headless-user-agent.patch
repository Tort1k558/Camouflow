+TEST_F(UserAgentUtilsTest, NativeHeadlessUserAgentPreservesBrowserIdentity) {
+  base::test::ScopedCommandLine scoped_command_line;
+  base::CommandLine* command_line = scoped_command_line.GetProcessCommandLine();
+  command_line->RemoveSwitch(kHeadless);
+  const std::string expected_user_agent = GetUserAgent();
+  const blink::UserAgentMetadata expected_metadata = GetUserAgentMetadata();
+  command_line->AppendSwitch(kHeadless);
+  command_line->AppendSwitch("camouflow-native-user-agent");
+  EXPECT_EQ(expected_user_agent, GetUserAgent());
+  const blink::UserAgentMetadata metadata = GetUserAgentMetadata();
+  EXPECT_EQ(expected_metadata.brand_version_list, metadata.brand_version_list);
+  EXPECT_EQ(expected_metadata.brand_full_version_list,
+            metadata.brand_full_version_list);
+  EXPECT_EQ(expected_metadata.full_version, metadata.full_version);
+  EXPECT_EQ(expected_metadata.platform, metadata.platform);
+  EXPECT_EQ(expected_metadata.platform_version, metadata.platform_version);
+  EXPECT_EQ(expected_metadata.architecture, metadata.architecture);
+  EXPECT_EQ(expected_metadata.bitness, metadata.bitness);
+  EXPECT_EQ(expected_metadata.model, metadata.model);
+  EXPECT_EQ(expected_metadata.mobile, metadata.mobile);
+  EXPECT_EQ(expected_metadata.wow64, metadata.wow64);
+  EXPECT_EQ(expected_metadata.form_factors, metadata.form_factors);
+}
+
+TEST_F(UserAgentUtilsTest, NativeHeadlessUserAgentRejectsFlagValue) {
+  base::test::ScopedCommandLine scoped_command_line;
+  scoped_command_line.GetProcessCommandLine()->AppendSwitchASCII(
+      "camouflow-native-user-agent", "false");
+  EXPECT_DEATH_IF_SUPPORTED(GetUserAgent(),
+                            "Invalid CamouFlow Native browser identity flag");
+}
