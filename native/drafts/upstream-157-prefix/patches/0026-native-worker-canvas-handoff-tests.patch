+TEST_F(WorkerThreadTest, GlintCanvasSeedArrivesBeforeEvaluation) {
+  std::array<uint8_t, 32> seed{};
+  for (uint8_t i = 0; i < seed.size(); ++i) {
+    seed[i] = i;
+  }
+  testing::InSequence sequence;
+  EXPECT_CALL(*reporting_proxy_, DidCreateWorkerGlobalScope(_))
+      .WillOnce([seed](WorkerOrWorkletGlobalScope* scope) {
+        auto* worker_scope = To<WorkerGlobalScope>(scope);
+        EXPECT_EQ(worker_scope->GlintCanvasPartitionSeed(), std::optional(seed));
+        auto copy = worker_scope->GlintCanvasPartitionSeed();
+        ASSERT_TRUE(copy);
+        copy->fill(255);
+        EXPECT_EQ(worker_scope->GlintCanvasPartitionSeed(), std::optional(seed));
+      });
+  EXPECT_CALL(*reporting_proxy_, WillEvaluateScriptMock()).Times(1);
+  EXPECT_CALL(*reporting_proxy_, DidEvaluateTopLevelScriptMock(true, _)).Times(1);
+  EXPECT_CALL(*reporting_proxy_, WillDestroyWorkerGlobalScope()).Times(1);
+  EXPECT_CALL(*reporting_proxy_, DidTerminateWorkerThread()).Times(1);
+  worker_thread_->StartWithSourceCode(security_origin_.get(), "//fixture",
+                                     KURL("http://fake.url/"), seed);
+  seed.fill(255);
+  worker_thread_->WaitForInit();
+  worker_thread_->Terminate();
+  worker_thread_->WaitForShutdownForTesting();
+}
+
+TEST_F(WorkerThreadTest, GlintCanvasSeedRemainsAbsentWithoutBootstrap) {
+  testing::InSequence sequence;
+  EXPECT_CALL(*reporting_proxy_, DidCreateWorkerGlobalScope(_))
+      .WillOnce([](WorkerOrWorkletGlobalScope* scope) {
+        EXPECT_FALSE(To<WorkerGlobalScope>(scope)->GlintCanvasPartitionSeed());
+      });
+  EXPECT_CALL(*reporting_proxy_, WillEvaluateScriptMock()).Times(1);
+  EXPECT_CALL(*reporting_proxy_, DidEvaluateTopLevelScriptMock(true, _)).Times(1);
+  EXPECT_CALL(*reporting_proxy_, WillDestroyWorkerGlobalScope()).Times(1);
+  EXPECT_CALL(*reporting_proxy_, DidTerminateWorkerThread()).Times(1);
+  Start();
+  worker_thread_->WaitForInit();
+  worker_thread_->Terminate();
+  worker_thread_->WaitForShutdownForTesting();
+}
+
+TEST_F(WorkerThreadTest, GlintSequentialScopesDoNotReusePreviousCanvasSeed) {
+  std::array<uint8_t, 32> first{};
+  std::array<uint8_t, 32> second{};
+  first.fill(17);
+  second.fill(233);
+  const std::optional<std::array<uint8_t, 32>> seeds[] = {
+      first, second, std::nullopt};
+  for (const auto& seed : seeds) {
+    testing::InSequence sequence;
+    EXPECT_CALL(*reporting_proxy_, DidCreateWorkerGlobalScope(_))
+        .WillOnce([seed](WorkerOrWorkletGlobalScope* scope) {
+          EXPECT_EQ(To<WorkerGlobalScope>(scope)->GlintCanvasPartitionSeed(), seed);
+        });
+    EXPECT_CALL(*reporting_proxy_, WillEvaluateScriptMock()).Times(1);
+    EXPECT_CALL(*reporting_proxy_, DidEvaluateTopLevelScriptMock(true, _)).Times(1);
+    EXPECT_CALL(*reporting_proxy_, WillDestroyWorkerGlobalScope()).Times(1);
+    EXPECT_CALL(*reporting_proxy_, DidTerminateWorkerThread()).Times(1);
+    worker_thread_->StartWithSourceCode(security_origin_.get(), "//fixture",
+                                       KURL("http://fake.url/"), seed);
+    worker_thread_->WaitForInit();
+    worker_thread_->Terminate();
+    worker_thread_->WaitForShutdownForTesting();
+    EXPECT_EQ(ExitCode::kGracefullyTerminated, GetExitCode());
+    worker_thread_.reset();
+    ASSERT_TRUE(testing::Mock::VerifyAndClearExpectations(reporting_proxy_.get()));
+    worker_thread_ = std::make_unique<WorkerThreadForTest>(*reporting_proxy_);
+  }
+}
+
+TEST_F(WorkerThreadTest, GlintImmediateTerminationRetainsOwnedCanvasSeed) {
+  std::array<uint8_t, 32> seed{};
+  seed.fill(29);
+  const auto expected = seed;
+  EXPECT_CALL(*reporting_proxy_, DidCreateWorkerGlobalScope(_))
+      .WillOnce([expected](WorkerOrWorkletGlobalScope* scope) {
+        EXPECT_EQ(To<WorkerGlobalScope>(scope)->GlintCanvasPartitionSeed(),
+                  std::optional(expected));
+      });
+  EXPECT_CALL(*reporting_proxy_, WillEvaluateScriptMock()).Times(AtMost(1));
+  EXPECT_CALL(*reporting_proxy_, DidEvaluateTopLevelScriptMock(_, _)).Times(AtMost(1));
+  EXPECT_CALL(*reporting_proxy_, WillDestroyWorkerGlobalScope()).Times(AtMost(1));
+  EXPECT_CALL(*reporting_proxy_, DidTerminateWorkerThread()).Times(1);
+  worker_thread_->StartWithSourceCode(security_origin_.get(), "//fixture",
+                                     KURL("http://fake.url/"), seed);
+  seed.fill(255);
+  worker_thread_->Terminate();
+  worker_thread_->WaitForShutdownForTesting();
+  EXPECT_EQ(ExitCode::kGracefullyTerminated, GetExitCode());
+}
