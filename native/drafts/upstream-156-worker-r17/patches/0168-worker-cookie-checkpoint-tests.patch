+  enum class CookieAction { kRegister, kDuplicate, kWrite, kDisconnect, kFailDrain };
+
+  void StartCookieEndpoint(bool with_producer) {
+    const KURL script_url("https://example.com/cookie-worker.js");
+    worker_thread_->Start(GlobalScopeCreationParams::CreateForWorkerForTesting(
+                              security_origin_.get(), script_url),
+                          WorkerBackingThreadStartupData::CreateDefault(),
+                          std::make_unique<WorkerDevToolsParams>());
+    worker_thread_->EvaluateClassicScript(script_url, "// checkpoint fixture",
+                                          nullptr, v8_inspector::V8StackTraceId());
+    auto receiver = cookie_endpoint_.BindNewPipeAndPassReceiver();
+    PostCrossThreadTask(
+        *worker_thread_->GetWorkerBackingThread().BackingThread().GetTaskRunner(),
+        FROM_HERE,
+        CrossThreadBindOnce(
+            [](WorkerThread* thread, bool create_producer,
+               mojo::PendingReceiver<mojom::blink::ServiceWorker> pending) {
+              auto* scope = To<ServiceWorkerGlobalScope>(thread->GlobalScope());
+              if (create_producer) {
+                EXPECT_TRUE(MakeGarbageCollected<WorkerCookieTestParticipant>(*scope)
+                                ->Register());
+              }
+              scope->BindServiceWorker(std::move(pending));
+            },
+            CrossThreadUnretained(worker_thread_.get()), with_producer,
+            std::move(receiver)));
+  }
+
+  std::optional<uint64_t> CaptureCookieTicket() {
+    base::test::TestFuture<bool, uint64_t> captured;
+    cookie_endpoint_->CaptureCookieProducerForCheckpoint(captured.GetCallback());
+    if (!captured.Get<0>()) {
+      return std::nullopt;
+    }
+    return captured.Get<1>();
+  }
+
+  bool DrainCookieTicket(uint64_t ticket, base::TimeTicks deadline) {
+    base::test::TestFuture<bool> done;
+    cookie_endpoint_->DrainCookieWritesForCheckpoint(ticket, deadline,
+                                                     done.GetCallback());
+    return done.Get();
+  }
+
+  bool ChangeCookieProducer(CookieAction action) {
+    auto completed =
+        base::MakeRefCounted<base::RefCountedData<base::WaitableEvent>>();
+    PostCrossThreadTask(
+        *worker_thread_->GetWorkerBackingThread().BackingThread().GetTaskRunner(),
+        FROM_HERE,
+        CrossThreadBindOnce(
+            [](WorkerThread* thread, CookieAction selected,
+               scoped_refptr<base::RefCountedData<base::WaitableEvent>> completion) {
+              auto* scope = To<ServiceWorkerGlobalScope>(thread->GlobalScope());
+              if (selected == CookieAction::kRegister ||
+                  selected == CookieAction::kDuplicate) {
+                auto* added = MakeGarbageCollected<WorkerCookieTestParticipant>(*scope);
+                EXPECT_EQ(added->Register(), selected == CookieAction::kRegister);
+              } else {
+                auto* participant = static_cast<WorkerCookieTestParticipant*>(
+                    CookieCheckpointParticipant::GetIfExists(*scope));
+                EXPECT_NE(participant, nullptr);
+                if (participant) {
+                  switch (selected) {
+                    case CookieAction::kWrite:
+                      participant->Write();
+                      break;
+                    case CookieAction::kDisconnect:
+                      participant->Disconnect();
+                      break;
+                    case CookieAction::kFailDrain:
+                      participant->FailDrain();
+                      break;
+                    case CookieAction::kRegister:
+                    case CookieAction::kDuplicate:
+                      NOTREACHED();
+                  }
+                }
+              }
+              completion->data.Signal();
+            },
+            CrossThreadUnretained(worker_thread_.get()), action,
+            completed));
+    return completed->data.TimedWait(base::Seconds(5));
+  }
+
  protected:
