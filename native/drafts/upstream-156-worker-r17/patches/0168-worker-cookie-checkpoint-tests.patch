+TEST_F(ServiceWorkerGlobalScopeTest, GlintCookieEmptyProducerCapturesAndDrains) {
+  StartCookieEndpoint(false);
+  auto ticket = CaptureCookieTicket();
+  ASSERT_TRUE(ticket);
+  EXPECT_NE(*ticket, 0u);
+  EXPECT_TRUE(DrainCookieTicket(*ticket, base::TimeTicks::Now() + base::Seconds(5)));
+}
+
+TEST_F(ServiceWorkerGlobalScopeTest, GlintCookieNewCaptureInvalidatesOldTicket) {
+  StartCookieEndpoint(false);
+  auto first = CaptureCookieTicket();
+  auto second = CaptureCookieTicket();
+  ASSERT_TRUE(first);
+  ASSERT_TRUE(second);
+  EXPECT_GT(*second, *first);
+  EXPECT_FALSE(DrainCookieTicket(*first, base::TimeTicks::Now() + base::Seconds(5)));
+  EXPECT_TRUE(DrainCookieTicket(*second, base::TimeTicks::Now() + base::Seconds(5)));
+}
