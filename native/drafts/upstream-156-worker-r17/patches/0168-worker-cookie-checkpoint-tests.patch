+// Exercises worker IPC/capture lifetime, not RestrictedCookieManager persistence.
+class WorkerCookieTestParticipant final
+    : public GarbageCollected<WorkerCookieTestParticipant>,
+      public CookieCheckpointParticipant {
+ public:
+  explicit WorkerCookieTestParticipant(ExecutionContext& context)
+      : CookieCheckpointParticipant(context) {}
+  bool Register() { return RegisterForCheckpoint(); }
+  std::optional<Snapshot> CaptureWritesForCheckpoint() const override {
+    if (!available_ || !IsRegisteredForCheckpoint()) {
+      return std::nullopt;
+    }
+    return Snapshot{1, epoch_};
+  }
+  void DrainWritesForCheckpoint(base::TimeTicks,
+                                base::OnceCallback<void(bool)> callback) override {
+    std::move(callback).Run(success_);
+  }
+  void Write() { ++epoch_; }
+  void Disconnect() { available_ = false; }
+  void FailDrain() { success_ = false; }
+
+ private:
+  uint64_t epoch_ = 0;
+  bool available_ = true;
+  bool success_ = true;
+};
+
+}  // namespace
