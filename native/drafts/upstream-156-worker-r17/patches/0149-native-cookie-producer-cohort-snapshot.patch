+constexpr std::optional<uint64_t> NextCheckpointProducerEpoch(
+    std::optional<uint64_t> current) {
+  if (!current || *current == std::numeric_limits<uint64_t>::max()) {
+    return std::nullopt;
+  }
+  return *current + 1;
+}
+
+static_assert(NextCheckpointProducerEpoch(0) == 1);
+static_assert(
+    !NextCheckpointProducerEpoch(std::numeric_limits<uint64_t>::max()));
+static_assert(!NextCheckpointProducerEpoch(std::nullopt));
+
+std::optional<uint64_t> g_checkpoint_producer_epoch = 0;
+
+void AdvanceCheckpointProducerEpoch() {
+  CHECK(Thread::MainThread()->IsCurrentThread());
+  g_checkpoint_producer_epoch =
+      NextCheckpointProducerEpoch(g_checkpoint_producer_epoch);
+}
 
