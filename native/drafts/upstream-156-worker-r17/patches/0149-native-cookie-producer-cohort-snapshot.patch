+TEST_F(DocumentTest, GlintCookieProducerEpochReadIsStable) {
+  auto before = WebDocument::CookieProducerEpochForCheckpoint();
+  ASSERT_TRUE(before);
+  EXPECT_EQ(before, WebDocument::CookieProducerEpochForCheckpoint());
+}
+
+TEST_F(DocumentTest, GlintCookieProducerCreationChangesCohortEpoch) {
+  auto before = WebDocument::CookieProducerEpochForCheckpoint();
+  ASSERT_TRUE(before);
+  auto* jar = MakeGarbageCollected<CookieJar>(&GetDocument());
+  EXPECT_NE(jar, nullptr);
+  auto after = WebDocument::CookieProducerEpochForCheckpoint();
+  ASSERT_TRUE(after);
+  EXPECT_GT(*after, *before);
+}
+
+TEST_F(DocumentTest, GlintCookieProducerRebindChangesCohortEpoch) {
+  auto* jar = MakeGarbageCollected<CookieJar>(&GetDocument());
+  auto before = WebDocument::CookieProducerEpochForCheckpoint();
+  ASSERT_TRUE(before);
+  mojo::PendingRemote<network::mojom::blink::RestrictedCookieManager> remote;
+  auto receiver = remote.InitWithNewPipeAndPassReceiver();
+  jar->SetCookieManager(std::move(remote));
+  auto after = WebDocument::CookieProducerEpochForCheckpoint();
+  ASSERT_TRUE(after);
+  EXPECT_GT(*after, *before);
+}
