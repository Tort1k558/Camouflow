+  auto receiver = remote.InitWithNewPipeAndPassReceiver();
+  GetDocument().SetCookieManager(std::move(remote));
+  EXPECT_TRUE(document.IsCookieProducerAvailableForCheckpoint());
+  receiver.reset();
+  base::RunLoop().RunUntilIdle();
+  EXPECT_FALSE(document.IsCookieProducerAvailableForCheckpoint());
+}
