+#ifndef THIRD_PARTY_BLINK_RENDERER_CORE_LOADER_COOKIE_CHECKPOINT_STATE_H_
+#define THIRD_PARTY_BLINK_RENDERER_CORE_LOADER_COOKIE_CHECKPOINT_STATE_H_
+
+#include <cstddef>
+#include <cstdint>
+#include <limits>
+#include <optional>
+
+namespace camouflow::native {
+
+// Shared write/connection accounting. The transport owner still validates its
+// lifetime, protocol version, connection and absolute deadline before replying.
+class CookieCheckpointState final {
+ public:
+  struct Snapshot {
+    std::uint64_t generation;
+    std::uint64_t epoch;
+    bool operator==(const Snapshot&) const = default;
+  };
+
+  static constexpr std::size_t kMaximumPendingWireRequests = 64;
+
+  constexpr CookieCheckpointState() = default;
+  CookieCheckpointState(const CookieCheckpointState&) = delete;
+  CookieCheckpointState& operator=(const CookieCheckpointState&) = delete;
+
+  constexpr bool IsAvailable() const { return !broken_ && !history_lost_; }
+  constexpr Snapshot Capture() const { return {generation_, epoch_}; }
+  constexpr bool IsCurrent(Snapshot snapshot) const {
+    return IsAvailable() && snapshot == Capture();
+  }
+
+  // Called before sending a write, not after its asynchronous reply.
+  constexpr bool RecordWrite() {
+    if (epoch_ == std::numeric_limits<std::uint64_t>::max()) {
+      broken_ = true;
+      return false;
+    }
+    last_write_epoch_ = ++epoch_;
+    return true;
+  }
+
+  constexpr void InvalidateConnection() {
+    history_lost_ |= last_write_epoch_ > acknowledged_write_epoch_;
+    if (generation_ == std::numeric_limits<std::uint64_t>::max() ||
+        epoch_ == std::numeric_limits<std::uint64_t>::max()) {
+      broken_ = true;
+    } else {
+      ++generation_;
+      ++epoch_;
+    }
+    pending_wire_requests_ = 0;
+  }
+
+  constexpr std::optional<Snapshot> BeginWireRequest() {
+    if (!IsAvailable() ||
+        pending_wire_requests_ >= kMaximumPendingWireRequests) {
+      return std::nullopt;
+    }
+    ++pending_wire_requests_;
+    return Capture();
+  }
+
+  // Only a wire reply or connection retirement releases a slot. A caller's
+  // timeout/cancellation does not cancel the underlying Mojo request.
+  constexpr bool RetireWireRequest(Snapshot snapshot) {
+    if (snapshot.generation != generation_) {
+      return false;
+    }
+    if (pending_wire_requests_ == 0) {
+      broken_ = true;
+      return false;
+    }
+    --pending_wire_requests_;
+    return true;
+  }
+
+  // Invoke only after the owner has validated a successful transport reply and
+  // its final posted-delivery guards. This is not a transport acknowledgment.
+  constexpr bool Acknowledge(Snapshot snapshot) {
+    if (!IsCurrent(snapshot)) {
+      return false;
+    }
+    acknowledged_write_epoch_ = last_write_epoch_;
+    return true;
+  }
+
+  constexpr std::size_t PendingWireRequests() const {
+    return pending_wire_requests_;
+  }
+  constexpr std::uint64_t LastWriteEpoch() const { return last_write_epoch_; }
+  constexpr std::uint64_t AcknowledgedWriteEpoch() const {
+    return acknowledged_write_epoch_;
+  }
+
+ private:
+  friend class CookieCheckpointStateTestPeer;
+
+  std::uint64_t generation_ = 0;
+  std::uint64_t epoch_ = 0;
+  std::uint64_t last_write_epoch_ = 0;
+  std::uint64_t acknowledged_write_epoch_ = 0;
+  std::size_t pending_wire_requests_ = 0;
+  bool history_lost_ = false;
+  bool broken_ = false;
+};
+
+}  // namespace camouflow::native
+
+#endif  // THIRD_PARTY_BLINK_RENDERER_CORE_LOADER_COOKIE_CHECKPOINT_STATE_H_
