+#include "content/renderer/document_cookie_checkpoint.h"
+
+#include <memory>
+#include <utility>
+
+namespace content {
+
+DocumentCookieCheckpoint::Reply::Reply(base::TimeTicks deadline,
+                                       base::OnceCallback<void(bool)> callback)
+    : deadline(deadline), callback(std::move(callback)) {}
+
+DocumentCookieCheckpoint::Reply::~Reply() = default;
+
+DocumentCookieCheckpoint::DocumentCookieCheckpoint(
+    base::TimeTicks deadline,
+    Capture capture,
+    Drain drain,
+    base::OnceCallback<void(bool)> callback)
+    : deadline_(deadline),
+      capture_(std::move(capture)),
+      drain_(std::move(drain)),
+      reply_(std::make_shared<Reply>(deadline, std::move(callback))) {}
+
+DocumentCookieCheckpoint::~DocumentCookieCheckpoint() = default;
+
