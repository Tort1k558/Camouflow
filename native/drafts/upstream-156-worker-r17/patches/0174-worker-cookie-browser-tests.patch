@@ -0,0 +1,53 @@
+// Copyright 2026 CamouFlow contributors.
+// SPDX-License-Identifier: MIT
+
+#include "content/public/test/glint_cookie_checkpoint_test_utils.h"
+
+#include <memory>
+#include <utility>
+
+#include "base/check.h"
+#include "base/functional/bind.h"
+#include "content/browser/camouflow_native/glint/profile_document_commit.h"
+#include "content/browser/service_worker/service_worker_context_wrapper.h"
+#include "content/browser/storage_partition_impl.h"
+#include "content/public/browser/browser_context.h"
+#include "content/public/browser/browser_thread.h"
+#include "content/public/browser/storage_partition.h"
+
+namespace content {
+
+base::ScopedClosureRunner BeginGlintCookiePrefixCommitForTesting(
+    BrowserContext* context,
+    base::TimeTicks deadline,
+    base::OnceCallback<void(GlintCookiePrefixCommitTestResult)> callback) {
+  CHECK_CURRENTLY_ON(BrowserThread::UI);
+  CHECK(callback);
+  size_t running_workers = 0;
+  if (context) {
+    context->ForEachLoadedStoragePartition(
+        [&running_workers](StoragePartition* partition) {
+          auto* workers = static_cast<StoragePartitionImpl*>(partition)
+                              ->GetServiceWorkerContext();
+          if (workers) {
+            running_workers += workers->GetRunningServiceWorkerInfos().size();
+          }
+        });
+  }
+  using Commit = camouflow::native::ProfileDocumentCommit;
+  auto operation = Commit::StartWithScope(
+      context, deadline,
+      base::BindOnce(
+          [](base::OnceCallback<void(GlintCookiePrefixCommitTestResult)> reply,
+             size_t workers, Commit::Result result) {
+            std::move(reply).Run(GlintCookiePrefixCommitTestResult{
+                result.status == Commit::Status::kCommittedDocumentAndWorkerCookiePrefix,
+                workers, static_cast<int>(result.status)});
+          },
+          std::move(callback), running_workers),
+      Commit::Scope::kDocumentsAndWorkerCookies);
+  return base::ScopedClosureRunner(base::BindOnce(
+      [](std::unique_ptr<Commit> pending) { pending.reset(); }, std::move(operation)));
+}
+
+}  // namespace content
