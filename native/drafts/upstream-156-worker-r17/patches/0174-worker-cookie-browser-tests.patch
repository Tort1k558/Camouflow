+// Copyright 2026 CamouFlow contributors.
+// SPDX-License-Identifier: MIT
+
+#ifndef CONTENT_PUBLIC_TEST_GLINT_COOKIE_CHECKPOINT_TEST_UTILS_H_
+#define CONTENT_PUBLIC_TEST_GLINT_COOKIE_CHECKPOINT_TEST_UTILS_H_
+
+#include <cstddef>
+
+#include "base/functional/callback.h"
+#include "base/functional/callback_helpers.h"
+#include "base/time/time.h"
+
+namespace content {
+class BrowserContext;
+
+struct GlintCookiePrefixCommitTestResult {
+  bool committed_prefix;
+  size_t running_workers_observed;
+  int coordinator_status;
+};
+
+// UI only. Calls the real explicit document+worker coordinator, without creating
+// a partition or starting a worker. Keep the returned guard through the callback;
+// destroying it cancels the owned operation. This is not a persistence bypass.
+[[nodiscard]] base::ScopedClosureRunner BeginGlintCookiePrefixCommitForTesting(
+    BrowserContext* context,
+    base::TimeTicks deadline,
+    base::OnceCallback<void(GlintCookiePrefixCommitTestResult)> callback);
+
+}  // namespace content
+
+#endif
