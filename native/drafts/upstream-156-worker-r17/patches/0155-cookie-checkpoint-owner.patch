+struct StoragePartitionImpl::CookieCheckpointRequest {
+  CookieCheckpointRequest(base::TimeTicks expires,
+                          base::OnceCallback<void(bool)> done)
+      : deadline(expires), callback(std::move(done)) {
+    timer.Start(FROM_HERE, expires - base::TimeTicks::Now(),
+                base::BindOnce(&CookieCheckpointRequest::Reject,
+                               base::Unretained(this)));
+  }
+
+  void Reject() {
+    timer.Stop();
+    if (callback) {
+      base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+          FROM_HERE, base::BindOnce(std::move(callback), false));
+    }
+  }
+
+  const base::TimeTicks deadline;
+  base::OnceCallback<void(bool)> callback;
+  base::OneShotTimer timer;
+};
