+class CookieCheckpointOwnerTest : public testing::Test {
+ public:
+  class Backend : public network::TestCookieManager {
+   public:
+    void FlushCookieStoreForCheckpoint(
+        FlushCookieStoreForCheckpointCallback callback) override {
+      replies.push_back(std::move(callback));
+    }
+    void FlushCookieStore(FlushCookieStoreCallback callback) override {
+      ++legacy_flushes;
+    }
+    std::vector<FlushCookieStoreForCheckpointCallback> replies;
+    size_t legacy_flushes = 0;
+  };
+
+  void SetUp() override {
+    partition_ = static_cast<StoragePartitionImpl*>(
+        browser_.GetDefaultStoragePartition());
+    Bind();
+  }
+
+  void TearDown() override {
+    partition_->RejectCookieCheckpoints();
+    partition_->cookie_manager_for_browser_process_.reset();
+    receiver_.reset();
+  }
+
+  void Bind() {
+    partition_->RejectCookieCheckpoints();
+    partition_->cookie_manager_for_browser_process_.reset();
+    receiver_.reset();
+    receiver_.Bind(partition_->cookie_manager_for_browser_process_
+                       .BindNewPipeAndPassReceiver());
+    partition_->cookie_manager_for_browser_process_.set_disconnect_handler(
+        base::BindOnce(
+            &StoragePartitionImpl::RejectCookieCheckpoints,
+            partition_->cookie_checkpoint_weak_factory_.GetWeakPtr()));
+  }
+
+  void Start(base::test::TestFuture<bool>& result) {
+    partition_->FlushCookiesForCheckpoint(
+        base::TimeTicks::Now() + base::Seconds(5), result.GetCallback());
+  }
+  void Reject() { partition_->RejectCookieCheckpoints(); }
+  void QueueSuccessThenRebind() {
+    partition_->OnCookieCheckpointComplete(
+        partition_->next_cookie_checkpoint_id_, true);
+    Bind();
+  }
+  void QueueSuccess() {
+    partition_->OnCookieCheckpointComplete(
+        partition_->next_cookie_checkpoint_id_, true);
+  }
+  void UseMemoryPartition() {
+    partition_ = static_cast<StoragePartitionImpl*>(
+        browser_.GetStoragePartition(StoragePartitionConfig::Create(
+            &browser_, "glint-test", "memory", true)));
+    Bind();
+  }
+  void Shutdown() {
+    partition_->cookie_checkpoint_shutdown_ = true;
+    partition_->RejectCookieCheckpoints();
+  }
+  size_t Slots() { return partition_->cookie_checkpoints_.size(); }
+  void SimulateOldVersion() {
+    partition_->OnCookieCheckpointVersion(
+        partition_->next_cookie_checkpoint_id_, 0);
+  }
+
+ protected:
+  BrowserTaskEnvironment tasks_{
+      base::test::TaskEnvironment::TimeSource::MOCK_TIME};
+  TestBrowserContext browser_;
+  raw_ptr<StoragePartitionImpl> partition_ = nullptr;
+  Backend backend_;
+  mojo::Receiver<network::mojom::CookieManager> receiver_{&backend_};
+};
+
+TEST_F(CookieCheckpointOwnerTest, SuccessIsPostedAfterBackendReply) {
+  base::test::TestFuture<bool> result;
+  Start(result);
+  EXPECT_FALSE(result.IsReady());
+  tasks_.RunUntilIdle();
+  ASSERT_EQ(backend_.replies.size(), 1u);
+  EXPECT_FALSE(result.IsReady());
+  std::move(backend_.replies.front()).Run(true);
+  EXPECT_TRUE(result.Get());
+  EXPECT_EQ(backend_.legacy_flushes, 0u);
+}
+
+TEST_F(CookieCheckpointOwnerTest, BackendFailureNeverFallsBack) {
+  base::test::TestFuture<bool> result;
+  Start(result);
+  tasks_.RunUntilIdle();
+  ASSERT_EQ(backend_.replies.size(), 1u);
+  std::move(backend_.replies.front()).Run(false);
+  EXPECT_FALSE(result.Get());
+  EXPECT_EQ(backend_.legacy_flushes, 0u);
+}
+
+TEST_F(CookieCheckpointOwnerTest, DeadlineRetainsOutstandingWireSlot) {
+  base::test::TestFuture<bool> result;
+  Start(result);
+  tasks_.RunUntilIdle();
+  ASSERT_EQ(backend_.replies.size(), 1u);
+  tasks_.FastForwardBy(base::Seconds(5));
+  EXPECT_FALSE(result.Get());
+  EXPECT_EQ(Slots(), 1u);
+  std::move(backend_.replies.front()).Run(true);
+  tasks_.RunUntilIdle();
+  EXPECT_EQ(Slots(), 0u);
+}
+
+TEST_F(CookieCheckpointOwnerTest, RebindRejectsPendingAndLateReplies) {
+  base::test::TestFuture<bool> old_result;
+  Start(old_result);
+  tasks_.RunUntilIdle();
+  ASSERT_EQ(backend_.replies.size(), 1u);
+  Bind();
+  EXPECT_FALSE(old_result.Get());
+  std::move(backend_.replies.front()).Run(true);
+  tasks_.RunUntilIdle();
+  EXPECT_EQ(Slots(), 0u);
+  base::test::TestFuture<bool> fresh;
+  Start(fresh);
+  tasks_.RunUntilIdle();
+  ASSERT_EQ(backend_.replies.size(), 2u);
+  std::move(backend_.replies.back()).Run(true);
+  EXPECT_TRUE(fresh.Get());
+}
