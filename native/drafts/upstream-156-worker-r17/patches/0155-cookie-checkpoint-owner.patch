+void StoragePartitionImpl::RejectCookieCheckpoints() {
+  DCHECK_CURRENTLY_ON(BrowserThread::UI);
+  cookie_checkpoint_weak_factory_.InvalidateWeakPtrs();
+  for (auto& [id, request] : cookie_checkpoints_) {
+    request->Reject();
+  }
+  cookie_checkpoints_.clear();
+}
+
+void StoragePartitionImpl::FlushCookiesForCheckpoint(
+    base::TimeTicks deadline,
+    base::OnceCallback<void(bool)> callback) {
+  DCHECK_CURRENTLY_ON(BrowserThread::UI);
+  CHECK(callback);
+  if (cookie_checkpoint_shutdown_ || !browser_context_ ||
+      browser_context_->ShutdownStarted() ||
+      browser_context_->IsOffTheRecord() || config_.in_memory() ||
+      deadline.is_max() || deadline <= base::TimeTicks::Now() ||
+      !cookie_manager_for_browser_process_.is_bound() ||
+      !cookie_manager_for_browser_process_.is_connected() ||
+      cookie_checkpoints_.size() >= 64 ||
+      next_cookie_checkpoint_id_ == std::numeric_limits<uint64_t>::max()) {
+    base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE, base::BindOnce(std::move(callback), false));
+    return;
+  }
+  const uint64_t id = ++next_cookie_checkpoint_id_;
+  cookie_checkpoints_.emplace(id, std::make_unique<CookieCheckpointRequest>(
+                                      deadline, std::move(callback)));
+  cookie_manager_for_browser_process_.QueryVersion(
+      base::BindOnce(&StoragePartitionImpl::OnCookieCheckpointVersion,
+                     cookie_checkpoint_weak_factory_.GetWeakPtr(), id));
+}
+
+void StoragePartitionImpl::OnCookieCheckpointVersion(uint64_t id,
+                                                     uint32_t version) {
+  DCHECK_CURRENTLY_ON(BrowserThread::UI);
+  const auto it = cookie_checkpoints_.find(id);
+  if (it == cookie_checkpoints_.end()) {
+    return;
+  }
+  if (version < 1 || !it->second->callback ||
+      base::TimeTicks::Now() >= it->second->deadline ||
+      !cookie_manager_for_browser_process_.is_connected()) {
+    OnCookieCheckpointComplete(id, false);
+    return;
+  }
+  cookie_manager_for_browser_process_->FlushCookieStoreForCheckpoint(
+      base::BindOnce(&StoragePartitionImpl::OnCookieCheckpointComplete,
+                     cookie_checkpoint_weak_factory_.GetWeakPtr(), id));
+}
+
+void StoragePartitionImpl::OnCookieCheckpointComplete(uint64_t id,
+                                                      bool success) {
+  DCHECK_CURRENTLY_ON(BrowserThread::UI);
+  const auto it = cookie_checkpoints_.find(id);
+  if (it == cookie_checkpoints_.end()) {
+    return;
+  }
+  it->second->timer.Stop();
+  if (it->second->callback) {
+    base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE,
+        base::BindOnce(
+            [](base::WeakPtr<StoragePartitionImpl> owner, bool success,
+               base::TimeTicks deadline,
+               base::OnceCallback<void(bool)> callback) {
+              std::move(callback).Run(
+                  success && base::TimeTicks::Now() < deadline && owner &&
+                  !owner->cookie_checkpoint_shutdown_ &&
+                  owner->browser_context_ &&
+                  !owner->browser_context_->ShutdownStarted() &&
+                  owner->cookie_manager_for_browser_process_.is_connected());
+            },
+            cookie_checkpoint_weak_factory_.GetWeakPtr(), success,
+            it->second->deadline, std::move(it->second->callback)));
+  }
+  cookie_checkpoints_.erase(it);
 }
 
