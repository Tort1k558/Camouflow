+struct CookieStore::CheckpointReply {
+  CheckpointReply(base::TimeTicks deadline, base::OnceCallback<void(bool)> done)
+      : deadline(deadline), callback(std::move(done)) {}
+
+  static void Complete(std::shared_ptr<CheckpointReply> reply, bool success) {
+    if (reply->callback) {
+      std::move(reply->callback)
+          .Run(success && base::TimeTicks::Now() < reply->deadline);
+    }
+  }
+
+  const base::TimeTicks deadline;
+  base::OnceCallback<void(bool)> callback;
+};
+
+std::optional<CookieStore::CheckpointSnapshot>
+CookieStore::CaptureWritesForCheckpoint() const {
+  auto* context = GetExecutionContext();
+  if (!context || context->IsContextDestroyed() ||
+      !checkpoint_state_.IsAvailable() || !backend_.is_bound() ||
+      !backend_.is_connected()) {
+    return std::nullopt;
+  }
+  return checkpoint_state_.Capture();
+}
+
+void CookieStore::NotifyCheckpointMutation() {
+  auto* context = GetExecutionContext();
+  if (context && context->IsWindow()) {
+    CookieJar::NoteExternalCookieProducerMutationForCheckpoint();
+  }
+}
+
+void CookieStore::MarkCheckpointCookieWrite() {
+  NotifyCheckpointMutation();
+  checkpoint_state_.RecordWrite();
+}
+
+void CookieStore::OnCheckpointBackendDisconnect() {
+  NotifyCheckpointMutation();
+  checkpoint_state_.InvalidateConnection();
+}
+
+void CookieStore::DrainWritesForCheckpoint(
+    base::TimeTicks deadline,
+    base::OnceCallback<void(bool)> callback) {
+  CHECK(callback);
+  const auto now = base::TimeTicks::Now();
+  auto reply = std::make_shared<CheckpointReply>(deadline, std::move(callback));
+  auto runner = base::SequencedTaskRunner::GetCurrentDefault();
+  if (deadline <= now || deadline > now + base::Seconds(30) ||
+      !CaptureWritesForCheckpoint().has_value() ||
+      checkpoint_state_.PendingWireRequests() >=
+          camouflow::native::CookieCheckpointState::kMaximumPendingWireRequests) {
+    runner->PostTask(FROM_HERE,
+                     base::BindOnce(&CheckpointReply::Complete, reply, false));
+    return;
+  }
+  // Independent of Oilpan owner lifetime and of whether Mojo drops its reply.
+  runner->PostDelayedTask(
+      FROM_HERE, base::BindOnce(&CheckpointReply::Complete, reply, false),
+      deadline - now);
+  const auto snapshot = checkpoint_state_.Capture();
+  const auto generation = snapshot.generation;
+  const auto epoch = snapshot.epoch;
+  if (!backend_.is_connected()) {
+    runner->PostTask(FROM_HERE,
+                     base::BindOnce(&CheckpointReply::Complete, reply, false));
+    return;
+  }
+  if (!checkpoint_state_.BeginWireRequest()) {
+    runner->PostTask(FROM_HERE,
+                     base::BindOnce(&CheckpointReply::Complete, reply, false));
+    return;
+  }
+  backend_.QueryVersion(BindOnce(&CookieStore::OnCheckpointVersion,
+                                 WrapWeakPersistent(this), reply, generation,
+                                 epoch));
+}
+
+void CookieStore::OnCheckpointVersion(std::shared_ptr<CheckpointReply> reply,
+                                    uint64_t generation,
+                                    uint64_t epoch,
+                                    uint32_t version) {
+  if (!CaptureWritesForCheckpoint().has_value() || version < 1 ||
+      camouflow::native::CookieCheckpointState::Snapshot{generation, epoch} !=
+          checkpoint_state_.Capture() || !reply->callback ||
+      base::TimeTicks::Now() >= reply->deadline || !backend_.is_bound() ||
+      !backend_.is_connected()) {
+    OnCheckpointWireReply(std::move(reply), generation, epoch, false);
+    return;
+  }
+  backend_->DrainCookieWritesForCheckpoint(
+      BindOnce(&CookieStore::OnCheckpointWireReply, WrapWeakPersistent(this),
+               std::move(reply), generation, epoch));
+}
+
+void CookieStore::OnCheckpointWireReply(std::shared_ptr<CheckpointReply> reply,
+                                      uint64_t generation,
+                                      uint64_t epoch,
+                                      bool success) {
+  checkpoint_state_.RetireWireRequest({generation, epoch});
+  base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE,
+      BindOnce(&CookieStore::DeliverCheckpointReply, WrapWeakPersistent(this),
+               std::move(reply), generation, epoch, success));
+}
+
+void CookieStore::DeliverCheckpointReply(std::shared_ptr<CheckpointReply> reply,
+                                       uint64_t generation,
+                                       uint64_t epoch,
+                                       bool success) {
+  success = success && checkpoint_state_.IsCurrent({generation, epoch}) &&
+            CaptureWritesForCheckpoint().has_value() &&
+            base::TimeTicks::Now() < reply->deadline;
+  if (success && reply->callback) {
+    success = checkpoint_state_.Acknowledge({generation, epoch});
+  }
+  CheckpointReply::Complete(std::move(reply), success);
+}
