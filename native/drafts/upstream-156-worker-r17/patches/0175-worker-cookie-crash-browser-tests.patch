+// This PRE body intentionally never completes as a gtest PASS. Only the explicit
+// acknowledged-crash controller may qualify its forced termination, and recovery
+// must then pass in a distinct process using the same fresh owned profile.
+IN_PROC_BROWSER_TEST_F(GlintCookiePrefixBrowserTest, PRE_CrashAfterAcknowledgedPrefix) {
+  const auto challenge = base::CommandLine::ForCurrentProcess()->GetSwitchValueASCII(
+      "glint-crash-challenge");
+  ASSERT_EQ(challenge.size(), 64u);
+  ASSERT_EQ(true, content::EvalJs(Contents(), kWriteWindowCookies));
+  ASSERT_EQ(true, content::EvalJs(Contents(), kWriteWorkerCookie));
+  ASSERT_EQ(true, content::EvalJs(Contents(), content::JsReplace(R"JS(
+    (async () => {
+      await cookieStore.set({name: 'glint_crash_nonce', value: $1, path: '/',
+        sameSite: 'lax', expires: Date.now() + 3600000});
+      return true;
+    })()
+  )JS", challenge)));
+  const auto result = CommitCookies();
+  ASSERT_GE(result.running_workers_observed, 1u);
+  ASSERT_TRUE(result.committed_prefix) << "coordinator status=" << result.coordinator_status;
+  ASSERT_EQ(true, content::EvalJs(Contents(), kAllCookiesPresent));
+  ASSERT_TRUE(WriteCrashAcknowledgment(result));
+  base::RunLoop wait_for_owned_parent_termination;
+  wait_for_owned_parent_termination.Run();
+  ADD_FAILURE() << "Intentional crash phase unexpectedly resumed instead of being terminated";
+}
+
+IN_PROC_BROWSER_TEST_F(GlintCookiePrefixBrowserTest, CrashAfterAcknowledgedPrefix) {
+  const auto challenge = base::CommandLine::ForCurrentProcess()->GetSwitchValueASCII(
+      "glint-crash-challenge");
+  ASSERT_EQ(challenge.size(), 64u);
+  ASSERT_EQ(true, content::EvalJs(Contents(), kAllCookiesPresent));
+  EXPECT_EQ(true, content::EvalJs(Contents(), content::JsReplace(R"JS(
+    (async () => {
+      const cookie = await cookieStore.get('glint_crash_nonce');
+      return cookie !== null && cookie.value === $1;
+    })()
+  )JS", challenge)));
+}
