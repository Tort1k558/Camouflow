+  bool WriteCrashAcknowledgment(
+      const content::GlintCookiePrefixCommitTestResult& result) {
+    const auto* command = base::CommandLine::ForCurrentProcess();
+    const auto challenge = command->GetSwitchValueASCII("glint-crash-challenge");
+    const auto destination = command->GetSwitchValuePath("glint-crash-ack");
+    base::FilePath user_data;
+    if (!result.committed_prefix || result.running_workers_observed == 0 ||
+        result.running_workers_observed > 512 || challenge.size() != 64 ||
+        !std::all_of(challenge.begin(), challenge.end(), [](char ch) {
+          return (ch >= '0' && ch <= '9') || (ch >= 'a' && ch <= 'f');
+        }) || !destination.IsAbsolute() || destination.ReferencesParent() ||
+        destination.BaseName().MaybeAsASCII() != "ack.json" ||
+        !base::PathService::Get(chrome::DIR_USER_DATA, &user_data) ||
+        destination.DirName() != user_data.DirName()) {
+      return false;
+    }
+    base::ScopedAllowBlockingForTesting allow_blocking;
+    base::DictValue payload;
+    payload.Set("schema", 1);
+    payload.Set("challenge", challenge);
+    payload.Set("pid", static_cast<int>(base::GetCurrentProcId()));
+    payload.Set("profile", user_data.AsUTF8Unsafe());
+    payload.Set("acknowledged", true);
+    payload.Set("workers", static_cast<int>(result.running_workers_observed));
+    payload.Set("scope", "document-and-worker-cookie-prefix");
+    std::string encoded;
+    if (!base::JSONWriter::Write(payload, &encoded)) {
+      return false;
+    }
+    const auto temporary = destination.AddExtensionASCII("tmp");
+    {
+      base::File file(temporary, base::File::FLAG_CREATE | base::File::FLAG_WRITE);
+      if (!file.IsValid() || !file.WriteAtCurrentPosAndCheck(base::as_byte_span(encoded))) {
+        return false;
+      }
+    }
+    // Receipt visibility is a control signal, not a disk-durability claim. Do
+    // not flush or shut down browser state before the parent forces termination.
+    return !base::PathExists(destination) && base::Move(temporary, destination);
+  }
+
   net::EmbeddedTestServer https_{net::EmbeddedTestServer::TYPE_HTTPS};
