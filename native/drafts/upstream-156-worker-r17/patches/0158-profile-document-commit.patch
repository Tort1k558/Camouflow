+++ b/content/browser/camouflow_native/glint/profile_document_commit.cc
@@ -0,0 +1,215 @@
+// Copyright 2026 CamouFlow contributors.
+// SPDX-License-Identifier: MIT
+
+#include "content/browser/camouflow_native/glint/profile_document_commit.h"
+
+#include <utility>
+
+#include "base/check.h"
+#include "base/check_op.h"
+#include "base/task/bind_post_task.h"
+#include "base/task/sequenced_task_runner.h"
+#include "content/browser/camouflow_native/glint/profile_producer_fence.h"
+#include "content/browser/dom_storage/dom_storage_context_wrapper.h"
+#include "content/browser/storage_partition_impl.h"
+#include "content/public/browser/browser_context.h"
+#include "content/public/browser/browser_thread.h"
+#include "content/public/browser/storage_partition.h"
+#include "mojo/public/cpp/bindings/callback_helpers.h"
+
+namespace camouflow::native {
+
+std::unique_ptr<ProfileDocumentCommit> ProfileDocumentCommit::Start(
+    content::BrowserContext* context,
+    base::TimeTicks deadline,
+    Callback callback) {
+  CHECK_CURRENTLY_ON(content::BrowserThread::UI);
+  CHECK(callback);
+  auto operation = std::unique_ptr<ProfileDocumentCommit>(
+      new ProfileDocumentCommit(context, deadline, std::move(callback)));
+  operation->Begin();
+  return operation;
+}
+
+ProfileDocumentCommit::ProfileDocumentCommit(content::BrowserContext* context,
+                                             base::TimeTicks deadline,
+                                             Callback callback)
+    : context_(context ? context->GetWeakPtr()
+                       : base::WeakPtr<content::BrowserContext>()),
+      deadline_(deadline),
+      callback_(std::move(callback)) {}
+
+ProfileDocumentCommit::~ProfileDocumentCommit() {
+  CHECK_CURRENTLY_ON(content::BrowserThread::UI);
+  weak_factory_.InvalidateWeakPtrs();
+  timer_.Stop();
+  producers_.reset();
+  if (callback_) {
+    base::BindPostTaskToCurrentDefault(std::move(callback_))
+        .Run(Result{Status::kCancelled, partitions_.size()});
+  }
+}
+
+void ProfileDocumentCommit::Begin() {
+  if (!context_ || context_->ShutdownStarted()) {
+    Finish(Status::kOwnerGone);
+    return;
+  }
+  if (context_->IsOffTheRecord()) {
+    Finish(Status::kInvalidScope);
+    return;
+  }
+  if (deadline_.is_max() || deadline_ <= base::TimeTicks::Now()) {
+    Finish(Status::kTimedOut);
+    return;
+  }
+  if (context_->GetLoadedStoragePartitionCount() > kMaxPartitions) {
+    Finish(Status::kTooManyPartitions);
+    return;
+  }
+  bool valid = true;
+  context_->ForEachLoadedStoragePartition(
+      [this, &valid](content::StoragePartition* partition) {
+        valid &= !partition->GetConfig().in_memory();
+        partitions_.push_back(PartitionLease{
+            static_cast<content::StoragePartitionImpl*>(partition)
+                ->GetWeakPtr(),
+            {},
+            {}});
+      });
+  if (!valid) {
+    Finish(Status::kInvalidScope);
+    return;
+  }
+  if (partitions_.empty()) {
+    Finish(Status::kNoPersistentPartitions);
+    return;
+  }
+  for (auto& lease : partitions_) {
+    if (!lease.partition || !lease.partition->GetDOMStorageContext()) {
+      Finish(Status::kNotReady);
+      return;
+    }
+    lease.cookie_owner = lease.partition->GetCookieCheckpointOwner();
+    lease.local_storage_owner = lease.partition->GetDOMStorageContext()
+                                    ->GetLocalStorageCheckpointOwner();
+    if (!lease.cookie_owner || !lease.local_storage_owner) {
+      Finish(Status::kNotReady);
+      return;
+    }
+  }
+  timer_.Start(FROM_HERE, deadline_ - base::TimeTicks::Now(),
+               base::BindOnce(&ProfileDocumentCommit::Finish,
+                              weak_factory_.GetWeakPtr(), Status::kTimedOut));
+  producers_ = ProfileProducerFence::Start(
+      context_.get(), deadline_,
+      base::BindOnce(
+          [](base::WeakPtr<ProfileDocumentCommit> operation,
+             ProfileProducerFence::Result result) {
+            if (operation) {
+              operation->ProducersReplied(
+                  result.status == ProfileProducerFence::Status::kAcknowledged);
+            }
+          },
+          weak_factory_.GetWeakPtr()),
+      ProfileProducerFence::ProducerScope::kDocumentStorage,
+      /*retain_cohort=*/true);
+}
+
+ProfileDocumentCommit::Status ProfileDocumentCommit::Revalidate() {
+  if (!context_ || context_->ShutdownStarted()) {
+    return Status::kOwnerGone;
+  }
+  if (context_->IsOffTheRecord()) {
+    return Status::kInvalidScope;
+  }
+  if (base::TimeTicks::Now() >= deadline_) {
+    return Status::kTimedOut;
+  }
+  if (!producers_ || producers_->CheckRetainedCohort() !=
+                         ProfileProducerFence::Status::kAcknowledged) {
+    return Status::kTopologyChanged;
+  }
+  for (const auto& lease : partitions_) {
+    if (!lease.partition || !lease.cookie_owner || !lease.local_storage_owner) {
+      return Status::kOwnerGone;
+    }
+    if (!lease.partition->GetCookieCheckpointOwner() ||
+        !lease.local_storage_owner->GetLocalStorageCheckpointOwner()) {
+      return Status::kNotReady;
+    }
+  }
+  return Status::kCommittedDocumentPrefix;
+}
+
+void ProfileDocumentCommit::ProducersReplied(bool success) {
+  if (completion_queued_) {
+    return;
+  }
+  if (!success) {
+    Finish(Status::kProducerRejected);
+    return;
+  }
+  const auto status = Revalidate();
+  if (status != Status::kCommittedDocumentPrefix) {
+    Finish(status);
+    return;
+  }
+  remaining_ = partitions_.size() * 2;
+  for (const auto& lease : partitions_) {
+    if (!lease.partition || !lease.cookie_owner || !lease.local_storage_owner) {
+      Finish(Status::kNotReady);
+      return;
+    }
+    auto reply = [this]() {
+      return mojo::WrapCallbackWithDefaultInvokeIfNotRun(
+          base::BindPostTaskToCurrentDefault(
+              base::BindOnce(&ProfileDocumentCommit::BackendReplied,
+                             weak_factory_.GetWeakPtr())),
+          false);
+    };
+    lease.cookie_owner->FlushCookiesForCheckpoint(deadline_, reply());
+    lease.local_storage_owner->FlushLocalStorageForCheckpoint(reply());
+  }
+}
+
+void ProfileDocumentCommit::BackendReplied(bool success) {
+  if (completion_queued_) {
+    return;
+  }
+  CHECK_GT(remaining_, 0u);
+  if (!success) {
+    Finish(Status::kBackendRejected);
+    return;
+  }
+  if (--remaining_ == 0) {
+    Finish(Status::kCommittedDocumentPrefix);
+  }
+}
+
+void ProfileDocumentCommit::Finish(Status status) {
+  if (completion_queued_ || !callback_) {
+    return;
+  }
+  completion_queued_ = true;
+  timer_.Stop();
+  base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, base::BindOnce(&ProfileDocumentCommit::Deliver,
+                                weak_factory_.GetWeakPtr(), status));
+}
+
+void ProfileDocumentCommit::Deliver(Status status) {
+  if (!context_ || context_->ShutdownStarted()) {
+    status = Status::kOwnerGone;
+  } else if (status == Status::kCommittedDocumentPrefix) {
+    status = Revalidate();
+  }
+  auto callback = std::move(callback_);
+  const auto partition_count = partitions_.size();
+  // Keep the acknowledged producer cohort observed until the final validation;
+  // do not let asynchronous backend work authorize success after topology loss.
+  producers_.reset();
+  std::move(callback).Run(Result{status, partition_count});
+}
+
+}  // namespace camouflow::native
