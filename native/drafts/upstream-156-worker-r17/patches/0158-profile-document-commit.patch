+// Copyright 2026 CamouFlow contributors.
+// SPDX-License-Identifier: MIT
+
+#ifndef CONTENT_BROWSER_CAMOUFLOW_NATIVE_GLINT_PROFILE_DOCUMENT_COMMIT_H_
+#define CONTENT_BROWSER_CAMOUFLOW_NATIVE_GLINT_PROFILE_DOCUMENT_COMMIT_H_
+
+#include <cstddef>
+#include <memory>
+#include <vector>
+
+#include "base/functional/callback.h"
+#include "base/memory/weak_ptr.h"
+#include "base/time/time.h"
+#include "base/timer/timer.h"
+#include "content/common/content_export.h"
+
+namespace content {
+class BrowserContext;
+class DOMStorageContextWrapper;
+class StoragePartitionImpl;
+}  // namespace content
+
+namespace camouflow::native {
+
+class ProfileProducerFence;
+
+// A document-producer prefix followed by cookie/localStorage store commits.
+// NOT an atomic profile snapshot: no mutation freeze or worker/HTTP/IDB/cache
+// fencing, session-restore guarantee or power-loss durability is implied.
+class CONTENT_EXPORT ProfileDocumentCommit final {
+ public:
+  enum class Status {
+    kCommittedDocumentPrefix,
+    kInvalidScope,
+    kNoPersistentPartitions,
+    kTooManyPartitions,
+    kNotReady,
+    kProducerRejected,
+    kBackendRejected,
+    kTopologyChanged,
+    kTimedOut,
+    kOwnerGone,
+    kCancelled,
+  };
+
+  struct Result {
+    Status status;
+    size_t loaded_partition_count;
+  };
+  using Callback = base::OnceCallback<void(Result)>;
+
+  // UI only; never creates a partition or starts/restarts a service. Retain
+  // until posted completion. Destruction posts cancellation for a pending call.
+  static std::unique_ptr<ProfileDocumentCommit> Start(
+      content::BrowserContext* context,
+      base::TimeTicks deadline,
+      Callback callback);
+  ~ProfileDocumentCommit();
+
+  ProfileDocumentCommit(const ProfileDocumentCommit&) = delete;
+  ProfileDocumentCommit& operator=(const ProfileDocumentCommit&) = delete;
+
+ private:
+  static constexpr size_t kMaxPartitions = 128;
+
+  struct PartitionLease {
+    base::WeakPtr<content::StoragePartitionImpl> partition;
+    base::WeakPtr<content::StoragePartitionImpl> cookie_owner;
+    base::WeakPtr<content::DOMStorageContextWrapper> local_storage_owner;
+  };
+
+  ProfileDocumentCommit(content::BrowserContext* context,
+                        base::TimeTicks deadline,
+                        Callback callback);
+  void Begin();
+  void ProducersReplied(bool success);
+  void BackendReplied(bool success);
+  Status Revalidate();
+  void Finish(Status status);
+  void Deliver(Status status);
+
+  base::WeakPtr<content::BrowserContext> context_;
+  const base::TimeTicks deadline_;
+  Callback callback_;
+  std::vector<PartitionLease> partitions_;
+  std::unique_ptr<ProfileProducerFence> producers_;
+  size_t remaining_ = 0;
+  bool completion_queued_ = false;
+  base::OneShotTimer timer_;
+  base::WeakPtrFactory<ProfileDocumentCommit> weak_factory_{this};
+};
+
+}  // namespace camouflow::native
+
+#endif
