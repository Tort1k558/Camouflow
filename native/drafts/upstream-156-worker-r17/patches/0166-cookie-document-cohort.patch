 void Document::DrainCookieWritesForCheckpoint(
     base::TimeTicks deadline,
     base::OnceCallback<void(bool)> callback) {
   CHECK(callback);
-  if (!IsActive() || !GetFrame() || !cookie_jar_) {
-    base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
-        FROM_HERE, base::BindOnce(std::move(callback), false));
-    return;
+  auto runner = base::SequencedTaskRunner::GetCurrentDefault();
+  const auto now = base::TimeTicks::Now();
+  const auto epoch = CookieJar::CheckpointProducerEpoch();
+  if (now >= deadline || deadline > now + base::Seconds(30) || !epoch ||
+      !IsCookieProducerAvailableForCheckpoint()) {
+    runner->PostTask(FROM_HERE, base::BindOnce(std::move(callback), false));
+    return;
+  }
+  auto* context = GetExecutionContext();
+  auto* participant = CookieCheckpointParticipant::GetIfExists(*context);
+  const auto snapshot = participant ? participant->CaptureWritesForCheckpoint()
+                                    : std::nullopt;
+  if (participant && !snapshot) {
+    runner->PostTask(FROM_HERE, base::BindOnce(std::move(callback), false));
+    return;
+  }
+
+  // Neither the timeout nor final delivery depends on a surviving Oilpan owner.
+  struct Reply {
+    explicit Reply(base::OnceCallback<void(bool)> completion)
+        : callback(std::move(completion)) {}
+    void Complete(bool success) {
+      if (callback) {
+        std::move(callback).Run(success);
+      }
+    }
+    base::OnceCallback<void(bool)> callback;
+    size_t remaining = 0;
+    bool success = true;
+  };
+  auto reply = std::make_shared<Reply>(std::move(callback));
+  reply->remaining = participant ? 2 : 1;
+  runner->PostDelayedTask(
+      FROM_HERE,
+      base::BindOnce([](std::shared_ptr<Reply> pending) { pending->Complete(false); },
+                     reply),
+      deadline - base::TimeTicks::Now());
+
+  auto validate =
+      [document = WeakPersistent<Document>(this),
+       jar = WeakPersistent<CookieJar>(cookie_jar_.Get()),
+       owner = WeakPersistent<ExecutionContext>(context),
+       producer = WeakPersistent<CookieCheckpointParticipant>(participant),
+       expected_epoch = *epoch, snapshot, deadline]() {
+        if (base::TimeTicks::Now() >= deadline || !document || !jar || !owner ||
+            owner->IsContextDestroyed() || !document->IsActive() ||
+            !document->GetFrame() || document->GetExecutionContext() != owner.Get() ||
+            document->cookie_jar_.Get() != jar.Get() ||
+            !jar->IsCheckpointProducerAvailable() ||
+            CookieJar::CheckpointProducerEpoch() != expected_epoch) {
+          return false;
+        }
+        auto* current = CookieCheckpointParticipant::GetIfExists(*owner);
+        if (current != producer.Get()) {
+          return false;
+        }
+        if (!snapshot) {
+          return !current;
+        }
+        return current && current->IsRegisteredForCheckpoint() &&
+               current->CaptureWritesForCheckpoint() == snapshot;
+      };
+  auto complete = [reply, runner, validate](bool success) {
+    if (!reply->callback || !reply->remaining) {
+      return;
+    }
+    reply->success = reply->success && success;
+    if (--reply->remaining != 0) {
+      return;
+    }
+    runner->PostTask(FROM_HERE, base::BindOnce(
+        [reply, validate]() { reply->Complete(reply->success && validate()); }));
+  };
+  cookie_jar_->DrainWritesForCheckpoint(deadline, base::BindOnce(complete));
+  if (participant) {
