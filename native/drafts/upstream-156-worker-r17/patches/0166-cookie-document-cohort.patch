+namespace blink {
+namespace {
+
+// A held second producer tests aggregation, not CookieStore's Mojo transport.
+class HeldCookieParticipant final
+    : public GarbageCollected<HeldCookieParticipant>,
+      public CookieCheckpointParticipant {
+ public:
+  explicit HeldCookieParticipant(ExecutionContext& context)
+      : CookieCheckpointParticipant(context) {}
+  bool Register() { return RegisterForCheckpoint(); }
+  std::optional<Snapshot> CaptureWritesForCheckpoint() const override {
+    if (!available_ || !IsRegisteredForCheckpoint()) {
+      return std::nullopt;
+    }
+    return Snapshot{1, epoch_};
+  }
+  void DrainWritesForCheckpoint(base::TimeTicks deadline,
+                                base::OnceCallback<void(bool)> callback) override {
+    EXPECT_FALSE(callback_);
+    deadline_ = deadline;
+    callback_ = std::move(callback);
+  }
+  void Reply(bool success) {
+    ASSERT_TRUE(callback_);
+    std::move(callback_).Run(success);
+  }
+  void Write() {
+    ++epoch_;
+    CookieJar::NoteExternalCookieProducerMutationForCheckpoint();
+  }
+  void Disconnect() {
+    available_ = false;
+    CookieJar::NoteExternalCookieProducerMutationForCheckpoint();
+  }
+  base::TimeTicks Deadline() const { return deadline_; }
+
+ private:
+  uint64_t epoch_ = 0;
+  bool available_ = true;
+  base::TimeTicks deadline_;
+  base::OnceCallback<void(bool)> callback_;
+};
+
+class DocumentCookieCohortTest : public PageTestBase {
+ public:
+  DocumentCookieCohortTest()
+      : PageTestBase(base::test::TaskEnvironment::TimeSource::MOCK_TIME) {}
+
+ protected:
+  HeldCookieParticipant* CreateParticipant() {
+    auto* participant = MakeGarbageCollected<HeldCookieParticipant>(
+        *GetDocument().GetExecutionContext());
+    EXPECT_TRUE(participant->Register());
+    return participant;
+  }
+  base::TimeTicks Deadline() { return base::TimeTicks::Now() + base::Seconds(5); }
+};
+
+TEST_F(DocumentCookieCohortTest, UnusedModuleIsNotCreated) {
+  base::test::TestFuture<bool> done;
+  GetDocument().DrainCookieWritesForCheckpoint(Deadline(), done.GetCallback());
+  EXPECT_FALSE(done.IsReady());
+  EXPECT_TRUE(done.Get());
+  EXPECT_EQ(CookieCheckpointParticipant::GetIfExists(
+                *GetDocument().GetExecutionContext()), nullptr);
+}
+
+TEST_F(DocumentCookieCohortTest, FirstPipeCannotAuthorizeTheHeldSecondPipe) {
+  Persistent<HeldCookieParticipant> participant = CreateParticipant();
+  const auto deadline = Deadline();
+  base::test::TestFuture<bool> done;
+  GetDocument().DrainCookieWritesForCheckpoint(deadline, done.GetCallback());
+  task_environment().RunUntilIdle();
+  EXPECT_FALSE(done.IsReady());
+  EXPECT_EQ(participant->Deadline(), deadline);
+  participant->Reply(true);
+  EXPECT_FALSE(done.IsReady());
+  EXPECT_TRUE(done.Get());
+}
+
+TEST_F(DocumentCookieCohortTest, SecondPipeFailureRejectsTheCohort) {
+  Persistent<HeldCookieParticipant> participant = CreateParticipant();
+  base::test::TestFuture<bool> done;
+  GetDocument().DrainCookieWritesForCheckpoint(Deadline(), done.GetCallback());
+  participant->Reply(false);
+  EXPECT_FALSE(done.Get());
+}
+
+TEST_F(DocumentCookieCohortTest, MutationBeforeFinalDeliveryRejectsOldSuccess) {
+  Persistent<HeldCookieParticipant> participant = CreateParticipant();
+  base::test::TestFuture<bool> done;
+  GetDocument().DrainCookieWritesForCheckpoint(Deadline(), done.GetCallback());
+  task_environment().RunUntilIdle();
+  participant->Reply(true);
+  participant->Write();
+  EXPECT_FALSE(done.Get());
+}
+
+TEST_F(DocumentCookieCohortTest, LateRegistrationRejectsAnEmptyProducerSnapshot) {
+  base::test::TestFuture<bool> done;
+  GetDocument().DrainCookieWritesForCheckpoint(Deadline(), done.GetCallback());
+  Persistent<HeldCookieParticipant> participant = CreateParticipant();
+  EXPECT_FALSE(done.Get());
+}
+
+TEST_F(DocumentCookieCohortTest, DuplicateRegistrationPoisonsTheCapturedProducer) {
+  Persistent<HeldCookieParticipant> participant = CreateParticipant();
+  base::test::TestFuture<bool> done;
+  GetDocument().DrainCookieWritesForCheckpoint(Deadline(), done.GetCallback());
+  auto* duplicate = MakeGarbageCollected<HeldCookieParticipant>(
+      *GetDocument().GetExecutionContext());
+  EXPECT_FALSE(duplicate->Register());
+  participant->Reply(true);
+  EXPECT_FALSE(done.Get());
+}
+
+TEST_F(DocumentCookieCohortTest, DisconnectBeforeFinalDeliveryRejectsSuccess) {
+  Persistent<HeldCookieParticipant> participant = CreateParticipant();
+  base::test::TestFuture<bool> done;
+  GetDocument().DrainCookieWritesForCheckpoint(Deadline(), done.GetCallback());
+  task_environment().RunUntilIdle();
+  participant->Reply(true);
+  participant->Disconnect();
+  EXPECT_FALSE(done.Get());
+}
+
+TEST_F(DocumentCookieCohortTest, TimeoutDeliversOnceEvenWhenTheSecondReplyIsLate) {
+  Persistent<HeldCookieParticipant> participant = CreateParticipant();
+  base::test::TestFuture<bool> done;
+  GetDocument().DrainCookieWritesForCheckpoint(Deadline(), done.GetCallback());
+  task_environment().FastForwardBy(base::Seconds(5));
+  ASSERT_TRUE(done.IsReady());
+  EXPECT_FALSE(done.Get());
+  participant->Reply(true);
+  task_environment().RunUntilIdle();
+}
