+base::expected<SkBitmap, CanvasCopyError> TransformOwnedCanvasCopy(
+    SkBitmap owned,
+    const std::array<uint8_t, 32>& partition_seed,
+    bool source_is_opaque) {
+  const auto bytes = CanvasCopyBytes(owned.pixmap());
+  if (!bytes.has_value()) {
+    return base::unexpected(bytes.error());
+  }
+  const bool half = owned.colorType() == kRGBA_F16_SkColorType;
+  if ((!half && owned.colorType() != kRGBA_8888_SkColorType) ||
+      (owned.alphaType() != kUnpremul_SkAlphaType &&
+       owned.alphaType() != kOpaque_SkAlphaType)) {
+    return base::unexpected(CanvasCopyError::kUnsupportedFormat);
+  }
+  const auto* pixels = owned.pixelRef();
+  if (!pixels || !pixels->unique() || owned.isImmutable() ||
+      pixels->pixels() != owned.getPixels() ||
+      pixels->width() != owned.width() || pixels->height() != owned.height() ||
+      pixels->rowBytes() != owned.rowBytes() ||
+      owned.rowBytes() != static_cast<size_t>(owned.width()) * (half ? 8 : 4)) {
+    return base::unexpected(CanvasCopyError::kInvalidLayout);
+  }
+  const bool opaque = source_is_opaque || owned.alphaType() == kOpaque_SkAlphaType;
+  if (!owned.setAlphaType(kUnpremul_SkAlphaType)) {
+    return base::unexpected(CanvasCopyError::kUnsupportedFormat);
+  }
+  bool transformed;
+  if (half) {
+    auto data = std::span(static_cast<uint16_t*>(owned.getPixels()), *bytes / 2);
+    if (opaque) {
+      for (size_t offset = 3; offset < data.size(); offset += 4) {
+        data[offset] = 0x3c00;
+      }
+    }
+    transformed = TransformEdgeCoherentCanvasF16(
+        data, owned.width(), owned.height(), partition_seed);
+  } else {
+    auto data = std::span(static_cast<uint8_t*>(owned.getPixels()), *bytes);
+    if (opaque) {
+      for (size_t offset = 3; offset < data.size(); offset += 4) {
+        data[offset] = 255;
+      }
+    }
+    transformed = TransformEdgeCoherentCanvas(
+        data, owned.width(), owned.height(), partition_seed);
+  }
+  if (!transformed) {
+    return base::unexpected(CanvasCopyError::kTransformFailed);
+  }
+  owned.notifyPixelsChanged();
+  owned.setImmutable();
+  return owned;
