+
+TEST(GlintOwnedCanvasCopyTest, RejectsSubsetBackingEvenAfterOriginalIsReleased) {
+  auto raster = MakeOwnedCanvasRaster();
+  ASSERT_TRUE(raster.getPixels());
+  SkBitmap subset;
+  ASSERT_TRUE(raster.extractSubset(&subset, SkIRect::MakeXYWH(1, 1, 2, 2)));
+  raster.reset();
+  const std::array<uint8_t, 32> seed{};
+  auto result = TransformOwnedCanvasCopy(std::move(subset), seed, false);
+  ASSERT_FALSE(result.has_value());
+  EXPECT_EQ(result.error(), CanvasCopyError::kInvalidLayout);
+}
+
+TEST(GlintOwnedCanvasCopyTest, KeepsF16DisplayP3ColourSpace) {
+  auto p3 = SkColorSpace::MakeRGB(SkNamedTransferFn::kSRGB, SkNamedGamut::kDisplayP3);
+  ASSERT_TRUE(p3);
+  SkBitmap raster;
+  ASSERT_TRUE(raster.tryAllocPixels(SkImageInfo::Make(
+      4, 4, kRGBA_F16_SkColorType, kUnpremul_SkAlphaType, p3)));
+  raster.eraseColor(SK_ColorRED);
+  const std::array<uint8_t, 32> seed{};
+  auto result = TransformOwnedCanvasCopy(std::move(raster), seed, false);
+  ASSERT_TRUE(result.has_value());
+  EXPECT_EQ(result->colorType(), kRGBA_F16_SkColorType);
+  EXPECT_TRUE(SkColorSpace::Equals(result->colorSpace(), p3.get()));
+  EXPECT_TRUE(result->isImmutable());
+}
+
+TEST(GlintOwnedCanvasCopyTest, Full4096RasterFitsUnchanged64MiBImageBudget) {
+  constexpr size_t kBudget = 64U * 1024U * 1024U;
+  SkBitmap bitmap;
+  ASSERT_TRUE(bitmap.tryAllocPixels(SkImageInfo::Make(
+      4096, 4096, kRGBA_8888_SkColorType, kOpaque_SkAlphaType,
+      SkColorSpace::MakeSRGB())));
+  bitmap.eraseColor(SK_ColorRED);
+  bitmap.setImmutable();
+  auto source = blink::UnacceleratedStaticBitmapImage::Create(
+      SkImages::RasterFromBitmap(bitmap));
+  ASSERT_TRUE(source);
+  source->SetOriginClean(false);
+  const std::array<uint8_t, 32> seed{};
+  auto rejected = CreateProtectedCanvasImage(source, seed, kBudget - 1);
+  ASSERT_FALSE(rejected.has_value());
+  EXPECT_EQ(rejected.error(), CanvasCopyError::kMemoryLimit);
+  auto result = CreateProtectedCanvasImage(source, seed, kBudget);
+  ASSERT_TRUE(result.has_value());
+  const auto info = result.value()->PaintImageForCurrentFrame().GetSkImageInfo();
+  EXPECT_EQ(info.width(), 4096);
+  EXPECT_EQ(info.height(), 4096);
+  EXPECT_FALSE(result.value()->OriginClean());
+}
