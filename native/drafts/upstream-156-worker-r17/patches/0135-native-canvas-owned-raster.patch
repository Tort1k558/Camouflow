+SkBitmap MakeOwnedCanvasRaster(size_t row_bytes = 0,
+                              SkColorType type = kRGBA_8888_SkColorType,
+                              SkAlphaType alpha = kUnpremul_SkAlphaType) {
+  const auto info = SkImageInfo::Make(4, 4, type, alpha, SkColorSpace::MakeSRGB());
+  SkBitmap bitmap;
+  if (!bitmap.tryAllocPixels(info, row_bytes ? row_bytes : info.minRowBytes())) {
+    return {};
+  }
+  std::array<uint8_t, 64> pixels{};
+  for (size_t y = 0; y < 4; ++y) {
+    for (size_t x = 0; x < 4; ++x) {
+      const size_t offset = (y * 4 + x) * 4;
+      pixels[offset] = static_cast<uint8_t>(x + 1);
+      pixels[offset + 1] = static_cast<uint8_t>(y + 1);
+      pixels[offset + 2] = 85;
+      pixels[offset + 3] = 255;
+    }
+  }
+  const auto input = SkImageInfo::Make(4, 4, kRGBA_8888_SkColorType,
+                                      kUnpremul_SkAlphaType,
+                                      SkColorSpace::MakeSRGB());
+  if (!bitmap.writePixels(SkPixmap(input, pixels.data(), 16))) {
+    return {};
+  }
+  return bitmap;
+}
+
+bool ReadOwnedCanvasRaster(const SkBitmap& bitmap,
+                          std::array<uint8_t, 64>& pixels) {
+  const auto info = SkImageInfo::Make(4, 4, kRGBA_8888_SkColorType,
+                                    kUnpremul_SkAlphaType,
+                                    SkColorSpace::MakeSRGB());
+  return bitmap.readPixels(info, pixels.data(), 16, 0, 0);
+}
+
+TEST(GlintOwnedCanvasCopyTest, ConsumesDenseAllocationAndInvalidatesGeneration) {
+  auto raster = MakeOwnedCanvasRaster();
+  ASSERT_TRUE(raster.getPixels());
+  const void* allocation = raster.getPixels();
+  const auto generation = raster.getGenerationID();
+  const std::array<uint8_t, 32> seed{};
+  auto result = TransformOwnedCanvasCopy(std::move(raster), seed, false);
+  ASSERT_TRUE(result.has_value());
+  EXPECT_EQ(result->getPixels(), allocation);
+  EXPECT_TRUE(result->isImmutable());
+  EXPECT_EQ(result->alphaType(), kUnpremul_SkAlphaType);
+  EXPECT_NE(result->getGenerationID(), generation);
+}
+
+TEST(GlintOwnedCanvasCopyTest, RejectsAliasedRasterWithoutChangingPixels) {
+  auto raster = MakeOwnedCanvasRaster();
+  ASSERT_TRUE(raster.getPixels());
+  SkBitmap alias = raster;
+  std::array<uint8_t, 64> before{}, after{};
+  ASSERT_TRUE(ReadOwnedCanvasRaster(alias, before));
+  const std::array<uint8_t, 32> seed{};
+  auto result = TransformOwnedCanvasCopy(std::move(raster), seed, false);
+  ASSERT_FALSE(result.has_value());
+  EXPECT_EQ(result.error(), CanvasCopyError::kInvalidLayout);
+  ASSERT_TRUE(ReadOwnedCanvasRaster(alias, after));
+  EXPECT_EQ(before, after);
+}
+
+TEST(GlintOwnedCanvasCopyTest, RejectsImmutableRaster) {
+  auto raster = MakeOwnedCanvasRaster();
+  ASSERT_TRUE(raster.getPixels());
+  raster.setImmutable();
+  const std::array<uint8_t, 32> seed{};
+  auto result = TransformOwnedCanvasCopy(std::move(raster), seed, false);
+  ASSERT_FALSE(result.has_value());
+  EXPECT_EQ(result.error(), CanvasCopyError::kInvalidLayout);
+}
+
+TEST(GlintOwnedCanvasCopyTest, RejectsPremultipliedInputUntilNormalized) {
