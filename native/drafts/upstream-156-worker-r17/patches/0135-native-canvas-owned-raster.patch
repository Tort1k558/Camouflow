+}
+
+TEST(GlintOwnedCanvasCopyTest, MatchesUnchangedPixelTransformOracle) {
+  auto raster = MakeOwnedCanvasRaster();
+  ASSERT_TRUE(raster.getPixels());
+  std::array<uint8_t, 64> expected{}, observed{};
+  ASSERT_TRUE(ReadOwnedCanvasRaster(raster, expected));
+  const std::array<uint8_t, 32> seed{};
+  ASSERT_TRUE(TransformEdgeCoherentCanvas(expected, 4, 4, seed));
+  auto result = TransformOwnedCanvasCopy(std::move(raster), seed, false);
+  ASSERT_TRUE(result.has_value());
+  ASSERT_TRUE(ReadOwnedCanvasRaster(result.value(), observed));
+  EXPECT_EQ(expected, observed);
+}
+
+TEST(GlintOwnedCanvasCopyTest, RejectsPaddedRows) {
