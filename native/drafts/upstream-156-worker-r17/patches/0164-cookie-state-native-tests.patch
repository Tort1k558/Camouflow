+// found in the LICENSE file.
+
+#include "third_party/blink/renderer/core/loader/cookie_checkpoint_state.h"
+
+#include <limits>
+
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace camouflow::native {
+
+class CookieCheckpointStateTestPeer {
+ public:
+  static void SetCounters(CookieCheckpointState& state,
+                          std::uint64_t generation,
+                          std::uint64_t epoch) {
+    state.generation_ = generation;
+    state.epoch_ = epoch;
+  }
+};
+
+namespace {
+
+using State = CookieCheckpointState;
+
+TEST(CookieCheckpointStateTest, EmptyStateCanAcknowledgeAnEmptyPrefix) {
+  State state;
+  EXPECT_TRUE(state.IsAvailable());
+  EXPECT_EQ(state.PendingWireRequests(), 0u);
+  EXPECT_TRUE(state.Acknowledge(state.Capture()));
+  EXPECT_EQ(state.LastWriteEpoch(), 0u);
+  EXPECT_EQ(state.AcknowledgedWriteEpoch(), 0u);
+}
+
+TEST(CookieCheckpointStateTest, AcknowledgedWriteSurvivesConnectionRetirement) {
+  State state;
+  ASSERT_TRUE(state.RecordWrite());
+  auto request = state.BeginWireRequest();
+  ASSERT_TRUE(request);
+  EXPECT_TRUE(state.RetireWireRequest(*request));
+  ASSERT_TRUE(state.Acknowledge(*request));
+  state.InvalidateConnection();
+  EXPECT_TRUE(state.IsAvailable());
+  EXPECT_FALSE(state.IsCurrent(*request));
+}
+
+TEST(CookieCheckpointStateTest, UnacknowledgedWriteMakesLostHistoryPermanent) {
+  State state;
+  ASSERT_TRUE(state.RecordWrite());
+  const auto old = state.Capture();
+  state.InvalidateConnection();
+  EXPECT_FALSE(state.IsAvailable());
+  EXPECT_FALSE(state.Acknowledge(old));
+  EXPECT_FALSE(state.Acknowledge(state.Capture()));
+  EXPECT_FALSE(state.BeginWireRequest());
+  ASSERT_TRUE(state.RecordWrite());
+  EXPECT_FALSE(state.IsAvailable());
+}
+
+TEST(CookieCheckpointStateTest, LaterWriteRejectsCapturedPrefix) {
+  State state;
+  auto request = state.BeginWireRequest();
+  ASSERT_TRUE(request);
+  ASSERT_TRUE(state.RecordWrite());
+  EXPECT_TRUE(state.RetireWireRequest(*request));
+  EXPECT_FALSE(state.Acknowledge(*request));
+  EXPECT_EQ(state.AcknowledgedWriteEpoch(), 0u);
+}
+
+TEST(CookieCheckpointStateTest, OldGenerationReplyCannotRetireNewRequest) {
+  State state;
+  auto old = state.BeginWireRequest();
+  ASSERT_TRUE(old);
+  state.InvalidateConnection();
+  auto current = state.BeginWireRequest();
+  ASSERT_TRUE(current);
+  EXPECT_FALSE(state.RetireWireRequest(*old));
+  EXPECT_EQ(state.PendingWireRequests(), 1u);
+  EXPECT_TRUE(state.RetireWireRequest(*current));
+  EXPECT_TRUE(state.Acknowledge(*current));
+}
+
+TEST(CookieCheckpointStateTest, PendingWireReservationsAreBounded) {
+  State state;
+  for (std::size_t i = 0; i < State::kMaximumPendingWireRequests; ++i) {
+    ASSERT_TRUE(state.BeginWireRequest());
+  }
+  EXPECT_EQ(state.PendingWireRequests(), 64u);
+  EXPECT_FALSE(state.BeginWireRequest());
+}
+
+TEST(CookieCheckpointStateTest, OnlyActualReplyReopensCapacity) {
+  State state;
+  auto first = state.BeginWireRequest();
+  ASSERT_TRUE(first);
+  for (std::size_t i = 1; i < State::kMaximumPendingWireRequests; ++i) {
+    ASSERT_TRUE(state.BeginWireRequest());
+  }
+  ASSERT_FALSE(state.BeginWireRequest());
+  EXPECT_TRUE(state.RetireWireRequest(*first));
+  EXPECT_TRUE(state.BeginWireRequest());
+  EXPECT_EQ(state.PendingWireRequests(), 64u);
+}
+
+TEST(CookieCheckpointStateTest, ConnectionRetirementClearsControlReservations) {
+  State state;
+  ASSERT_TRUE(state.BeginWireRequest());
+  state.InvalidateConnection();
+  EXPECT_EQ(state.PendingWireRequests(), 0u);
+  EXPECT_TRUE(state.IsAvailable());
+  EXPECT_TRUE(state.BeginWireRequest());
+}
+
+TEST(CookieCheckpointStateTest, ReplyUnderflowRejectsFurtherAcknowledgments) {
+  State state;
+  EXPECT_FALSE(state.RetireWireRequest(state.Capture()));
+  EXPECT_FALSE(state.IsAvailable());
+  EXPECT_FALSE(state.Acknowledge(state.Capture()));
+  EXPECT_FALSE(state.BeginWireRequest());
+}
+
+TEST(CookieCheckpointStateTest, ParallelRepliesCanAcknowledgeTheSamePrefix) {
+  State state;
+  ASSERT_TRUE(state.RecordWrite());
+  auto a = state.BeginWireRequest();
+  auto b = state.BeginWireRequest();
+  ASSERT_TRUE(a);
+  ASSERT_TRUE(b);
+  ASSERT_TRUE(state.RetireWireRequest(*b));
+  ASSERT_TRUE(state.Acknowledge(*b));
+  ASSERT_TRUE(state.RetireWireRequest(*a));
+  EXPECT_TRUE(state.Acknowledge(*a));
+  EXPECT_EQ(state.PendingWireRequests(), 0u);
+}
+
+TEST(CookieCheckpointStateTest, WriteEpochCannotWrap) {
+  State state;
+  CookieCheckpointStateTestPeer::SetCounters(
+      state, 0, std::numeric_limits<std::uint64_t>::max());
+  EXPECT_FALSE(state.RecordWrite());
+  EXPECT_FALSE(state.IsAvailable());
+  EXPECT_FALSE(state.BeginWireRequest());
+  EXPECT_EQ(state.Capture().epoch, std::numeric_limits<std::uint64_t>::max());
+}
+
+TEST(CookieCheckpointStateTest, ConnectionGenerationCannotWrap) {
+  State state;
+  CookieCheckpointStateTestPeer::SetCounters(
+      state, std::numeric_limits<std::uint64_t>::max(), 0);
+  state.InvalidateConnection();
+  EXPECT_FALSE(state.IsAvailable());
+  EXPECT_FALSE(state.Acknowledge(state.Capture()));
+  EXPECT_EQ(state.Capture().generation,
+            std::numeric_limits<std::uint64_t>::max());
+}
+
+TEST(CookieCheckpointStateTest, ConnectionMutationEpochCannotWrap) {
+  State state;
+  CookieCheckpointStateTestPeer::SetCounters(
+      state, 0, std::numeric_limits<std::uint64_t>::max());
+  state.InvalidateConnection();
+  EXPECT_FALSE(state.IsAvailable());
+  EXPECT_EQ(state.PendingWireRequests(), 0u);
+  EXPECT_EQ(state.Capture().epoch, std::numeric_limits<std::uint64_t>::max());
+}
+
+}  // namespace
+}  // namespace camouflow::native
