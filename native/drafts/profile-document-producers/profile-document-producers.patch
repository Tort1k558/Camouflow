+TEST_F(ProfileProducerFenceTest, CombinedWaitsForBothKindsAcrossRenderers) {
+  CheckpointHost first(&context_);
+  CheckpointHost second(&context_);
+  base::test::TestFuture<Result> result;
+  auto operation = ProfileProducerFence::Start(
+      &context_, Deadline(), result.GetCallback(),
+      ProfileProducerFence::ProducerScope::kDocumentStorage);
+  EXPECT_EQ(first.requests, 1);
+  EXPECT_EQ(second.requests, 1);
+  EXPECT_EQ(first.cookie_requests, 1);
+  EXPECT_EQ(second.cookie_requests, 1);
+  first.Reply(true);
+  second.CookieReply(true);
+  second.Reply(true);
+  environment_.RunUntilIdle();
+  EXPECT_FALSE(result.IsReady());
+  first.CookieReply(true);
+  EXPECT_EQ(result.Get().status, Status::kAcknowledged);
+  EXPECT_EQ(result.Get().renderer_count, 2u);
+}
+
+TEST_F(ProfileProducerFenceTest, CookieOnlyNeverContactsLocalStorage) {
+  CheckpointHost host(&context_);
+  base::test::TestFuture<Result> result;
+  auto operation = ProfileProducerFence::Start(
+      &context_, Deadline(), result.GetCallback(),
+      ProfileProducerFence::ProducerScope::kDocumentCookies);
+  EXPECT_EQ(host.requests, 0);
+  EXPECT_EQ(host.cookie_requests, 1);
+  host.CookieReply(true);
+  EXPECT_EQ(result.Get().status, Status::kAcknowledged);
+}
+
