+IN_PROC_BROWSER_TEST_F(RenderProcessHostTestBase,
+                       ProfileDocumentCheckpointCombinedHungRendererDeadline) {
+  using Fence = camouflow::native::ProfileProducerFence;
+  ASSERT_TRUE(embedded_test_server()->Start());
+  ASSERT_TRUE(NavigateToURL(shell(), embedded_test_server()->GetURL("/title1.html")));
+  auto* host = shell()->web_contents()->GetPrimaryMainFrame()->GetProcess();
+  ScopedAllowRendererCrashes allow(host);
+  DOMMessageQueue messages(shell()->web_contents());
+  ExecuteScriptAsync(shell(),
+      "domAutomationController.send('profile-busy'); while (true) {}");
+  std::string message;
+  ASSERT_TRUE(messages.WaitForMessage(&message));
+  ASSERT_EQ(JsReplace("$1", "profile-busy"), message);
+  base::test::TestFuture<Fence::Result> result;
+  auto operation = Fence::Start(host->GetBrowserContext(),
+      base::TimeTicks::Now() + base::Milliseconds(100), result.GetCallback(),
+      Fence::ProducerScope::kDocumentStorage);
+  const auto status = result.Get().status;
+  // Both browser and aggregate timers use the same deadline; either may win.
+  EXPECT_TRUE(status == Fence::Status::kTimedOut ||
+              status == Fence::Status::kProducerRejected);
+  RenderProcessHostWatcher exit(host, RenderProcessHostWatcher::WATCH_FOR_PROCESS_EXIT);
+  ASSERT_TRUE(host->Shutdown(0));
+  exit.Wait();
+}
