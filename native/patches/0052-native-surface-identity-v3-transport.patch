+
+TEST_F(GlintSurfacePolicyProducerTest,
+       IdentityModeSelectsStableSeedsWithExactPartition) {
+  ASSERT_TRUE(content::InitializeNativePrivacyContext(
+      browser_context(), owned_.GetPath(),
+      content::NativeFingerprintDerivationMode::kProfileIdentity));
+  task_environment()->RunUntilIdle();
+  const auto other = blink::StorageKey::CreateFirstParty(
+      url::Origin::Create(GURL("https://other.test")));
+  auto first = CreateSurfacePolicy(browser_context(), Partition());
+  auto second = CreateSurfacePolicy(browser_context(), other);
+  ASSERT_TRUE(first);
+  ASSERT_TRUE(second);
+  EXPECT_EQ(first->identity_mode, SurfaceIdentityMode::kProfileIdentity);
+  EXPECT_EQ(first->canvas, second->canvas);
+  EXPECT_EQ(first->webgl, second->webgl);
+  EXPECT_EQ(first->webgpu, second->webgpu);
+  EXPECT_EQ(first->audio, second->audio);
+  EXPECT_NE(first->partition_encoding, second->partition_encoding);
+  EXPECT_TRUE(ValidateSurfacePolicy(*first, Partition()));
+  EXPECT_FALSE(ValidateSurfacePolicy(*first, other));
+  EXPECT_EQ(first->canvas, content::DeriveNativeSelectedFingerprintKey(
+                               browser_context(), Partition(), "canvas"));
+}
+
+TEST_F(GlintSurfacePolicyProducerTest,
+       DefaultModeRetainsPartitionDependentSeeds) {
+  Initialize();
+  task_environment()->RunUntilIdle();
+  auto first = CreateSurfacePolicy(browser_context(), Partition());
+  const auto other = blink::StorageKey::CreateFirstParty(
+      url::Origin::Create(GURL("https://other.test")));
+  auto second = CreateSurfacePolicy(browser_context(), other);
+  ASSERT_TRUE(first);
+  ASSERT_TRUE(second);
+  EXPECT_EQ(first->identity_mode, SurfaceIdentityMode::kPartitionedPrivacy);
+  EXPECT_NE(first->canvas, second->canvas);
+  EXPECT_EQ(first->canvas, content::DeriveNativePrivacyKey(
+                               browser_context(), Partition(), "canvas"));
+}
