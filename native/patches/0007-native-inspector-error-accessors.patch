+v8::MaybeLocal<v8::Value> getErrorPropertyDescriptor(
+    v8::Local<v8::Context> context, v8::Local<v8::Object> object,
+    v8::Local<v8::String> name) {
+  v8::Isolate* isolate = v8::Isolate::GetCurrent();
+  for (int depth = 0; depth < 128; ++depth) {
+    if (object->IsProxy()) return v8::MaybeLocal<v8::Value>();
+    v8::Local<v8::Value> descriptor;
+    if (!object->GetOwnPropertyDescriptor(context, name).ToLocal(&descriptor)) {
+      return v8::MaybeLocal<v8::Value>();
+    }
+    if (descriptor->IsObject()) return descriptor;
+    v8::Local<v8::Value> prototype = object->GetPrototype();
+    if (!prototype->IsObject()) return v8::Undefined(isolate);
+    object = prototype.As<v8::Object>();
+  }
+  return v8::MaybeLocal<v8::Value>();
+}
