+void RenderFrameHostImpl::RejectGlintDocumentCanvasCommit(
+    const base::UnguessableToken& navigation_token) {
+  NavigationRequest* rejected = nullptr;
+  for (const auto& entry : navigation_requests_) {
+    auto* request = entry.second.get();
+    if (request->commit_params().navigation_token != navigation_token) {
+      continue;
+    }
+    if (!request->IsWaitingToCommit() || request->GetRenderFrameHost() != this ||
+        !request->commit_params().glint_document_canvas_commit) {
+      return;
+    }
+    rejected = request;
+    break;
+  }
+  // Late, duplicate and foreign-frame tokens must not cancel another request.
+  if (!rejected) {
+    return;
+  }
+  FrameTreeNode* node = rejected->frame_tree_node();
+  rejected->set_net_error(net::ERR_ABORTED);
+  NavigationRequestCancelled(rejected,
+                             NavigationDiscardReason::kInternalCancellation);
+  node->render_manager()->DiscardSpeculativeRFHIfUnused(
+      NavigationDiscardReason::kInternalCancellation);
+  // Cleanup can destroy this RenderFrameHost; do not access members here.
+}
