+  BlinkStorageKey resolved(
+      ResolveGlintDocumentStorageKey(key, final_origin->ToUrlOrigin()));
+  resolved = resolved.WithOrigin(final_origin);
+  EXPECT_EQ(resolved.GetSecurityOrigin(), final_origin);
+  EXPECT_TRUE(resolved.GetSecurityOrigin()->IsPotentiallyTrustworthy());
+  EXPECT_TRUE(resolved.GetSecurityOrigin()->CanLoadLocalResources());
