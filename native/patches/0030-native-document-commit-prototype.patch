+                         mojom::AncestorChainBit::kCrossSite, false),
+      StorageKey::Create(origin, net::SchemefulSite(GURL("https://top.test/")),
+                         mojom::AncestorChainBit::kCrossSite, true),
+      StorageKey::CreateFirstParty(url::Origin()),
+      StorageKey::CreateWithNonce(url::Origin(), base::UnguessableToken::Create())};
+  const auto final_origin = SecurityOrigin::Create(KURL("https://next.test/"));
+  for (const auto& key : keys) {
+    BlinkStorageKey expected(key);
+    if (expected.GetSecurityOrigin()->IsOpaque() && !expected.GetNonce()) {
+      expected = BlinkStorageKey::CreateFirstParty(final_origin);
+    }
+    expected = expected.WithOrigin(final_origin);
+    BlinkStorageKey resolved(
+        ResolveGlintDocumentStorageKey(key, final_origin->ToUrlOrigin()));
+    resolved = resolved.WithOrigin(final_origin);
+    EXPECT_EQ(static_cast<StorageKey>(resolved).SerializeForNativePrivacy(),
+              static_cast<StorageKey>(expected).SerializeForNativePrivacy());
+    EXPECT_EQ(resolved.GetSecurityOrigin(), final_origin);
+  }
+}
