+TEST_F(StorageKeyTest, NativePrivacyEncodingIsStableAndPreservesStorageFormat) {
+  const auto origin = url::Origin::Create(GURL("https://sub.example.test:8443"));
+  const auto key = StorageKey::CreateFirstParty(origin);
+  const auto storage = key.Serialize();
+  const auto privacy = key.SerializeForNativePrivacy();
+  ASSERT_TRUE(privacy);
+  EXPECT_EQ(*privacy, *key.SerializeForNativePrivacy());
+  EXPECT_EQ(*privacy, *StorageKey(key).SerializeForNativePrivacy());
+  EXPECT_EQ(key.Serialize(), storage);
+  EXPECT_NE(*privacy, storage);
+}
