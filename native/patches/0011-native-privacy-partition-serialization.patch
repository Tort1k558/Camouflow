+
+std::optional<std::string> StorageKey::SerializeForNativePrivacy() const {
+  constexpr size_t kMaximumBytes = 8192;
+  std::string out("CamouFlowNative/partition/v1");
+  out.push_back('\0');
+  const auto append_integer = [&out](uint64_t value, int bytes) {
+    for (int shift = (bytes - 1) * 8; shift >= 0; shift -= 8) {
+      out.push_back(static_cast<char>((value >> shift) & 0xff));
+    }
+  };
+  const auto append_nonce = [&append_integer](const base::UnguessableToken& nonce) {
+    append_integer(nonce.GetHighForSerialization(), 8);
+    append_integer(nonce.GetLowForSerialization(), 8);
+  };
+  const auto append_field = [&out, &append_integer](std::string_view value) {
+    if (value.size() > kMaximumBytes ||
+        out.size() + 4 + value.size() > kMaximumBytes) {
+      return false;
+    }
+    append_integer(value.size(), 4);
+    out.append(value);
+    return true;
+  };
+  const auto append_origin = [&out, &append_nonce, &append_integer,
+                              &append_field](const url::Origin& origin) {
+    out.push_back(origin.opaque() ? '\1' : '\0');
+    const auto& tuple = origin.GetTupleOrPrecursorTupleIfOpaque();
+    if (!append_field(tuple.scheme()) || !append_field(tuple.host())) {
+      return false;
+    }
+    append_integer(tuple.port(), 2);
+    if (origin.opaque()) {
+      const auto* nonce = origin.GetNonceForSerialization();
+      CHECK(nonce);
+      append_nonce(*nonce);
+    }
+    return true;
+  };
+  if (!append_origin(origin_) ||
+      !append_origin(top_level_site_if_third_party_enabled_.internal_value())) {
+    return std::nullopt;
+  }
+  out.push_back(ancestor_chain_bit_if_third_party_enabled_ ==
+                        blink::mojom::AncestorChainBit::kCrossSite
+                    ? '\1'
+                    : '\0');
+  out.push_back(nonce_.has_value() ? '\1' : '\0');
+  if (nonce_) {
+    append_nonce(*nonce_);
+  }
+  if (out.size() > kMaximumBytes) {
+    return std::nullopt;
+  }
+  return out;
 }
 
