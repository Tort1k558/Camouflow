@@ -156,5 +163,86 @@ INSTANTIATE_TYPED_TEST_SUITE_P(
     GLES2DecoderPassthroughImmediateSizeArgCommandTest,
     ES3ImmediateSizeArgCommandTypes0);
 
+TEST_F(GLES2DecoderPassthroughTest,
+       GlintMetadataInvalidSharedMemoryDoesNotWrite) {
+  base::test::ScopedFeatureList scoped_features;
+  scoped_features.InitAndDisableFeature(
+      features::kGlintReadbackMetadataCandidate);
+  using Command = cmds::GetGlintReadFramebufferMetadataCHROMIUM;
+  Command command;
+  command.Init(kInvalidSharedMemoryId, kSharedMemoryOffset);
+  std::array<uint8_t, kSharedBufferSize> before;
+  const auto* memory = static_cast<const uint8_t*>(shared_memory_base_.get());
+  std::copy_n(memory, before.size(), before.begin());
+  EXPECT_EQ(error::kOutOfBounds, ExecuteCmd(command));
+  EXPECT_TRUE(std::equal(before.begin(), before.end(), memory));
+}
+
+TEST_F(GLES2DecoderPassthroughTest,
+       GlintMetadataOverflowingOffsetDoesNotWrite) {
+  base::test::ScopedFeatureList scoped_features;
+  scoped_features.InitAndDisableFeature(
+      features::kGlintReadbackMetadataCandidate);
+  using Command = cmds::GetGlintReadFramebufferMetadataCHROMIUM;
+  Command command;
+  command.Init(shared_memory_id_, 0xfffffffcu);
+  std::array<uint8_t, kSharedBufferSize> before;
+  const auto* memory = static_cast<const uint8_t*>(shared_memory_base_.get());
+  std::copy_n(memory, before.size(), before.begin());
+  EXPECT_EQ(error::kOutOfBounds, ExecuteCmd(command));
+  EXPECT_TRUE(std::equal(before.begin(), before.end(), memory));
+}
+
+TEST_F(GLES2DecoderPassthroughTest,
+       GlintMetadataTruncatedResultStorageDoesNotWrite) {
+  base::test::ScopedFeatureList scoped_features;
+  scoped_features.InitAndDisableFeature(
+      features::kGlintReadbackMetadataCandidate);
+  using Command = cmds::GetGlintReadFramebufferMetadataCHROMIUM;
+  Command command;
+  command.Init(shared_memory_id_, kSharedBufferSize - 7 * sizeof(GLint));
+  std::array<uint8_t, kSharedBufferSize> before;
+  const auto* memory = static_cast<const uint8_t*>(shared_memory_base_.get());
+  std::copy_n(memory, before.size(), before.begin());
+  EXPECT_EQ(error::kOutOfBounds, ExecuteCmd(command));
+  EXPECT_TRUE(std::equal(before.begin(), before.end(), memory));
+}
+
+TEST_F(GLES2DecoderPassthroughTest,
+       GlintMetadataInitializedResultDoesNotWrite) {
+  base::test::ScopedFeatureList scoped_features;
+  scoped_features.InitAndDisableFeature(
+      features::kGlintReadbackMetadataCandidate);
+  using Command = cmds::GetGlintReadFramebufferMetadataCHROMIUM;
+  Command command;
+  auto* result = GetSharedMemoryAs<Command::Result*>();
+  result->SetNumResults(1);
+  command.Init(shared_memory_id_, kSharedMemoryOffset);
+  std::array<uint8_t, kSharedBufferSize> before;
+  const auto* memory = static_cast<const uint8_t*>(shared_memory_base_.get());
+  std::copy_n(memory, before.size(), before.begin());
+  EXPECT_EQ(error::kInvalidArguments, ExecuteCmd(command));
+  EXPECT_TRUE(std::equal(before.begin(), before.end(), memory));
+}
+
+TEST_F(GLES2DecoderPassthroughTest,
+       GlintMetadataFeatureOffPublishesOnlyUnavailable) {
+  base::test::ScopedFeatureList scoped_features;
+  scoped_features.InitAndDisableFeature(
+      features::kGlintReadbackMetadataCandidate);
+  using Command = cmds::GetGlintReadFramebufferMetadataCHROMIUM;
+  auto* result = GetSharedMemoryAs<Command::Result*>();
+  result->SetNumResults(0);
+  result->GetData()[kGlintReadbackMetadataValues] = 0x4c;
+  Command command;
+  command.Init(shared_memory_id_, kSharedMemoryOffset);
+  ASSERT_EQ(error::kNoError, ExecuteCmd(command));
+  ASSERT_EQ(result->GetNumResults(), static_cast<int>(kGlintReadbackMetadataValues));
+  EXPECT_TRUE(std::equal(kGlintReadbackMetadataUnavailable.begin(),
+                         kGlintReadbackMetadataUnavailable.end(),
+                         result->GetData()));
+  EXPECT_EQ(result->GetData()[kGlintReadbackMetadataValues], 0x4c);
+}
+
 }  // namespace gles2
 }  // namespace gpu
